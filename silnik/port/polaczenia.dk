fun runSleepOperation(reg: ref Registers, op: Operation, resultWorld: ref SavedWorld, resultBody: ref SavedBody, kind: ref i32) -> i32 = {
    if (op.opcode == 56i32) {
        let created: game.WorldResult = game.createSleepWorld(op.solverParameters.gravity, op.solverParameters.maximumLinearSpeed, op.solverParameters, op.wake);
        if (created.status == game.OK) { resultWorld = SavedWorld(true, created.number, created.id); reg.worlds[op.a] = resultWorld; kind = 1i32; }
        return created.status;
    }
    if (op.opcode == 57i32) {
        var made = game.BodyResult();
        if (op.mode == 1i32) made = game.createBody8(reg.worlds[op.b].number, op.def);
        else made = game.createBody(reg.worlds[op.b].number, op.def);
        if (made.status == game.OK) { resultBody = SavedBody(true, made.number, reg.worlds[op.b].number, made.id); reg.bodies[op.a] = resultBody; kind = 2i32; }
        return made.status;
    }
    if (op.opcode == 61i32) { resultWorld = reg.worlds[op.a]; kind = 1i32; return game.setSleepingEnabled(resultWorld.number, op.wake); }
    if (op.opcode == 64i32) return runSleepComponent(reg, op);
    resultBody = reg.bodies[op.b]; kind = 2i32;
    if (op.opcode == 58i32) return game.setAwake(reg.worlds[op.a].number, resultBody.number, op.wake);
    if (op.opcode == 59i32) return game.setSleepEnabled(reg.worlds[op.a].number, resultBody.number, op.wake);
    if (op.opcode == 60i32) return game.setSleepThreshold(reg.worlds[op.a].number, resultBody.number, op.value.x);
    return game.bodyStatus(reg.worlds[op.a].number, resultBody.number);
}

fun decodeSolverParameters(w: ref u32[64]) -> game.SolverWorldParameters = {
    var result = game.SolverWorldParameters();
    result.gravity = math2.Vec2(fromBits(w[2]), fromBits(w[3])); result.maximumLinearSpeed = fromBits(w[4]);
    result.contactHertz = fromBits(w[5]); result.contactDampingRatio = fromBits(w[6]); result.maxContactPushSpeed = fromBits(w[7]);
    result.restitutionThreshold = fromBits(w[8]); result.hitEventThreshold = fromBits(w[9]); result.enableWarmStarting = w[10] != 0u32;
    return result;
}

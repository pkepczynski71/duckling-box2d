# Box2D 8c661469, src/world.c:100.                                                                     
                                                                                           
const CONTACT_PROFILE: i32 = 11i32;

# Box2D 8c661469, src/shape.                                                                               
var guard13B: bool = false;
var profile13C: i32 = 0i32;
var initialC13: bool = false;
var currentCase13: u32 = 1u32;
# Box2D 8c661469, src/world.                                                               
fun component13() -> bool = { return CONTACT_PROFILE == 10i32 or profile13C == 15i32; }
var groupError13: str = "";
var initialRow13: bool = true; var initialA13: bool = false; var initialTagged13: bool = false;
var chainInput13: game.ChainDescription = game.ChainDescription();
var lastChainInput13: game.ChainDescription = game.ChainDescription();
var rawChainInput13: raw.ChainDef = raw.ChainDef(); var lastRawInput13: bool = false;
var lastPoints13: bool = false; var lastMaterials13: bool = false;
var chainZ13: i32[18] = zeroChainZ13(); var chainI13: i32[6] = zeroChainI13();
var chainStatus13: i32 = 0i32; var chainReason13: i32 = 0i32;
fun zeroChainZ13() -> i32[18] = { var values: i32[18]; return values; }
fun zeroChainI13() -> i32[6] = { var values: i32[6]; return values; }
class SavedChain13 { saved: bool = false; number: game.ChainNumber = game.ChainNumber(); owner: game.WorldNumber = game.WorldNumber(); id: raw.ChainId = raw.ChainId(); }
class SavedChainCopy13 { saved: bool = false; value: game.ChainView = game.ChainView(); id: raw.ChainId = raw.ChainId(); children: List[broad.ShapeId] = emptyRawChildren13(); }
fun emptyRawChildren13() -> List[broad.ShapeId] = { var values: List[broad.ShapeId]; return values; }
fun zeroChains13() -> SavedChain13[16] = { var values: SavedChain13[16]; return values; }
fun zeroChainCopies13() -> SavedChainCopy13[4] = { var values: SavedChainCopy13[4]; return values; }
fun chainRaw13(id: raw.ChainId) -> () = { outHex(id.index1 as u32); outHex(id.world0 as u32); outHex(id.generation as u32); }
fun chainNumber13(number: game.ChainNumber) -> () = { outHex(number.slot as u32); outPair(number.birthTicket); outPair(number.ownerTicket); }
fun bodyNumber13(number: game.BodyNumber) -> () = { outHex(number.slot as u32); outPair(number.birthTicket); outPair(number.ownerTicket); }
fun shapeNumber13(number: game.ShapeNumber) -> () = { outHex(number.slot as u32); outPair(number.birthTicket); outPair(number.ownerTicket); }
fun childRaw13(id: broad.ShapeId) -> () = { outHex(id.index1 as u32); outHex(id.world0 as u32); outHex(id.generation as u32); }
fun zeros13(count: i32) -> () = { var i: i32 = 0i32; while (i < count) { outHex(0u32); i = i+1i32; } }
fun outChainAnswer13(id: u32, seq: u32, status: i32, reason: i32) -> () = {
    prefix("A13",id,seq); outHex(status as u32); outHex(reason as u32); newline(); chainZ13[0] = 1i32;
}
fun chainLegacyReason13(reg: ref Registers, op: Operation, status: i32) -> i32 = {
    if (status == game.LOCKED) return 1i32;
    if (status != game.PARAM) return 0i32;
    if (op.opcode == 80i32 and op.mode == 1i32 and op.kind == 0i32 and game.bodyStatus(reg.worlds[op.a].number,reg.bodies[op.b].number) == game.OK) {
        if (raw.worlds.at(reg.worlds[op.a].number.slot as i64).bodies.at(reg.bodies[op.b].number.slot as i64).headChainId != -1i32 and op.words[4] != 0u32) return 80i32;
    }
    if ((op.opcode == 18i32 or op.opcode == 19i32 or (op.opcode == 81i32 and op.mode == 1i32)) and game.shapeStatus(reg.worlds[op.a].number,reg.shapes[op.b].number) == game.OK) {
        if (raw.worlds.at(reg.worlds[op.a].number.slot as i64).shapes.at(reg.shapes[op.b].number.slot as i64).shapeType == 4i32) return 81i32;
    }
    return 0i32;
}
fun materialOut13(material: raw.SurfaceMaterial) -> () = { outFloat(material.friction); outFloat(material.restitution); outFloat(material.rollingResistance); outFloat(material.tangentSpeed); outHex(material.userMaterialId as u32); outHex(material.customColor); }
fun cloneDescription13(source: ref game.ChainDescription) -> game.ChainDescription = {
    var value = game.ChainDescription(); value.points = copy source.points; value.materials = copy source.materials;
    value.isLoop = source.isLoop; value.filter = source.filter; value.hasObjectId = source.hasObjectId; value.objectId = source.objectId; value.enableSensorEvents = source.enableSensorEvents; return value;
}
fun readChainInput13(id: u32, seq: u32, words: ref u32[64]) -> () = {
    var description = game.ChainDescription(); description.materials = raw.emptySurfaceMaterials();
    description.isLoop = words[5] != 0u32; description.hasObjectId = words[7] != 0u32; description.objectId = words64.Key64(words[8],words[9]);
    description.filter = broad.ShapeFilter(pairFromWords(words[10],words[11]),pairFromWords(words[12],words[13]),words[14] as i32); description.enableSensorEvents = words[15] != 0u32;
    var i: u32 = 0u32;
    while (i < words[4] and inputOk) {
        groupError13 = "PORT14A: INPUT_POINT\n"; requiredRow("P13B",6i32); let rowId: u32 = readWord(); let rowSeq: u32 = readWord(); let index: u32 = readWord();
        readingPayload = true; let x: u32 = readWord(); let y: u32 = readWord(); readingPayload = false; endRow(); if (not inputOk) return;
        if (rowId != id) { invalid("PORT14A: INPUT_ID\n"); return; }
        if (rowSeq != seq) { invalid("PORT14A: INPUT_SEQ\n"); return; }
        if (index != i) { invalid("PORT14A: INPUT_SEQUENCE\n"); return; }
        description.points.push(math2.Vec2(fromBits(x),fromBits(y))); i = i+1u32;
    }
    var j: u32 = 0u32;
    while (j < words[6] and inputOk) {
        groupError13 = "PORT14A: INPUT_MATERIAL\n"; requiredRow("U13B",10i32); let matId: u32 = readWord(); let matSeq: u32 = readWord(); let matIndex: u32 = readWord();
        readingPayload = true; var material = raw.SurfaceMaterial(); material.friction = fromBits(readWord()); material.restitution = fromBits(readWord());
        material.rollingResistance = fromBits(readWord()); material.tangentSpeed = fromBits(readWord()); material.userMaterialId = readWord() as i32; material.customColor = readWord(); readingPayload = false; endRow(); if (not inputOk) return;
        if (matId != id) { invalid("PORT14A: INPUT_ID\n"); return; } if (matSeq != seq) { invalid("PORT14A: INPUT_SEQ\n"); return; }
        if (matIndex != j) { invalid("PORT14A: INPUT_SEQUENCE\n"); return; }
        description.materials.push(material); j = j+1u32;
    }
    groupError13 = ""; chainInput13 = move description;
}
fun echoChainInput13(id: u32, seq: u32) -> () = {
    var i: i64 = 0i64; while (i < chainInput13.points.length()) {
        let point: math2.Vec2 = chainInput13.points.at(i); prefix("EP13B",id,seq); outDec(i as i32); outFloat(point.x); outFloat(point.y); newline(); chainZ13[14] = chainZ13[14]+1i32; i = i+1i64;
    }
    var j: i64 = 0i64; while (j < chainInput13.materials.length()) { prefix("EU13B",id,seq); outDec(j as i32); materialOut13(chainInput13.materials.at(j)); newline(); chainZ13[15] = chainZ13[15]+1i32; j = j+1i64; }
}
fun pairFromWords(low: u32, high: u32) -> i64 = { return (((high as u64) << 32u64) | low as u64) as i64; }
fun decodeChain13(code: u32, words: ref u32[64]) -> Operation = {
    var op = Operation(); op.opcode = code as i32; op.words = words; var used: i32 = 0i32;
    if (code <= 105u32) {
        if (words[0] > 1u32) { invalid("PORT14A: INPUT_MODE\n"); return op; } op.mode = words[0] as i32;
        op.a = registerIndex(words[1],16u32);
        op.b = registerIndex(words[2],if code == 100u32 then 256u32 else (if code >= 104u32 then 512u32 else 16u32));
        if (code == 100u32) {
            used = 16i32; op.c = registerIndex(words[3],16u32);
            if (words[4] > 128u32 or words[6] > 128u32) { invalid("PORT14A: INPUT_POPULATION\n"); return op; }
            if (words[5] > 1u32 or words[7] > 1u32 or words[15] > 1u32) { invalid("PORT14A: INPUT_BOOL\n"); return op; }
            if (words[7] == 0u32 and (words[8] != 0u32 or words[9] != 0u32)) { invalid("PORT14A: INPUT_UNUSED\n"); return op; }
        } else if (code == 102u32) {
            used = 4i32; if (words[3] > 128u32) { invalid("PORT14A: INPUT_POPULATION\n"); return op; }
            if (op.mode == 1i32 and words[3] != 0u32) { invalid("PORT14A: INPUT_UNUSED\n"); return op; }
        } else if (code == 103u32) { used = 5i32; if (words[3] > 2u32) { invalid("PORT14A: INPUT_ENUM\n"); return op; } }
        else used = 3i32;
    } else if (code == 106u32) { used = 3i32; op.a = registerIndex(words[0],16u32); op.b = registerIndex(words[1],16u32); op.c = registerIndex(words[2],4u32); }
    else if (code == 107u32 or code == 108u32) { used = if code == 107u32 then 1i32 else 3i32; op.a = registerIndex(words[0],4u32); }
    else if (code == 109u32) { used = 2i32; if (words[0] > 1u32) { invalid("PORT14A: INPUT_ENUM\n"); return op; } if (words[1] > 1u32) { invalid("PORT14A: INPUT_BOOL\n"); return op; } }
    unusedRange(words,used,64i32); return op;
}
fun validChainOp13(reg: ref Registers, op: Operation) -> bool = {
    let code: i32 = op.opcode;
    if (code <= 106i32) {
        if (not reg.worlds[op.a].saved) { invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n"); return false; }
        if (code == 100i32) {
            if (not reg.bodies[op.b].saved) { invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n"); return false; }
            if (reg.chains13[op.c].saved and game.chainStatus(reg.chains13[op.c].owner,reg.chains13[op.c].number) == game.OK) { invalid("PORT14A: INPUT_REGISTER_COLLISION\n"); return false; }
        } else if (code == 104i32 or code == 105i32) { if (not reg.shapes[op.b].saved) { invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n"); return false; } }
        else if (not reg.chains13[op.b].saved) { invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n"); return false; }
    }
    if (code == 107i32 or code == 108i32) {
        if (not reg.chainCopies13[op.a].saved) { invalid("PORT14A: INPUT_COPY\n"); return false; }
        if (code == 108i32) {
            if (op.words[1] as i64 >= reg.chainCopies13[op.a].value.segments.length()) { invalid("PORT14A: INPUT_COPY\n"); return false; }
            if (op.words[2] == reg.chainCopies13[op.a].value.segments.at(op.words[1] as i64).slot as u32) { invalid("PORT14A: INPUT_DOMAIN\n"); return false; }
        }
    }
    if (code == 109i32 and ((op.words[0] == 0u32 and not lastPoints13) or (op.words[0] == 1u32 and not lastMaterials13))) { invalid("PORT14A: INPUT_COPY\n"); return false; }
    return true;
}
fun runChain13(reg: ref Registers, id: u32, seq: u32, op: Operation) -> i32 = {
    if (not validChainOp13(reg,op)) return -1i32;
    var execution = Execution(); chainStatus13 = game.OK; chainReason13 = 0i32; var beforePools13: PoolCounts = poolCounts();
    clearSolverObservations(); clearSleepObservations(); clearHookObservations12(reg,op);
    let code: i32 = op.opcode;
    if (code == 100i32) {
        var validation = game.ChainValidation(); let owner: game.WorldNumber = reg.worlds[op.a].number;
        if (op.mode == 1i32) validation = game.chainCreatePreflight(owner,reg.bodies[op.b].number,&chainInput13);
        else {
            validation.status = game.bodyMutationStatus(owner,reg.bodies[op.b].number);
            if (validation.status == game.OK) {
                if (op.words[4] < 4u32 or (op.words[6] != 1u32 and op.words[6] != op.words[4])) { invalid("PORT14A: INPUT_DOMAIN\n"); return -1i32; }
                var mi: i64 = 0i64; while (mi < chainInput13.materials.length()) { if (not game.validSurfaceMaterial(chainInput13.materials.at(mi))) { invalid("PORT14A: INPUT_DOMAIN\n"); return -1i32; } mi = mi+1i64; }
                var pi: i64 = 0i64; while (pi < chainInput13.points.length()) { if (not game.finiteVector(chainInput13.points.at(pi))) { invalid("PORT14A: INPUT_DOMAIN\n"); return -1i32; } pi = pi+1i64; }
                let segments: i32 = if chainInput13.isLoop then op.words[4] as i32 else op.words[4] as i32-3i32;
                if (not game.chainTicketReservation(game.lastIssued,segments)) validation.status = game.LIMIT;
            }
        }
        chainStatus13 = validation.status; chainReason13 = validation.reason;
        if (chainStatus13 == game.OK) {
            let segmentCount: i32 = if chainInput13.isLoop then op.words[4] as i32 else op.words[4] as i32-3i32;
            var freeRegisters: i32 = 0i32; var sri: i32 = 0i32;
            while (sri < 512i32) { if (not reg.shapes[sri].saved) freeRegisters = freeRegisters+1i32; sri = sri+1i32; }
            if (freeRegisters < segmentCount) { invalid("PORT14A: INPUT_POPULATION\n"); return -1i32; }
            if (not chainPopulationReservation13(reg,owner,segmentCount,op.words[6] as i32)) return -1i32;
            let chainGrowth13: i32 = if raw.worlds.at(owner.slot as i64).chainIdPool.freeCount == 0i32 then 1i32 else 0i32;
            var made = game.ChainResult();
            if (op.mode == 1i32) { lastChainInput13 = cloneDescription13(&chainInput13); made = game.addChain(owner,reg.bodies[op.b].number,&lastChainInput13); }
            else {
                rawChainInput13.points = copy chainInput13.points; rawChainInput13.count = op.words[4] as i32; rawChainInput13.isLoop = chainInput13.isLoop;
                rawChainInput13.materials = copy chainInput13.materials; rawChainInput13.materialCount = op.words[6] as i32; rawChainInput13.filter = chainInput13.filter;
                rawChainInput13.hasObjectId = chainInput13.hasObjectId; rawChainInput13.objectId = chainInput13.objectId; rawChainInput13.enableSensorEvents = chainInput13.enableSensorEvents;
                made.id = raw.b2CreateChain(reg.bodies[op.b].id,&rawChainInput13); game.stampChainTickets(owner,made.id); made.status = game.OK;
                let slot: i32 = made.id.index1-1i32; made.number = game.ChainNumber(slot,raw.worlds.at(owner.slot as i64).chainShapes.at(slot as i64).birthTicket,owner.birthTicket);
            }
            chainStatus13 = made.status; chainReason13 = made.reason;
            if (made.status == game.OK) {
                reg.totalChainSlots13 = reg.totalChainSlots13+chainGrowth13;
                reg.chains13[op.c] = SavedChain13(true,made.number,owner,made.id);
                var children: List[broad.ShapeId] = raw.b2Chain_GetSegments(made.id,segmentCount); var ci: i64 = 0i64; var target: i32 = 0i32;
                while (ci < children.length()) {
                    while (reg.shapes[target].saved) target = target+1i32;
                    let child: broad.ShapeId = children.at(ci); let slotChild: i32 = child.index1-1i32;
                    let number: game.ShapeNumber = game.ShapeNumber(slotChild,raw.worlds.at(owner.slot as i64).shapes.at(slotChild as i64).birthTicket,owner.birthTicket);
                    reg.shapes[target] = SavedShape(true,number,owner,child); ci = ci+1i64; target = target+1i32;
                }
                lastRawInput13 = op.mode == 0i32; lastPoints13 = true; lastMaterials13 = true;
            }
        }
    } else if (code >= 101i32 and code <= 106i32) {
        let owner2: game.WorldNumber = reg.worlds[op.a].number;
        if (code == 104i32 or code == 105i32) {
            chainStatus13 = game.shapeStatus(owner2,reg.shapes[op.b].number);
            if (chainStatus13 == game.OK and code == 105i32 and raw.worlds.at(owner2.slot as i64).shapes.at(reg.shapes[op.b].number.slot as i64).shapeType != 4i32) {
                if (op.mode == 0i32) { invalid("PORT14A: INPUT_DOMAIN\n"); return -1i32; } chainStatus13 = game.PARAM;
            }
        } else {
            let number2: game.ChainNumber = reg.chains13[op.b].number;
            chainStatus13 = if code == 101i32 or code == 103i32 then game.chainMutationStatus(owner2,number2) else game.chainStatus(owner2,number2);
            if (chainStatus13 == game.OK) {
                let rawId: raw.ChainId = raw.b2MakeChainId(raw.worlds.at(owner2.slot as i64),number2.slot);
                if (code == 101i32) chainStatus13 = game.destroyChain(owner2,number2);
                else if (code == 103i32) {
                    let setter: i32 = op.words[3] as i32; let value: f32 = fromBits(op.words[4]);
                    if (op.mode == 1i32) {
                        if (setter == 0i32) chainStatus13 = game.setChainFriction(owner2,number2,value);
                        else if (setter == 1i32) chainStatus13 = game.setChainRestitution(owner2,number2,value);
                        else chainStatus13 = game.setChainMaterial(owner2,number2,op.words[4] as i32);
                    } else {
                        if (setter != 2i32 and (not game.finite(value) or (setter == 0i32 and value < 0.0f32))) { invalid("PORT14A: INPUT_DOMAIN\n"); return -1i32; }
                        if (setter == 0i32) raw.b2Chain_SetFriction(rawId,value); else if (setter == 1i32) raw.b2Chain_SetRestitution(rawId,value); else raw.b2Chain_SetMaterial(rawId,op.words[4] as i32);
                    }
                } else if (code == 106i32) {
                    var view: game.ChainLookup = game.lookupChain(owner2,number2); chainStatus13 = view.status;
                    if (view.status == game.OK) { var saved = SavedChainCopy13(); saved.saved = true; saved.value = game.cloneChainView(&view.value); saved.id = rawId; saved.children = raw.b2Chain_GetSegments(rawId,128i32); reg.chainCopies13[op.c] = move saved; }
                }
            }
        }
    } else if (code == 109i32) {
        if (lastRawInput13) {
            if (op.words[0] == 0u32) { rawChainInput13.points.at(0i64).x = 123.0f32; if (op.words[1] == 1u32) { rawChainInput13.points = raw.emptyChainPoints(); lastPoints13 = false; } }
            else { rawChainInput13.materials.at(0i64).friction = 2.0f32; rawChainInput13.materials.at(0i64).userMaterialId = -7i32; if (op.words[1] == 1u32) { rawChainInput13.materials = raw.emptySurfaceMaterials(); lastMaterials13 = false; } }
        } else {
            if (op.words[0] == 0u32) { lastChainInput13.points.at(0i64).x = 123.0f32; if (op.words[1] == 1u32) { lastChainInput13.points = raw.emptyChainPoints(); lastPoints13 = false; } }
            else { lastChainInput13.materials.at(0i64).friction = 2.0f32; lastChainInput13.materials.at(0i64).userMaterialId = -7i32; if (op.words[1] == 1u32) { lastChainInput13.materials = raw.emptySurfaceMaterials(); lastMaterials13 = false; } }
        }
    }
    if (chainStatus13 == game.LOCKED) chainReason13 = 1i32;
    if (not checkPopulation(reg,id,&beforePools13) or not checkIntegrity()) return -1i32;
    execution.status = chainStatus13; outEcho(id,seq,op); if (code == 100i32) echoChainInput13(id,seq);

    outChainAnswer13(id,seq,chainStatus13,chainReason13); outState(reg,id,seq,op,&execution); return chainStatus13;
}
fun chainPopulationReservation13(reg: ref Registers, owner: game.WorldNumber, segments: i32, materials: i32) -> bool = {
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    let shapeGrowth: i32 = if segments > world.shapeIdPool.freeCount then segments-world.shapeIdPool.freeCount else 0i32;
    let chainGrowth: i32 = if world.chainIdPool.freeCount == 0i32 then 1i32 else 0i32;
    let chainMax: i32 = if guard13B or profile13C == 15i32 then 4i32 else 16i32;
    var aliveMaterials: i32 = 0i32; var wi: i32 = 0i32;
    while (wi < 128i32) {
        if (raw.worlds.at(wi as i64).inUse) { var ci: i32 = 0i32; while (ci < raw.worlds.at(wi as i64).chainIdPool.nextIndex) {
            if (raw.worlds.at(wi as i64).chainShapes.at(ci as i64).id != -1i32) aliveMaterials = aliveMaterials+raw.worlds.at(wi as i64).chainShapes.at(ci as i64).materialCount;
            ci = ci+1i32;
        } } wi = wi+1i32;
    }
    if (reg.totalShapeSlots+shapeGrowth > familyLimit(1u32,1i32) or reg.totalChainSlots13+chainGrowth > chainMax or aliveMaterials+materials > 256i32) { invalid("PORT14A: INPUT_POPULATION\n"); return false; } return true;
}
                                                                       
fun outChainPublic13(reg: ref Registers, id: u32, seq: u32, op: Operation, execution: ref Execution) -> () = {
    var ci: i32 = 0i32; var live: i32 = 0i32; var saved: i32 = 0i32;
    while (ci < 16i32) {
        if (reg.chains13[ci].saved) {
            saved = saved+1i32; prefix("CN13",id,seq); outDec(ci); chainRaw13(reg.chains13[ci].id); chainNumber13(reg.chains13[ci].number); newline(); chainZ13[1] = chainZ13[1]+1i32;
        } ci = ci+1i32;
    }
    ci = 0i32;
    while (ci < 16i32) {
        if (reg.chains13[ci].saved) {
            prefix("V13",id,seq); outDec(ci); outHex(raw.b2Chain_IsValid(reg.chains13[ci].id) as u32);
            outHex((game.chainStatus(reg.chains13[ci].owner,reg.chains13[ci].number) == game.OK) as u32); newline(); chainZ13[16] = chainZ13[16]+1i32;
        } ci = ci+1i32;
    }
    if (op.opcode == 102i32) {
        prefix("CQ13",id,seq); outDec(op.b); outHex(execution.status as u32); chainZ13[2] = 1i32;
        if (execution.status != game.OK) { zeros13(18i32); newline(); }
        else {
            let owner: game.WorldNumber = reg.worlds[op.a].number; var world: ref raw.World = raw.worlds.at(owner.slot as i64);

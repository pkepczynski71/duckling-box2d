fun a13Main() -> i64 = { if (not a13InputOk) return 2i64;
    if (a13TokenEquals("GUARD13A")) return a13GuardMain();
    a13ConsumeTag("PORT13A"); if (not a13InputOk) return 2i64; a13CheckArity(3i32); if (not a13InputOk) return 2i64;
    a13RowPosition = a13RowPosition + 1i32; var debugTrace: bool = false;
    if (a13TokenEquals("R")) debugTrace = false; else if (a13TokenEquals("D")) debugTrace = true; else { a13Invalid("PORT13A: INPUT_PROFILE\n"); return 2i64; }
    a13RowPosition = a13RowPosition + 1i32; let count: u32 = a13ReadWord(); a13EndRow(); if (not a13InputOk) return 2i64;
    if (count < 1u32 or count > 128u32) { a13Invalid("PORT13A: INPUT_N\n"); return 2i64; }
    outputString14(if debugTrace then "PORT13A D" else "PORT13A R"); a13OutDec(count as i32); a13Newline();
    var id: u32 = 1u32; var total: u32 = 0u32;
    while (id <= count and a13InputOk) {

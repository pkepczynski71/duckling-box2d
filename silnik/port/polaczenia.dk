            let integer: bool = (group == 1i32 and i < 4i32) or (group == 2i32 and payloadIntegerB14(fixtureTypeB14,i)) or (group == 4i32 and (i == 3i32 or i == 11i32));
            if (not integer and not game.finite(fromBits(f[group].words[i]))) invalid("PORT14A: INPUT_DOMAIN\n");
            if (group == 2i32 and payloadBooleanB14(fixtureTypeB14,i) and f[group].words[i] > 1u32) invalid("PORT14A: INPUT_BOOL\n"); i = i+1i32;
        } group = group+1i32;
    }
    var bi: i32 = 0i32; while (bi < 2i32) { decodeRot(f[3i32].words[10i32*bi+2i32],f[3i32].words[10i32*bi+3i32]); bi = bi+1i32; }
    if (not inputOk) return;
    let madeWorld: game.WorldResult = game.createSleepWorld(math2.Vec2(),400.0f32,game.SolverWorldParameters(),true);
    reg.worlds[0i32] = SavedWorld(true,madeWorld.number,madeWorld.id);
    bi = 0i32;
    while (bi < 2i32) {
        var def = raw.BodyDef(); def.bodyType = f[0i32].words[3i32+bi] as i32;
        let made: game.BodyResult = game.createBody8(madeWorld.number,def); reg.bodies[bi] = SavedBody(true,made.number,madeWorld.number,made.id); bi = bi+1i32;
    }
    var madeJoint = game.JointResult();

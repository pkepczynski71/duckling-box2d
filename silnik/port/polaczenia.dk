    h[0] = shape.shapeType as u32;
    if (shape.shapeType == 0i32) {
        h[1] = 1u32; h[2] = toBits(shape.circle.radius); h[5] = toBits(shape.circle.center.x); h[6] = toBits(shape.circle.center.y);
    } else if (shape.shapeType == 1i32) {
        h[1] = 2u32; h[2] = toBits(shape.capsule.radius);
        h[5] = toBits(shape.capsule.center1.x); h[6] = toBits(shape.capsule.center1.y);
        h[7] = toBits(shape.capsule.center2.x); h[8] = toBits(shape.capsule.center2.y);
    } else if (shape.shapeType == 2i32) {
        h[1] = 2u32; h[5] = toBits(shape.segment.point1.x); h[6] = toBits(shape.segment.point1.y);
        h[7] = toBits(shape.segment.point2.x); h[8] = toBits(shape.segment.point2.y);
    } else if (shape.shapeType == 4i32) {
        h[1] = 2u32; h[5] = toBits(shape.chainSegment.segment.point1.x); h[6] = toBits(shape.chainSegment.segment.point1.y); h[7] = toBits(shape.chainSegment.segment.point2.x); h[8] = toBits(shape.chainSegment.segment.point2.y);
    } else {
        h[1] = shape.polygon.count as u32; h[2] = toBits(shape.polygon.radius);
        h[3] = toBits(shape.polygon.centroid.x); h[4] = toBits(shape.polygon.centroid.y);
        var i: i32 = 0i32;
        while (i < shape.polygon.count) {
            h[5i32+2i32*i] = toBits(shape.polygon.vertices[i].x); h[6i32+2i32*i] = toBits(shape.polygon.vertices[i].y);
            h[21i32+2i32*i] = toBits(shape.polygon.normals[i].x); h[22i32+2i32*i] = toBits(shape.polygon.normals[i].y); i = i + 1i32;
        }
    }

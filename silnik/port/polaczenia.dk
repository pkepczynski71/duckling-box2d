fun runSleepComponent(reg: ref Registers, op: Operation) -> i32 = {
    let status: i32 = game.worldStatus(reg.worlds[op.a].number);
    if (status != game.OK) { invalid("PORT14A: INPUT_DOMAIN\n"); return status; }
    var world: ref raw.World = raw.worlds.at(reg.worlds[op.a].number.slot as i64);
    if (op.kind == 1i32) {
        if (op.c < 3i32 or op.c >= world.solverSetIdPool.nextIndex) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.PARAM; }
        if (raw.b2GetSolverSet(world, op.c).setIndex != op.c) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.PARAM; }
        raw.b2WakeSolverSet(world, op.c);
    } else {
        if (op.c < 0i32 or op.c >= world.islandIdPool.nextIndex) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.PARAM; }
        if (world.islands.at(op.c as i64).islandId != op.c) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.PARAM; }
        if (op.kind == 2i32) {
            if (world.islands.at(op.c as i64).setIndex != 2i32) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.PARAM; }
            raw.b2TrySleepIsland(world, op.c);
        } else raw.b2SplitIsland(world, op.c);
    }
    return game.OK;
}

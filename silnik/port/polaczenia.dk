            var denseIndex: i64 = 0i64;
            while (denseIndex < context.bodyIds.length()) {
                let savedId: i32 = context.bodyIds.at(denseIndex);
                if (savedId == bodyId) savedIndex = denseIndex;
                denseIndex = denseIndex + 1i64;
            }

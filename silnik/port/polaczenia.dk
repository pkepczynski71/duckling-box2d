fun viewWords14(saved: SavedJoint14) -> u32[51] = { return encodeView14(saved,game.lookupJoint(saved.owner,saved.number)); }
fun encodeView14(saved: SavedJoint14, found: game.JointLookup) -> u32[51] = {
    var words: u32[51]; if (found.status != game.OK) return words;
    let v: game.JointView = game.cloneJointView(found.value); let d: game.DistanceDescription = v.distanceParameters;
    let a: raw.BodyId = raw.b2Joint_GetBodyA(saved.id); let b: raw.BodyId = raw.b2Joint_GetBodyB(saved.id); let w: raw.WorldId = raw.b2Joint_GetWorld(saved.id);
    words[0] = v.jointType as u32; words[1] = a.index1 as u32; words[2] = a.world0 as u32; words[3] = a.generation as u32;
    words[4] = b.index1 as u32; words[5] = b.world0 as u32; words[6] = b.generation as u32; words[7] = w.index1 as u32; words[8] = 0u32; words[9] = w.generation as u32;
    words[10] = v.bodyA.slot as u32; words[11] = v.bodyA.birthTicket.low; words[12] = v.bodyA.birthTicket.high; words[13] = v.bodyA.ownerTicket.low; words[14] = v.bodyA.ownerTicket.high;
    words[15] = v.bodyB.slot as u32; words[16] = v.bodyB.birthTicket.low; words[17] = v.bodyB.birthTicket.high; words[18] = v.bodyB.ownerTicket.low; words[19] = v.bodyB.ownerTicket.high;
    words[20] = toBits(v.localAnchorA.x); words[21] = toBits(v.localAnchorA.y); words[22] = toBits(v.localAnchorB.x); words[23] = toBits(v.localAnchorB.y);
    words[27] = v.collideConnected as u32; words[28] = v.hasObjectId as u32; words[29] = v.objectId.low; words[30] = v.objectId.high;
    words[31] = toBits(v.force.x); words[32] = toBits(v.force.y); words[33] = toBits(v.torque); words[34] = toBits(v.linearSeparation); words[35] = toBits(v.angularSeparation);
    words[36] = toBits(v.constraintHertz); words[37] = toBits(v.constraintDampingRatio);

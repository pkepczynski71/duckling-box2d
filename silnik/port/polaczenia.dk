        let digit: u32 = (word >> (shift as u32)) & 15u32;
        if (digit < 10u32) outputChar14((48u32 + digit) as char);
        else outputChar14((97u32 + digit - 10u32) as char);
        shift = shift - 4i32;
    }
}

fun createRevoluteB14(reg: ref Registers, op: Operation) -> game.JointAction = {
    let a: u32[64] = op.words; let owner: game.WorldNumber = reg.worlds[a[1] as i32].number;
    let value: game.RevoluteDescription = descriptions14[a[5] as i32].revolute;
    var made = game.JointResult(); var rawId = raw.JointId();
    if (a[0] == 1u32) made = game.createRevoluteJoint(owner,reg.bodies[a[2] as i32].number,reg.bodies[a[3] as i32].number,value);
    else {
        if (not validRawRevoluteB14(value) or game.bodyStatus(owner,reg.bodies[a[2] as i32].number) != game.OK or game.bodyStatus(owner,reg.bodies[a[3] as i32].number) != game.OK or reg.bodies[a[2] as i32].number.slot == reg.bodies[a[3] as i32].number.slot) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.JointAction(); }

        if (words[0i32] == 0u32) { if (kind == 1u32) proxy = distance.b2MakeProxy(&points.points, points.count, points.radius); else proxy = distance.b2MakeOffsetProxy(&points.points, points.count, points.radius, offset.p, offset.q); }

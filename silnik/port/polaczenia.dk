            var source: distance.ShapeProxy = distance.b2MakeProxy(&points.points, points.count, 0.0f32); var first: distance.ShapeProxy = source; var second: distance.ShapeProxy = source;
            var original = distance.SimplexCache(); original.count = 1i32; original.indexA[0i32] = 1i32;
            var firstCache: distance.SimplexCache = original; var secondCache: distance.SimplexCache = original;
            first.points[0i32].x = 7.0f32; firstCache.indexA[0i32] = 2i32;
            if (source.points[0i32].x == 0.0f32 and second.points[0i32].x == 0.0f32) high = high | 1u32;

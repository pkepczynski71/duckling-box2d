        while (ni < 32i32) { op.def.name.bytes[ni] = w[5i32+ni] as u8; ni = ni + 1i32; } return 37i32;
    }
    if (op.opcode == 86i32) { op.mode = w[1] as i32; op.kind = w[2] as i32; return 7i32; }
    if (op.opcode == 87i32) { op.kind = w[1] as i32; return if w[2] == 0u32 then 3i32 else (if op.kind == 1i32 then 12i32 else 6i32); }
    if (op.opcode == 88i32) { op.mode = w[1] as i32; op.b = w[2] as i32; op.capacity = w[3] as i32; return 4i32; }

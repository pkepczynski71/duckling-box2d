    outHex(liveWorlds as u32); outHex(liveBodies as u32); outHex(liveShapes as u32);
    outHex(chainZ13[17] as u32); outHex(if chainZ13[17] == 0i32 then 0u32 else (if op.opcode == 16i32 then 2u32 else (if op.opcode >= 80i32 and op.opcode != 90i32 then 0u32 else 1u32)));
    outHex((execution.status == game.UNSUPPORTED_PAIR) as u32);
    outHex((savedWorlds + savedBodies + savedShapes) as u32); outHex(liveWorlds as u32); outHex(liveBodies as u32);
    outHex(liveShapes as u32); outHex(liveShapes as u32); outHex(liveBodies as u32); outHex(liveBodies as u32);
    outHex(nQ as u32); outHex(nK as u32); outHex(execution.moves.length() as u32); outHex(nMCN as u32); outHex(nMC as u32);
    outHex(nQGN as u32); outHex(nQG as u32); outHex(nSB as u32); outPair(game.lastIssued); newline();
    outZ9(reg, id, seq, op, execution);

        var reg = Registers(); joints14 = zeroJoints14(); descriptions14 = zeroDescriptions14(); copies14 = zeroCopies14(); fixture14 = false; prepared14 = false;
        lastPoints13 = false; lastMaterials13 = false; completedPositiveSteps = 0u32;
        outputString14("CASE"); outDec(id as i32); outDec(calls as i32); newline();
        if (direct14 and (profileB14 or id >= 65u32)) loadFixture14(&reg,id);
        var seq: u32 = 1u32;

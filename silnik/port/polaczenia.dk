    return game.finite(value.localAnchorA.x) and game.finite(value.localAnchorA.y) and game.finite(value.localAnchorB.x) and game.finite(value.localAnchorB.y) and game.finite(value.referenceAngle) and game.finite(value.targetAngle) and game.finite(value.hertz) and game.finite(value.dampingRatio) and game.finite(value.lowerAngle) and game.finite(value.upperAngle) and game.finite(value.maxMotorTorque) and game.finite(value.motorSpeed) and game.finite(value.drawSize) and game.validRevoluteLimits14(value.lowerAngle,value.upperAngle);

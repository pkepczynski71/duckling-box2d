        if (attachedReason14(reg,op,status)) reason = 8i32;
    }
    prefix("A14",id,seq); outDec(status); outDec(reason); newline();
}
fun outJointPublic14(reg: ref Registers, id: u32, seq: u32, op: Operation) -> () = {
    var j: i32 = 0i32;
    while (j < 256i32) {

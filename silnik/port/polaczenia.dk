fun validLiveOperation(reg: ref Registers, op: Operation) -> bool = {
    if (op.opcode >= 82i32 and op.opcode <= 89i32) return validExtended12(reg, op);
    var initialized: bool = reg.worlds[op.a].saved;
    if (op.opcode == 80i32 or op.opcode == 92i32) initialized = initialized and reg.bodies[op.b].saved;
    if (op.opcode == 81i32) initialized = initialized and reg.shapes[op.b].saved;
    if (op.opcode == 91i32 and op.kind == 1i32) initialized = initialized and reg.bodies[op.b].saved;
    if (op.opcode == 91i32 and op.kind == 2i32) initialized = initialized and reg.shapes[op.b].saved;
    if (not initialized) { invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n"); return false; }
    if (op.opcode == 90i32 and liveBody(reg, op.b)) { invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n"); return false; }
    if (reg.phase != 0i32) { invalid("PORT14A: INPUT_PHASE\n"); return false; }
    return true;
}

        words[38] = typedR.enableSpring as u32;
        words[39] = toBits(typedR.hertz);
        words[40] = toBits(typedR.dampingRatio);
        words[41] = toBits(typedR.targetAngle);
        words[42] = typedR.enableLimit as u32;
        words[43] = toBits(typedR.lowerAngle);
        words[44] = toBits(typedR.upperAngle);
        words[45] = toBits(v.angle);
        words[46] = typedR.enableMotor as u32;
        words[47] = toBits(typedR.motorSpeed);
        words[48] = toBits(typedR.maxMotorTorque);
        words[49] = toBits(v.motorTorque);
        return words;
    }
    if (v.jointType == 4i32) {
        let typedP: game.PrismaticDescription = v.prismaticParameters;
        words[24] = toBits(v.referenceAngle); words[25] = toBits(v.localAxisA.x); words[26] = toBits(v.localAxisA.y);
        words[38] = typedP.enableSpring as u32;
        words[39] = toBits(typedP.hertz);
        words[40] = toBits(typedP.dampingRatio);
        words[41] = toBits(typedP.targetTranslation);
        words[42] = typedP.enableLimit as u32;
        words[43] = toBits(typedP.lowerTranslation);
        words[44] = toBits(typedP.upperTranslation);
        words[45] = toBits(v.translation);
        words[46] = toBits(v.speed);
        words[47] = typedP.enableMotor as u32;
        words[48] = toBits(typedP.motorSpeed);
        words[49] = toBits(typedP.maxMotorForce);
        words[50] = toBits(v.motorForce);

fun main() -> i64 = {
    initialTagged13 = true; initialRow13 = false; profile13C = 14i32;
    readRow(); consumeTag("PORT14"); if (not inputOk) return 2i64;
    if (rowPosition >= rowLength or rowBytes[rowPosition] != 32i32) { invalid("PORT14A: INPUT_ARITY\n"); return 2i64; }
    rowPosition = rowPosition+1i32;
    if (profileB14 and tokenEquals("B")) consumeTag("B");
    else if (not profileB14 and tokenEquals("A")) consumeTag("A"); else { invalid("PORT14A: INPUT_PROFILE\n"); return 2i64; }
    rowPosition = rowPosition+1i32;
    if (tokenEquals("PUBLIC")) profile14 = "PUBLIC"; else if (tokenEquals("DIRECT")) { profile14 = "DIRECT"; direct14 = true; }
    else if (tokenEquals("GUARD")) profile14 = "GUARD"; else { invalid("PORT14A: INPUT_PROFILE\n"); return 2i64; }
    consumeTag(profile14); checkArity(4i32); let count: u32 = readWord(); endRow(); if (not inputOk) return 2i64;
    var maximum: u32 = 96u32; if (direct14) maximum = 128u32; else if (sameText13(profile14,"GUARD")) maximum = if profileB14 then 221u32 else 156u32;
    if (count < 1u32 or count > maximum) { invalid("PORT14A: INPUT_N\n"); return 2i64; }
    if (sameText13(profile14,"GUARD")) return jointGuardMain14(count);
    if (direct14) profile13C = 15i32;
    outputString14(if profileB14 then "PORT14 B " else "PORT14 A "); outputString14(profile14); outDec(count as i32); newline(); var id: u32 = 1u32;
    while (id <= count and inputOk) {
        currentCase13 = id; requiredRow("C",3i32); let got: u32 = readWord(); let calls: u32 = readWord(); endRow(); if (not inputOk) return 2i64;
        if (got != id) { invalid("PORT14A: INPUT_ID\n"); return 2i64; }
        let maxCalls: u32 = if direct14 then 32u32 else (if id <= (if profileB14 then 24u32 else 48u32) then 128u32 else (if profileB14 and id >= 49u32 and id <= 54u32 then 2048u32 else 1328u32));

        prefix("M", id, seq); outDec(op.a); outDec(i as i32);
        outHex(event.bodyId.index1 as u32); outHex(event.bodyId.world0 as u32); outHex(event.bodyId.generation as u32);
        outFloat(event.transform.p.x); outFloat(event.transform.p.y); outFloat(event.transform.q.c); outFloat(event.transform.q.s);
        outObject(event.hasObjectId, event.objectId); outHex(event.fellAsleep as u32); newline(); i = i + 1i64;
    }
}


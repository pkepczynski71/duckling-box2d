fun mutateEvents(events: ref game.ContactEvents) -> () = {
    if (events.begin.length() > 0i64) {
        events.begin.at(0i64).shapeA.birthTicket.low = events.begin.at(0i64).shapeA.birthTicket.low ^ 1u32;
        events.begin.at(0i64).manifold.normal.x = fromBits(toBits(events.begin.at(0i64).manifold.normal.x) ^ 2147483648u32);
    } else if (events.end.length() > 0i64) events.end.at(0i64).shapeA.birthTicket.low = events.end.at(0i64).shapeA.birthTicket.low ^ 1u32;
    let count: i64 = events.hits.length();
    if (count > 0i64) {
        let first: game.ContactHit = events.hits.at(0i64); events.hits.push(first);
        if (count >= 2i64) {
            let second: game.ContactHit = events.hits.at(1i64); events.hits.at(0i64) = second; events.hits.at(1i64) = first;
        }
        events.hits.at(0i64).shapeA.birthTicket.low = events.hits.at(0i64).shapeA.birthTicket.low ^ 1u32;
        events.hits.at(0i64).point.x = fromBits(toBits(events.hits.at(0i64).point.x) ^ 2147483648u32);
    }
    events.hitCount = events.hits.length() as i32;
}

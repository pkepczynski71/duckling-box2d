    def.objectId = value.objectId;
    return def;
}
fun createPrismaticB14(reg: ref Registers, op: Operation) -> game.JointAction = {
    let a: u32[64] = op.words; let owner: game.WorldNumber = reg.worlds[a[1] as i32].number;
    let value: game.PrismaticDescription = descriptions14[a[5] as i32].prismatic;
    var made = game.JointResult(); var rawId = raw.JointId();
    if (a[0] == 1u32) made = game.createPrismaticJoint(owner,reg.bodies[a[2] as i32].number,reg.bodies[a[3] as i32].number,value);
    else {
        if (not validRawPrismaticB14(value) or game.bodyStatus(owner,reg.bodies[a[2] as i32].number) != game.OK or game.bodyStatus(owner,reg.bodies[a[3] as i32].number) != game.OK or reg.bodies[a[2] as i32].number.slot == reg.bodies[a[3] as i32].number.slot) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.JointAction(); }
        made.status = game.OK;
        if (game.ticketLimit(game.lastIssued)) made.status = game.LIMIT;
        else {
            let ticket: words64.Key64 = game.nextTicket(game.lastIssued);
            rawId = raw.b2CreatePrismaticJoint(reg.worlds[a[1] as i32].id,rawDescriptionPrismaticB14(reg,a[2] as i32,a[3] as i32,value));
            let slot: i32 = rawId.index1-1i32; var world: ref raw.World = raw.worlds.at(owner.slot as i64);
            world.joints.at(slot as i64).birthTicket = ticket; world.joints.at(slot as i64).ownerTicket = owner.birthTicket; game.lastIssued = ticket;
            made.number = game.JointNumber(slot,ticket,owner.birthTicket);
        }
    }
    if (made.status == game.OK and a[0] == 1u32) rawId = game.makeJointId14(owner,made.number);
    if (made.status == game.OK) joints14[a[4] as i32] = SavedJoint14(true,made.number,owner,rawId,4i32);
    return game.JointAction(made.status,made.reason);
}
fun validRawPrismaticB14(value: game.PrismaticDescription) -> bool = {
    return game.finite(value.localAnchorA.x) and game.finite(value.localAnchorA.y) and game.finite(value.localAnchorB.x) and game.finite(value.localAnchorB.y) and game.finite(value.localAxisA.x) and game.finite(value.localAxisA.y) and game.finite(value.referenceAngle) and game.finite(value.targetTranslation) and game.finite(value.hertz) and game.finite(value.dampingRatio) and game.finite(value.lowerTranslation) and game.finite(value.upperTranslation) and game.finite(value.maxMotorForce) and game.finite(value.motorSpeed) and value.lowerTranslation <= value.upperTranslation and mass2.b2Dot(value.localAxisA,value.localAxisA) > 0.0f32 and game.finite(mass2.b2Dot(value.localAxisA,value.localAxisA));
}
fun descriptionBoolB14(typ: i32, field: i32) -> bool = {
    if (typ == 5i32) return field == 6i32 or field == 9i32 or field == 12i32 or field == 16i32 or field == 17i32;
    if (typ == 4i32) return field == 8i32 or field == 11i32 or field == 14i32 or field == 17i32 or field == 18i32;
    return field == 5i32 or field == 8i32 or field == 11i32 or field == 14i32 or field == 15i32;
}

                                                                
fun mutateRevoluteB14(owner: game.WorldNumber, number: game.JointNumber, id: raw.JointId, op: Operation) -> game.JointAction = {
    let a: u32[64] = op.words; let kind: u32 = a[3]; let value: f32 = fromBits(a[4]); let other: f32 = fromBits(a[5]); let flag: bool = a[4] != 0u32;
    if (a[0] == 1u32) {
        if (kind == 32u32) return game.setRevoluteSpring(owner,number,flag);
        if (kind == 33u32) return game.setRevoluteHertz(owner,number,value);
        if (kind == 34u32) return game.setRevoluteDamping(owner,number,value);
        if (kind == 35u32) return game.setRevoluteTargetAngle(owner,number,value);
        if (kind == 36u32) return game.setRevoluteLimit(owner,number,flag);
        if (kind == 37u32) return game.setRevoluteLimits(owner,number,value,other);
        if (kind == 38u32) return game.setRevoluteMotor(owner,number,flag);
        if (kind == 39u32) return game.setRevoluteMotorSpeed(owner,number,value);
        if (kind == 40u32) return game.setRevoluteMaxMotorTorque(owner,number,value);
    }
    if (raw.b2Joint_GetType(id) != 5i32) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.JointAction(); }
    if (kind != 32u32 and kind != 36u32 and kind != 38u32 and (not game.finite(value) or (kind == 37u32 and not game.finite(other)))) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.JointAction(); }
    if (kind == 37u32 and not (game.validRevoluteLimits14(value,other))) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.JointAction(); }
    if (kind == 32u32) raw.b2RevoluteJoint_EnableSpring(id,flag);
    else if (kind == 33u32) raw.b2RevoluteJoint_SetSpringHertz(id,value);
    else if (kind == 34u32) raw.b2RevoluteJoint_SetSpringDampingRatio(id,value);
    else if (kind == 35u32) raw.b2RevoluteJoint_SetTargetAngle(id,value);
    else if (kind == 36u32) raw.b2RevoluteJoint_EnableLimit(id,flag);
    else if (kind == 37u32) raw.b2RevoluteJoint_SetLimits(id,value,other);
    else if (kind == 38u32) raw.b2RevoluteJoint_EnableMotor(id,flag);
    else if (kind == 39u32) raw.b2RevoluteJoint_SetMotorSpeed(id,value);
    else if (kind == 40u32) raw.b2RevoluteJoint_SetMaxMotorTorque(id,value);
    return game.JointAction();
}
fun mutatePrismaticB14(owner: game.WorldNumber, number: game.JointNumber, id: raw.JointId, op: Operation) -> game.JointAction = {
    let a: u32[64] = op.words; let kind: u32 = a[3]; let value: f32 = fromBits(a[4]); let other: f32 = fromBits(a[5]); let flag: bool = a[4] != 0u32;
    if (a[0] == 1u32) {
        if (kind == 48u32) return game.setPrismaticSpring(owner,number,flag);
        if (kind == 49u32) return game.setPrismaticHertz(owner,number,value);
        if (kind == 50u32) return game.setPrismaticDamping(owner,number,value);
        if (kind == 51u32) return game.setPrismaticTargetTranslation(owner,number,value);
        if (kind == 52u32) return game.setPrismaticLimit(owner,number,flag);
        if (kind == 53u32) return game.setPrismaticLimits(owner,number,value,other);
        if (kind == 54u32) return game.setPrismaticMotor(owner,number,flag);
        if (kind == 55u32) return game.setPrismaticMotorSpeed(owner,number,value);
        if (kind == 56u32) return game.setPrismaticMaxMotorForce(owner,number,value);
    }
    if (raw.b2Joint_GetType(id) != 4i32) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.JointAction(); }
    if (kind != 48u32 and kind != 52u32 and kind != 54u32 and (not game.finite(value) or (kind == 53u32 and not game.finite(other)))) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.JointAction(); }
    if (kind == 53u32 and not (value <= other)) { invalid("PORT14A: INPUT_DOMAIN\n"); return game.JointAction(); }
    if (kind == 48u32) raw.b2PrismaticJoint_EnableSpring(id,flag);
    else if (kind == 49u32) raw.b2PrismaticJoint_SetSpringHertz(id,value);
    else if (kind == 50u32) raw.b2PrismaticJoint_SetSpringDampingRatio(id,value);
    else if (kind == 51u32) raw.b2PrismaticJoint_SetTargetTranslation(id,value);
    else if (kind == 52u32) raw.b2PrismaticJoint_EnableLimit(id,flag);
    else if (kind == 53u32) raw.b2PrismaticJoint_SetLimits(id,value,other);
    else if (kind == 54u32) raw.b2PrismaticJoint_EnableMotor(id,flag);
    else if (kind == 55u32) raw.b2PrismaticJoint_SetMotorSpeed(id,value);
    else if (kind == 56u32) raw.b2PrismaticJoint_SetMaxMotorForce(id,value);
    return game.JointAction();
}
fun mutationBoolB14(kind: u32) -> bool = {
    return kind == 4u32 or kind == 5u32 or kind == 18u32 or kind == 21u32 or kind == 22u32
        or (profileB14 and (kind == 32u32 or kind == 36u32 or kind == 38u32 or kind == 48u32 or kind == 52u32 or kind == 54u32));
}

var mathFixtureB14: i32 = 0i32;
var mathWordsB14: u32[6] = zeroMathB14();
fun zeroMathB14() -> u32[6] = { var values: u32[6]; return values; }
var mathResultB14: math2.Vec2 = math2.Vec2(); var mathResultCountB14: i32 = 0i32;
fun payloadBooleanB14(typ: i32, field: i32) -> bool = {
    return field >= (if typ == 5i32 then 27i32 else (if typ == 4i32 then 31i32 else 23i32));
}
fun payloadIntegerB14(typ: i32, field: i32) -> bool = {
    let first: i32 = if typ == 5i32 then 14i32 else (if typ == 4i32 then 16i32 else 11i32);
    return field == first or field == first+1i32 or payloadBooleanB14(typ,field);
}
fun loadMathB14(id: u32) -> () = {
    mathFixtureB14 = expectedMathFixtureB14(id); if (mathFixtureB14 == 0i32) return;
    let width: i32 = if mathFixtureB14 == 1i32 then 1i32 else 6i32;
    requiredRow("F14",5i32+width); if (not inputOk) return;
    let actual: u32 = readWord(); let fixture: u32 = readWord(); let group: u32 = readWord(); let n: u32 = readWord();
    if (actual != id) invalid("PORT14A: INPUT_ID\n");
    if (fixture != mathFixtureB14 as u32 or group != 5u32) invalid("PORT14A: INPUT_PHASE\n");
    if (n != width as u32) invalid("PORT14A: INPUT_ARITY\n");
    var i: i32 = 0i32; readingPayload = true;
    while (i < width and inputOk) { mathWordsB14[i] = readWord(); if (not game.finite(fromBits(mathWordsB14[i]))) invalid("PORT14A: INPUT_DOMAIN\n"); i = i+1i32; }
    readingPayload = false; endRow(); if (not inputOk) return;
    prefix("EF14",id,fixture); outDec(5i32); outDec(width); i = 0i32;
    while (i < width) { outHex(mathWordsB14[i]); i = i+1i32; } newline();
}

                                                                  
fun getterB14(owner: game.WorldNumber, number: game.JointNumber, selector: u32) -> game.JointScalar = {
    if (selector == 64u32) { let flag64: game.JointBoolean = game.getRevoluteSpring(owner,number); return game.JointScalar(flag64.status,flag64.reason,if flag64.value then 1.0f32 else 0.0f32); }
    if (selector == 65u32) return game.getRevoluteHertz(owner,number);
    if (selector == 66u32) return game.getRevoluteDamping(owner,number);
    if (selector == 67u32) return game.getRevoluteTargetAngle(owner,number);
    if (selector == 68u32) return game.getRevoluteAngle(owner,number);
    if (selector == 69u32) { let flag69: game.JointBoolean = game.getRevoluteLimit(owner,number); return game.JointScalar(flag69.status,flag69.reason,if flag69.value then 1.0f32 else 0.0f32); }
    if (selector == 70u32) return game.getRevoluteLowerLimit(owner,number);
    if (selector == 71u32) return game.getRevoluteUpperLimit(owner,number);
    if (selector == 72u32) { let flag72: game.JointBoolean = game.getRevoluteMotor(owner,number); return game.JointScalar(flag72.status,flag72.reason,if flag72.value then 1.0f32 else 0.0f32); }
    if (selector == 73u32) return game.getRevoluteMotorSpeed(owner,number);
    if (selector == 74u32) return game.getRevoluteMaxMotorTorque(owner,number);
    if (selector == 75u32) return game.getRevoluteMotorTorque(owner,number);
    if (selector == 80u32) { let flag80: game.JointBoolean = game.getPrismaticSpring(owner,number); return game.JointScalar(flag80.status,flag80.reason,if flag80.value then 1.0f32 else 0.0f32); }
    if (selector == 81u32) return game.getPrismaticHertz(owner,number);
    if (selector == 82u32) return game.getPrismaticDamping(owner,number);
    if (selector == 83u32) return game.getPrismaticTargetTranslation(owner,number);
    if (selector == 84u32) return game.getPrismaticTranslation(owner,number);
    if (selector == 85u32) return game.getPrismaticSpeed(owner,number);
    if (selector == 86u32) { let flag86: game.JointBoolean = game.getPrismaticLimit(owner,number); return game.JointScalar(flag86.status,flag86.reason,if flag86.value then 1.0f32 else 0.0f32); }
    if (selector == 87u32) return game.getPrismaticLowerLimit(owner,number);
    if (selector == 88u32) return game.getPrismaticUpperLimit(owner,number);
    if (selector == 89u32) { let flag89: game.JointBoolean = game.getPrismaticMotor(owner,number); return game.JointScalar(flag89.status,flag89.reason,if flag89.value then 1.0f32 else 0.0f32); }
    if (selector == 90u32) return game.getPrismaticMotorSpeed(owner,number);
    if (selector == 91u32) return game.getPrismaticMaxMotorForce(owner,number);
    if (selector == 92u32) return game.getPrismaticMotorForce(owner,number);
    return game.JointScalar(game.PARAM,6i32,0.0f32);
}
fun getterBooleanB14(selector: u32) -> bool = { return selector == 64u32 or selector == 69u32 or selector == 72u32 or selector == 80u32 or selector == 86u32 or selector == 89u32; }
fun getterSelectorB14(selector: u32) -> bool = { return selector <= 1u32 or (profileB14 and ((selector >= 64u32 and selector <= 75u32) or (selector >= 80u32 and selector <= 92u32))); }
fun guardCreateB14(owner: game.WorldNumber, a: game.BodyNumber, b: game.BodyNumber) -> game.JointAction = {
    if (profileB14 and guardArgs14[25] == 5u32) {
        var revolute = game.defaultRevoluteDescription(); var ri: i32 = 0i32;
        while (ri < 20i32) { setDescriptionRevoluteB14(&revolute,ri,guardArgs14[4i32+ri]); ri = ri+1i32; }
        return game.jointCreatePreflight(owner,a,b,revolute);
    }
    if (profileB14 and guardArgs14[25] == 4u32) {
        var prismatic = game.defaultPrismaticDescription(); var pi: i32 = 0i32;
        while (pi < 21i32) { setDescriptionPrismaticB14(&prismatic,pi,guardArgs14[4i32+pi]); pi = pi+1i32; }
        return game.jointCreatePreflight(owner,a,b,prismatic);
    }
    return game.jointCreatePreflight(owner,a,b,guardDescription14());
}
var callbackTypedB14: Description14 = Description14();
fun descriptionCanaryB14(value: Description14) -> u32 = {
    if (value.jointType == 5i32) return toBits(value.revolute.referenceAngle);
    if (value.jointType == 4i32) return toBits(value.prismatic.localAxisA.x);
    return toBits(value.value.length);
}
                                                                          
fun expectedMathFixtureB14(id: u32) -> i32 = {
    if (id <= 14u32) return 1i32;
    if (id <= 16u32 or (id >= 65u32 and id <= 68u32)) return 2i32;
    return 0i32;
}

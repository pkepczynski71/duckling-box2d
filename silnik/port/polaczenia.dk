fun validSleepOperation(reg: ref Registers, op: Operation) -> bool = {
    var initialized: bool = true; var collision: bool = false;
    if (op.opcode == 56i32) collision = reg.worlds[op.a].saved and game.worldStatus(reg.worlds[op.a].number) == game.OK;
    else if (op.opcode == 57i32) { initialized = reg.worlds[op.b].saved; collision = liveBody(reg, op.a); }

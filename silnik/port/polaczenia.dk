    }
    if (op.opcode == 83i32 or op.opcode == 85i32) {
        op.kind = if op.opcode == 83i32 then w[1] as i32 + 1i32 else w[1] as i32; op.b = w[2] as i32; op.mode = w[3] as i32;
        if (op.opcode == 83i32 and op.mode == 0i32 and op.kind == 1i32 and w[4] == 2u32) invalid("PORT14A: INPUT_PROFILE\n");
        return if op.opcode == 83i32 then 6i32 else 7i32;

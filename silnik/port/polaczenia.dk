            let touching: bool = (raw.worlds.at(slotW as i64).contacts.at(slotC as i64).flags & 1u32) != 0u32;
            if (touching != (op.manifold.pointCount > 0i32)) { invalid("PORT14A: INPUT_DOMAIN\n"); return false; }
        }
    }
    if (op.opcode == 52i32 and game.shapeStatus(reg.worlds[op.a].number, reg.shapes[op.b].number) != game.OK) { invalid("PORT14A: INPUT_DOMAIN\n"); return false; }

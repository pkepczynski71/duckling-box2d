fun emptyOutputChars14() -> List[char] = { var values: List[char]; return values; }
class OutputRow14 { data: List[char] = emptyOutputChars14(); }
fun emptyOutputRows14() -> List[OutputRow14] = { var values: List[OutputRow14]; return values; }
class OutputBucket14 { rows: List[OutputRow14] = emptyOutputRows14(); }
fun zeroOutputBuckets14() -> OutputBucket14[1500] = { var values: OutputBucket14[1500]; return values; }
var outputBuckets14: OutputBucket14[1500] = zeroOutputBuckets14();
var outputLine14: List[char] = emptyOutputChars14(); var capturingOutput14: bool = false;
var currentOutputRank14: i32 = 0i32; var outputBytes14: i64 = 0i64;
fun outputChar14(c: char) -> () = {
    if (not capturingOutput14) { io.writeChar(c); return; }
    if (not inputOk) return;
    if (outputBytes14 >= 13833216i64) { invalid("PORT14A: INPUT_POPULATION\n"); return; }
    outputBytes14 = outputBytes14+1i64; outputLine14.push(c);
    if (c == '\n') {
        var row = OutputRow14(); row.data = copy outputLine14;
        outputBuckets14[currentOutputRank14].rows.push(move row); outputLine14.clear();
    }
}
fun outputString14(value: str) -> () = {
    if (not capturingOutput14) { io.writeStr(value); return; }
    let chars: cptr char = builtins.ptr_from_slice[char](value) as cptr char; var i: i64 = 0i64;
    while (i < value.length()) { outputChar14(chars[i]); i = i+1i64; }
}
fun discardOutput14() -> () = {
    capturingOutput14 = false; var rank: i32 = 0i32;
    while (rank < 1500i32) { outputBuckets14[rank].rows.clear(); rank = rank+1i32; }
    outputLine14.clear(); outputBytes14 = 0i64;
}
fun beginOutput14() -> () = { discardOutput14(); capturingOutput14 = true; currentOutputRank14 = 0i32; }
fun flushOutput14() -> () = {
    capturingOutput14 = false; var rank: i32 = 0i32;
    while (rank < 1500i32) {
        var i: i64 = 0i64; while (i < outputBuckets14[rank].rows.length()) {
            var row: ref OutputRow14 = outputBuckets14[rank].rows.at(i); var j: i64 = 0i64;
            while (j < row.data.length()) { let c: char = row.data.at(j); io.writeChar(c); j = j+1i64; } i = i+1i64;
        } rank = rank+1i32;
    }
    discardOutput14();
}

                                                                                         
fun rawDomain14(owner: game.WorldNumber, id: raw.JointId) -> bool = { return game.worldStatus(owner) == game.OK and id.world0 as i32 == owner.slot and raw.b2Joint_IsValid(id); }
fun currentSavedJoint14(owner: game.WorldNumber, id: raw.JointId) -> SavedJoint14 = {
    let slot: i32 = id.index1-1i32; let record: raw.JointRecord = raw.worlds.at(owner.slot as i64).joints.at(slot as i64);
    return SavedJoint14(true,game.JointNumber(slot,record.birthTicket,record.ownerTicket),owner,id,record.jointType);
}

                                                                                     
fun attachedReason14(reg: ref Registers, op: Operation, status: i32) -> bool = {
    if (status != game.PARAM or op.opcode != 80i32 or op.mode != 1i32) return false;
    if (game.bodyStatus(reg.worlds[op.a].number,reg.bodies[op.b].number) != game.OK) return false;
    if (chainLegacyReason13(reg,op,status) == 80i32) return false;
    let body: raw.BodyRecord = raw.worlds.at(reg.worlds[op.a].number.slot as i64).bodies.at(reg.bodies[op.b].number.slot as i64);
    return body.jointCount > 0i32 and ((op.kind == 0i32 and body.bodyType != op.words[4] as i32) or (op.kind == 1i32 and op.words[4] == 0u32 and body.setIndex != 1i32));
}

                                                                             
                                                                             

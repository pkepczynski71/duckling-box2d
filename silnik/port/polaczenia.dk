                    outHex(c.contactId as u32); outHex(c.indexA as u32); outHex(c.indexB as u32); execution.n10[3] = execution.n10[3] + 1i32;
                } else {
                    prefix("SC10", id, seq); outDec(slot); outDec(sub); outDec(phase); outDec(packet.colorIndex); outDec(packet.packetIndex); outDec(lane);
                    outConstraint(c, false); execution.n10[4] = execution.n10[4] + 1i32;
                }

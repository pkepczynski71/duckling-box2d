fun outDescription14(value: game.DistanceDescription) -> () = {
    outHex(0u32); outFloat(value.localAnchorA.x); outFloat(value.localAnchorA.y); outFloat(value.localAnchorB.x); outFloat(value.localAnchorB.y);
    outFloat(value.length); outHex(value.enableSpring as u32); outFloat(value.hertz); outFloat(value.dampingRatio); outHex(value.enableLimit as u32);
    outFloat(value.minLength); outFloat(value.maxLength); outHex(value.enableMotor as u32); outFloat(value.maxMotorForce); outFloat(value.motorSpeed);

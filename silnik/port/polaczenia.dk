fun outLivePrivate(reg: ref Registers, id: u32, seq: u32) -> () = {
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
            var bi: i64 = 0i64;
            while (bi < world.bodies.length()) {
                let body: raw.BodyRecord = world.bodies.at(bi);
                if (body.id != -1i32) {
                    prefix("NP12", id, seq); outDec(wi); outDec(bi as i32);
                    var ni: i32 = 0i32; while (ni < 32i32) { outHex(body.name[ni] as u32); ni = ni + 1i32; } newline(); privateNames = privateNames + 1i32;
                }
                bi = bi + 1i64;
            }
        }
        wi = wi + 1i32;
    }
}
# Box2D 8c661469, src/world.c:695-812. Transport counters, not physics state.
fun outLiveCounters(id: u32, seq: u32) -> () = {
    prefix("I12", id, seq); var i: i32 = 0i32;
    while (i < 11i32) { outHex(liveCounts[i] as u32); i = i + 1i32; } newline();
    prefix("IP12", id, seq); outHex(privateNames as u32); newline();
    prefix("Z12", id, seq); outHex(completedPositiveSteps); outHex(seq); newline();
}


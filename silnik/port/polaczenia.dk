fun outIdentity14(value: Identity14) -> () = { var i: i32 = 0i32; while (i < 8i32) { outHex(value.words[i]); i = i+1i32; } }
fun jp14(id: u32, seq: u32, source: i32, world: i32, slot: i32, group: i32, n: i32) -> () = {
    prefix("J14",id,seq);
    currentOutputRank14 = if group == 8i32 then 1200i32 else (if source != 0i32 then 700i32+3i32*source+(if group == 0i32 then 0i32 else 1i32) else (if group == 0i32 then 400i32 else (if group == 4i32 or group == 9i32 or group == 11i32 then 500i32 else 1000i32+group)));

        op.def.bodyType = w[3] as i32;
        op.def.position = math2.Vec2(fromBits(w[4]), fromBits(w[5]));
        op.def.rotation = math2.Rot(fromBits(w[6]), fromBits(w[7]));
        op.def.linearVelocity = math2.Vec2(fromBits(w[8]), fromBits(w[9]));
        op.def.angularVelocity = fromBits(w[10]); op.def.linearDamping = fromBits(w[11]); op.def.angularDamping = fromBits(w[12]); op.def.gravityScale = fromBits(w[13]);
        op.def.fixedRotation = w[14] != 0u32; op.def.allowFastRotation = w[15] != 0u32;

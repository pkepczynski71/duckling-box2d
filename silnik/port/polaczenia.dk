    else if (fixtureTypeB14 == 4i32) madeJoint = game.createPrismaticJoint(madeWorld.number,reg.bodies[0i32].number,reg.bodies[1i32].number,game.defaultPrismaticDescription());
    else madeJoint = game.createDistanceJoint(madeWorld.number,reg.bodies[0i32].number,reg.bodies[1i32].number,game.defaultDistanceDescription());
    joints14[0i32] = SavedJoint14(true,madeJoint.number,madeWorld.number,game.makeJointId14(madeWorld.number,madeJoint.number),fixtureTypeB14);
    var world: ref raw.World = raw.worlds.at(madeWorld.number.slot as i64); var sim: ref raw.JointSim = raw.b2GetJointSim(world,0i32);
    sim.localOriginAnchorA.x = fromBits(f[1i32].words[4i32]);
    sim.localOriginAnchorA.y = fromBits(f[1i32].words[5i32]);
    sim.localOriginAnchorB.x = fromBits(f[1i32].words[6i32]);
    sim.localOriginAnchorB.y = fromBits(f[1i32].words[7i32]);

        outputString14("CASE"); outDec(id as i32); outDec(calls as i32); newline();
        var reg = Registers(); joints14 = zeroJoints14(); descriptions14 = zeroDescriptions14(); copies14 = zeroCopies14();
        fixture14 = false; prepared14 = false; compact14 = false; pendingKind14 = -1i32; physicalWorldSaved14 = false; physicalBodiesSaved14 = false;
        completedPositiveSteps = 0u32; callbackCount14 = 0i32; lastPoints13 = false; lastMaterials13 = false;
        var seq: u32 = 1u32;
        while (seq <= calls and inputOk) { let op: Operation = readOperation14(&reg,id,seq); if (inputOk) runOperation14(&reg,id,seq,op); seq = seq+1u32; }
        if (inputOk and guardKind14 != 0u32) jointGuardHelper14(&reg,id,if calls == 0u32 then 0u32 else calls+1u32);

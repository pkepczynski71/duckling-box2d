        else if (field == 3u32) body.birthTicket.low = replacement;
        else if (field == 4u32) body.birthTicket.high = replacement;
        else if (field == 5u32) body.slot = replacement as i32;
        if ((field == 6u32 or field == 7u32) and game.worldStatus(owner) == game.OK and body.slot >= 0i32) {

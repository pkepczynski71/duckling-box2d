    }
    words[38] = toBits(d.length); words[39] = d.enableSpring as u32;
    words[40] = toBits(d.hertz); words[41] = toBits(d.dampingRatio); words[42] = d.enableLimit as u32; words[43] = toBits(d.minLength); words[44] = toBits(d.maxLength);
    words[45] = toBits(v.currentLength); words[46] = d.enableMotor as u32; words[47] = toBits(d.motorSpeed); words[48] = toBits(d.maxMotorForce); words[49] = toBits(v.motorForce); return words;
}
fun outViewWords14(words: ref u32[51], n: i32 = 50i32) -> () = { var i: i32 = 0i32; while (i < n) { outHex(words[i]); i = i+1i32; } }
fun outAnswer14(reg: ref Registers, id: u32, seq: u32, op: Operation, status: i32) -> () = {
    if (guardMode14 and callbackCount14 > 0i32 and (op.opcode == 31i32 or op.opcode == 32i32)) {
        var callIndex14: i64 = 0i64; while (callIndex14 < callbackResults14.length()) {
            let answer14: game.JointAction = callbackResults14.at(callIndex14);
            prefix("A14",id,seq); currentOutputRank14 = 130i32; outDec(answer14.status); outDec(answer14.reason); newline(); callIndex14 = callIndex14+1i64;
        }
    }
    var reason: i32 = reason14;
    if (op.opcode < 200i32) {
        reason = chainLegacyReason13(reg,op,status);

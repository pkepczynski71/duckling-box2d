    var parameters = game.SolverWorldParameters(); parameters.gravity = math2.Vec2(); parameters.maximumLinearSpeed = 100.0f32;
    let createdWorld: game.WorldResult = game.createSleepWorld(math2.Vec2(), 100.0f32, parameters, true);
    var def = raw.BodyDef(); def.bodyType = 2i32;
    let createdBody: game.BodyResult = game.createBody8(createdWorld.number, def);
    var source = raw.ShapeRecord(); source.circle = math2.Circle(math2.Vec2(), 1.0f32); source.friction = 0.5f32; source.userMaterialId = 3i32;
    let createdShape: game.ShapeResult = game.addPreparedShape(createdWorld.number, createdBody.number, source, false);
    if (createdWorld.status != game.OK or createdBody.status != game.OK or createdShape.status != game.OK) { invalid("PORT14A: INPUT_DOMAIN\n"); return 2i64; }
    let owner: game.WorldNumber = createdWorld.number;
    var status: i32 = game.OK;
    if (code == 90u32) {
        if (not game.validBodyDef(op.def) or not game.validName(op.def.name)) status = game.PARAM;
    } else if (code == 92u32) {
        if (not game.finiteVector(op.value)) status = game.PARAM;
    } else if (code == 80u32) {
        if (op.kind == 0i32 and op.words[4] != 2u32) {
            if (not game.safeBodyChange(owner, createdBody.number, op.words[4] as i32, false, false)) status = game.GEOMETRY;
        } else if (op.kind == 2i32) {
            if (not game.validMassData(op.liveMass)) status = game.PARAM;
            else if (not game.safeMassData(owner, createdBody.number, op.liveMass)) status = game.GEOMETRY;
        } else if (op.kind == 3i32 or (op.kind == 7i32 and op.wake)) {
            if (not game.safeBodyChange(owner, createdBody.number, 2i32, op.wake and op.kind == 7i32, op.kind == 7i32)) status = game.GEOMETRY;
        } else if (op.kind == 4i32 or op.kind == 5i32) {
            if (not game.validNonnegative(op.value.x)) status = game.PARAM;
        } else if (op.kind == 6i32) {
            if (not game.finite(op.value.x)) status = game.PARAM;
        } else if (op.kind == 8i32) {
            let target: math2.Transform = math2.Transform(op.position, op.rotation);
            if (not game.validTargetTransform(target, op.dt) or not game.safeTargetTransform(owner, createdBody.number, target, op.dt)) status = game.PARAM;
        }
    } else {
        if (op.kind == 0i32 or op.kind == 1i32) {
            if (not game.validNonnegative(op.value.x)) status = game.PARAM;
        } else if (op.kind == 3i32) {
            if (not game.validSurfaceMaterial(op.liveMaterial)) status = game.PARAM;
        } else if (op.kind >= 5i32) {
            var prepared = raw.ShapeRecord();
            if (not game.prepareReplacement(source, op.source, &prepared)) status = game.GEOMETRY;
            else if (not game.preflight(owner, createdBody.number.slot, 3i32, createdShape.number.slot, prepared, 0.0f32)) status = game.GEOMETRY;
        }

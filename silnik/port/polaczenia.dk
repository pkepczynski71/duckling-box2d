    let opcode: u32 = readWord();
    decimalError = "PORT14A: INPUT_SEQUENCE\n"; decimalOverflow = decimalError;
    if (not inputOk) return op;
    if (seq != expectedSeq) { invalid("PORT14A: INPUT_SEQUENCE\n"); return op; }
    if (opcode > 92u32 or (opcode >= 65u32 and opcode <= 79u32) or opcode == 63u32 or opcode == 20u32 or (opcode >= 6u32 and opcode <= 9u32) or (opcode >= 22u32 and opcode <= 29u32)) { invalid("PORT14A: INPUT_OPCODE\n"); return op; }

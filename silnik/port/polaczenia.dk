        } else if (debugTrace) result = distance.b2ShapeDistanceDebug(&input, &cache, &trace, words[53i32] as i32, words[54i32] != 0u32);
        else result = distance.b2ShapeDistance(&input, &cache, &trace, words[53i32] as i32, words[54i32] != 0u32);
    } else {

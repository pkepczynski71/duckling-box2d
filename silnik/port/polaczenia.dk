            if (not reg.worlds[words[0] as i32].saved or game.worldStatus(guardedOwner) != game.OK) { invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n"); return; }
            var guardedWorld: ref raw.World = raw.worlds.at(guardedOwner.slot as i64);
            let savedNext: i32 = guardedWorld.solverSetIdPool.nextIndex;
            let seededNext: i32 = if savedNext < 4i32 then 4i32 else savedNext;
            if (guardedWorld.solverSets.length() < 4i64) guardedWorld.solverSets.push(raw.SolverSet());
            var savedCounts: List[i32]; var guardedIndex: i32 = 2i32;
            while (guardedIndex < seededNext) {
                let oldCount: i32 = raw.b2GetSolverSet(guardedWorld, guardedIndex).bodyCount;
                savedCounts.push(oldCount); raw.b2GetSolverSet(guardedWorld, guardedIndex).bodyCount = 0i32;
                guardedIndex = guardedIndex + 1i32;
            }
            guardedWorld.solverSetIdPool.nextIndex = seededNext;
            raw.b2GetSolverSet(guardedWorld, 2i32).bodyCount = awakeCount as i32;
            raw.b2GetSolverSet(guardedWorld, 3i32).bodyCount = sleepingCount as i32;
            accepted = game.sleepBodyUpperFit(guardedWorld);
            guardedIndex = 2i32;
            while (guardedIndex < seededNext) {
                let restoredCount: i32 = savedCounts.at((guardedIndex - 2i32) as i64);
                raw.b2GetSolverSet(guardedWorld, guardedIndex).bodyCount = restoredCount;
                guardedIndex = guardedIndex + 1i32;
            }
            guardedWorld.solverSetIdPool.nextIndex = savedNext;
        } else if (fitsSum) accepted = game.sleepBodyUpperBlocksFit(upper);

fun outHitPublic(reg: ref Registers, id: u32, seq: u32, op: Operation, execution: ref Execution) -> () = {
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
            prefix("HN10", id, seq); outDec(wi); outHex(world.contactHitEvents.length() as u32); newline(); execution.z10[0] = execution.z10[0] + 1i32;
            var j: i64 = 0i64;
            while (j < world.contactHitEvents.length()) {
                let hit: raw.ContactHitEvent = world.contactHitEvents.at(j);
                prefix("HR10", id, seq); outDec(wi); outDec(j as i32); outRawShape(hit.shapeA); outRawShape(hit.shapeB);
                outFloat(hit.point.x); outFloat(hit.point.y); outFloat(hit.normal.x); outFloat(hit.normal.y); outFloat(hit.approachSpeed); newline();
                execution.z10[1] = execution.z10[1] + 1i32; j = j + 1i64;
            }
        }
        wi = wi + 1i32;
    }
    var ki: i32 = 0i32;
    while (ki < 4i32) {
        if (op.opcode == 49i32 and op.b == ki and execution.status != game.OK) {
                                                                                       
            var failed = game.ContactEvents(); failed.status = execution.status; outHitCopy(&failed, id, seq, ki, 0i32, execution);
        } else if (reg.events[ki].saved) {
            outHitCopy(&reg.events[ki].values, id, seq, ki, 0i32, execution);
            if (op.opcode == 50i32 and op.a == ki and op.mutateCopy) {
                var changed: game.ContactEvents = game.cloneContactEvents(&reg.events[ki].values); mutateEvents(&changed);
                outHitCopy(&changed, id, seq, ki, 1i32, execution);
                var fresh: game.ContactEvents = game.cloneContactEvents(&reg.events[ki].values); outHitCopy(&fresh, id, seq, ki, 2i32, execution);
            }
        }
        ki = ki + 1i32;
    }
}

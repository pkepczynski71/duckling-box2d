fun outJointCommon14(joint: raw.JointRecord) -> () = {
    outHex(joint.hasObjectId as u32); outPair(joint.objectId); outHex(joint.setIndex as u32); outHex(joint.colorIndex as u32); outHex(joint.localIndex as u32);
    outHex(joint.edgeA.bodyId as u32); outHex(joint.edgeA.prevKey as u32); outHex(joint.edgeA.nextKey as u32);
    outHex(joint.edgeB.bodyId as u32); outHex(joint.edgeB.prevKey as u32); outHex(joint.edgeB.nextKey as u32);
    outHex(joint.jointId as u32); outHex(joint.islandId as u32); outHex(joint.islandPrev as u32); outHex(joint.islandNext as u32);
    outFloat(joint.drawSize); outHex(joint.jointType as u32); outHex(joint.generation as u32); outHex(joint.isMarked as u32); outHex(joint.collideConnected as u32);
}
fun outJointSim14(sim: raw.JointSim) -> () = {
    outHex(sim.jointId as u32); outHex(sim.bodyIdA as u32); outHex(sim.bodyIdB as u32); outHex(sim.jointType as u32);
    outFloat(sim.localOriginAnchorA.x); outFloat(sim.localOriginAnchorA.y); outFloat(sim.localOriginAnchorB.x); outFloat(sim.localOriginAnchorB.y);
    outFloat(sim.invMassA); outFloat(sim.invMassB); outFloat(sim.invIA); outFloat(sim.invIB); outFloat(sim.constraintHertz); outFloat(sim.constraintDampingRatio);
    outFloat(sim.constraintSoftness.biasRate); outFloat(sim.constraintSoftness.massScale); outFloat(sim.constraintSoftness.impulseScale);
}
fun outDistance14(joint: raw.DistanceJoint) -> () = {
    outFloat(joint.length); outFloat(joint.hertz); outFloat(joint.dampingRatio); outFloat(joint.minLength); outFloat(joint.maxLength); outFloat(joint.maxMotorForce); outFloat(joint.motorSpeed);
    outFloat(joint.impulse); outFloat(joint.lowerImpulse); outFloat(joint.upperImpulse); outFloat(joint.motorImpulse); outHex(joint.indexA as u32); outHex(joint.indexB as u32);
    outFloat(joint.anchorA.x); outFloat(joint.anchorA.y); outFloat(joint.anchorB.x); outFloat(joint.anchorB.y); outFloat(joint.deltaCenter.x); outFloat(joint.deltaCenter.y);
    outFloat(joint.distanceSoftness.biasRate); outFloat(joint.distanceSoftness.massScale); outFloat(joint.distanceSoftness.impulseScale); outFloat(joint.axialMass);
    outHex(joint.enableSpring as u32); outHex(joint.enableLimit as u32); outHex(joint.enableMotor as u32);
}
fun outJointPrivate14(reg: ref Registers, id: u32, seq: u32, op: Operation) -> () = {
    if (compact14) { outCompactJoint14(reg,id,seq); return; }
    var group: i32 = 1i32;
    while (group <= 7i32) {
        if (group != 4i32 and group != 6i32) {
            var wi: i32 = 0i32;
            while (wi < 16i32) {
                if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
                    var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
                    if (group == 7i32) {
                        var bi: i32 = 0i32; while (bi < world.bodyIdPool.nextIndex) { let body: raw.BodyRecord = world.bodies.at(bi as i64); if (body.id != -1i32) { jp14(id,seq,0i32,world.worldId as i32,bi,7i32,2i32); outHex(body.headJointKey as u32); outHex(body.jointCount as u32); newline(); } bi = bi+1i32; }
                    } else {
                        var ji: i32 = 0i32;
                        while (ji < world.jointIdPool.nextIndex) {
                            let joint: raw.JointRecord = world.joints.at(ji as i64); let alive: bool = joint.jointId != -1i32;
                            if (group == 5i32) { jp14(id,seq,0i32,world.worldId as i32,ji,5i32,6i32); outHex(alive as u32); outHex(joint.generation as u32); outPair(joint.birthTicket); outPair(joint.ownerTicket); newline(); }
                            else if (alive) {
                                if (group == 1i32) { jp14(id,seq,0i32,world.worldId as i32,ji,1i32,21i32); outJointCommon14(joint); }
                                else if (group == 2i32) { jp14(id,seq,0i32,world.worldId as i32,ji,2i32,17i32); outJointSim14(raw.b2GetJointSim(world,ji)); }
                                else {
                                    jp14(id,seq,0i32,world.worldId as i32,ji,3i32,payloadArityB14(joint.jointType));
                                    if (joint.jointType == 5i32) outRevoluteB14(raw.b2GetJointSim(world,ji).revoluteJoint);
                                    else if (joint.jointType == 4i32) outPrismaticB14(raw.b2GetJointSim(world,ji).prismaticJoint);
                                    else outDistance14(raw.b2GetJointSim(world,ji).distanceJoint);
                                }
                                newline(); if (group == 1i32) counts14[16] = counts14[16]+1u32;
                            }
                            ji = ji+1i32;
                        }
                    }
                } wi = wi+1i32;
            }
        } group = group+1i32;
    }
    var wi2: i32 = 0i32;
    while (wi2 < 16i32) {
        if (reg.worlds[wi2].saved and game.worldStatus(reg.worlds[wi2].number) == game.OK) {
            var world2: ref raw.World = raw.worlds.at(reg.worlds[wi2].number.slot as i64);
            var ii: i32 = 0i32;
            while (ii < world2.islandIdPool.nextIndex) { let island: raw.Island = world2.islands.at(ii as i64); if (island.islandId != -1i32) {
                lp14(id,seq,0i32,world2.worldId as i32,1i32,ii,island.jointCount); var ji: i32 = island.headJoint;
                while (ji != -1i32) { outHex(ji as u32); ji = world2.joints.at(ji as i64).islandNext; } newline();
            } ii = ii+1i32; }
            var si: i32 = 0i32; while (si < world2.solverSetIdPool.nextIndex) { var set: ref raw.SolverSet = raw.b2GetSolverSet(world2,si); if (set.setIndex != -1i32) {
                lp14(id,seq,0i32,world2.worldId as i32,2i32,si,set.jointCount); var ji: i32 = 0i32; while (ji < set.jointCount) { outHex(set.jointSims.at(ji as i64).jointId as u32); ji = ji+1i32; } newline();
            } si = si+1i32; }
            var ci: i32 = 0i32; while (ci < 12i32) {
                lp14(id,seq,0i32,world2.worldId as i32,3i32,ci,world2.constraintGraph.colors[ci].jointCount);
                var ji: i32 = 0i32; while (ji < world2.constraintGraph.colors[ci].jointCount) { outHex(world2.constraintGraph.colors[ci].jointSims.at(ji as i64).jointId as u32); ji = ji+1i32; } newline(); ci = ci+1i32;
            }
            lp14(id,seq,0i32,world2.worldId as i32,4i32,0i32,4i32+world2.jointIdPool.freeCount);
            outHex(world2.jointIdPool.nextIndex as u32); outHex(world2.jointIdPool.freeCount as u32); outPair(game.lastIssued);
            var fi: i32 = 0i32; while (fi < world2.jointIdPool.freeCount) { let freed: i32 = world2.jointIdPool.freeArray.at(fi as i64); outHex(freed as u32); fi = fi+1i32; } newline();
        } wi2 = wi2+1i32;
    }
    if (op.opcode == 210i32 and op.words[0] == 0u32) {
        jp14(id,seq,0i32,0i32,0i32,10i32,16i32); var world: ref raw.World = raw.worlds.at(joints14[0i32].owner.slot as i64);
        let sim: raw.JointSim = raw.b2GetJointSim(world,0i32); var indexA: i32 = 0i32; var indexB: i32 = 0i32;
        if (sim.jointType == 5i32) { indexA = sim.revoluteJoint.indexA; indexB = sim.revoluteJoint.indexB; }
        else if (sim.jointType == 4i32) { indexA = sim.prismaticJoint.indexA; indexB = sim.prismaticJoint.indexB; }
        else { indexA = sim.distanceJoint.indexA; indexB = sim.distanceJoint.indexB; }
        outDirectState14(raw.solverState(world,indexA)); outDirectState14(raw.solverState(world,indexB)); newline();
    }
    counts14[14] = completedPositiveSteps; counts14[15] = seq; counts14[19] = fixture14 as u32;
    jp14(id,seq,0i32,16i32,0i32,8i32,20i32); var co: i32 = 0i32; while (co < 20i32) { outHex(counts14[co]); co = co+1i32; } newline();
}
fun newArity14(code: u32, kind: u32) -> i32 = {
    if (code == 200u32) return 2i32; if (code == 201u32) return 6i32;
    if (code == 202u32 or code == 204u32 or code == 205u32 or code == 207u32 or code == 210u32 or code == 211u32 or code == 212u32) return 3i32;
    if (code == 206u32) return 5i32; if (code == 208u32) return 1i32; if (code == 209u32) return 4i32;
    if (code == 203u32) {
        if (profileB14 and (kind == 37u32 or kind == 53u32)) return 6i32;
        if (profileB14 and ((kind >= 32u32 and kind <= 40u32) or (kind >= 48u32 and kind <= 56u32))) return 5i32;
        if (kind == 0u32 or kind == 1u32 or kind == 3u32 or kind == 7u32 or kind == 17u32) return 6i32;
        if (kind == 5u32) return 7i32; if (kind == 6u32) return 4i32;
        if (kind == 2u32 or kind == 4u32 or kind == 16u32 or (kind >= 18u32 and kind <= 24u32)) return 5i32;
    }
    return -1i32;
}
fun readOperation14(reg: ref Registers, id: u32, seq: u32) -> Operation = {
    readRow(); consumeTag("O"); let actual: u32 = readWord(); let code: u32 = readWord(); var result = Operation();
    if (not inputOk) return result; if (actual != seq) { invalid("PORT14A: INPUT_SEQ\n"); return result; }
    let known: bool = legalOpcode13(code) or (code >= 41u32 and code <= 45u32) or (code >= 51u32 and code <= 53u32) or (code >= 100u32 and code <= 109u32) or code == 64u32 or code == 120u32 or (code >= 200u32 and code <= 212u32);
    if (not known) { invalid("PORT14A: INPUT_OPCODE\n"); return result; }
    if (code < 200u32) {
        if (profileB14 and direct14) { invalid("PORT14A: INPUT_PROFILE\n"); return result; }
        checkArity(67i32); var words: u32[64]; readPayload(&words); if (not inputOk) return result;
        if (code == 120u32) { invalid("PORT14A: INPUT_PROFILE\n"); return result; }
        if ((code >= 41u32 and code <= 45u32) or (code >= 51u32 and code <= 53u32)) { invalid("PORT14A: INPUT_PHASE\n"); return result; }
        if (code == 64u32 and not direct14) { invalid("PORT14A: INPUT_PHASE\n"); return result; }
        if (code >= 100u32 and code <= 109u32) {
            result = decodeChain13(code,&words); if (inputOk and code == 100u32 and validChainOp13(reg,result)) readChainInput13(id,seq,&words);
        } else {
            if (not legalOpcode13(code) and code != 64u32) { invalid("PORT14A: INPUT_OPCODE\n"); return result; }
            result = decodePayload12(code,words);
        }
        return result;
    }
    if (code > 212u32) { invalid("PORT14A: INPUT_OPCODE\n"); return result; }
    let n: u32 = readWord(); if (n > 7u32) { invalid("PORT14A: INPUT_ARITY\n"); return result; }
    checkArity(4i32+n as i32); result.opcode = code as i32; var ai: i32 = 0i32; readingPayload = true;
    while (ai < n as i32 and inputOk) { result.words[ai] = readWord(); ai = ai+1i32; } readingPayload = false; endRow();
    let arity: i32 = newArity14(code,result.words[3]);
    if (arity < 0i32) { invalid("PORT14A: INPUT_ENUM\n"); return result; }
    if (n as i32 != arity) { invalid("PORT14A: INPUT_ARITY\n"); return result; }
    validateOperation14(reg,result);
    if (inputOk and direct14 and (profileB14 or currentCase13 >= 65u32) and code != 210u32) invalid("PORT14A: INPUT_PROFILE\n"); return result;
}
fun requireSavedWorld14(reg: ref Registers, slot: u32) -> bool = {
    if (slot >= 16u32) { invalid("PORT14A: INPUT_REGISTER_RANGE\n"); return false; }
    if (not reg.worlds[slot as i32].saved) { invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n"); return false; } return true;
}
fun validateOperation14(reg: ref Registers, op: Operation) -> () = {
    let a: u32[64] = op.words; let code: i32 = op.opcode;
    if (code == 200i32) { if (a[0] != 0u32 and (not profileB14 or (a[0] != 4u32 and a[0] != 5u32))) invalid("PORT14A: INPUT_ENUM\n"); if (a[1] >= 16u32) invalid("PORT14A: INPUT_REGISTER_RANGE\n"); return; }
    if (code == 202i32) {
        if (not profileB14) {
            if (a[1] > 17u32) { invalid("PORT14A: INPUT_ENUM\n"); return; }
            if ((a[1] == 5u32 or a[1] == 8u32 or a[1] == 11u32 or a[1] == 14u32 or a[1] == 15u32) and a[2] > 1u32) { invalid("PORT14A: INPUT_BOOL\n"); return; }
            if (a[0] >= 16u32) { invalid("PORT14A: INPUT_REGISTER_RANGE\n"); return; }
            if (not descriptions14[a[0] as i32].saved) invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n"); return;
        }
        if (a[0] >= 16u32) { invalid("PORT14A: INPUT_REGISTER_RANGE\n"); return; }
        if (not descriptions14[a[0] as i32].saved) { invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n"); return; }
        let typ: i32 = descriptions14[a[0] as i32].jointType;
        if (a[1] >= descriptionArityB14(typ) as u32) { invalid("PORT14A: INPUT_ENUM\n"); return; }
        if (descriptionBoolB14(typ,a[1] as i32) and a[2] > 1u32) invalid("PORT14A: INPUT_BOOL\n"); return;
    }
    if (code == 208i32 or code == 209i32) {
        if (code == 209i32 and a[1] != 0u32 and a[1] != 4u32) { invalid("PORT14A: INPUT_ENUM\n"); return; }
        if (a[0] >= 4u32) { invalid("PORT14A: INPUT_REGISTER_RANGE\n"); return; }
        if (not copies14[a[0] as i32].saved) { invalid("PORT14A: INPUT_COPY\n"); return; }
        if (code == 209i32) {
            var saved: ref Copy14 = &copies14[a[0] as i32];
            if (a[1] == 4u32 and not saved.isView) { invalid("PORT14A: INPUT_COPY\n"); return; }
            let limit: u32 = if a[1] == 4u32 then viewArityB14(saved.jointType) as u32 else (if saved.isView then 8u32 else (8i64*saved.items.length()) as u32);
            if (a[2] >= limit) { invalid("PORT14A: INPUT_COPY\n"); return; }
            var previous: u32 = 0u32;
            if (a[1] == 4u32) previous = saved.view[a[2] as i32];
            else if (saved.isView) previous = saved.identity.words[a[2] as i32];
            else previous = saved.items.at((a[2]/8u32) as i64).words[(a[2]%8u32) as i32];
            if (previous == a[3]) invalid("PORT14A: INPUT_DOMAIN\n");
        } return;
    }
    if (code == 210i32) {
        if (not direct14 or (not profileB14 and currentCase13 < 65u32) or not joints14[0i32].saved) { invalid("PORT14A: INPUT_PROFILE\n"); return; }
        if (a[0] > (if profileB14 then 2u32 else 0u32) or a[1] > 2u32) invalid("PORT14A: INPUT_ENUM\n");
        if (a[0] != 0u32 and (a[0] as i32 != mathFixtureB14 or a[1] != 0u32 or a[2] != 0u32)) invalid("PORT14A: INPUT_PHASE\n");
        if (a[0] != 0u32 and not prepared14) invalid("PORT14A: INPUT_PHASE\n");
        if (a[2] > 1u32) invalid("PORT14A: INPUT_BOOL\n");
        if (a[1] < 2u32 and a[2] != 0u32) invalid("PORT14A: INPUT_UNUSED\n");
        if (a[1] != 0u32 and not prepared14) invalid("PORT14A: INPUT_PHASE\n"); return;
    }
    if (code == 211i32) {
        if (a[0] > 18u32) invalid("PORT14A: INPUT_ENUM\n");
        if (guardMode14) { validateSeed14(reg,a); return; }
        if (not direct14 or (a[0] != 8u32 and a[0] != 17u32 and a[0] != 18u32)) invalid("PORT14A: INPUT_PROFILE\n"); return;
    }
    if (code != 207i32 and a[0] > 1u32) { invalid("PORT14A: INPUT_MODE\n"); return; }
if (code == 203i32 and (mutationBoolB14(a[3])) and a[4] > 1u32) { invalid("PORT14A: INPUT_BOOL\n"); return; }
if (code == 203i32 and a[3] == 5u32 and a[4] == 0u32 and (a[5] != 0u32 or a[6] != 0u32)) { invalid("PORT14A: INPUT_UNUSED\n"); return; }
    let wr: u32 = if code == 207i32 then a[0] else a[1]; if (not requireSavedWorld14(reg,wr)) return;
    if (code == 201i32) {
        if (a[2] >= 256u32 or a[3] >= 256u32 or a[4] >= 256u32 or a[5] >= 16u32) { invalid("PORT14A: INPUT_REGISTER_RANGE\n"); return; }
        if (direct14 and (profileB14 or currentCase13 >= 65u32)) { invalid("PORT14A: INPUT_PROFILE\n"); return; }
        if (not reg.bodies[a[2] as i32].saved or not reg.bodies[a[3] as i32].saved or not descriptions14[a[5] as i32].saved) { invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n"); return; }
        if (jointLive14(a[4] as i32)) invalid("PORT14A: INPUT_REGISTER_COLLISION\n");
    } else if (code == 206i32) {
        if (a[2] >= 256u32 or a[4] >= 4u32) { invalid("PORT14A: INPUT_REGISTER_RANGE\n"); return; }
        if (not reg.bodies[a[2] as i32].saved) invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n");
        if (a[3] > 128u32) invalid("PORT14A: INPUT_POPULATION\n");
        if ((a[0] == 1u32 and a[3] != 0u32) or (a[0] == 0u32 and a[4] != 0u32)) invalid("PORT14A: INPUT_UNUSED\n");
    } else {
        let jr: u32 = if code == 207i32 then a[1] else a[2];
        if (jr >= 256u32 or (code == 207i32 and a[2] >= 4u32)) { invalid("PORT14A: INPUT_REGISTER_RANGE\n"); return; }
        if (not joints14[jr as i32].saved) invalid("PORT14A: INPUT_REGISTER_UNINITIALIZED\n");
    }
}
fun setDescriptionField14(value: ref game.DistanceDescription, field: i32, word: u32) -> () = {
    let f: f32 = fromBits(word);
    if (field == 0i32) value.localAnchorA.x = f; else if (field == 1i32) value.localAnchorA.y = f;
    else if (field == 2i32) value.localAnchorB.x = f; else if (field == 3i32) value.localAnchorB.y = f;
    else if (field == 4i32) value.length = f; else if (field == 5i32) value.enableSpring = word != 0u32;
    else if (field == 6i32) value.hertz = f; else if (field == 7i32) value.dampingRatio = f;
    else if (field == 8i32) value.enableLimit = word != 0u32; else if (field == 9i32) value.minLength = f;
    else if (field == 10i32) value.maxLength = f; else if (field == 11i32) value.enableMotor = word != 0u32;
    else if (field == 12i32) value.maxMotorForce = f; else if (field == 13i32) value.motorSpeed = f;
    else if (field == 14i32) value.collideConnected = word != 0u32; else if (field == 15i32) value.hasObjectId = word != 0u32;
    else if (field == 16i32) value.objectId.low = word; else value.objectId.high = word;

# Box2D 8c661469, src/world.c:100.                                                           
fun poolCounts() -> PoolCounts = {
    var result = PoolCounts(); var i: i32 = 0i32;
    while (i < 128i32) {
        if (raw.worlds.at(i as i64).inUse) {
            result.bodies[i] = raw.worlds.at(i as i64).bodyIdPool.nextIndex;
            result.shapes[i] = raw.worlds.at(i as i64).shapeIdPool.nextIndex;
            result.contacts[i] = raw.worlds.at(i as i64).contactIdPool.nextIndex;
        }
        i = i + 1i32;
    }
    return result;
}

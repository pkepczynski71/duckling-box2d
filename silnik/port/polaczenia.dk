    outputString14("GA 1"); outFixtureWords(words, 64i32);
    outputString14("CASE 1 0\n"); outGuardResult(0u32, (1000u32 + code) as i32, status, status == game.OK, 0i64);
    checkEnd(); if (not inputOk) return 2i64;
    outputString14("ENDCASE 1\nEND 1\n"); return 0i64;
}


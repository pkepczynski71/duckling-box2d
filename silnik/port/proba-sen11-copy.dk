                                                                            
                                                                    
import fizyka.kola as math2;
import fizyka.swiat as raw;
import fizyka.gra as game;
import core.primitive_io as io;
fun outUnsigned(value: u64) -> () = {
    if (value >= 10u64) outUnsigned(value / 10u64);
    io.writeChar(('0' as u64 + value % 10u64) as char);
}
fun field(value: u64) -> () = { io.writeChar(' '); outUnsigned(value); }
fun word(value: f32) -> u32 = { var number: f32 = value; return (&number as cptr u32)[0]; }
fun main() -> i64 = {
    var parameters = game.SolverWorldParameters(); parameters.gravity = math2.Vec2();
    let owner: game.WorldResult = game.createSleepWorld(parameters.gravity, parameters.maximumLinearSpeed, parameters, true);
    var def = raw.BodyDef(); def.bodyType = 2i32; def.isAwake = false;
    let body: game.BodyResult = game.createBody8(owner.number, def);
    if (owner.status != game.OK or body.status != game.OK) return 2i64;
    var first: game.SleepState = game.getSleepState(owner.number, body.number);
    let second: game.SleepState = game.getSleepState(owner.number, body.number);
    let before: bool = first.isSleeping; let beforeThreshold: u32 = word(first.sleepThreshold);
    first.isSleeping = false; first.sleepThreshold = 0.0f32;
    let after: bool = second.isSleeping; let afterThreshold: u32 = word(second.sleepThreshold);
    let fresh: game.SleepState = game.getSleepState(owner.number, body.number);
    io.writeStr("COPYSTATE11"); field(first.status as u64); field(before as u64); field(beforeThreshold as u64);
    field(after as u64); field(afterThreshold as u64); field(fresh.isSleeping as u64); field(word(fresh.sleepThreshold) as u64);
    io.writeChar('\n'); return 0i64;
}

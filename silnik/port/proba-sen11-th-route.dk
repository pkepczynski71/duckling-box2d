                                                                         
                                                                                   
import fizyka.kola as math2;
import fizyka.swiat as raw;
import fizyka.gra as game;
import core.primitive_io as io;

fun outUnsigned(value: u64) -> () = {
    if (value >= 10u64) outUnsigned(value / 10u64);
    io.writeChar(('0' as u64 + value % 10u64) as char);
}
fun field(value: u64) -> () = { io.writeChar(' '); outUnsigned(value); }
fun main() -> i64 = {
    var route: i32 = 0i32;
    while (route < 5i32) {
        var parameters = game.SolverWorldParameters(); parameters.gravity = math2.Vec2();
        let owner: game.WorldResult = game.createSleepWorld(parameters.gravity, parameters.maximumLinearSpeed, parameters, true);
        if (owner.status != game.OK) return 2i64;
        let before: game.Key64 = game.lastIssued;
        var def = raw.BodyDef(); def.bodyType = 2i32; def.sleepThreshold = -1.0f32;
        var shape = raw.ShapeRecord(); shape.circle.radius = 0.5f32;
        var status: i32 = game.STALE;
        if (route == 0i32) { let result: game.BodyResult = game.createBody(owner.number, def); status = result.status; }
        else if (route == 1i32) { let result: game.BodyResult = game.createBody8(owner.number, def); status = result.status; }
        else if (route == 2i32) { let result: game.PairResult = game.createBodyWithShape(owner.number, def, shape, true, false, game.Key64()); status = result.status; }
        else if (route == 3i32) { let result: game.PairResult = game.createBodyWithPreparedShape(owner.number, def, shape, true, false, game.Key64()); status = result.status; }
        else { let result: game.PairResult = game.createBodyWithBox(owner.number, def, game.BoxGeometry(), shape, true, false, game.Key64()); status = result.status; }
        var world: ref raw.World = raw.worlds.at(owner.number.slot as i64);
        io.writeStr("THROUTE11"); field(route as u64); field(status as u64);
        field(world.bodyIdPool.nextIndex as u64); field(world.bodyIdPool.freeCount as u64);
        field(world.shapeIdPool.nextIndex as u64); field(world.islandIdPool.nextIndex as u64);
        field(raw.b2GetSolverSet(world, 2i32).bodyCount as u64);
        field((game.lastIssued.low - before.low) as u64); field((game.lastIssued.high - before.high) as u64);
        io.writeChar('\n'); route = route + 1i32;
    }
    return 0i64;
}

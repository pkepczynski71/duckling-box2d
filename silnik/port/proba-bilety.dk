import fizyka.gra as game;
import fizyka.swiat as raw;
import fizyka.kola as math2;
import fizyka.zbior as bits;
import core.primitive_io as io;

# Box2D 8c661469, src/world.c:100-128. Full 128-world pool, failed create and recycling.
fun checkWorldPool() -> bool = {
    var numbers: game.WorldNumber[128];
    var i: i32 = 0i32;
    while (i < 128i32) {
        let created: game.WorldResult = game.createWorld(math2.Vec2(), 400.0f32);
        if (created.status != game.OK or created.id.index1 != (i + 1i32) as u16) return false;
        numbers[i] = created.number;
        i = i + 1i32;
    }
    let before: bits.Key64 = game.lastIssued;
    let full: game.WorldResult = game.createWorld(math2.Vec2(), 400.0f32);
    if (full.status != game.LIMIT or full.id.index1 != 0u16 or not bits.equalKey(before, game.lastIssued)) return false;
    if (game.destroyWorld(numbers[17]) != game.OK) return false;
    let replacement: game.WorldResult = game.createWorld(math2.Vec2(), 400.0f32);
    if (replacement.status != game.OK or replacement.id.index1 != 18u16 or replacement.id.generation != 1u16) return false;
    if (game.worldStatus(numbers[17]) != game.STALE) return false;
    numbers[17] = replacement.number;
    i = 0i32;
    while (i < 128i32) {
        if (game.destroyWorld(numbers[i]) != game.OK) return false;
        i = i + 1i32;
    }
    return true;
}

# Box2D 8c661469, src/world.                                                          
fun main() -> i64 = {
                                                                                    
    let first: bits.Key64 = game.nextTicket(bits.Key64());
    let carry: bits.Key64 = game.nextTicket(bits.Key64(4294967295u32, 17u32));
    if (not bits.equalKey(first, bits.Key64(1u32, 0u32))) return 1i64;
    if (not bits.equalKey(carry, bits.Key64(0u32, 18u32))) return 2i64;
    let maximum: bits.Key64 = bits.Key64(4294967295u32, 4294967295u32);
    if (not game.ticketLimit(maximum) or not bits.equalKey(game.nextTicket(maximum), maximum)) return 3i64;
    if (not checkWorldPool()) return 13i64;
    game.lastIssued = bits.Key64(4294967295u32, 0u32);
    let carriedWorld: game.WorldResult = game.createWorld(math2.Vec2(), 400.0f32);
    if (carriedWorld.status != game.OK or not bits.equalKey(carriedWorld.number.birthTicket, bits.Key64(0u32, 1u32))) return 14i64;
    if (game.destroyWorld(carriedWorld.number) != game.OK) return 15i64;
                                                                                   
    game.lastIssued = bits.Key64(4294967294u32, 4294967295u32);
    let world: game.WorldResult = game.createWorld(math2.Vec2(), 400.0f32);
    if (world.status != game.OK or not bits.equalKey(world.number.birthTicket, maximum)) return 4i64;
    let before: game.WorldLookup = game.lookupWorld(world.number);
    let rejectedBody: game.BodyResult = game.createBody(world.number, raw.BodyDef());
    let after: game.WorldLookup = game.lookupWorld(world.number);
    if (rejectedBody.status != game.LIMIT or rejectedBody.id.index1 != 0i32) return 5i64;
    if (before.value.bodyCount != after.value.bodyCount or after.value.islandCount != 0i32) return 6i64;
    if (raw.worlds.at(world.number.slot as i64).bodyIdPool.nextIndex != 0i32) return 7i64;
    let rejectedWorld: game.WorldResult = game.createWorld(math2.Vec2(), 400.0f32);
    if (rejectedWorld.status != game.LIMIT or rejectedWorld.id.index1 != 0u16) return 8i64;
    var wi: i32 = 0i32;
    var used: i32 = 0i32;
    while (wi < 128i32) {
        if (raw.worlds.at(wi as i64).inUse) used = used + 1i32;
        wi = wi + 1i32;
    }
    if (used != 1i32 or not bits.equalKey(game.lastIssued, maximum)) return 9i64;
    if (game.destroyWorld(world.number) != game.OK) return 10i64;
    let stillRejected: game.WorldResult = game.createWorld(math2.Vec2(), 400.0f32);
    if (stillRejected.status != game.LIMIT or raw.worlds.at(0i64).inUse) return 11i64;
    if (not bits.equalKey(game.lastIssued, maximum)) return 12i64;
    io.writeStr("BILETY OK\n");
    return 0i64;
}

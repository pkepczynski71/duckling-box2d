}
fun validate19(code: u32, n: u32, a: ref u32[64], banks: ref Bank19[2]) -> () = {
    var needed: u32 = 1u32;
    if (code == 600u32) needed = 9u32; else if (code == 601u32 or code == 607u32) needed = 0u32; else if (code == 602u32) needed = 8u32; else if (code == 603u32) needed = 20u32; else if (code == 608u32) needed = 3u32;
    if (n != needed) fail19("ARITY");
    if (code == 600u32) { if (a[0] > 1u32) fail19("MODE"); if (a[1] > 7u32) fail19("SELECTOR"); }
    if (code == 602u32) {
        if (a[0] > 4u32) fail19("DOMAIN"); var i: i32 = 1i32;
        while (i < 8i32) { let active: bool = not (i == 1i32 and (a[0] == 2u32 or a[0] == 4u32)) and not (a[0] == 0u32 and (i == 2i32 or i == 3i32)); if (active and not game.finite(fromBits(a[i]))) fail19("DOMAIN"); i = i+1i32; }
        if (((a[0] == 0u32 or a[0] == 1u32 or a[0] == 3u32) and fromBits(a[1]) < 0.0f32) or (a[0] == 3u32 and (fromBits(a[2]) <= 0.0f32 or fromBits(a[3]) <= 0.0f32))) fail19("DOMAIN");
    }
    if (code == 603u32) {
        if (a[0] < 3u32 or a[0] > 8u32 or not game.finite(fromBits(a[1])) or fromBits(a[1]) < 0.0f32) fail19("DOMAIN");
        var hull = poly.Polygon(); hull.count = a[0] as i32; var hullIndex: i32 = 0i32;
        while (hullIndex < 8i32) { if (hullIndex < hull.count) { hull.vertices[hullIndex] = math2.Vec2(fromBits(a[2i32+2i32*hullIndex]),fromBits(a[3i32+2i32*hullIndex])); if (not game.finiteVector(hull.vertices[hullIndex])) fail19("DOMAIN"); } else if (a[2i32+2i32*hullIndex] != 0u32 or a[3i32+2i32*hullIndex] != 0u32) fail19("DOMAIN"); hullIndex = hullIndex+1i32; }
        if (not raw.b2ValidateHull(&hull) or not game.finite(fromBits(a[18])) or not game.finite(fromBits(a[19]))) fail19("DOMAIN");
    }
    if (code == 605u32 or code == 606u32 or code == 608u32) {
        if (a[0] > 1u32) fail19("BANK");
        if (code == 608u32) { if (a[1] > 13u32) fail19("FIELD"); if (((a[1] == 3u32 or a[1] == 12u32) and a[2] > 1u32) or (a[1] == 13u32 and a[2] > 2u32)) fail19("VALUE"); }

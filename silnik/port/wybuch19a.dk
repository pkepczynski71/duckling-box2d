    }
    si = 0i32;
    while (si < 512i32) {
        if (reg.shapes[si].saved and game.shapeStatus(reg.shapes[si].owner, reg.shapes[si].number) == game.OK) {
            var sw: ref raw.World = raw.worlds.at(reg.shapes[si].id.world0 as i64);
            let leafShape: raw.ShapeRecord = sw.shapes.at(reg.shapes[si].number.slot as i64);
            if (leafShape.proxyKey != -1i32) {
                let treeType: i32 = broad.B2_PROXY_TYPE(leafShape.proxyKey);
                let proxyId: i32 = broad.B2_PROXY_ID(leafShape.proxyKey);
                var actualTree: ref tree.DynamicTree = &sw.broadPhase.trees[treeType];
                let category: i64 = tree.b2DynamicTree_GetCategoryBits(actualTree, proxyId);
                let userData: i64 = tree.b2DynamicTree_GetUserData(actualTree, proxyId);
                prefix("T", id, seq); outDec(si); outHex(treeType as u32); outHex(proxyId as u32);
                outAABB(tree.b2DynamicTree_GetAABB(actualTree, proxyId));
                outHex(category as u32); outHex(((category as u64) >> 32u64) as u32);
                outHex(userData as u32); outHex(((userData as u64) >> 32u64) as u32); newline(); nT = nT + 1i32;
            }
        }
        si = si + 1i32;
    }
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);

fun outJointCommon14(joint: raw.JointRecord) -> () = {
    outHex(joint.hasObjectId as u32); outPair(joint.objectId); outHex(joint.setIndex as u32); outHex(joint.colorIndex as u32); outHex(joint.localIndex as u32);
    outHex(joint.edgeA.bodyId as u32); outHex(joint.edgeA.prevKey as u32); outHex(joint.edgeA.nextKey as u32);
    outHex(joint.edgeB.bodyId as u32); outHex(joint.edgeB.prevKey as u32); outHex(joint.edgeB.nextKey as u32);
    outHex(joint.jointId as u32); outHex(joint.islandId as u32); outHex(joint.islandPrev as u32); outHex(joint.islandNext as u32);
    outFloat(joint.drawSize); outHex(joint.jointType as u32); outHex(joint.generation as u32); outHex(joint.isMarked as u32); outHex(joint.collideConnected as u32);
}

fun outJointSim14(sim: raw.JointSim) -> () = {
    outHex(sim.jointId as u32); outHex(sim.bodyIdA as u32); outHex(sim.bodyIdB as u32); outHex(sim.jointType as u32);
    outFloat(sim.localOriginAnchorA.x); outFloat(sim.localOriginAnchorA.y); outFloat(sim.localOriginAnchorB.x); outFloat(sim.localOriginAnchorB.y);
    outFloat(sim.invMassA); outFloat(sim.invMassB); outFloat(sim.invIA); outFloat(sim.invIB); outFloat(sim.constraintHertz); outFloat(sim.constraintDampingRatio);
    outFloat(sim.constraintSoftness.biasRate); outFloat(sim.constraintSoftness.massScale); outFloat(sim.constraintSoftness.impulseScale);
}

fun outDistance14(joint: raw.DistanceJoint) -> () = {
    outFloat(joint.length); outFloat(joint.hertz); outFloat(joint.dampingRatio); outFloat(joint.minLength); outFloat(joint.maxLength); outFloat(joint.maxMotorForce); outFloat(joint.motorSpeed);
    outFloat(joint.impulse); outFloat(joint.lowerImpulse); outFloat(joint.upperImpulse); outFloat(joint.motorImpulse); outHex(joint.indexA as u32); outHex(joint.indexB as u32);
    outFloat(joint.anchorA.x); outFloat(joint.anchorA.y); outFloat(joint.anchorB.x); outFloat(joint.anchorB.y); outFloat(joint.deltaCenter.x); outFloat(joint.deltaCenter.y);
    outFloat(joint.distanceSoftness.biasRate); outFloat(joint.distanceSoftness.massScale); outFloat(joint.distanceSoftness.impulseScale); outFloat(joint.axialMass);
    outHex(joint.enableSpring as u32); outHex(joint.enableLimit as u32); outHex(joint.enableMotor as u32);
}

fun outJointPrivate14(reg: ref Registers, id: u32, seq: u32, op: Operation) -> () = {
    if (compact14) { outCompactJoint14(reg,id,seq); return; }
    var group: i32 = 1i32;
    while (group <= 7i32) {
        if (group != 4i32 and group != 6i32) {
            var wi: i32 = 0i32;
            while (wi < 16i32) {
                if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
                    var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
                    if (group == 7i32) {
                        var bi: i32 = 0i32; while (bi < world.bodyIdPool.nextIndex) { let body: raw.BodyRecord = world.bodies.at(bi as i64); if (body.id != -1i32) { jp14(id,seq,0i32,world.worldId as i32,bi,7i32,2i32); outHex(body.headJointKey as u32); outHex(body.jointCount as u32); newline(); } bi = bi+1i32; }
                    } else {
                        var ji: i32 = 0i32;
                        while (ji < world.jointIdPool.nextIndex) {
                            let joint: raw.JointRecord = world.joints.at(ji as i64); let alive: bool = joint.jointId != -1i32;
                            if (group == 5i32) { jp14(id,seq,0i32,world.worldId as i32,ji,5i32,6i32); outHex(alive as u32); outHex(joint.generation as u32); outPair(joint.birthTicket); outPair(joint.ownerTicket); newline(); }
                            else if (alive) {
                                if (group == 1i32) { jp14(id,seq,0i32,world.worldId as i32,ji,1i32,21i32); outJointCommon14(joint); }
                                else if (group == 2i32) { jp14(id,seq,0i32,world.worldId as i32,ji,2i32,17i32); outJointSim14(raw.b2GetJointSim(world,ji)); }
                                else {
                                    jp14(id,seq,0i32,world.worldId as i32,ji,3i32,payloadArityB14(joint.jointType));
                                    if (joint.jointType == 5i32) outRevoluteB14(raw.b2GetJointSim(world,ji).revoluteJoint);
                                    else if (joint.jointType == 4i32) outPrismaticB14(raw.b2GetJointSim(world,ji).prismaticJoint);
                                    else outDistance14(raw.b2GetJointSim(world,ji).distanceJoint);
                                }
                                newline(); if (group == 1i32) counts14[16] = counts14[16]+1u32;
                            }
                            ji = ji+1i32;
                        }
                    }
                } wi = wi+1i32;
            }
        } group = group+1i32;
    }
    var wi2: i32 = 0i32;
    while (wi2 < 16i32) {
        if (reg.worlds[wi2].saved and game.worldStatus(reg.worlds[wi2].number) == game.OK) {
            var world2: ref raw.World = raw.worlds.at(reg.worlds[wi2].number.slot as i64);
            var ii: i32 = 0i32;
            while (ii < world2.islandIdPool.nextIndex) { let island: raw.Island = world2.islands.at(ii as i64); if (island.islandId != -1i32) {
                lp14(id,seq,0i32,world2.worldId as i32,1i32,ii,island.jointCount); var ji: i32 = island.headJoint;
                while (ji != -1i32) { outHex(ji as u32); ji = world2.joints.at(ji as i64).islandNext; } newline();
            } ii = ii+1i32; }
            var si: i32 = 0i32; while (si < world2.solverSetIdPool.nextIndex) { var set: ref raw.SolverSet = raw.b2GetSolverSet(world2,si); if (set.setIndex != -1i32) {
                lp14(id,seq,0i32,world2.worldId as i32,2i32,si,set.jointCount); var ji: i32 = 0i32; while (ji < set.jointCount) { outHex(set.jointSims.at(ji as i64).jointId as u32); ji = ji+1i32; } newline();
            } si = si+1i32; }
            var ci: i32 = 0i32; while (ci < 12i32) {
                lp14(id,seq,0i32,world2.worldId as i32,3i32,ci,world2.constraintGraph.colors[ci].jointCount);
                var ji: i32 = 0i32; while (ji < world2.constraintGraph.colors[ci].jointCount) { outHex(world2.constraintGraph.colors[ci].jointSims.at(ji as i64).jointId as u32); ji = ji+1i32; } newline(); ci = ci+1i32;
            }
            lp14(id,seq,0i32,world2.worldId as i32,4i32,0i32,4i32+world2.jointIdPool.freeCount);
            outHex(world2.jointIdPool.nextIndex as u32); outHex(world2.jointIdPool.freeCount as u32); outPair(game.lastIssued);
            var fi: i32 = 0i32; while (fi < world2.jointIdPool.freeCount) { let freed: i32 = world2.jointIdPool.freeArray.at(fi as i64); outHex(freed as u32); fi = fi+1i32; } newline();
        } wi2 = wi2+1i32;
    }
    if (op.opcode == 210i32 and op.words[0] == 0u32) {
        jp14(id,seq,0i32,0i32,0i32,10i32,16i32); var world: ref raw.World = raw.worlds.at(joints14[0i32].owner.slot as i64);
        let sim: raw.JointSim = raw.b2GetJointSim(world,0i32); var indexA: i32 = 0i32; var indexB: i32 = 0i32;
        if (sim.jointType == 5i32) { indexA = sim.revoluteJoint.indexA; indexB = sim.revoluteJoint.indexB; }
        else if (sim.jointType == 4i32) { indexA = sim.prismaticJoint.indexA; indexB = sim.prismaticJoint.indexB; }
        else { indexA = sim.distanceJoint.indexA; indexB = sim.distanceJoint.indexB; }
        outDirectState14(raw.solverState(world,indexA)); outDirectState14(raw.solverState(world,indexB)); newline();
    }
    counts14[14] = completedPositiveSteps; counts14[15] = seq; counts14[19] = fixture14 as u32;
    jp14(id,seq,0i32,16i32,0i32,8i32,20i32); var co: i32 = 0i32; while (co < 20i32) { outHex(counts14[co]); co = co+1i32; } newline();
}


fun outIsland(island: raw.Island) -> () = {
    let alive: bool = island.islandId != -1i32; outHex(alive as u32);
    if (not alive) {
        var i: i32 = 1i32;
        while (i < 15i32) { outHex(if i <= 3i32 then 4294967295u32 else 0u32); i = i + 1i32; }
        return;
    }
    outHex(island.setIndex as u32); outHex(island.localIndex as u32); outHex(island.islandId as u32);
    outHex(island.headBody as u32); outHex(island.tailBody as u32); outHex(island.bodyCount as u32);
    outHex(island.headContact as u32); outHex(island.tailContact as u32); outHex(island.contactCount as u32);
    outHex(island.headJoint as u32); outHex(island.tailJoint as u32); outHex(island.jointCount as u32);
    outHex(island.parentIsland as u32); outHex(island.constraintRemoveCount as u32);
}

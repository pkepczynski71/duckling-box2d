# Box2D 8c661469, src/world.c:100.                                                           

fun outContactNumber(number: game.ContactNumber) -> () = { outHex(number.slot as u32); outPair(number.birthTicket); outPair(number.ownerTicket); }
# Box2D 8c661469, src/shape.h:13. Historical Number5, distinct from raw ShapeId.

fun outShapeNumber(number: game.ShapeNumber) -> () = { outHex(number.slot as u32); outPair(number.birthTicket); outPair(number.ownerTicket); }
# Box2D 8c661469, include/box2d/id.h:52.
# Box2D 8c661469, src/world.c:100.                                                           

fun outRawShape(number: broad.ShapeId) -> () = { outHex(number.index1 as u32); outHex(number.world0 as u32); outHex(number.generation as u32); }
# Box2D 8c661469, src/contact.c:453.

fun outContactValue(value: game.ContactValue) -> () = {
    outContactNumber(value.number); outShapeNumber(value.shapeA); outShapeNumber(value.shapeB);
    outHex(value.touching as u32); outManifold(value.manifold);
}
# Box2D 8c661469, src/body.c:460-495. A fresh returned list for every phase.

fun outContactList(list: ref game.ContactList, id: u32, seq: u32, phase: i32) -> i32 = {
    prefix("GL", id, seq); outDec(phase); outDec(0i32); outDec(0i32);
    outHex(list.status as u32); outHex(list.values.length() as u32); newline();
    var i: i64 = 0i64;
    while (i < list.values.length()) {
        let value: game.ContactValue = list.values.at(i);
        prefix("GL", id, seq); outDec(phase); outDec(1i32); outDec(i as i32); outContactValue(value); newline(); i = i + 1i64;
    }
    return 1i32 + list.values.length() as i32;
}
# Box2D 8c661469, src/world.c:1529-1555. GE/GC same copied values, independent lists.

fun outContactEvents(tag: str, events: ref game.ContactEvents, id: u32, seq: u32, slot: i32, phase: i32) -> i32 = {
    prefix(tag, id, seq); outDec(slot); outDec(phase); outDec(0i32); outDec(0i32);
    outHex(events.status as u32); outHex(events.begin.length() as u32); outHex(events.end.length() as u32); outHex(events.hitCount as u32); newline();
    var i: i64 = 0i64;
    while (i < events.begin.length()) {
        let begin: game.ContactBegin = events.begin.at(i);
        prefix(tag, id, seq); outDec(slot); outDec(phase); outDec(1i32); outDec(i as i32);
        outShapeNumber(begin.shapeA); outShapeNumber(begin.shapeB); outManifold(begin.manifold); newline(); i = i + 1i64;
    }
    var j: i64 = 0i64;
    while (j < events.end.length()) {
        let end: game.ContactEnd = events.end.at(j);
        prefix(tag, id, seq); outDec(slot); outDec(phase); outDec(2i32); outDec(j as i32);
        outShapeNumber(end.shapeA); outShapeNumber(end.shapeB); newline(); j = j + 1i64;
    }
    return 1i32 + events.begin.length() as i32 + events.end.length() as i32;
}
# Box2D 8c661469, src/world.c:1529-1555. Mutation belongs to the returned copy only.

fun mutateEvents(events: ref game.ContactEvents) -> () = {
    if (events.begin.length() > 0i64) {
        events.begin.at(0i64).shapeA.birthTicket.low = events.begin.at(0i64).shapeA.birthTicket.low ^ 1u32;
        events.begin.at(0i64).manifold.normal.x = fromBits(toBits(events.begin.at(0i64).manifold.normal.x) ^ 2147483648u32);
    } else if (events.end.length() > 0i64) events.end.at(0i64).shapeA.birthTicket.low = events.end.at(0i64).shapeA.birthTicket.low ^ 1u32;
    let count: i64 = events.hits.length();
    if (count > 0i64) {
        let first: game.ContactHit = events.hits.at(0i64); events.hits.push(first);
        if (count >= 2i64) {
            let second: game.ContactHit = events.hits.at(1i64); events.hits.at(0i64) = second; events.hits.at(1i64) = first;
        }
        events.hits.at(0i64).shapeA.birthTicket.low = events.hits.at(0i64).shapeA.birthTicket.low ^ 1u32;
        events.hits.at(0i64).point.x = fromBits(toBits(events.hits.at(0i64).point.x) ^ 2147483648u32);
    }
    events.hitCount = events.hits.length() as i32;
}
# Box2D 8c661469, src/body.                                                       

fun outContactPublic(reg: ref Registers, id: u32, seq: u32, op: Operation, execution: ref Execution) -> () = {
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
            var bi: i32 = 0i32;
            while (bi < world.bodyIdPool.nextIndex) {
                if (world.bodies.at(bi as i64).id != -1i32) {
                    let bodyId: raw.BodyId = raw.b2MakeBodyId(world, bi);
                    let capacity: i32 = raw.b2Body_GetContactCapacity(bodyId);
                    var data: List[raw.ContactData] = raw.b2Body_GetContactData(bodyId, capacity);
                    prefix("CD", id, seq); outDec(wi); outDec(bi); outDec(0i32); outDec(0i32); outHex(capacity as u32); outHex(data.length() as u32); newline();
                    execution.z9[5] = execution.z9[5] + 1i32;
                    var di: i64 = 0i64;
                    while (di < data.length()) {
                        let item: raw.ContactData = data.at(di);
                        prefix("CD", id, seq); outDec(wi); outDec(bi); outDec(1i32); outDec(di as i32);
                        outRawShape(item.shapeA); outRawShape(item.shapeB); outManifold(item.manifold); newline();
                        execution.z9[5] = execution.z9[5] + 1i32; di = di + 1i64;
                    }
                }
                bi = bi + 1i32;
            }
        }
        wi = wi + 1i32;
    }
    var ci: i32 = 0i32;
    while (ci < 256i32) {
        if (reg.contacts[ci].saved) {
            prefix("NC9", id, seq); outDec(ci); outContactNumber(reg.contacts[ci].number); newline(); execution.z9[3] = execution.z9[3] + 1i32;
        }
        ci = ci + 1i32;
    }
    if (op.opcode == 46i32 or op.opcode == 47i32) {
        prefix("RC9", id, seq); outHex(execution.contact.status as u32); outHex(execution.contact.has as u32);
        if (op.opcode == 47i32) outContactNumber(reg.contacts[op.b].number);
        else outContactNumber(execution.contact.value.number);
        newline(); execution.z9[4] = 1i32;
    }
    if (op.opcode == 47i32 and execution.contact.status == game.OK) {
        prefix("GV", id, seq); outDec(0i32); outHex(0u32); outContactValue(execution.contact.value); newline(); execution.z9[6] = 1i32;
        if (op.mutateCopy) {
            var changed: game.ContactValue = execution.contact.value;
            changed.manifold.normal.x = fromBits(toBits(changed.manifold.normal.x) ^ 2147483648u32);
            prefix("GV", id, seq); outDec(1i32); outHex(0u32); outContactValue(changed); newline();
            let again: game.ContactLookup = game.lookupContact(reg.worlds[op.a].number, reg.contacts[op.b].number);
            prefix("GV", id, seq); outDec(2i32); outHex(again.status as u32); outContactValue(again.value); newline(); execution.z9[6] = 3i32;
        }
    }
    if (op.opcode == 48i32) {
        execution.z9[7] = outContactList(&execution.contactList, id, seq, 0i32);
        if (execution.contactList.status == game.OK and op.mutateCopy) {
            var changedList: game.ContactList = game.contacts(reg.worlds[op.a].number, reg.bodies[op.b].number);
            let count: i64 = changedList.values.length();
            if (count > 0i64) {
                let first: game.ContactValue = changedList.values.at(0i64); changedList.values.push(first);
                if (count >= 2i64) {
                    let second: game.ContactValue = changedList.values.at(1i64);
                    changedList.values.at(0i64) = second; changedList.values.at(1i64) = first;
                }
                changedList.values.at(0i64).manifold.normal.x = fromBits(toBits(changedList.values.at(0i64).manifold.normal.x) ^ 2147483648u32);
            }
            execution.z9[7] = execution.z9[7] + outContactList(&changedList, id, seq, 1i32);
            var fresh: game.ContactList = game.contacts(reg.worlds[op.a].number, reg.bodies[op.b].number);
            execution.z9[7] = execution.z9[7] + outContactList(&fresh, id, seq, 2i32);
        }
    }
    var ew: i32 = 0i32;
    while (ew < 16i32) {
        if (reg.worlds[ew].saved and game.worldStatus(reg.worlds[ew].number) == game.OK) {
            var current: game.ContactEvents = game.copyContactEvents(reg.worlds[ew].number);
            execution.z9[8] = execution.z9[8] + outContactEvents("GE", &current, id, seq, ew, 0i32);
        } else if (op.opcode == 49i32 and ew == op.a) {
            var failed: game.ContactEvents = game.copyContactEvents(reg.worlds[ew].number);
            execution.z9[8] = execution.z9[8] + outContactEvents("GE", &failed, id, seq, ew, 0i32);
        }
        ew = ew + 1i32;
    }
    var ki: i32 = 0i32;
    while (ki < 4i32) {
        if (reg.events[ki].saved) {
            execution.z9[9] = execution.z9[9] + outContactEvents("GC", &reg.events[ki].values, id, seq, ki, 0i32);
            if (op.opcode == 50i32 and op.a == ki and op.mutateCopy) {
                var mutated: game.ContactEvents = game.cloneContactEvents(&reg.events[ki].values); mutateEvents(&mutated);
                execution.z9[9] = execution.z9[9] + outContactEvents("GC", &mutated, id, seq, ki, 1i32);
                var reread: game.ContactEvents = game.cloneContactEvents(&reg.events[ki].values);
                execution.z9[9] = execution.z9[9] + outContactEvents("GC", &reread, id, seq, ki, 2i32);
            }
        }
        ki = ki + 1i32;
    }
}

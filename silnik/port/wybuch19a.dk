fun clearSolverObservations() -> () = {
    var wi: i32 = 0i32;
    while (wi < 128i32) {
        if (raw.worlds.at(wi as i64).inUse) {
            raw.worlds.at(wi as i64).solverTrace = raw.SolverContext();
            raw.worlds.at(wi as i64).stepRequests.clear(); raw.worlds.at(wi as i64).stepCreated.clear();
        }
        wi = wi + 1i32;
    }
}

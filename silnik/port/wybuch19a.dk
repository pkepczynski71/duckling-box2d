            var bw: ref raw.World = raw.worlds.at(reg.bodies[bi].id.world0 as i64);
            let body: raw.BodyRecord = bw.bodies.at(reg.bodies[bi].number.slot as i64);
            var set: ref raw.SolverSet = raw.b2GetSolverSet(bw, body.setIndex);

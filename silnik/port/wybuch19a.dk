    prefix("A19",id,seq); outDec(code as i32); outDec(status.status); outDec(status.reason); newline();
    prefix("R19",id,seq); outDec(code as i32); outDec(kind); outDec(rn);
    if (code == 606u32) outBank19(banks[a[0] as i32]); else { i = 0i32; while (i < rn) { outHex(result[i]); i = i+1i32; } } newline();
    if (inCount >= 0i32) { prefix("I19",id,seq); outDec(inCount); i = 0i32; while (i < inCount) { outHex(arguments[i]); i = i+1i32; } newline(); }
    i = 0i32; while (i < 2i32) { if (banks[i].saved) { prefix("V19",id,seq); outDec(i); outDec(19i32); outBank19(banks[i]); newline(); } i = i+1i32; }
    if (code == 609u32 and a[0] == 0u32) {
                                                                                     
                                                                            
        var nativeWorld: ref raw.World = raw.worlds.at(reg.worlds[0].number.slot as i64);
        nativeWorld.callbacks12.preSolve = raw.b2DefaultPreSolve12;
        nativeWorld.callbacks12.preInstalled = false; nativeWorld.callbacks12.preContext = words64.Key64();
                                                                            
                                                                                 

            let shape: raw.ShapeRecord = raw.worlds.at(reg.shapes[si].id.world0 as i64).shapes.at(reg.shapes[si].number.slot as i64);
            prefix("P", id, seq); outDec(si); outHex(shape.id as u32); outHex(shape.bodyId as u32);
            outHex(shape.prevShapeId as u32); outHex(shape.nextShapeId as u32); outHex(shape.proxyKey as u32);
            outFloat(shape.localCentroid.x); outFloat(shape.localCentroid.y); outAABB(shape.fatAABB); outHex(shape.enlargedAABB as u32);
            newline(); nP = nP + 1i32;

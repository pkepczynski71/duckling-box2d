var initialRow13: bool = true; var initialA13: bool = false; var initialTagged13: bool = false;

var chainZ13: i32[18] = zeroChainZ13(); var chainI13: i32[6] = zeroChainI13();

fun zeroChainZ13() -> i32[18] = { var values: i32[18]; return values; }

fun zeroChainI13() -> i32[6] = { var values: i32[6]; return values; }

class SavedChain13 { saved: bool = false; number: game.ChainNumber = game.ChainNumber(); owner: game.WorldNumber = game.WorldNumber(); id: raw.ChainId = raw.ChainId(); }

class SavedChainCopy13 { saved: bool = false; value: game.ChainView = game.ChainView(); id: raw.ChainId = raw.ChainId(); children: List[broad.ShapeId] = emptyRawChildren13(); }

fun emptyRawChildren13() -> List[broad.ShapeId] = { var values: List[broad.ShapeId]; return values; }

fun zeroChains13() -> SavedChain13[16] = { var values: SavedChain13[16]; return values; }

fun zeroChainCopies13() -> SavedChainCopy13[4] = { var values: SavedChainCopy13[4]; return values; }

fun chainRaw13(id: raw.ChainId) -> () = { outHex(id.index1 as u32); outHex(id.world0 as u32); outHex(id.generation as u32); }

fun chainNumber13(number: game.ChainNumber) -> () = { outHex(number.slot as u32); outPair(number.birthTicket); outPair(number.ownerTicket); }

fun bodyNumber13(number: game.BodyNumber) -> () = { outHex(number.slot as u32); outPair(number.birthTicket); outPair(number.ownerTicket); }

fun shapeNumber13(number: game.ShapeNumber) -> () = { outHex(number.slot as u32); outPair(number.birthTicket); outPair(number.ownerTicket); }

fun childRaw13(id: broad.ShapeId) -> () = { outHex(id.index1 as u32); outHex(id.world0 as u32); outHex(id.generation as u32); }

fun zeros13(count: i32) -> () = { var i: i32 = 0i32; while (i < count) { outHex(0u32); i = i+1i32; } }

fun chainLegacyReason13(reg: ref Registers, op: Operation, status: i32) -> i32 = {
    if (status == game.LOCKED) return 1i32;
    if (status != game.PARAM) return 0i32;
    if (op.opcode == 80i32 and op.mode == 1i32 and op.kind == 0i32 and game.bodyStatus(reg.worlds[op.a].number,reg.bodies[op.b].number) == game.OK) {
        if (raw.worlds.at(reg.worlds[op.a].number.slot as i64).bodies.at(reg.bodies[op.b].number.slot as i64).headChainId != -1i32 and op.words[4] != 0u32) return 80i32;
    }
    if ((op.opcode == 18i32 or op.opcode == 19i32 or (op.opcode == 81i32 and op.mode == 1i32)) and game.shapeStatus(reg.worlds[op.a].number,reg.shapes[op.b].number) == game.OK) {
        if (raw.worlds.at(reg.worlds[op.a].number.slot as i64).shapes.at(reg.shapes[op.b].number.slot as i64).shapeType == 4i32) return 81i32;
    }
    return 0i32;
}

fun materialOut13(material: raw.SurfaceMaterial) -> () = { outFloat(material.friction); outFloat(material.restitution); outFloat(material.rollingResistance); outFloat(material.tangentSpeed); outHex(material.userMaterialId as u32); outHex(material.customColor); }

fun outChainPublic13(reg: ref Registers, id: u32, seq: u32, op: Operation, execution: ref Execution) -> () = {
    var ci: i32 = 0i32; var live: i32 = 0i32; var saved: i32 = 0i32;
    while (ci < 16i32) {
        if (reg.chains13[ci].saved) {
            saved = saved+1i32; prefix("CN13",id,seq); outDec(ci); chainRaw13(reg.chains13[ci].id); chainNumber13(reg.chains13[ci].number); newline(); chainZ13[1] = chainZ13[1]+1i32;
        } ci = ci+1i32;
    }
    ci = 0i32;
    while (ci < 16i32) {
        if (reg.chains13[ci].saved) {
            prefix("V13",id,seq); outDec(ci); outHex(raw.b2Chain_IsValid(reg.chains13[ci].id) as u32);
            outHex((game.chainStatus(reg.chains13[ci].owner,reg.chains13[ci].number) == game.OK) as u32); newline(); chainZ13[16] = chainZ13[16]+1i32;
        } ci = ci+1i32;
    }
    if (op.opcode == 102i32) {
        prefix("CQ13",id,seq); outDec(op.b); outHex(execution.status as u32); chainZ13[2] = 1i32;
        if (execution.status != game.OK) { zeros13(18i32); newline(); }
        else {
            let owner: game.WorldNumber = reg.worlds[op.a].number; var world: ref raw.World = raw.worlds.at(owner.slot as i64);
            let number: game.ChainNumber = reg.chains13[op.b].number; let rawId: raw.ChainId = raw.b2MakeChainId(world,number.slot);
            let worldId: raw.WorldId = raw.b2Chain_GetWorld(rawId); outHex(worldId.index1 as u32); outHex(0u32); outHex(worldId.generation as u32); outHex(owner.slot as u32); outPair(owner.birthTicket); zeros13(2i32);
            let bodySlot: i32 = world.chainShapes.at(number.slot as i64).bodyId; bodyNumber13(game.BodyNumber(bodySlot,world.bodies.at(bodySlot as i64).birthTicket,owner.birthTicket));
            let count: i32 = raw.b2Chain_GetSegmentCount(rawId);
            var children: List[broad.ShapeId]; var checked = game.ShapeList();
            if (op.mode == 0i32) children = raw.b2Chain_GetSegments(rawId,op.words[3] as i32);
            else { checked = game.chainSegments(owner,number); var ix: i64 = 0i64; while (ix < checked.values.length()) { children.push(raw.b2MakeShapeId(world,checked.values.at(ix).slot)); ix = ix+1i64; } }
            outHex(count as u32); outHex(children.length() as u32); outFloat(raw.b2Chain_GetFriction(rawId)); outFloat(raw.b2Chain_GetRestitution(rawId)); outHex(raw.b2Chain_GetMaterial(rawId) as u32); newline();
            var j: i64 = 0i64; while (j < children.length()) {
                let child: broad.ShapeId = children.at(j); prefix("QL13",id,seq); outDec(op.b); outDec(j as i32); childRaw13(child);
                var childNumber: game.ShapeNumber = game.ShapeNumber(child.index1-1i32,world.shapes.at((child.index1-1i32) as i64).birthTicket,owner.birthTicket);
                if (op.mode == 1i32) childNumber = checked.values.at(j);
                shapeNumber13(childNumber); newline(); chainZ13[3] = chainZ13[3]+1i32; j = j+1i64;
            }
        }
    }
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            var world2: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64); var si: i64 = 0i64;
            live = live+world2.chainIdPool.nextIndex-world2.chainIdPool.freeCount;
            while (si < world2.shapes.length()) {
                if (world2.shapes.at(si).id != -1i32 and world2.shapes.at(si).shapeType == 4i32) {
                    let segment: raw.ChainSegment = raw.b2Shape_GetChainSegment(raw.b2MakeShapeId(world2,si as i32));
                    prefix("CS13",id,seq); outDec(wi); outDec(si as i32); outFloat(segment.ghost1.x); outFloat(segment.ghost1.y);
                    outFloat(segment.segment.point1.x); outFloat(segment.segment.point1.y); outFloat(segment.segment.point2.x); outFloat(segment.segment.point2.y);
                    outFloat(segment.ghost2.x); outFloat(segment.ghost2.y); outHex(segment.chainId as u32); newline(); chainZ13[4] = chainZ13[4]+1i32;
                } si = si+1i64;
            }
        } wi = wi+1i32;
    }
    if (op.opcode == 104i32) {
        prefix("PC13",id,seq); outDec(op.b); outHex(execution.status as u32); chainZ13[5] = 1i32;
        if (execution.status != game.OK) zeros13(9i32);
        else {
            let result: game.ParentChainResult = game.parentChain(reg.worlds[op.a].number,reg.shapes[op.b].number); outHex(result.hasParent as u32);
            if (result.hasParent) { chainRaw13(raw.b2MakeChainId(raw.worlds.at(reg.worlds[op.a].number.slot as i64),result.number.slot)); chainNumber13(result.number); }
            else zeros13(8i32);
        } newline();
    }
    var ki: i32 = 0i32;
    while (ki < 4i32) {
        if (reg.chainCopies13[ki].saved) {
            outChainCopy13(&reg.chainCopies13[ki],id,seq,ki,0i32);
            if (op.opcode == 108i32 and op.a == ki) {
                var changed = SavedChainCopy13(); changed.saved = true; changed.id = reg.chainCopies13[ki].id;
                changed.value = game.cloneChainView(&reg.chainCopies13[ki].value); changed.children = copy reg.chainCopies13[ki].children;
                changed.value.segments.at(op.words[1] as i64).slot = op.words[2] as i32;
                outChainCopy13(&changed,id,seq,ki,1i32); outChainCopy13(&reg.chainCopies13[ki],id,seq,ki,2i32);
            }
        } ki = ki+1i32;
    }
    chainZ13[10] = saved; chainZ13[11] = live;
}

fun outChainCopy13(saved: ref SavedChainCopy13, id: u32, seq: u32, registerSlot: i32, phase: i32) -> () = {
    prefix("COPY13",id,seq); outDec(registerSlot); outDec(phase); newline(); chainZ13[6] = chainZ13[6]+1i32;
    prefix("CV13",id,seq); outDec(registerSlot); outDec(phase); chainRaw13(saved.id); chainNumber13(saved.value.number); bodyNumber13(saved.value.body); outHex(saved.value.segments.length() as u32); newline(); chainZ13[7] = chainZ13[7]+1i32;
    var j: i64 = 0i64; while (j < saved.value.segments.length()) {
        prefix("CE13",id,seq); outDec(registerSlot); outDec(phase); outDec(j as i32); childRaw13(saved.children.at(j)); shapeNumber13(saved.value.segments.at(j)); newline(); chainZ13[8] = chainZ13[8]+1i32; j = j+1i64;
    }
    prefix("ENDCOPY13",id,seq); outDec(registerSlot); outDec(phase); newline(); chainZ13[9] = chainZ13[9]+1i32;
}

fun outChainPrivate13(reg: ref Registers, id: u32, seq: u32) -> () = {
    var group: i32 = 0i32;
    while (group < 6i32) {
        var wi: i32 = 0i32;
        while (wi < 16i32) {
            if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
                var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
                if (group == 3i32) {
                    var bi: i64 = 0i64; while (bi < world.bodies.length()) { if (world.bodies.at(bi).id != -1i32) { prefix("BH13",id,seq); outDec(wi); outDec(bi as i32); outHex(world.bodies.at(bi).headChainId as u32); newline(); chainI13[3] = chainI13[3]+1i32; } bi = bi+1i64; }
                } else if (group == 4i32) {
                    prefix("IP13",id,seq); outDec(wi); outHex(world.chainIdPool.nextIndex as u32); outHex(world.chainIdPool.freeCount as u32);
                    var fi: i32 = 0i32; while (fi < world.chainIdPool.freeCount) { let freed: i32 = world.chainIdPool.freeArray.at(fi as i64); outHex(freed as u32); fi = fi+1i32; } newline(); chainI13[4] = chainI13[4]+1i32;
                } else {
                    var ci: i32 = 0i32; while (ci < world.chainIdPool.nextIndex) {
                        var chain: ref raw.ChainShape = world.chainShapes.at(ci as i64); let alive: bool = chain.id != -1i32;
                        if (group == 0i32) {
                            prefix("CH13",id,seq); outDec(wi); outDec(ci); outHex(alive as u32);
                            if (alive) { outHex(chain.bodyId as u32); outHex(chain.nextChainId as u32); outHex(chain.count as u32); outHex(chain.materialCount as u32); } else zeros13(4i32);
                            newline(); chainI13[0] = chainI13[0]+1i32;
                        } else if (group == 1i32 and alive) {
                            var sj: i32 = 0i32; while (sj < chain.count) { let slot: i32 = chain.shapeIndices.at(sj as i64); prefix("CI13",id,seq); outDec(wi); outDec(ci); outDec(sj);
                                childRaw13(raw.b2MakeShapeId(world,slot)); shapeNumber13(game.ShapeNumber(slot,world.shapes.at(slot as i64).birthTicket,world.birthTicket)); newline(); chainI13[1] = chainI13[1]+1i32; sj = sj+1i32; }
                        } else if (group == 2i32 and alive) {
                            var mj: i32 = 0i32; while (mj < chain.materialCount) { prefix("CM13",id,seq); outDec(wi); outDec(ci); outDec(mj); materialOut13(chain.materials.at(mj as i64)); newline(); chainI13[2] = chainI13[2]+1i32; mj = mj+1i32; }
                        } else if (group == 5i32) { prefix("CG13",id,seq); outDec(wi); outDec(ci); outHex(alive as u32); outHex(chain.generation as u32); outPair(chain.birthTicket); outPair(chain.ownerTicket); newline(); chainI13[5] = chainI13[5]+1i32; }
                        ci = ci+1i32;
                    }
                }
            } wi = wi+1i32;
        } group = group+1i32;
    }
}

fun outChainCounters13(id: u32, seq: u32) -> () = {
    prefix("I13",id,seq); var i: i32 = 0i32; while (i < 6i32) { outHex(chainI13[i] as u32); i = i+1i32; } newline();
    chainZ13[12] = completedPositiveSteps as i32; chainZ13[13] = seq as i32;
                                                                                 
    prefix("Z13",id,seq); var j: i32 = 0i32; while (j < 17i32) { outHex(chainZ13[j] as u32); j = j+1i32; } outHex(chainZ13[17] as u32); newline();
}


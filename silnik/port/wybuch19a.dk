fun argumentEquals19(p: cptr char, text: str) -> bool = {
    let t: cptr char = builtins.ptr_from_slice[char](text) as cptr char; var i: i64 = 0i64;
    while (i < text.length()) { if (p[i] != t[i]) return false; i = i+1i64; } return p[i] == '\0';
}
fun main(argc: i32, argv: cptr cptr char) -> i64 = {
    var diagnostic: bool = false; if (argc == 2i32 and argumentEquals19(argv[1],"--diagnostic")) diagnostic = true; else if (argc != 1i32) fail19("HEADER");
    var header: Line19 = read19(); if (header.count != 4i32 or not tag19(&header,0i32,"PORT19")) fail19("HEADER"); if (not tag19(&header,1i32,"A")) fail19("PART");
    var profile: i32 = -1i32; if (tag19(&header,2i32,"DIRECT")) profile = 0i32; else if (tag19(&header,2i32,"PUBLIC")) profile = 1i32; else if (tag19(&header,2i32,"GUARD")) profile = 2i32; if (profile < 0i32) fail19("PROFILE");
    let count: u32 = number19(&header,3i32); let full: u32 = if profile == 1i32 then 32u32 else 48u32;
    if (count == 0u32 or count > full or (not diagnostic and count != full)) fail19("N");
    profile13C = 14i32; initialRow13 = false; initialTagged13 = true; var previous: u32 = 0u32; var ci: u32 = 0u32;
    while (ci < count) {
        var row: Line19 = read19(); if (row.count != 3i32 or not tag19(&row,0i32,"C")) fail19("CASE");
        let id: u32 = number19(&row,1i32); let calls: u32 = number19(&row,2i32); if (id == 0u32 or id > full or id <= previous or (not diagnostic and id != ci+1u32)) fail19("ID"); previous = id;
        let expected: u32 = if profile == 2i32 then 0u32 else (if profile == 0i32 or id == 23u32 or id == 24u32 then 1u32 else 9u32);
        if ((profile == 2i32 and calls != 0u32) or (profile != 2i32 and (calls == 0u32 or calls > 32u32 or (not diagnostic and calls != expected)))) fail19("COUNT");
        var reg = Registers(); var banks: Bank19[2] = zeroBanks19(); joints14 = zeroJoints14(); copies14 = zeroCopies14(); completedPositiveSteps = 0u32;
        var p: u32[26] = sceneWords19(if profile == 1i32 then 1i32 else 0i32,if profile == 2i32 then 1u32 else id);
        if (not (profile == 1i32 and (id == 23u32 or id == 24u32))) createScene19(&reg,&p);
        outputString14("CASE"); outDec(id as i32); outDec(calls as i32); newline();
        var s: u32 = 0u32; let total: u32 = if profile == 2i32 then 2u32 else calls;
        while (s < total) {
            var op: Line19 = read19(); let guard: bool = profile == 2i32;
            if (op.count < 4i32 or not tag19(&op,0i32,if guard then "G" else "O")) fail19(if guard then "GUARD" else "SEQ");
            let seq: u32 = number19(&op,1i32); let code: u32 = number19(&op,2i32); let n: u32 = number19(&op,3i32);
            if (seq != (if guard then s else s+1u32)) fail19(if guard then "GUARD" else "SEQ");
            if (code < 600u32 or code > 609u32 or code == 604u32) fail19("OPCODE"); if (n > 64u32 or op.count != 4i32+n as i32) fail19("ARITY");
            var a: u32[64]; var i: i32 = 0i32; while (i < n as i32) { a[i] = number19(&op,4i32+i,true); i = i+1i32; }
            if (guard) {
                if (code != 600u32 or n != 9u32 or a[0] != 1u32) fail19("GUARD"); if (a[1] > 7u32) fail19("SELECTOR");
                prefix("G19",id,s); outDec(600i32); outDec(9i32); i = 0i32; while (i < 9i32) { outHex(a[i]); i = i+1i32; } newline();
                let answer: game.ChainValidation = checked19(reg.worlds[0].number,a[1],description19(&a),false); prefix("GA19",id,s); outDec((answer.status == game.OK) as i32); outDec(answer.status); outDec(answer.reason); newline();
            } else { validate19(code,n,&a,&banks); execute19(&reg,&banks,&p,id,s+1u32,code,n,&a); }
            s = s+1u32;
        }
        outputString14("ENDCASE"); outDec(id as i32); newline(); cleanup(&reg); ci = ci+1u32;
    }
    if (io.readCharCode() >= 0i32) fail19("TRAILING_DATA"); outputString14("END"); outDec(count as i32); newline(); return 0i64;
}

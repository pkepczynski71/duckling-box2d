fun outSleepWorldPhase(world: ref raw.World, wi: i32, id: u32, seq: u32, phase: i32, bitRecord: bool) -> () = {
    if (bitRecord) {
        prefix("AB11", id, seq); outDec(wi); outDec(phase);
        if (phase == 0i32) outBitSet(&world.finalizedAwakeIslandBitSet);
        else outBitSet(&world.awakeIslandBitSet);
    } else {
        prefix("WS11", id, seq); outDec(wi); outDec(phase); outHex(world.enableSleep as u32);
        if (phase == 0i32) { outHex(world.finalizedSplitIslandId as u32); outHex(world.finalizedTaskSplitIslandId as u32); outFloat(world.finalizedTaskSplitSleepTime); }
        else {
            outHex(world.splitIslandId as u32);
                                                                                                 
            if (world.hasEverFinalized) { outHex(world.taskSplitIslandId as u32); outFloat(world.taskSplitSleepTime); }
            else { outHex(0u32); outHex(0u32); }
        }
    }
    newline();
}

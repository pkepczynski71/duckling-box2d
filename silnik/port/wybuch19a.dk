        else if (descriptions14[d].jointType == 4i32) outDescriptionPrismaticB14(descriptions14[d].prismatic);
        else outDescription14(descriptions14[d].value); newline(); counts14[17] = counts14[17]+1u32; } d = d+1i32; }
    if (mathResultCountB14 > 0i32) {

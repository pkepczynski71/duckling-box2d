fun execute19(reg: ref Registers, banks: ref Bank19[2], p: ref u32[26], id: u32, seq: u32, code: u32, n: u32, a: ref u32[64]) -> () = {
    if (code == 600u32 and a[0] == 0u32) { if (a[1] != 0u32 or game.explosionPreflight(reg.worlds[0].number,description19(a)).status != game.OK) fail19("DOMAIN"); }
    reset19(reg); var result: u32[30]; var rn: i32 = 0i32; var kind: i32 = 0i32; var inCount: i32 = -1i32; var arguments: u32[39]; var status = game.ChainValidation(); var nativeStep = Execution(); var candidates: i32 = 0i32;
    prefix("E19",id,seq); outDec(code as i32); outDec(n as i32); var i: i32 = 0i32; while (i < n as i32) { outHex(a[i]); i = i+1i32; } newline();
    if (code == 600u32) {
        var submitted: game.ExplosionDescription = description19(a); var e: raw.ExplosionDef = definition19(submitted);
        if (a[0] == 1u32) status = checked19(reg.worlds[0].number,a[1],submitted,true); else raw.b2World_Explode(reg.worlds[0].id,&e);
        if (status.status == game.OK) candidates = trace19(reg,id,seq);
        if (a[0] == 1u32) e = definition19(submitted);
        arguments[0] = e.maskBits.low; arguments[1] = e.maskBits.high; arguments[2] = toBits(e.position.x); arguments[3] = toBits(e.position.y); arguments[4] = toBits(e.radius); arguments[5] = toBits(e.falloff); arguments[6] = toBits(e.impulsePerLength); inCount = 7i32;
    } else if (code == 601u32) {
        let e: game.ExplosionDescription = game.defaultExplosionDescription(); result[0] = e.maskBits.low; result[1] = e.maskBits.high; result[2] = toBits(e.position.x); result[3] = toBits(e.position.y); result[4] = toBits(e.radius); result[5] = toBits(e.falloff); result[6] = toBits(e.impulsePerLength); kind = 1i32; rn = 7i32; inCount = 0i32;
    } else if (code == 602u32 or code == 603u32) {
        var s: raw.ShapeRecord = if code == 602u32 then geometry19(a) else polygon19(a); let line: math2.Vec2 = if code == 602u32 then math2.Vec2(fromBits(a[6]),fromBits(a[7])) else math2.Vec2(fromBits(a[18]),fromBits(a[19]));
        let c: math2.Vec2 = raw.b2GetShapeCentroid(&s); result[0] = toBits(raw.b2GetShapePerimeter(&s)); result[1] = toBits(raw.b2GetShapeProjectedPerimeter(&s,line)); result[2] = toBits(c.x); result[3] = toBits(c.y); arguments = shapeInput19(&s,line); kind = 2i32; rn = 4i32; inCount = 39i32;

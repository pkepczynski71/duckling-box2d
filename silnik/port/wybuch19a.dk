fun outContactSim(sim: raw.ContactSim) -> () = {
    outHex(sim.contactId as u32); outHex(sim.bodySimIndexA as u32); outHex(sim.bodySimIndexB as u32);
    outHex(sim.shapeIdA as u32); outHex(sim.shapeIdB as u32);
    outFloat(sim.invMassA); outFloat(sim.invIA); outFloat(sim.invMassB); outFloat(sim.invIB);
    outFloat(sim.friction); outFloat(sim.restitution);
    if (sim.rollingDefined) outFloat(sim.rollingResistance); else outHex(0u32);
    outFloat(sim.tangentSpeed); outHex(sim.simFlags); outHex(sim.cache.count as u32);
    var i: i32 = 0i32;
    while (i < 3i32) { outHex(sim.cache.indexA[i] as u32); i = i + 1i32; }
    var j: i32 = 0i32;
    while (j < 3i32) { outHex(sim.cache.indexB[j] as u32); j = j + 1i32; }
    outManifold(sim.manifold); outHex(sim.rollingDefined as u32);
}

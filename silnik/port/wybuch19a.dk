    outFloat(sim.center.x); outFloat(sim.center.y); outFloat(sim.localCenter.x); outFloat(sim.localCenter.y);
    outFloat(sim.rotation0.c); outFloat(sim.rotation0.s); outFloat(sim.center0.x); outFloat(sim.center0.y);
    outFloat(sim.force.x); outFloat(sim.force.y); outFloat(sim.torque); outFloat(sim.invMass); outFloat(sim.invInertia);
    outFloat(sim.minExtent); outFloat(sim.maxExtent); outFloat(sim.linearDamping); outFloat(sim.angularDamping); outFloat(sim.gravityScale);
    outHex(sim.bodyId as u32); outHex(sim.isFast as u32); outHex(0u32); outHex(sim.isSpeedCapped as u32); outHex(sim.allowFastRotation as u32); outHex(0u32);
}

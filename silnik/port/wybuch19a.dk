const SCENE_INPUT19: str = "";
fun sceneWords19(profile: i32, id: u32) -> u32[26] = {
    var p: u32[26];
    let source: cptr char = builtins.ptr_from_slice[char](SCENE_INPUT19) as cptr char;
    let base: i32 = ((if profile == 1i32 then 48i32 else 0i32)+(id as i32)-1i32)*208i32;
    var i: i32 = 0i32;
    while (i < 26i32) {
        var word: u32 = 0u32; var digit: i32 = 0i32;
        while (digit < 8i32) {
            let c: u32 = source[base+8i32*i+digit] as u32;
            word = word*16u32+(if c <= 57u32 then c-48u32 else c-87u32); digit = digit+1i32;
        }
        p[i] = word; i = i+1i32;
    }
    return p;
}
                                                                                  
extern("C") { fundecl exit(code: i32) -> (); fundecl getenv(name: cptr char) -> cptr char; }
fun fail19(reason: str) -> () = {
    let prefix19: str = "PORT19A: INPUT_"; let lf19: str = "\n";
    write(2i32,builtins.ptr_from_slice[char](prefix19) as cptr char,prefix19.length() as u64);
    write(2i32,builtins.ptr_from_slice[char](reason) as cptr char,reason.length() as u64);
    write(2i32,builtins.ptr_from_slice[char](lf19) as cptr char,1u64); exit(2i32);
}
class Line19 { bytes: i32[2048]; starts: i32[80]; ends: i32[80]; count: i32 = 0i32; }
fun read19() -> Line19 = {
    var r: Line19; var n: i32 = 0i32; var cr: bool = false; var c: i32 = io.readCharCode();
    if (c < 0i32) fail19("EOF");
    while (c >= 0i32 and c != 10i32) {
        if (cr) fail19("ASCII");
        if (c == 13i32) cr = true;
        else { if (c < 32i32 or c > 126i32) fail19("ASCII"); if (n == 2048i32) fail19("LINE_LENGTH"); r.bytes[n] = c; n = n+1i32; }
        c = io.readCharCode();
    }
    if (cr and c != 10i32) fail19("ASCII");
    if (n == 0i32 or r.bytes[0] == 32i32 or r.bytes[n-1i32] == 32i32) fail19("ASCII");
    r.starts[0] = 0i32; r.count = 1i32; var i: i32 = 0i32;
    while (i < n) {
        if (r.bytes[i] == 32i32) {
            if (r.bytes[i+1i32] == 32i32) fail19("ASCII");
            r.ends[r.count-1i32] = i; if (r.count == 80i32) fail19("ARITY");
            r.starts[r.count] = i+1i32; r.count = r.count+1i32;
        }
        i = i+1i32;
    }
    r.ends[r.count-1i32] = n; return r;
}
fun tag19(r: ref Line19, index: i32, text: str) -> bool = {
    if (index >= r.count or r.ends[index]-r.starts[index] != text.length() as i32) return false;
    let p: cptr char = builtins.ptr_from_slice[char](text) as cptr char;
    var i: i32 = 0i32; while (i < text.length() as i32) { if (r.bytes[r.starts[index]+i] != p[i] as i32) return false; i = i+1i32; } return true;
}
fun number19(r: ref Line19, index: i32, payload: bool = false) -> u32 = {
    if (index >= r.count) fail19("ARITY");
    let start: i32 = r.starts[index]; let end: i32 = r.ends[index];
    if (end-start > 1i32 and r.bytes[start] == 48i32) fail19(if payload then "WORD" else "NUMBER");
    var value: u64 = 0u64; var i: i32 = start;
    while (i < end) {
        let c: i32 = r.bytes[i]; if (c < 48i32 or c > 57i32) fail19(if payload then "WORD" else "NUMBER");
        value = value*10u64+(c-48i32) as u64; if (value > 4294967295u64) fail19(if payload then "WORD" else "NUMBER"); i = i+1i32;
    }
    return value as u32;
}
class Bank19 { saved: bool = false; view: raw.BodyView = raw.BodyView(); number: game.BodyNumber = game.BodyNumber(); }
fun zeroBanks19() -> Bank19[2] = { var a: Bank19[2]; return a; }
fun viewWords19(v: raw.BodyView) -> u32[14] = {
    var p: u32[14]; p[0] = toBits(v.linearVelocity.x); p[1] = toBits(v.linearVelocity.y); p[2] = toBits(v.angularVelocity); p[3] = v.isAwake as u32;
    p[4] = toBits(v.transform.p.x); p[5] = toBits(v.transform.p.y); p[6] = toBits(v.transform.q.c); p[7] = toBits(v.transform.q.s);
    p[8] = toBits(v.center.x); p[9] = toBits(v.center.y); p[10] = toBits(v.mass); p[11] = toBits(v.inertia); p[12] = v.isEnabled as u32; p[13] = v.bodyType as u32; return p;
}
fun outView19(v: raw.BodyView) -> () = { var p: u32[14] = viewWords19(v); var i: i32 = 0i32; while (i < 14i32) { outHex(p[i]); i = i+1i32; } }
fun outBank19(b: Bank19) -> () = { outView19(b.view); bodyNumber13(b.number); }
fun save19(reg: ref Registers) -> Bank19 = {
    let lookup: game.BodyLookup = game.lookupBody(reg.worlds[0].number,reg.bodies[0].number);
    if (lookup.status != game.OK) fail19("DOMAIN"); return Bank19(true,lookup.value,reg.bodies[0].number);
}
fun edit19(b: ref Bank19, field: u32, word: u32) -> () = {
    let f: f32 = fromBits(word);
    if (field == 0u32) b.view.linearVelocity.x = f; else if (field == 1u32) b.view.linearVelocity.y = f; else if (field == 2u32) b.view.angularVelocity = f;
    else if (field == 3u32) b.view.isAwake = word != 0u32; else if (field == 4u32) b.view.transform.p.x = f; else if (field == 5u32) b.view.transform.p.y = f;
    else if (field == 6u32) b.view.transform.q.c = f; else if (field == 7u32) b.view.transform.q.s = f; else if (field == 8u32) b.view.center.x = f; else if (field == 9u32) b.view.center.y = f;
    else if (field == 10u32) b.view.mass = f; else if (field == 11u32) b.view.inertia = f; else if (field == 12u32) b.view.isEnabled = word != 0u32; else b.view.bodyType = word as i32;
}
fun description19(a: ref u32[64]) -> game.ExplosionDescription = {
    return game.ExplosionDescription(words64.Key64(a[2],a[3]),math2.Vec2(fromBits(a[4]),fromBits(a[5])),fromBits(a[6]),fromBits(a[7]),fromBits(a[8]));
}
fun definition19(e: game.ExplosionDescription) -> raw.ExplosionDef = { return raw.ExplosionDef(e.maskBits,e.position,e.radius,e.falloff,e.impulsePerLength); }
fun outDescription19(e: raw.ExplosionDef) -> () = { outPair(e.maskBits); outFloat(e.position.x); outFloat(e.position.y); outFloat(e.radius); outFloat(e.falloff); outFloat(e.impulsePerLength); }
fun checked19(owner: game.WorldNumber, selector: u32, e: game.ExplosionDescription, invoke: bool) -> game.ChainValidation = {
    var selected: game.WorldNumber = owner; var temporary = game.WorldResult();
    var w: ref raw.World = raw.worlds.at(owner.slot as i64); let savedId: u16 = w.worldId; let savedLock: bool = w.locked;
    if (selector == 1u32) selected.slot = -1i32; else if (selector == 2u32) selected.slot = 128i32;
    else if (selector == 3u32 or selector == 4u32) {
        let old: game.WorldResult = game.createSleepWorld(math2.Vec2(),400.0f32,game.SolverWorldParameters());
        selected = old.number; game.destroyWorld(old.number);
        if (selector == 4u32) temporary = game.createSleepWorld(math2.Vec2(),400.0f32,game.SolverWorldParameters());
    } else if (selector == 5u32) w.worldId = 127u16;
    else if (selector == 6u32) selected.birthTicket.low = selected.birthTicket.low ^ 1u32;
    else if (selector == 7u32) w.locked = true;
    let result: game.ChainValidation = if invoke then game.explode(selected,e) else game.explosionPreflight(selected,e);
    w.worldId = savedId; w.locked = savedLock;
    if (temporary.status == game.OK and temporary.number.slot >= 0i32) game.destroyWorld(temporary.number);
    return result;
}
fun geometry19(a: ref u32[64]) -> raw.ShapeRecord = {
    var s = raw.ShapeRecord(); s.shapeType = a[0] as i32;
    let r: f32 = fromBits(a[1]); let hx: f32 = fromBits(a[2]); let hy: f32 = fromBits(a[3]); let x: f32 = fromBits(a[4]); let y: f32 = fromBits(a[5]);
    if (s.shapeType == 0i32) s.circle = math2.Circle(math2.Vec2(x,y),r);
    else if (s.shapeType == 1i32) s.capsule = raw.Capsule(math2.Vec2(x-hx,y-hy),math2.Vec2(x+hx,y+hy),r);
    else if (s.shapeType == 3i32) { s.polygon = mass2.b2MakeOffsetRoundedBox(hx,hy,math2.Vec2(x,y),math2.Rot(1.0f32,0.0f32),r); }
    else if (s.shapeType == 2i32) s.segment = raw.Segment(math2.Vec2(x-hx,y-hy),math2.Vec2(x+hx,y+hy));
    else s.chainSegment.segment = raw.Segment(math2.Vec2(x-hx,y-hy),math2.Vec2(x+hx,y+hy)); return s;
}
fun polygon19(a: ref u32[64]) -> raw.ShapeRecord = {
    var s = raw.ShapeRecord(); s.shapeType = 3i32; s.polygon.count = a[0] as i32; s.polygon.radius = fromBits(a[1]);
    var i: i32 = 0i32; while (i < s.polygon.count) { s.polygon.vertices[i] = math2.Vec2(fromBits(a[2i32+2i32*i]),fromBits(a[3i32+2i32*i])); i = i+1i32; }
    raw.b2MakePolygon(&s.polygon); return s;
}
fun shapeInput19(s: ref raw.ShapeRecord, line: math2.Vec2) -> u32[39] = {
    var p: u32[39]; p[0] = s.shapeType as u32; var proxy: distance.ShapeProxy = raw.b2MakeShapeDistanceProxy(s);
    p[1] = proxy.count as u32; p[2] = toBits(proxy.radius); var i: i32 = 0i32;
    while (i < proxy.count) { p[3i32+2i32*i] = toBits(proxy.points[i].x); p[4i32+2i32*i] = toBits(proxy.points[i].y); i = i+1i32; }
    if (s.shapeType == 3i32) { i = 0i32; while (i < s.polygon.count) { p[19i32+2i32*i] = toBits(s.polygon.normals[i].x); p[20i32+2i32*i] = toBits(s.polygon.normals[i].y); i = i+1i32; } p[35] = toBits(s.polygon.centroid.x); p[36] = toBits(s.polygon.centroid.y); }
    p[37] = toBits(line.x); p[38] = toBits(line.y); return p;
}
fun makeShape19(reg: ref Registers, slot: i32, parent: i32, s: raw.ShapeRecord) -> () = {
    let result: game.ShapeResult = game.addPreparedShapeFlags12(reg.worlds[0].number,reg.bodies[parent].number,s,true,s.enablePreSolveEvents);
    if (result.status != game.OK) fail19("DOMAIN"); reg.shapes[slot] = SavedShape(true,result.number,reg.worlds[0].number,result.id);

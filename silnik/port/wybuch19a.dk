        let b: game.BodyResult = game.createBody8(reg.worlds[0].number,bd); reg.bodies[1] = SavedBody(true,b.number,reg.worlds[0].number,b.id);
        var s = raw.ShapeRecord(); s.circle.radius = 0.5f32; s.enablePreSolveEvents = true;
        makeShape19(reg,1i32,1i32,s); raw.worlds.at(reg.worlds[0].number.slot as i64).shapes.at(0i64).enablePreSolveEvents = true;
        lockCount19 = 0u32; lockOwner19 = reg.worlds[0].number; lockBody19 = reg.bodies[0].id;

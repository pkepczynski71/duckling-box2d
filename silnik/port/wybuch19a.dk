                            canonicalB = if entry.primary then request.shapeIndexB else request.shapeIndexA;
                        }
                                                                                                       
                        prefix("RQ", id, seq); outDec(wi); outDec(ri as i32);
                        outHex(request.moveIndex as u32); outHex(request.shapeIndexA as u32); outHex(request.shapeIndexB as u32);
                        outHex(entry.kind as u32); outHex(entry.primary as u32); outHex((actual != -1i32) as u32);
                        outHex(actual as u32); outHex(canonicalA as u32); outHex(canonicalB as u32); newline(); lines = lines + 1i32; ri = ri + 1i64;
                    }
                } else if (group == 1i32) {
                    prefix("CP", id, seq); outDec(wi); outHex(world.contactIdPool.nextIndex as u32); outHex(world.contactIdPool.freeCount as u32);
                    outHex((world.contactIdPool.nextIndex - world.contactIdPool.freeCount) as u32); newline(); lines = 1i32;
                } else if (group == 2i32) {

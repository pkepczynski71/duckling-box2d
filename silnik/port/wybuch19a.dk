fun sameText13(left: str, right: str) -> bool = {
    if (left.length() != right.length()) return false;
    let lp: cptr char = builtins.ptr_from_slice[char](left) as cptr char; let rp: cptr char = builtins.ptr_from_slice[char](right) as cptr char;
    var ti: i64 = 0i64; while (ti < left.length()) { if (lp[ti] != rp[ti]) return false; ti = ti+1i64; } return true;
}

fun invalid(message: str) -> () = {
    if (not inputOk) return;
    if (profileB14) {
        var translatedB: char[128]; var selectedB: str = message;
        if (groupError13.length() != 0i64 and (sameText13(message,"PORT19A: INPUT_ARITY\n") or sameText13(message,"PORT19A: INPUT_ID\n") or sameText13(message,"PORT19A: INPUT_SEQ\n") or sameText13(message,"PORT19A: INPUT_SEQUENCE\n"))) selectedB = groupError13;
        let originalB: cptr char = builtins.ptr_from_slice[char](selectedB) as cptr char;
        var mbi: i64 = 0i64; while (mbi < selectedB.length()) { translatedB[mbi] = originalB[mbi]; mbi = mbi+1i64; }
        translatedB[6] = 'B'; inputOk = false; write(2i32,&translatedB as cptr char,selectedB.length() as u64); return;
    }
    if (initialC13) {
        var translatedC: char[128]; var selectedC: str = message;
        if (groupError13.length() != 0i64 and (sameText13(message,"PORT19A: INPUT_ARITY\n") or sameText13(message,"PORT19A: INPUT_ID\n") or sameText13(message,"PORT19A: INPUT_SEQ\n") or sameText13(message,"PORT19A: INPUT_SEQUENCE\n"))) selectedC = groupError13;
        let originalC: cptr char = builtins.ptr_from_slice[char](selectedC) as cptr char;
        var mc: i64 = 0i64; while (mc < selectedC.length()) { translatedC[mc] = originalC[mc]; mc = mc+1i64; }
        translatedC[6] = 'C'; inputOk = false; write(2i32,&translatedC as cptr char,selectedC.length() as u64); return;
    }
    if (initialA13) {
        var translated: char[128]; let original: cptr char = builtins.ptr_from_slice[char](message) as cptr char;
        var mi: i64 = 0i64; while (mi < message.length()) { translated[mi] = original[mi]; mi = mi+1i64; }
        translated[6] = 'A'; inputOk = false; write(2i32,&translated as cptr char,message.length() as u64); return;
    }
    if (groupError13.length() != 0i64 and (sameText13(message,"PORT19A: INPUT_ARITY\n") or sameText13(message,"PORT19A: INPUT_ID\n") or sameText13(message,"PORT19A: INPUT_SEQ\n") or sameText13(message,"PORT19A: INPUT_SEQUENCE\n"))) {
        inputOk = false; write(2i32,builtins.ptr_from_slice[char](groupError13) as cptr char,groupError13.length() as u64); return;
    }
    inputOk = false;
    write(2i32, builtins.ptr_from_slice[char](message) as cptr char, message.length() as u64);
}

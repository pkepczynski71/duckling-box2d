            let record: raw.BodyRecord = yw.bodies.at(reg.bodies[yi].number.slot as i64);
            var ys: ref raw.SolverSet = raw.b2GetSolverSet(yw, record.setIndex);
            let simY: raw.BodySim = ys.bodySims.at(record.localIndex as i64);

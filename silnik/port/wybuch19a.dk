                var li: i64 = 0i64; while (li < copies14[k].rawItems.length()) { let item: raw.JointId = copies14[k].rawItems.at(li); outHex(item.index1 as u32); outHex(item.world0 as u32); outHex(item.generation as u32); li = li+1i64; } newline();

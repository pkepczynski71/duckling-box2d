    }
    var ji: i32 = 0i32;
    while (ji < 16i32) {
        if (reg.worlds[ji].saved and game.worldStatus(reg.worlds[ji].number) == game.OK) {
            var jw: ref raw.World = raw.worlds.at(reg.worlds[ji].number.slot as i64);
            prefix("JW", id, seq); outDec(ji); outPair(jw.stepIndex); outFloat(jw.inv_h); outHex(jw.locked as u32);
            outHex(jw.endEventArrayIndex as u32); outHex(jw.bodyMoveEvents.length() as u32);
            outHex(jw.broadPhase.movePairCapacity as u32); outHex(jw.broadPhase.movePairIndex as u32); newline(); nJW = nJW + 1i32;
        }
        ji = ji + 1i32;
    }
    reg.regI8[0] = nX;
    reg.regI8[1] = nP;
    reg.regI8[2] = nT;
    reg.regI8[3] = nF;
    reg.regI8[4] = nU;
    reg.regI8[5] = nH;
    reg.regI8[6] = nY;

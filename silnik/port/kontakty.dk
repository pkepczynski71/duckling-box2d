# Box2D 8c661469, src/body.c:1811-1828. Actual game return values, in each requested phase.
fun outGameShapes(values: ref List[game.ShapeNumber], owner: game.WorldNumber, id: u32, seq: u32, phase: i32) -> () = {
    prefix("QGN", id, seq); outDec(phase); outHex(values.length() as u32); newline();
    var i: i64 = 0i64;
    while (i < values.length()) {
        let number: game.ShapeNumber = values.at(i);
        var world: ref raw.World = raw.worlds.at(owner.slot as i64);
        let saved: SavedShape = SavedShape(true, number, owner, raw.b2MakeShapeId(world, number.slot));
        prefix("QG", id, seq); outDec(phase); outDec(i as i32); outShapeHandle(saved); newline(); i = i + 1i64;
    }
}


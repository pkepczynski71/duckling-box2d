fun outCopy(saved: ref SavedCopy, id: u32, seq: u32, copySlot: i32) -> () = {
    prefix("MCN", id, seq); outDec(copySlot); outHex(saved.values.length() as u32); newline();
    var i: i64 = 0i64;
    while (i < saved.values.length()) {
        let value: game.BodyMove = saved.values.at(i);
        prefix("MC", id, seq); outDec(copySlot); outDec(i as i32);
        outHex(value.number.slot as u32); outPair(value.number.birthTicket); outPair(value.number.ownerTicket);
        outFloat(value.transform.p.x); outFloat(value.transform.p.y); outFloat(value.transform.q.c); outFloat(value.transform.q.s);
        outObject(value.hasObjectId, value.objectId); outHex(value.fellAsleep as u32); newline(); i = i + 1i64;
    }
}

# Box2D 8c661469, src/world.c:1491-1503. Only the result of a successful executed Step is read.
fun outStep(reg: ref Registers, id: u32, seq: u32, op: Operation, execution: ref Execution) -> () = {
    prefix("K", id, seq); outDec(op.a); outFloat(op.dt); outHex(op.subStepCount as u32);
    outHex(execution.rawStep.effectiveSubSteps as u32); outHex(execution.rawStep.didSolve as u32); outHex(execution.moves.length() as u32); newline();
    var i: i64 = 0i64;
    while (i < execution.moves.length()) {
        let event: raw.BodyMoveEvent = execution.moves.at(i);
        prefix("M", id, seq); outDec(op.a); outDec(i as i32);
        outHex(event.bodyId.index1 as u32); outHex(event.bodyId.world0 as u32); outHex(event.bodyId.generation as u32);
        outFloat(event.transform.p.x); outFloat(event.transform.p.y); outFloat(event.transform.q.c); outFloat(event.transform.q.s);
        outObject(event.hasObjectId, event.objectId); outHex(event.fellAsleep as u32); newline(); i = i + 1i64;
    }
}

# Box2D 8c661469, src/world.                                               
fun outState(reg: ref Registers, id: u32, seq: u32, op: Operation, execution: ref Execution) -> () = {
    var savedWorlds: i32 = 0i32;
    var savedBodies: i32 = 0i32;
    var savedShapes: i32 = 0i32;
    var liveShapes: i32 = 0i32;
    var liveWorlds: i32 = 0i32;
    var liveBodies: i32 = 0i32;
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved) {
            savedWorlds = savedWorlds + 1i32;
            prefix("V", id, seq); outDec(1i32); outDec(wi);
            outHex(raw.b2World_IsValid(reg.worlds[wi].id) as u32);
            outHex((game.worldStatus(reg.worlds[wi].number) == game.OK) as u32); newline();
        }
        wi = wi + 1i32;
    }
    var bi: i32 = 0i32;
    while (bi < 256i32) {
        if (reg.bodies[bi].saved) {
            savedBodies = savedBodies + 1i32;
            prefix("V", id, seq); outDec(2i32); outDec(bi);
            outHex(raw.b2Body_IsValid(reg.bodies[bi].id) as u32);
            outHex((game.bodyStatus(reg.bodies[bi].owner, reg.bodies[bi].number) == game.OK) as u32); newline();
        }
        bi = bi + 1i32;
    }
    var si: i32 = 0i32;
    while (si < 512i32) {
        if (reg.shapes[si].saved) {
            savedShapes = savedShapes + 1i32;
            prefix("V", id, seq); outDec(3i32); outDec(si);
            outHex(raw.b2Shape_IsValid(reg.shapes[si].id) as u32);
            outHex((game.shapeStatus(reg.shapes[si].owner, reg.shapes[si].number) == game.OK) as u32); newline();
        }
        si = si + 1i32;
    }
    wi = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            liveWorlds = liveWorlds + 1i32;
            let world: game.WorldLookup = game.lookupWorld(reg.worlds[wi].number);
            prefix("W", id, seq); outDec(wi); outWorldId(reg.worlds[wi].id);
            outPair(reg.worlds[wi].number.birthTicket);
            outFloat(world.value.gravity.x); outFloat(world.value.gravity.y);
            outFloat(world.value.maximumLinearSpeed);
            outHex(world.value.bodyCount as u32); outHex(world.value.shapeCount as u32);
            outHex(world.value.islandCount as u32); newline();
        }
        wi = wi + 1i32;
    }
    bi = 0i32;
    while (bi < 256i32) {
        if (reg.bodies[bi].saved and game.bodyStatus(reg.bodies[bi].owner, reg.bodies[bi].number) == game.OK) {
            liveBodies = liveBodies + 1i32;
            let body: game.BodyLookup = game.lookupBody(reg.bodies[bi].owner, reg.bodies[bi].number);
            prefix("B", id, seq); outDec(bi); outBodyHandle(reg.bodies[bi]);
            outHex(body.value.bodyType as u32);
            outFloat(body.value.transform.p.x); outFloat(body.value.transform.p.y);
            outFloat(body.value.transform.q.c); outFloat(body.value.transform.q.s);
            outFloat(body.value.center.x); outFloat(body.value.center.y);
            outFloat(body.value.linearVelocity.x); outFloat(body.value.linearVelocity.y);
            outFloat(body.value.angularVelocity); outFloat(body.value.mass); outFloat(body.value.inertia);
            outFloat(body.value.localCenter.x); outFloat(body.value.localCenter.y);
            outHex(body.value.shapeCount as u32); outHex(body.value.isAwake as u32);
            outHex(body.value.isEnabled as u32); outHex(body.value.fixedRotation as u32);
            outObject(body.value.hasObjectId, body.value.objectId); newline();
        }
        bi = bi + 1i32;
    }
    si = 0i32;
    while (si < 512i32) {
        if (reg.shapes[si].saved and game.shapeStatus(reg.shapes[si].owner, reg.shapes[si].number) == game.OK) {
            liveShapes = liveShapes + 1i32;
            outShapeState(reg.shapes[si], id, seq, si);
        }
        si = si + 1i32;
    }
    si = 0i32;
    while (si < 512i32) {
        if (reg.shapes[si].saved and game.shapeStatus(reg.shapes[si].owner, reg.shapes[si].number) == game.OK) outGeometry(reg.shapes[si], id, seq, si);
        si = si + 1i32;
    }
    bi = 0i32;
    while (bi < 256i32) {
        if (reg.bodies[bi].saved and game.bodyStatus(reg.bodies[bi].owner, reg.bodies[bi].number) == game.OK) {
            let bodyId: raw.BodyId = reg.bodies[bi].id;
            let bodyCount: i32 = raw.worlds.at(bodyId.world0 as i64).bodies.at((bodyId.index1-1i32) as i64).shapeCount;
            prefix("L", id, seq); outDec(bi); outHex(bodyCount as u32); outShapeList(bodyId, bodyCount); newline();
            prefix("A", id, seq); outDec(bi); outAABB(raw.b2Body_ComputeAABB(bodyId)); newline();
        }
        bi = bi + 1i32;
    }
    var nQ: i32 = 0i32;
    if (op.opcode == 21i32 and game.bodyStatus(reg.worlds[op.a].number, reg.bodies[op.b].number) == game.OK) {
        nQ = 1i32;
        let qId: raw.BodyId = reg.bodies[op.b].id;
        var qValues: List[broad.ShapeId] = raw.b2Body_GetShapes(qId, op.capacity);
        prefix("Q", id, seq); outDec(op.b); outHex(op.capacity as u32); outHex(qValues.length() as u32);
        var qi: i64 = 0i64;
        while (qi < qValues.length()) {
            let qShape: broad.ShapeId = qValues.at(qi);
            outHex(qShape.index1 as u32); outHex(qShape.world0 as u32); outHex(qShape.generation as u32); qi = qi + 1i64;
        }
        newline();
    }
    var nQGN: i32 = 0i32; var nQG: i32 = 0i32; var nSB: i32 = 0i32;
    if (op.opcode == 38i32) {
        outGameShapes(&execution.shapes.values, reg.worlds[op.a].number, id, seq, 0i32);
        nQGN = 1i32; nQG = execution.shapes.values.length() as i32;
        if (execution.status == game.OK and op.mutateCopy) {
            if (execution.shapes.values.length() >= 1i64) {
                let first: game.ShapeNumber = execution.shapes.values.at(0i64); execution.shapes.values.push(first);
                if (nQG >= 2i32) {
                    let second: game.ShapeNumber = execution.shapes.values.at(1i64);
                    execution.shapes.values.at(0i64) = second; execution.shapes.values.at(1i64) = first;
                }
            }
            outGameShapes(&execution.shapes.values, reg.worlds[op.a].number, id, seq, 1i32);
            nQG = nQG + execution.shapes.values.length() as i32;
            var again: game.ShapeList = game.getShapes(reg.worlds[op.a].number, reg.bodies[op.b].number);
            outGameShapes(&again.values, reg.worlds[op.a].number, id, seq, 2i32);
            nQG = nQG + again.values.length() as i32; nQGN = 3i32;
        }
    }
    if (op.opcode == 39i32) {
        prefix("SB", id, seq); outHex(execution.parent.status as u32); outHex((execution.parent.status == game.OK) as u32);
        if (execution.parent.status == game.OK) outBodyHandle(SavedBody(true, execution.parent.number, reg.worlds[op.a].number, execution.parent.id));
        else outNull(); newline(); nSB = 1i32;
    }
    let nK: i32 = if op.opcode == 31i32 or op.opcode == 32i32 then 1i32 else 0i32;
    if (nK == 1i32) outStep(reg, id, seq, op, execution);
    var nMCN: i32 = 0i32; var nMC: i32 = 0i32;
    if (op.opcode == 37i32 or (op.opcode == 32i32 and execution.status == game.OK)) {
        outCopy(&reg.copies[op.copySlot], id, seq, op.copySlot);
        nMCN = 1i32; nMC = reg.copies[op.copySlot].values.length() as i32;
    }
    outContactPublic(reg, id, seq, op, execution);
    outPrivate(reg, id, seq);
    outContactPrivate(reg, id, seq, op, execution);
    prefix("I8", id, seq);
    var i8index: i32 = 0i32;
    while (i8index < 10i32) { outHex(reg.regI8[i8index] as u32); i8index = i8index + 1i32; }
    newline();
    prefix("I9", id, seq);
    var i9index: i32 = 0i32;
    while (i9index < 20i32) { outHex(execution.n9[i9index] as u32); i9index = i9index + 1i32; }
    newline();
    prefix("Z8", id, seq);
    outHex(savedWorlds as u32); outHex(savedBodies as u32); outHex(savedShapes as u32);
    outHex(liveWorlds as u32); outHex(liveBodies as u32); outHex(liveShapes as u32);
    outHex(1u32); outHex(if op.opcode == 16i32 then 2u32 else 1u32);
    outHex((execution.status == game.UNSUPPORTED_PAIR) as u32);
    outHex((savedWorlds + savedBodies + savedShapes) as u32); outHex(liveWorlds as u32); outHex(liveBodies as u32);
    outHex(liveShapes as u32); outHex(liveShapes as u32); outHex(liveBodies as u32); outHex(liveBodies as u32);
    outHex(nQ as u32); outHex(nK as u32); outHex(execution.moves.length() as u32); outHex(nMCN as u32); outHex(nMC as u32);
    outHex(nQGN as u32); outHex(nQG as u32); outHex(nSB as u32); outPair(game.lastIssued); newline();
    outZ9(reg, id, seq, op, execution);
}

# Box2D 8c661469, src/world.                                                                    
fun liveBody(reg: ref Registers, slot: i32) -> bool = {
    return reg.bodies[slot].saved and game.bodyStatus(reg.bodies[slot].owner, reg.bodies[slot].number) == game.OK;
}
# Box2D 8c661469, src/world.c:1614-1644.
fun liveShape(reg: ref Registers, slot: i32) -> bool = {
    return reg.shapes[slot].saved and game.shapeStatus(reg.shapes[slot].owner, reg.shapes[slot].number) == game.OK;
}
# Box2D 8c661469, src/world.                                                                           
fun validOperation(reg: ref Registers, op: Operation) -> bool = {
    if (op.opcode == 0i32) return true;
    if (op.opcode == 1i32) return reg.worlds[op.a].saved;
    if (op.opcode == 2i32 or op.opcode == 30i32 or op.opcode == 16i32) return reg.worlds[op.b].saved;
    if (op.opcode == 10i32 or op.opcode == 17i32) return reg.worlds[op.b].saved and reg.bodies[op.c].saved;
    if (op.opcode == 31i32 or op.opcode == 32i32) return reg.worlds[op.a].saved;
    if (op.opcode == 37i32) return reg.copies[op.copySlot].saved;
    if (op.opcode == 15i32) return reg.worlds[op.a].saved and (if op.kind == 2i32 then reg.bodies[op.b].saved else reg.shapes[op.b].saved);
    if ((op.opcode >= 33i32 and op.opcode <= 36i32) or op.opcode == 38i32 or op.opcode == 3i32 or op.opcode == 4i32 or op.opcode == 5i32 or op.opcode == 13i32 or op.opcode == 21i32)
        return reg.worlds[op.a].saved and reg.bodies[op.b].saved;
    return reg.worlds[op.a].saved and reg.shapes[op.b].saved;
}

# Box2D 8c661469, src/island.c:68-76.                                               
fun checkIslands() -> bool = {
    var wi: i32 = 0i32;
    while (wi < 128i32) {
        if (raw.worlds.at(wi as i64).inUse) {
            var world: ref raw.World = raw.worlds.at(wi as i64);
            var setIndex: i32 = 0i32;
            while (setIndex <= 2i32) {
                var set: ref raw.SolverSet = raw.b2GetSolverSet(world, setIndex);
                var local: i32 = 0i32;
                var good: bool = set.islandCount >= 0i32 and set.islandCount as i64 <= set.islandSims.length();
                while (local < set.islandCount and good) {
                    let islandId: i32 = set.islandSims.at(local as i64);
                    good = islandId >= 0i32 and islandId as i64 < world.islands.length();
                    if (good) good = world.islands.at(islandId as i64).localIndex == local;
                    local = local + 1i32;
                }
                if (not good) {
                    invalid("PORT9B: INPUT_DOMAIN\n"); failureCode = 2i64; return false;
                }
                setIndex = setIndex + 2i32;
            }
        }
        wi = wi + 1i32;
    }
    return true;
}

# Box2D 8c661469, src/shape.                                                                               
fun checkShapeLists() -> bool = {
    var wi: i32 = 0i32;
    while (wi < 128i32) {
        if (raw.worlds.at(wi as i64).inUse) {
            var world: ref raw.World = raw.worlds.at(wi as i64);
            var bi: i64 = 0i64; var total: i32 = 0i32;
            while (bi < world.bodies.length()) {
                let body: raw.BodyRecord = world.bodies.at(bi);
                if (body.id != -1i32) {
                    var previous: i32 = -1i32; var slot: i32 = body.headShapeId; var count: i32 = 0i32;
                    if (body.shapeCount < 0i32) return false;
                    while (slot != -1i32) {
                        if (slot < 0i32 or slot as i64 >= world.shapes.length() or count >= body.shapeCount) return false;
                        let shape: raw.ShapeRecord = world.shapes.at(slot as i64);
                        if (shape.id != slot or shape.bodyId != bi as i32 or shape.prevShapeId != previous) return false;
                        previous = slot; slot = shape.nextShapeId; count = count + 1i32;
                    }
                    if (count != body.shapeCount) return false;
                    total = total + count;
                }
                bi = bi + 1i64;
            }
            var alive: i32 = 0i32; var si: i64 = 0i64;
            while (si < world.shapes.length()) {
                let item: raw.ShapeRecord = world.shapes.at(si);
                if (item.id != -1i32) {
                    alive = alive + 1i32;
                    if (item.id != si as i32 or item.bodyId < 0i32 or item.bodyId as i64 >= world.bodies.length()) return false;
                    if (world.bodies.at(item.bodyId as i64).id != item.bodyId) return false;
                }
                si = si + 1i64;
            }
            if (total != alive or alive != world.shapeIdPool.nextIndex-world.shapeIdPool.freeCount) return false;
        }
        wi = wi + 1i32;
    }
    return true;
}
# Box2D 8c661469, src/island.                                                                  
fun checkIntegrity() -> bool = {
    if (not checkShapeLists()) { invalid("PORT9B: INPUT_DOMAIN\n"); failureCode = 2i64; return false; }
    if (not checkDenseBodies()) { invalid("PORT9B: INPUT_DOMAIN\n"); failureCode = 2i64; return false; }
    return checkIslands();
}

# Box2D 8c661469, src/body.                                                              
fun checkDenseBodies() -> bool = {
    var wi: i32 = 0i32;
    while (wi < 128i32) {
        if (raw.worlds.at(wi as i64).inUse) {
            var world: ref raw.World = raw.worlds.at(wi as i64);
            var setIndex: i32 = 0i32; var total: i32 = 0i32;
            while (setIndex <= 2i32) {
                var set: ref raw.SolverSet = raw.b2GetSolverSet(world, setIndex);
                if (set.bodyCount < 0i32 or set.bodyCount as i64 > set.bodySims.length()) return false;
                if (setIndex == 2i32 and set.bodyCount as i64 > set.bodyStates.length()) return false;
                var local: i32 = 0i32;
                while (local < set.bodyCount) {
                    let sim: raw.BodySim = set.bodySims.at(local as i64);
                    if (sim.bodyId < 0i32 or sim.bodyId as i64 >= world.bodies.length()) return false;
                    let body: raw.BodyRecord = world.bodies.at(sim.bodyId as i64);
                    if (body.id != sim.bodyId or body.localIndex != local or body.setIndex != setIndex) return false;
                    if (not game.finiteVector(sim.transform.p) or not game.finite(sim.transform.q.c) or not game.finite(sim.transform.q.s)
                        or not game.finiteVector(sim.force) or not game.finite(sim.torque)) return false;
                    if (setIndex == 2i32) {
                        let state: raw.BodyState = set.bodyStates.at(local as i64);
                        if (not game.finiteVector(state.linearVelocity) or not game.finite(state.angularVelocity)
                            or not game.finiteVector(state.deltaPosition) or not game.finite(state.deltaRotation.c) or not game.finite(state.deltaRotation.s)) return false;
                    }
                    local = local + 1i32;
                }
                total = total + set.bodyCount; setIndex = setIndex + 2i32;
            }
            var bi: i64 = 0i64; var alive: i32 = 0i32;
            while (bi < world.bodies.length()) {
                let record: raw.BodyRecord = world.bodies.at(bi);
                if (record.id != -1i32) {
                    if (record.id != bi as i32 or (record.setIndex != 0i32 and record.setIndex != 2i32)) return false;
                    var owner: ref raw.SolverSet = raw.b2GetSolverSet(world, record.setIndex);
                    if (record.localIndex < 0i32 or record.localIndex >= owner.bodyCount) return false;
                    if (owner.bodySims.at(record.localIndex as i64).bodyId != record.id) return false;
                    alive = alive + 1i32;
                }
                bi = bi + 1i64;
            }
            if (total != alive or alive != world.bodyIdPool.nextIndex - world.bodyIdPool.freeCount) return false;
        }
        wi = wi + 1i32;
    }
    return true;
}
# Box2D 8c661469, src/world.                                                       
                                                                          
                                                                                  
fun legacyRawStep(id: raw.WorldId, dt: f32, requested: i32) -> raw.StepResult = {
    var world: ref raw.World = raw.worlds.at((id.index1 - 1u16) as i64);
    if (world.locked or dt == 0.0f32) return raw.b2World_Step(id, dt, requested);
    let capacity: i32 = world.broadPhase.movePairCapacity;
    let pairIndex: i32 = world.broadPhase.movePairIndex;
    var view: broad.CollisionView = raw.collisionView(world);
    var prepared: broad.PairUpdateResult = broad.b2PrepareBroadPhasePairs(&world.broadPhase, &view);
    var firstContact: i32 = -1i32;
    var ci: i32 = 0i32;
    while (prepared.requests.length() == 0i64 and ci < world.contactIdPool.nextIndex and firstContact == -1i32) {
        if (world.contacts.at(ci as i64).contactId != -1i32) firstContact = ci;
        ci = ci + 1i32;
    }
    world.broadPhase.movePairCapacity = capacity; world.broadPhase.movePairIndex = pairIndex;
    if (prepared.requests.length() == 0i64 and firstContact == -1i32) return raw.b2World_Step(id, dt, requested);
    var result = raw.StepResult(); result.status = game.UNSUPPORTED_PAIR;
    if (prepared.requests.length() != 0i64) {
        let first: broad.ContactRequest = prepared.requests.at(0i64);
        result.shapeA = raw.b2MakeShapeId(world, first.shapeIndexA); result.shapeB = raw.b2MakeShapeId(world, first.shapeIndexB);
    } else {
        result.shapeA = raw.b2MakeShapeId(world, world.contacts.at(firstContact as i64).shapeIdA);
        result.shapeB = raw.b2MakeShapeId(world, world.contacts.at(firstContact as i64).shapeIdB);
    }
    return result;
}
fun legacyGameStep(owner: game.WorldNumber, parameters: game.StepParameters) -> game.StepResult = {
    var result = game.StepResult(); result.status = game.worldStatus(owner);
    if (result.status != game.OK) return result;
    if (not game.validStepParameters(parameters)) { result.status = game.PARAM; return result; }
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    if (parameters.dt > 0.0f32 and not game.bodyBlocksFit(raw.b2GetSolverSet(world, 2i32).bodyCount)) return game.step(owner, parameters);
    let executed: raw.StepResult = legacyRawStep(raw.WorldId((owner.slot + 1i32) as u16, world.generation), parameters.dt, parameters.subStepCount);
    result.status = executed.status; result.effectiveSubSteps = executed.effectiveSubSteps; result.didSolve = executed.didSolve;
    if (result.status == game.UNSUPPORTED_PAIR) {
        let a: i32 = executed.shapeA.index1 - 1i32; let b: i32 = executed.shapeB.index1 - 1i32;
        result.shapeA = game.ShapeNumber(a, world.shapes.at(a as i64).birthTicket, owner.birthTicket);
        result.shapeB = game.ShapeNumber(b, world.shapes.at(b as i64).birthTicket, owner.birthTicket);
        return result;
    }
    var i: i64 = 0i64;
    while (i < world.bodyMoveEvents.length()) {
        let event: raw.BodyMoveEvent = world.bodyMoveEvents.at(i);
        let slot: i32 = event.bodyId.index1 - 1i32;
        var value = game.BodyMove();
        value.number = game.BodyNumber(slot, world.bodies.at(slot as i64).birthTicket, owner.birthTicket);
        value.transform = event.transform; value.hasObjectId = event.hasObjectId; value.objectId = event.objectId;
        value.fellAsleep = event.fellAsleep; result.values.push(value); i = i + 1i64;
    }
    return result;
}

fun runOperation(reg: ref Registers, id: u32, seq: u32, op: Operation, emit: bool) -> i32 = {
    if (not validOperation9(reg, op, id)) return -1i32;

    var status: i32 = game.OK; var kind: i32 = 0i32;
    var resultWorld = SavedWorld(); var resultBody = SavedBody(); var resultShape = SavedShape();
    var execution = Execution();
    var beforePools: PoolCounts = poolCounts();
    if (op.opcode >= 40i32) {
        if (not runContactOperation(reg, id, seq, op, &execution)) return -1i32;
        status = execution.status;
        if (op.opcode == 40i32 and status == game.OK) { resultShape = reg.shapes[op.a]; kind = 3i32; }
    } else if (op.opcode == 0i32) {
        let createdWorld: game.WorldResult = game.createWorld(op.gravity, op.maximumLinearSpeed); status = createdWorld.status;
        if (status == game.OK) {
            resultWorld = SavedWorld(true, createdWorld.number, createdWorld.id); reg.worlds[op.a] = resultWorld; kind = 1i32;
        }
    } else if (op.opcode == 1i32) {
        resultWorld = reg.worlds[op.a]; kind = 1i32; status = game.destroyWorld(resultWorld.number);
    } else if (op.opcode == 2i32) {
        let createdBody: game.BodyResult = game.createBody(reg.worlds[op.b].number, op.def); status = createdBody.status;
        if (status == game.OK) {
            resultBody = SavedBody(true, createdBody.number, reg.worlds[op.b].number, createdBody.id); reg.bodies[op.a] = resultBody; kind = 2i32;
        }
    } else if (op.opcode == 30i32) {
        var body8 = game.BodyResult();
        if (op.mode == 1i32) body8 = game.createBody8(reg.worlds[op.b].number, op.def);
        else body8 = game.createBody(reg.worlds[op.b].number, op.def);
        status = body8.status;
        if (status == game.OK) {
            resultBody = SavedBody(true, body8.number, reg.worlds[op.b].number, body8.id); reg.bodies[op.a] = resultBody; kind = 2i32;
        }
    } else if (op.opcode == 31i32 or op.opcode == 32i32) {
        resultWorld = reg.worlds[op.a]; kind = 1i32;
        if (op.opcode == 32i32) {
            execution.gameStep = legacyGameStep(resultWorld.number, game.StepParameters(op.dt, op.subStepCount));
            status = execution.gameStep.status;
            execution.rawStep.status = status;
            execution.rawStep.effectiveSubSteps = execution.gameStep.effectiveSubSteps;
            execution.rawStep.didSolve = execution.gameStep.didSolve;
            if (status == game.UNSUPPORTED_PAIR) {
                var pairWorld: ref raw.World = raw.worlds.at(resultWorld.number.slot as i64);
                execution.rawStep.shapeA = raw.b2MakeShapeId(pairWorld, execution.gameStep.shapeA.slot);
                execution.rawStep.shapeB = raw.b2MakeShapeId(pairWorld, execution.gameStep.shapeB.slot);
            }
            if (status == game.OK) {
                var retained: List[game.BodyMove];
                var retainedIndex: i64 = 0i64;
                while (retainedIndex < execution.gameStep.values.length()) {
                    let retainedMove: game.BodyMove = execution.gameStep.values.at(retainedIndex);
                    retained.push(retainedMove); retainedIndex = retainedIndex + 1i64;
                }
                reg.copies[op.copySlot].values = move retained; reg.copies[op.copySlot].saved = true;
            }
        } else {
            status = game.worldStatus(resultWorld.number);
            if (status == game.OK) {
                var stepWorld: ref raw.World = raw.worlds.at(resultWorld.number.slot as i64);
                if (not game.finite(op.dt) and op.dt > 0.0f32 and raw.b2GetSolverSet(stepWorld, 2i32).bodyCount != 0i32) {
                    invalid("PORT9B: INPUT_DOMAIN\n"); return -1i32;
                }
                if (op.dt > 0.0f32 and not game.bodyBlocksFit(raw.b2GetSolverSet(stepWorld, 2i32).bodyCount)) {
                    status = game.LIMIT;
                } else {
                    execution.rawStep = legacyRawStep(resultWorld.id, op.dt, op.subStepCount); status = execution.rawStep.status;
                }
            }
        }
        if (status == game.OK) execution.moves = raw.b2World_GetBodyEvents(resultWorld.id);
    } else if (op.opcode >= 33i32 and op.opcode <= 36i32) {
        resultBody = reg.bodies[op.b]; kind = 2i32;
        if (op.opcode == 34i32) status = game.applyAction(reg.worlds[op.a].number, resultBody.number, op.kind, op.value, op.point, op.wake);
        else if (op.opcode == 35i32 and op.mode == 1i32) status = game.setLinearVelocity(reg.worlds[op.a].number, resultBody.number, op.value);
        else if (op.opcode == 36i32 and op.mode == 1i32) status = game.setAngularVelocity(reg.worlds[op.a].number, resultBody.number, op.value.x);
        else {
            status = game.bodyStatus(reg.worlds[op.a].number, resultBody.number);
            if (status == game.OK) {
                if (op.opcode == 33i32) raw.b2Body_ApplyAction(resultBody.id, op.kind, op.value, op.point, op.wake);
                else if (op.opcode == 35i32) raw.b2Body_SetLinearVelocity(resultBody.id, op.value);
                else raw.b2Body_SetAngularVelocity(resultBody.id, op.value.x);
            }
        }
    } else if (op.opcode == 37i32) {
        status = game.OK;
    } else if (op.opcode == 38i32) {
        resultBody = reg.bodies[op.b]; kind = 2i32;
        execution.shapes = game.getShapes(reg.worlds[op.a].number, resultBody.number); status = execution.shapes.status;
    } else if (op.opcode == 39i32) {
        resultShape = reg.shapes[op.b]; kind = 3i32;
        execution.parent = game.shapeBody(reg.worlds[op.a].number, resultShape.number); status = execution.parent.status;
    } else if (op.opcode == 10i32 or op.opcode == 17i32) {
        var createdShape = game.ShapeResult();
        if (op.opcode == 10i32) createdShape = game.createShapeRaw(reg.worlds[op.b].number, reg.bodies[op.c].number, op.source, op.updateMass, op.invoke);
        else {
            createdShape.status = game.bodyStatus(reg.worlds[op.b].number, reg.bodies[op.c].number);
            if (createdShape.status == game.OK) {
                if (not op.geometryGood) createdShape.status = game.GEOMETRY;
                else if (op.tag == 4i32) createdShape = game.addBox(reg.worlds[op.b].number, reg.bodies[op.c].number,
                    game.BoxGeometry(op.halfWidth, op.halfHeight, op.localCenter, op.localRotation, op.radius), op.source, op.invoke);
                else createdShape = game.addShape(reg.worlds[op.b].number, reg.bodies[op.c].number, op.source, op.invoke);
            }
        }
        status = createdShape.status;
        if (status == game.OK) {
            resultShape = SavedShape(true, createdShape.number, reg.worlds[op.b].number, createdShape.id); reg.shapes[op.a] = resultShape; kind = 3i32;
        }
    } else if (op.opcode == 16i32) {
        var pair = game.PairResult(); pair.status = game.worldStatus(reg.worlds[op.b].number);
        if (pair.status == game.OK) {
            if (not op.geometryGood) pair.status = game.GEOMETRY;
            else if (op.tag == 4i32) pair = game.createBodyWithBox(reg.worlds[op.b].number, op.def,
                game.BoxGeometry(op.halfWidth, op.halfHeight, op.localCenter, op.localRotation, op.radius), op.source, op.invoke, op.source.hasObjectId, op.source.objectId);
            else pair = game.createBodyWithShape(reg.worlds[op.b].number, op.def, op.source, op.invoke, op.source.hasObjectId, op.source.objectId);
        }
        status = pair.status;
        if (status == game.OK) {
            resultBody = SavedBody(true, pair.body.number, reg.worlds[op.b].number, pair.body.id);
            resultShape = SavedShape(true, pair.shape.number, reg.worlds[op.b].number, pair.shape.id);
            reg.bodies[op.a] = resultBody; reg.shapes[op.c] = resultShape; kind = 2i32;
        }
    } else if (op.opcode == 3i32 or op.opcode == 4i32 or op.opcode == 5i32 or op.opcode == 13i32 or op.opcode == 21i32 or (op.opcode == 15i32 and op.kind == 2i32)) {
        resultBody = reg.bodies[op.b]; kind = 2i32;
        if (op.opcode == 3i32) status = game.destroyBody(reg.worlds[op.a].number, resultBody.number);
        else if (op.opcode == 4i32) status = game.setTransform(reg.worlds[op.a].number, resultBody.number, op.position, op.rotation);
        else if (op.opcode == 13i32) status = game.applyMassRaw(reg.worlds[op.a].number, resultBody.number);
        else if (op.opcode == 15i32) status = game.setBodyObjectId(reg.worlds[op.a].number, resultBody.number, op.source.hasObjectId, op.source.objectId);
        else status = game.bodyStatus(reg.worlds[op.a].number, resultBody.number);
    } else {
        resultShape = reg.shapes[op.b]; kind = 3i32;
        if (op.opcode == 11i32) status = game.destroyShapeRaw(reg.worlds[op.a].number, resultShape.number, op.updateMass);
        else if (op.opcode == 12i32) status = game.setDensityRaw(reg.worlds[op.a].number, resultShape.number, op.source.density, op.updateMass);
        else if (op.opcode == 14i32) status = game.shapeStatus(reg.worlds[op.a].number, resultShape.number);
        else if (op.opcode == 15i32) status = game.setShapeObjectId(reg.worlds[op.a].number, resultShape.number, op.source.hasObjectId, op.source.objectId);
        else if (op.opcode == 18i32) status = game.destroyShape(reg.worlds[op.a].number, resultShape.number);
        else status = game.setDensity(reg.worlds[op.a].number, resultShape.number, op.source.density);
    }
    if (not checkPopulation(reg, id, &beforePools)) return -1i32;
    if (not checkIntegrity()) return -1i32;
    execution.status = status;
    if (emit) {
        outEcho(id, seq, op);
        prefix("R", id, seq); outDec(0i32); outDec(status); outDec(kind);
        if (kind == 1i32) outWorldHandle(resultWorld);
        else if (kind == 2i32) outBodyHandle(resultBody);
        else if (kind == 3i32) outShapeHandle(resultShape);
        else outNull(); newline();
        if (op.opcode == 16i32) {
            prefix("R", id, seq); outDec(1i32); outDec(status); outDec(if status == game.OK then 3i32 else 0i32);
            if (status == game.OK) outShapeHandle(resultShape); else outNull(); newline();
        }
        if (status == game.UNSUPPORTED_PAIR) {
            var unsupportedWorld: ref raw.World = raw.worlds.at(reg.worlds[op.a].number.slot as i64);
            let shapeA: raw.ShapeRecord = unsupportedWorld.shapes.at((execution.rawStep.shapeA.index1 - 1i32) as i64);
            let shapeB: raw.ShapeRecord = unsupportedWorld.shapes.at((execution.rawStep.shapeB.index1 - 1i32) as i64);
            prefix("UP", id, seq); outHex(shapeA.id as u32); outPair(shapeA.birthTicket); outPair(unsupportedWorld.birthTicket);
            outHex(shapeB.id as u32); outPair(shapeB.birthTicket); outPair(unsupportedWorld.birthTicket); newline();
        }
        outState(reg, id, seq, op, &execution);
    }
    return if inputOk then status else -1i32;
}

# Box2D 8c661469, src/world.c:263. Same ascending cleanup order as the C driver.
fun cleanup(reg: ref Registers) -> () = {
    var i: i32 = 0i32;
    while (i < 16i32) {
        if (reg.worlds[i].saved and game.worldStatus(reg.worlds[i].number) == game.OK) game.destroyWorld(reg.worlds[i].number);
        i = i + 1i32;
    }
}

# Box2D 8c661469, include/box2d/types.h:81. Bit-cast smoke check from step 5.
# Box2D 8c661469, src/world.c:100.                                                           
fun checkTransport() -> bool = {
    return toBits(fromBits(2147483648u32)) == 2147483648u32
        and toBits(fromBits(1u32)) == 1u32 and toBits(fromBits(2139095039u32)) == 2139095039u32
        and fromBits(1065353216u32) == 1.0f32 and fromBits(3212836864u32) == -1.0f32;
}

# Box2D 8c661469, src/world.c:100,263.                                                    
fun main() -> i64 = {
    if (not checkTransport()) return 2i64;
    readRow();
    if (not inputOk) return 2i64;
    if (rowLength < 6i32 or rowBytes[0] != 80i32 or rowBytes[1] != 79i32 or rowBytes[2] != 82i32
        or rowBytes[3] != 84i32 or rowBytes[4] != 57i32 or rowBytes[5] != 66i32
        or (rowLength > 6i32 and rowBytes[6] != 32i32)) {
        invalid("PORT9B: INPUT_TAG\n"); return 2i64;
    }
    checkArity(2i32); rowPosition = 6i32;
    let count: u32 = readWord();
    endRow();
    if (not inputOk) return 2i64;
    if (count < 1u32 or count > 64u32) { invalid("PORT9B: INPUT_N\n"); return 2i64; }
    io.writeStr("PORT9B"); outDec(count as i32); newline();
    var caseIndex: u32 = 0u32;
    while (caseIndex < count and inputOk) {
        readTag(67i32);
        if (not inputOk) return 2i64;
        let id: u32 = readWord();
        if (not inputOk) return 2i64;
        let opCount: u32 = readWord();
        endRow();
        if (not inputOk) return 2i64;
        if (id != caseIndex + 1u32) { invalid("PORT9B: INPUT_ID\n"); return 2i64; }
        if (opCount < 1u32 or opCount > opMaximum(id)) { invalid("PORT9B: INPUT_OPCOUNT\n"); return 2i64; }
        var reg = Registers();
        io.writeStr("CASE"); outDec(id as i32); outDec(opCount as i32); newline();
        var seq: u32 = 1u32;
        while (seq <= opCount and inputOk) {
            let op: Operation = readOperation(seq);
            if (not inputOk) { cleanup(&reg); return 2i64; }
            if (runOperation(&reg, id, seq, op, true) < 0i32) { cleanup(&reg); return failureCode; }
            seq = seq + 1u32;
        }
        if (not capturesClosed(&reg)) { invalid("PORT9B: INPUT_CAPTURE_UNCLOSED\n"); cleanup(&reg); return 2i64; }
        io.writeStr("ENDCASE"); outDec(id as i32); newline();
        cleanup(&reg);
        caseIndex = caseIndex + 1u32;
    }
    checkEnd();
    if (not inputOk) return 2i64;
    io.writeStr("END"); outDec(count as i32); newline();
    return 0i64;
}

# Box2D 8c661469, include/box2d/collision.h:498-549. Exact M30 fixture transport, no geometry.
# Box2D 8c661469, src/world.c:100.                                                           
fun decodeManifold(w: ref u32[64], offset: i32) -> math2.Manifold = {
    var result = math2.Manifold();
    result.normal = math2.Vec2(fromBits(w[offset]), fromBits(w[offset + 1i32]));
    result.rollingImpulse = fromBits(w[offset + 2i32]);
    if (w[offset + 3i32] > 2u32) { invalid("PORT9B: INPUT_FIXTURE_MANIFOLD\n"); return result; }
    result.pointCount = w[offset + 3i32] as i32;
    var i: i32 = 0i32;
    while (i < 2i32) {
        let base: i32 = offset + 4i32 + 13i32 * i;
        var point: ref math2.ManifoldPoint = raw.manifoldPoint(&result, i);
        point.point = math2.Vec2(fromBits(w[base]), fromBits(w[base + 1i32]));
        point.anchorA = math2.Vec2(fromBits(w[base + 2i32]), fromBits(w[base + 3i32]));
        point.anchorB = math2.Vec2(fromBits(w[base + 4i32]), fromBits(w[base + 5i32]));
        point.separation = fromBits(w[base + 6i32]); point.normalImpulse = fromBits(w[base + 7i32]);
        point.tangentImpulse = fromBits(w[base + 8i32]); point.totalNormalImpulse = fromBits(w[base + 9i32]);
        point.normalVelocity = fromBits(w[base + 10i32]);
        if (w[base + 11i32] > 65535u32 or w[base + 12i32] > 1u32) { invalid("PORT9B: INPUT_FIXTURE_MANIFOLD\n"); return result; }
        point.id = w[base + 11i32] as u16; point.persisted = w[base + 12i32] == 1u32;
        i = i + 1i32;
    }
    var j: i32 = 0i32;
    while (j < 30i32) {
        if (j != 3i32 and j != 15i32 and j != 16i32 and j != 28i32 and j != 29i32
            and not game.finite(fromBits(w[offset + j]))) { invalid("PORT9B: INPUT_FIXTURE_MANIFOLD\n"); return result; }
        j = j + 1i32;
    }
    return result;
}
# Box2D 8c661469, src/shape.c:163-227. Decode game floats without rejecting NaN before the game guards.
fun decodeGeometry9(op: ref Operation, w: ref u32[64]) -> () = {
    var used: i32 = 0i32;
    if (op.tag == 0i32) {
        used = 3i32; op.source.circle = math2.Circle(math2.Vec2(fromBits(w[4]), fromBits(w[5])), fromBits(w[6]));
    } else if (op.tag == 1i32) {
        used = 5i32; op.source.capsule = raw.Capsule(math2.Vec2(fromBits(w[4]), fromBits(w[5])), math2.Vec2(fromBits(w[6]), fromBits(w[7])), fromBits(w[8]));
    } else if (op.tag == 2i32) {
        used = 4i32; op.source.segment = raw.Segment(math2.Vec2(fromBits(w[4]), fromBits(w[5])), math2.Vec2(fromBits(w[6]), fromBits(w[7])));
    } else if (op.tag == 3i32) {
        used = 18i32; op.source.polygon.count = w[4] as i32; op.source.polygon.radius = fromBits(w[5]);
        var i: i32 = 0i32;
        while (i < 8i32) {
            op.source.polygon.vertices[i] = math2.Vec2(fromBits(w[6i32 + 2i32 * i]), fromBits(w[7i32 + 2i32 * i]));
            if (i as u32 >= w[4] and (w[6i32 + 2i32 * i] != 0u32 or w[7i32 + 2i32 * i] != 0u32)) invalid("PORT9B: INPUT_UNUSED\n");
            i = i + 1i32;
        }
        op.geometryGood = w[4] >= 3u32 and w[4] <= 8u32;
    } else {
        used = 7i32; op.halfWidth = fromBits(w[4]); op.halfHeight = fromBits(w[5]);
        op.localCenter = math2.Vec2(fromBits(w[6]), fromBits(w[7]));
        op.localRotation = math2.Rot(fromBits(w[8]), fromBits(w[9])); op.radius = fromBits(w[10]);
        if (game.finite(op.localRotation.c) and game.finite(op.localRotation.s)) decodeRot(w[8], w[9]);
        op.geometryGood = game.validBox(game.BoxGeometry(op.halfWidth, op.halfHeight, op.localCenter, op.localRotation, op.radius));
    }
    var padding: i32 = used;
    while (padding < 40i32) {
        if (w[4i32 + padding] != 0u32) invalid("PORT9B: INPUT_UNUSED\n");
        padding = padding + 1i32;
    }
    op.source.shapeType = if op.tag == 4i32 then 3i32 else op.tag;
    if (op.mode == 0i32) {
        var fi: i32 = 0i32;
        while (fi < used) {
            if (op.tag != 3i32 or fi != 0i32) decodeFloat(w[4i32 + fi]);
            fi = fi + 1i32;
        }
        if (not game.validContactMaterial(&op.source) or not game.finite(op.source.density) or op.source.density < 0.0f32)
            invalid("PORT9B: INPUT_DOMAIN\n");
    }
}
# Box2D 8c661469, src/contact.                                                      
fun decodeContactOperation(op: ref Operation, w: ref u32[64]) -> i32 = {
    let code: i32 = op.opcode;
    if (code == 40i32) {
        op.a = registerIndex(w[0], 512u32); op.b = registerIndex(w[1], 16u32); op.c = registerIndex(w[2], 256u32);
        if (w[3] > 4u32) { invalid("PORT9B: INPUT_ENUM\n"); return 59i32; } op.tag = w[3] as i32;
        op.source.density = fromBits(w[44]); op.source.friction = fromBits(w[45]); op.source.restitution = fromBits(w[46]);
        op.source.rollingResistance = fromBits(w[47]); op.source.tangentSpeed = fromBits(w[48]); op.source.userMaterialId = w[49] as i32;
        op.source.filter = decodeFilter(w, 50i32);
        op.invoke = decodeBool(w[55], "PORT9B: INPUT_BOOL\n");
        op.source.enableContactEvents = decodeBool(w[56], "PORT9B: INPUT_BOOL\n");
        op.source.enableHitEvents = decodeBool(w[57], "PORT9B: INPUT_BOOL\n");
        op.mode = decodeBool(w[58], "PORT9B: INPUT_BOOL\n") as i32; op.updateMass = true;
        if (op.mode == 1i32 and op.source.enableHitEvents) invalid("PORT9B: INPUT_GAME_HIT\n");
        decodeGeometry9(op, w);
        return 59i32;
    }
    if (code == 50i32) {
        op.a = registerIndex(w[0], 4u32); op.mutateCopy = decodeBool(w[1], "PORT9B: INPUT_BOOL\n"); return 2i32;
    }
    op.a = registerIndex(w[0], 16u32);
    if (code >= 41i32 and code <= 45i32) return 1i32;
    if (code == 46i32) {
        op.b = registerIndex(w[1], 512u32); op.c = registerIndex(w[2], 512u32); op.d = registerIndex(w[3], 256u32); return 4i32;
    }
    if (code == 49i32) { op.b = registerIndex(w[1], 4u32); return 2i32; }
    if (code == 48i32) op.b = registerIndex(w[1], 256u32);
    else if (code == 52i32) op.b = registerIndex(w[1], 512u32);
    else op.b = registerIndex(w[1], 256u32);
    if (code == 47i32 or code == 48i32) { op.mutateCopy = decodeBool(w[2], "PORT9B: INPUT_BOOL\n"); return 3i32; }
    if (code == 53i32) { op.wake = decodeBool(w[2], "PORT9B: INPUT_BOOL\n"); return 3i32; }
    if (code == 52i32) {
        op.source.friction = fromBits(w[2]); op.source.restitution = fromBits(w[3]);
        op.source.rollingResistance = fromBits(w[4]); op.source.tangentSpeed = fromBits(w[5]); op.source.userMaterialId = w[6] as i32;
        if (not game.validContactMaterial(&op.source)) invalid("PORT9B: INPUT_DOMAIN\n"); return 7i32;
    }
    op.manifold = decodeManifold(w, 2i32); op.cache.count = w[32] as i32;
    if (w[32] > 3u32) invalid("PORT9B: INPUT_FIXTURE_CACHE\n");
    var ci: i32 = 0i32;
    while (ci < 3i32) {

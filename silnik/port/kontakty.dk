# Box2D 8c661469, src/world.c:100. Driver limits from frozen manifest families B1-B16.
fun opMaximum(id: u32) -> u32 = {
    if (CONTACT_PROFILE == 2i32) return 16u32;
    if (id <= 4u32) return 64u32;
    if (id >= 49u32 and id <= 52u32) return 256u32;
    return 128u32;
}
# Box2D 8c661469, src/world.c:487. No implicit CLOSE on end of input.
fun capturesClosed(reg: ref Registers) -> bool = {
    return reg.phase == 0i32;
}
# Box2D 8c661469, src/contact.c:186. Initialized historical registers remain valid transport sources.
fun validOperation9(reg: ref Registers, op: Operation, id: u32) -> bool = {
    var sourceGood: bool = true;
    var collision: bool = false;
    if (op.opcode >= 40i32) {
        if (op.opcode == 40i32) {
            sourceGood = reg.worlds[op.b].saved and reg.bodies[op.c].saved;
            collision = liveShape(reg, op.a);
        } else if (op.opcode == 50i32) sourceGood = reg.events[op.a].saved;
        else {
            sourceGood = reg.worlds[op.a].saved;
            if (op.opcode == 46i32) sourceGood = sourceGood and reg.shapes[op.b].saved and reg.shapes[op.c].saved;
            if (op.opcode == 47i32 or op.opcode == 51i32 or op.opcode == 53i32) sourceGood = sourceGood and reg.contacts[op.b].saved;
            if (op.opcode == 48i32) sourceGood = sourceGood and reg.bodies[op.b].saved;
            if (op.opcode == 52i32) sourceGood = sourceGood and reg.shapes[op.b].saved;
        }
    } else {
        if (op.opcode == 0i32) collision = reg.worlds[op.a].saved and game.worldStatus(reg.worlds[op.a].number) == game.OK;
        if (op.opcode == 2i32 or op.opcode == 30i32) collision = liveBody(reg, op.a);
        if (op.opcode == 10i32 or op.opcode == 17i32) collision = liveShape(reg, op.a);
        if (op.opcode == 16i32) collision = liveBody(reg, op.a) or liveShape(reg, op.c);
                                                                                         
        sourceGood = validOperation(reg, op);
    }
    if (not sourceGood) { invalid("PORT9B: INPUT_REGISTER_UNINITIALIZED\n"); return false; }
    if (collision) { invalid("PORT9B: INPUT_REGISTER_COLLISION\n"); return false; }
    if (op.opcode < 46i32 or op.opcode > 50i32) {
        if (reg.phase == 0i32) {
            if (op.opcode >= 42i32 and op.opcode <= 45i32) { invalid("PORT9B: INPUT_PHASE\n"); return false; }
        } else if (op.opcode != reg.phase + 41i32 or op.a != reg.phaseOwner) {
            invalid("PORT9B: INPUT_PHASE\n"); return false;
        }
    }
    if (op.opcode == 51i32 or op.opcode == 53i32) {
        if (game.contactStatus(reg.worlds[op.a].number, reg.contacts[op.b].number) != game.OK) { invalid("PORT9B: INPUT_DOMAIN\n"); return false; }
        if (op.opcode == 51i32) {
            let slotC: i32 = reg.contacts[op.b].number.slot;
            let slotW: i32 = reg.worlds[op.a].number.slot;
            let touching: bool = (raw.worlds.at(slotW as i64).contacts.at(slotC as i64).flags & 1u32) != 0u32;
            if (touching != (op.manifold.pointCount > 0i32)) { invalid("PORT9B: INPUT_FIXTURE_MANIFOLD\n"); return false; }
        }
    }
    if (op.opcode == 52i32 and game.shapeStatus(reg.worlds[op.a].number, reg.shapes[op.b].number) != game.OK) { invalid("PORT9B: INPUT_DOMAIN\n"); return false; }
    return true;
}
# Box2D 8c661469, src/world.                                                               
fun runContactOperation(reg: ref Registers, id: u32, seq: u32, op: Operation, execution: ref Execution) -> bool = {
    if (op.opcode == 40i32) {
        var created = game.ShapeResult();
        created.status = game.bodyStatus(reg.worlds[op.b].number, reg.bodies[op.c].number);
        if (created.status == game.OK) {
            var source: raw.ShapeRecord = op.source;
            if (op.mode == 1i32 and not game.validContactMaterial(&source)) created.status = game.PARAM;
            else if (not op.geometryGood) {
                if (op.mode == 0i32) { invalid("PORT9B: INPUT_DOMAIN\n"); return false; }
                created.status = game.GEOMETRY;
            }
            else if (op.tag == 4i32) {
                if (op.mode == 1i32) created = game.addBox(reg.worlds[op.b].number, reg.bodies[op.c].number,
                    game.BoxGeometry(op.halfWidth, op.halfHeight, op.localCenter, op.localRotation, op.radius), source, op.invoke);
                else {
                    source.polygon = mass2.b2MakeOffsetRoundedBox(op.halfWidth, op.halfHeight, op.localCenter, op.localRotation, op.radius);
                    created = game.createShapeRaw(reg.worlds[op.b].number, reg.bodies[op.c].number, source, true, op.invoke);
                }
            } else if (op.mode == 1i32) created = game.addShape(reg.worlds[op.b].number, reg.bodies[op.c].number, source, op.invoke);
            else {
                var rawGood: bool = true;
                if (op.tag == 3i32) rawGood = game.preparePolygon(&source.polygon);
                if (not rawGood or not game.validShapeGeometry(&source)) {
                                                                                       
                    let shortSegment: bool = op.tag == 2i32 and mass2.b2LengthSquared(math2.b2Sub(source.segment.point1, source.segment.point2))
                        <= math2.B2_LINEAR_SLOP * math2.B2_LINEAR_SLOP;
                    if (not shortSegment) { invalid("PORT9B: INPUT_DOMAIN\n"); return false; }
                }
                created = game.createShapeRaw(reg.worlds[op.b].number, reg.bodies[op.c].number, source, true, op.invoke);
            }
        }
        execution.status = created.status;
        if (created.status == game.OK) reg.shapes[op.a] = SavedShape(true, created.number, reg.worlds[op.b].number, created.id);
        return inputOk;
    }
    if (op.opcode == 50i32) { execution.status = game.OK; return true; }
    let owner: game.WorldNumber = reg.worlds[op.a].number;
    if (op.opcode == 46i32) {
        execution.contact = game.findContact(owner, reg.shapes[op.b].number, reg.shapes[op.c].number);
        execution.status = execution.contact.status;
        if (execution.status == game.OK) {
            if (reg.contacts[op.d].saved and contactNumberLive(reg.contacts[op.d].number)) {
                let old: game.ContactNumber = reg.contacts[op.d].number;
                let next: game.ContactNumber = execution.contact.value.number;
                if (old.slot != next.slot or not words64.equalKey(old.birthTicket, next.birthTicket) or not words64.equalKey(old.ownerTicket, next.ownerTicket)) {
                    invalid("PORT9B: INPUT_REGISTER_COLLISION\n"); return false;
                }
            }
            reg.contacts[op.d] = SavedContact(true, execution.contact.value.number);
        }
        return true;
    }
    if (op.opcode == 47i32) {
        execution.contact = game.lookupContact(owner, reg.contacts[op.b].number); execution.status = execution.contact.status; return true;
    }
    if (op.opcode == 48i32) {
        execution.contactList = game.contacts(owner, reg.bodies[op.b].number); execution.status = execution.contactList.status; return true;
    }
    if (op.opcode == 49i32) {
        var events: game.ContactEvents = game.copyContactEvents(owner); execution.status = events.status;
        if (events.status == game.OK) { reg.events[op.b].saved = true; reg.events[op.b].values = move events; }
        return true;
    }
    execution.status = game.worldStatus(owner);
    if (execution.status != game.OK) return true;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    if (op.opcode == 41i32) { raw.b2OpenContactCapture(world); reg.phase = 1i32; reg.phaseOwner = op.a; }
    else if (op.opcode == 42i32) {
        execution.pairs = game.updateContactPairs(owner); execution.status = execution.pairs.status;
        reg.phase = if execution.status == game.OK then 2i32 else 0i32;
    } else if (op.opcode == 43i32) {
        execution.taskCount = raw.b2CollideTasks(world);
        if (execution.taskCount > 0i32) { outTask(world, op.a, id, seq, execution); raw.b2CollideChanges(world); }
        reg.phase = 3i32;
    } else if (op.opcode == 44i32) { raw.b2MergeAwakeIslands(world); reg.phase = 4i32; }
    else if (op.opcode == 45i32) { raw.b2CloseContactCapture(world); reg.phase = 0i32; }
    else if (op.opcode == 51i32) {
        var sim: ref raw.ContactSim = raw.b2GetContactSim(world, world.contacts.at(reg.contacts[op.b].number.slot as i64));
        sim.manifold = op.manifold; sim.cache = op.cache;
    } else if (op.opcode == 52i32) {
        var shape: ref raw.ShapeRecord = world.shapes.at(reg.shapes[op.b].number.slot as i64);
        shape.friction = op.source.friction; shape.restitution = op.source.restitution;
        shape.rollingResistance = op.source.rollingResistance; shape.tangentSpeed = op.source.tangentSpeed; shape.userMaterialId = op.source.userMaterialId;
    } else if (op.opcode == 53i32) raw.b2DestroyContact(world, reg.contacts[op.b].number.slot, op.wake);
    return inputOk;
}


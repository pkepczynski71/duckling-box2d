}
# Box2D 8c661469, src/world.c:100. Frozen corpus limits, not engine limits or allocations.
fun familyLimit(id: u32, kind: i32) -> i32 = {
    if (CONTACT_PROFILE == 2i32) return 4i32;
    let family: u32 = (id - 1u32) / 4u32;
    if (family == 0u32) return 0i32;
    if (family == 1u32 or family == 2u32 or family == 5u32) return if kind == 2i32 then 1i32 else 2i32;
    if (family == 3u32 or family == 4u32) return 3i32;
    if (family >= 6u32 and family <= 8u32) return if kind == 2i32 then 12i32 else 8i32;
    if (family == 9u32 or family == 10u32) return if kind == 2i32 then 13i32 else 14i32;
    if (family == 11u32) return 4i32;
    if (family == 12u32) {
        if (kind == 0i32) return 65i32;
        if (kind == 1i32) return 130i32;
        return 129i32;
    }
    if (family == 13u32) {
        if (kind == 0i32) return 6i32;
        if (kind == 1i32) return 12i32;
        return 16i32;
    }
    return if kind == 0i32 then 8i32 else 16i32;
}
# Box2D 8c661469, src/world.                                                                     
fun checkPopulation(reg: ref Registers, id: u32, before: ref PoolCounts) -> bool = {
    var worlds: i32 = 0i32; var rawEvents: i64 = 0i64;
    var i: i32 = 0i32;
    while (i < 128i32) {
        if (raw.worlds.at(i as i64).inUse) {
            var world: ref raw.World = raw.worlds.at(i as i64); worlds = worlds + 1i32;
            if (world.bodyIdPool.nextIndex > before.bodies[i]) reg.totalBodySlots = reg.totalBodySlots + world.bodyIdPool.nextIndex - before.bodies[i];
            if (world.shapeIdPool.nextIndex > before.shapes[i]) reg.totalShapeSlots = reg.totalShapeSlots + world.shapeIdPool.nextIndex - before.shapes[i];
            if (world.contactIdPool.nextIndex > before.contacts[i]) reg.totalContactSlots = reg.totalContactSlots + world.contactIdPool.nextIndex - before.contacts[i];
            rawEvents = rawEvents + world.contactBeginEvents.length() + world.contactEndEvents0.length() + world.contactEndEvents1.length();
        }
        i = i + 1i32;
    }
    var savedBodies: i32 = 0i32; var savedShapes: i32 = 0i32; var copies: i64 = 0i64;
    var bi: i32 = 0i32; var si: i32 = 0i32; var ki: i32 = 0i32;
    while (bi < 256i32) { if (reg.bodies[bi].saved) savedBodies = savedBodies + 1i32; bi = bi + 1i32; }
    while (si < 512i32) { if (reg.shapes[si].saved) savedShapes = savedShapes + 1i32; si = si + 1i32; }
    while (ki < 4i32) {
        if (reg.events[ki].saved) copies = copies + reg.events[ki].values.begin.length() + reg.events[ki].values.end.length();
        ki = ki + 1i32;
    }
    let maxB: i32 = familyLimit(id, 0i32); let maxS: i32 = familyLimit(id, 1i32); let maxC: i32 = familyLimit(id, 2i32);
    if (worlds > 2i32 or reg.totalBodySlots > maxB or reg.totalShapeSlots > maxS or reg.totalContactSlots > maxC
        or savedBodies > 2i32 * maxB or savedShapes > 2i32 * maxS or rawEvents > 4i64 * maxC as i64 or copies > 8i64 * maxC as i64) {
        invalid("PORT9B: INPUT_POPULATION\n"); return false;
    }
    return true;
}


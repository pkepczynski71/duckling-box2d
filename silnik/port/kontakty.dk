fun contactNumberLive(number: game.ContactNumber) -> bool = {
    var wi: i32 = 0i32;
    while (wi < 128i32) {
        if (raw.worlds.at(wi as i64).inUse and words64.equalKey(raw.worlds.at(wi as i64).birthTicket, number.ownerTicket))
            return game.contactStatus(game.WorldNumber(wi, number.ownerTicket), number) == game.OK;
        wi = wi + 1i32;
    }
    return false;
}

        else if (tag == 1u32) geometryUsed = 5i32;
        else if (tag == 2u32) geometryUsed = 4i32;
        else if (tag == 3u32) geometryUsed = 18i32;
        else geometryUsed = 7i32;
        var gi: i32 = geometryUsed;
        while (gi < 40i32) { if (w[geometry + gi] != 0u32) { invalid("PORT9B: INPUT_UNUSED\n"); return false; } gi = gi + 1i32; }
        if (tag == 3u32) {
            var vertex: i32 = 0i32;
            while (vertex < 8i32) {
                if (vertex as u32 >= w[geometry] and (w[geometry + 2i32 + 2i32 * vertex] != 0u32 or w[geometry + 3i32 + 2i32 * vertex] != 0u32)) {
                    invalid("PORT9B: INPUT_UNUSED\n"); return false;
                }
                vertex = vertex + 1i32;
            }
        }
    }
    if ((code == 33u32 or code == 34u32) and (((w[2] == 1u32 or w[2] == 4u32) and (w[5] != 0u32 or w[6] != 0u32))
        or ((w[2] == 2u32 or w[2] == 5u32) and (w[4] != 0u32 or w[5] != 0u32 or w[6] != 0u32)))) {
        invalid("PORT9B: INPUT_UNUSED\n"); return false;
    }
    return inputOk;
}

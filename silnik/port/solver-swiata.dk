            var lane: i32 = 0i32;
            while (lane < laneCount) {
                prefix("FH10", id, index as u32); outDec(op); outDec(lane);
                if (helper.kind == 0i32 and op == 14i32) outHex(wmath.b2AllZeroW(a) as u32);
                else outFloat(wmath.laneValue(result, lane)); newline(); lines = lines + 1i32; lane = lane + 1i32;
            }

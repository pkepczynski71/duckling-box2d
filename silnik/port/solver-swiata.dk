fun outSolverTrace(context: ref raw.SolverContext, world: ref raw.World, slot: i32, id: u32, seq: u32, sub: i32, phase: i32, group: i32, execution: ref Execution) -> () = {
    if (group == 1i32) { outSolverContext(context, slot, id, seq); execution.n10[1] = execution.n10[1] + 1i32; }
    else if (group == 2i32) {

        else if (op.opcode == 35i32 and op.mode == 1i32) status = game.setLinearVelocity(reg.worlds[op.a].number, resultBody.number, op.value);
        else if (op.opcode == 36i32 and op.mode == 1i32) status = game.setAngularVelocity(reg.worlds[op.a].number, resultBody.number, op.value.x);
        else {

            resultBody = SavedBody(true, pair.body.number, reg.worlds[op.b].number, pair.body.id);
            resultShape = SavedShape(true, pair.shape.number, reg.worlds[op.b].number, pair.shape.id);
            reg.bodies[op.a] = resultBody; reg.shapes[op.c] = resultShape; kind = 2i32;
        }
    } else if (op.opcode == 3i32 or op.opcode == 4i32 or op.opcode == 5i32 or op.opcode == 13i32 or op.opcode == 21i32 or (op.opcode == 15i32 and op.kind == 2i32)) {
        resultBody = reg.bodies[op.b]; kind = 2i32;

fun outConstraint(c: raw.ContactConstraint, overflow: bool) -> () = {
    if (overflow and c.pointCount == 1i32) { outHex(1073741823u32); outHex(0u32); }
    else { outHex(4294967295u32); outHex(511u32); }
    outHex(c.contactId as u32); outHex(c.indexA as u32); outHex(c.indexB as u32); outHex(c.pointCount as u32);
    outFloat(c.normal.x); outFloat(c.normal.y); outFloat(c.invMassA); outFloat(c.invIA); outFloat(c.invMassB); outFloat(c.invIB);
    outFloat(c.friction); outFloat(c.restitution); outFloat(c.tangentSpeed);
    outFloat(c.rollingResistance); outFloat(c.rollingMass); outFloat(c.rollingImpulse); outSoftness(c.softness);
    outConstraintPoint(c.point0);
    if (overflow and c.pointCount == 1i32) { var j: i32 = 0i32; while (j < 11i32) { outHex(0u32); j = j + 1i32; } }
    else outConstraintPoint(c.point1);
}

            outHex(blk.blockType as u32); outHex(blk.colorIndex as u32); outHex(blk.startIndex as u32); outHex(blk.count as u32); newline();
            execution.n10[2] = execution.n10[2] + 1i32; ordinal = ordinal + 1i32; bi = bi + 1i64;
        }
    } else if (group == 3i32 or group == 4i32) {
        var pi: i64 = 0i64;
        while (pi < context.packets.length()) {
            var packet: ref raw.ContactPacket = context.packets.at(pi);
            var lane: i32 = 0i32;
            while (lane < 4i32) {
                let c: raw.ContactConstraint = raw.packetLane(packet, lane);
                if (group == 3i32) {
                    prefix("PK10", id, seq); outDec(slot); outDec(packet.colorIndex); outDec(packet.packetIndex); outDec(lane);
                    outHex(c.contactId as u32); outHex(c.indexA as u32); outHex(c.indexB as u32); execution.n10[3] = execution.n10[3] + 1i32;
                } else {
                    prefix("SC10", id, seq); outDec(slot); outDec(sub); outDec(phase); outDec(packet.colorIndex); outDec(packet.packetIndex); outDec(lane);
                    outConstraint(c, false); execution.n10[4] = execution.n10[4] + 1i32;
                }
                newline(); lane = lane + 1i32;
            }
            pi = pi + 1i64;
        }
        var oi: i64 = 0i64;
        while (oi < context.overflow.length()) {
            let over: raw.ContactConstraint = context.overflow.at(oi);
            if (group == 3i32) {
                prefix("PK10", id, seq); outDec(slot); outDec(11i32); outDec(oi as i32); outDec(0i32);
                outHex(over.contactId as u32); outHex(over.indexA as u32); outHex(over.indexB as u32); execution.n10[3] = execution.n10[3] + 1i32;
            } else {
                prefix("SC10", id, seq); outDec(slot); outDec(sub); outDec(phase); outDec(11i32); outDec(oi as i32); outDec(0i32);
                outConstraint(over, true); execution.n10[4] = execution.n10[4] + 1i32;
            }
            newline(); oi = oi + 1i64;
        }
    } else if (group == 5i32) {
        var bodyId: i32 = 0i32;
        while (bodyId < world.bodyIdPool.nextIndex) {
            let body: raw.BodyRecord = world.bodies.at(bodyId as i64);
            if (body.id != -1i32 and body.setIndex == 2i32) {
                let state: raw.BodyState = context.bodies.at(body.localIndex as i64);
                prefix("BV10", id, seq); outDec(slot); outDec(sub); outDec(phase); outDec(bodyId);
                outFloat(state.linearVelocity.x); outFloat(state.linearVelocity.y); outFloat(state.angularVelocity);
                outFloat(state.deltaPosition.x); outFloat(state.deltaPosition.y); outFloat(state.deltaRotation.c); outFloat(state.deltaRotation.s); newline();
                execution.n10[5] = execution.n10[5] + 1i32;
            }
            bodyId = bodyId + 1i32;
        }
    }
}

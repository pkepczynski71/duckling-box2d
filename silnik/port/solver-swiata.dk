# Box2D 8c661469, src/solver.c:1576-1669.                                                         
fun outComponentBlocks(context: ref raw.SolverContext, id: u32, seq: u32, sub: i32, phase: i32, execution: ref Execution) -> () = {
    var j: i64 = 0i64; var ordinal: i32 = 0i32;
    while (j < context.blocks.length()) {
        let blk: raw.SolverBlock = context.blocks.at(j);
        if (blk.phase == phase) {
            prefix("SB10", id, seq); outDec(0i32); outDec(sub); outDec(phase); outDec(ordinal);
            outHex(blk.blockType as u32); outHex(blk.colorIndex as u32); outHex(blk.startIndex as u32); outHex(blk.count as u32); newline();
            execution.n10[2] = execution.n10[2] + 1i32; ordinal = ordinal + 1i32;
        }
        j = j + 1i64;
    }
}

# Box2D 8c661469, src/world.                                                                                   
fun guardCount(low: u32, high: u32) -> i64 = {
    if (high > 2147483647u32) { invalid("PORT10: INPUT_DOMAIN\n"); return 0i64; }
    return ((high as i64) << 32i32) | (low as i64);
}
# Box2D 8c661469, src/world.                                                                                        
fun outGuardResult(seq: u32, helper: i32, status: i32, accepted: bool, value: i64) -> () = {
    prefix("GR10", 1u32, seq); outDec(helper); outHex(status as u32); outHex(accepted as u32);
    outHex(value as u32); outHex(((value as u64) >> 32u64) as u32); newline();
}
# Box2D 8c661469, src/world.                                                                                           
fun seedGuard(reg: ref Registers, words: ref u32[64], kind: u32, seq: u32) -> () = {
    if (kind == 4u32) { game.lastIssued = words64.Key64(words[1], words[2]); guardSeedApplied = true; return; }
    if (kind != 8u32) return;
    guardSeedApplied = true;
    let selector: u32 = words[0]; let wi: i32 = words[1] as i32; let source: i32 = words[2] as i32;
    let field: u32 = words[3]; let replacement: u32 = words[4];
    let owner: game.WorldNumber = reg.worlds[wi].number;
    var status: i32 = game.STALE;
    if (not reg.worlds[wi].saved) { invalid("PORT10: INPUT_REGISTER_UNINITIALIZED\n"); return; }
    if (selector == 0u32) {
        var number: game.WorldNumber = owner;
        if (field == 3u32) number.birthTicket.low = replacement;
        else if (field == 4u32) number.birthTicket.high = replacement;
        else if (field == 5u32) number.slot = replacement as i32;
        status = game.worldStatus(number);
    } else if (selector == 1u32) {
        if (not reg.bodies[source].saved) { invalid("PORT10: INPUT_REGISTER_UNINITIALIZED\n"); return; }
        var body: game.BodyNumber = reg.bodies[source].number;
        if (field == 1u32) body.ownerTicket.low = replacement;
        else if (field == 2u32) body.ownerTicket.high = replacement;
        else if (field == 3u32) body.birthTicket.low = replacement;
        else if (field == 4u32) body.birthTicket.high = replacement;
        else if (field == 5u32) body.slot = replacement as i32;
        status = game.bodyStatus(owner, body);
    } else if (selector == 2u32) {
        if (not reg.shapes[source].saved) { invalid("PORT10: INPUT_REGISTER_UNINITIALIZED\n"); return; }
        var shape: game.ShapeNumber = reg.shapes[source].number;
        if (field == 1u32) shape.ownerTicket.low = replacement;
        else if (field == 2u32) shape.ownerTicket.high = replacement;
        else if (field == 3u32) shape.birthTicket.low = replacement;
        else if (field == 4u32) shape.birthTicket.high = replacement;
        else if (field == 5u32) shape.slot = replacement as i32;
        status = game.shapeStatus(owner, shape);
    } else {
        if (not reg.contacts[source].saved) { invalid("PORT10: INPUT_REGISTER_UNINITIALIZED\n"); return; }
        var contact: game.ContactNumber = reg.contacts[source].number;
        if (field == 1u32) contact.ownerTicket.low = replacement;
        else if (field == 2u32) contact.ownerTicket.high = replacement;
        else if (field == 3u32) contact.birthTicket.low = replacement;
        else if (field == 4u32) contact.birthTicket.high = replacement;
        else if (field == 5u32) contact.slot = replacement as i32;
        if (game.worldStatus(owner) == game.OK) {
            var world: ref raw.World = raw.worlds.at(owner.slot as i64);
                                                                                                         
            if (field == 5u32 and contact.slot == world.contactIdPool.nextIndex and contact.slot >= 0i32 and reg.contacts[source].number.slot >= 0i32) {
                let originalSlot: i32 = reg.contacts[source].number.slot;
                if (originalSlot < world.contactIdPool.nextIndex) {
                    var seeded: raw.ContactRecord = world.contacts.at(originalSlot as i64); seeded.contactId = contact.slot;
                    while (world.contacts.length() <= contact.slot as i64) world.contacts.push(raw.ContactRecord());
                    world.contacts.at(contact.slot as i64) = seeded;
                }
            }
            if ((field == 6u32 or field == 7u32) and contact.slot >= 0i32 and contact.slot < world.contactIdPool.nextIndex) {
                let original: raw.ContactRecord = world.contacts.at(contact.slot as i64);
                if (field == 6u32) world.contacts.at(contact.slot as i64).contactId = replacement as i32;
                else world.contacts.at(contact.slot as i64).setIndex = replacement as i32;
                status = game.contactStatus(owner, contact); world.contacts.at(contact.slot as i64) = original;
            } else status = game.contactStatus(owner, contact);
        } else status = game.contactStatus(owner, contact);
    }
    outGuardResult(seq, 10i32 + selector as i32, status, status == game.OK, 0i64);
}
# Box2D 8c661469, src/world.                                                 
                                                                                                               
fun guardMain() -> i64 = {
    readNamedTag("GUARD10", 2i32); let count: u32 = readWord(); endRow();
    if (not inputOk) return 2i64;
    if (count != 1u32) { invalid("PORT10: INPUT_N\n"); return 2i64; }
    readNamedTag("G", 5i32); let id: u32 = readWord(); let kind: u32 = readWord(); let seedAfter: u32 = readWord(); let opCount: u32 = readWord(); endRow();
    if (not inputOk) return 2i64;
    if (id != 1u32) { invalid("PORT10: INPUT_ID\n"); return 2i64; }
    if (kind > 8u32 or kind == 5u32 or kind == 7u32) { invalid("PORT10: INPUT_ENUM\n"); return 2i64; }
    let operations: bool = kind == 0u32 or kind == 4u32 or kind == 8u32;
    if ((operations and (opCount < 1u32 or opCount > 16u32 or seedAfter > opCount)) or (not operations and (opCount != 0u32 or seedAfter != 0u32))) { invalid("PORT10: INPUT_OPCOUNT\n"); return 2i64; }
    readNamedTag("GA", 66i32); let gaId: u32 = readWord(); var words: u32[64] = readFixtureWords(64i32);
    if (not inputOk) return 2i64;
    if (gaId != id) { invalid("PORT10: INPUT_ID\n"); return 2i64; }
    var used: i32 = 0i32;
    if (kind == 1u32) {
        used = 11i32;
        if (words[0] >= 16u32) invalid("PORT10: INPUT_REGISTER_RANGE\n");
        if (words[1] > 1u32 or words[10] > 1u32) invalid("PORT10: INPUT_BOOL\n");
    } else if (kind == 2u32) used = 2i32;
    else if (kind == 3u32) {
        used = 5i32;
        if (words[0] > 2u32) invalid("PORT10: INPUT_ENUM\n");
        if (words[0] != 2u32 and (words[3] != 0u32 or words[4] != 0u32)) invalid("PORT10: INPUT_UNUSED\n");
    } else if (kind == 4u32) {
        used = 3i32; if (words[0] >= 16u32) invalid("PORT10: INPUT_REGISTER_RANGE\n");
    } else if (kind == 6u32) used = 4i32;
    else if (kind == 8u32) {
        used = 5i32;
        if (words[0] > 3u32 or words[3] > 7u32 or (words[0] != 3u32 and words[3] > 5u32)) invalid("PORT10: INPUT_ENUM\n");
        if (words[1] >= 16u32 or words[2] >= (if words[0] == 2u32 then 512u32 else 256u32)) invalid("PORT10: INPUT_REGISTER_RANGE\n");
        if (words[0] == 0u32 and words[2] != 0u32) invalid("PORT10: INPUT_UNUSED\n");
    }
    var unused: i32 = used; while (unused < 64i32) { if (words[unused] != 0u32) invalid("PORT10: INPUT_UNUSED\n"); unused = unused + 1i32; }
    if (not inputOk) return 2i64;
    var accepted: bool = false; var value: i64 = 0i64; var helper: i32 = 0i32;
    if (kind == 1u32) accepted = game.validSolverWorldParameters(decodeSolverParameters(&words));
    else if (kind == 2u32) { helper = 1i32; accepted = game.validStepParameters(game.StepParameters(fromBits(words[0]), words[1] as i32)); }
    else if (kind == 3u32) {
        helper = 2i32 + words[0] as i32;
        let amount: i64 = guardCount(words[1], words[2]); let added: i64 = guardCount(words[3], words[4]);
        value = amount;
        if (words[0] == 0u32) accepted = raw.b2BlocksFit(amount, 0i32);
        else if (words[0] == 1u32) accepted = game.contactBlocksFit(amount);
        else accepted = game.checkedContactSum(amount, added, &value);
    } else if (kind == 6u32) {
        helper = 9i32; var material = raw.ShapeRecord();
        material.friction = fromBits(words[0]); material.restitution = fromBits(words[1]); material.rollingResistance = fromBits(words[2]); material.tangentSpeed = fromBits(words[3]);
        accepted = game.validContactMaterial(&material);
    }
    if (not inputOk) return 2i64;
    io.writeStr("GUARD10 1\nG 1"); outDec(kind as i32); outDec(seedAfter as i32); outDec(opCount as i32); newline();
    io.writeStr("GA 1"); outFixtureWords(&words, 64i32); io.writeStr("CASE 1"); outDec(opCount as i32); newline();
    if (not operations) {
        var status: i32 = if accepted then game.OK else game.PARAM; if (kind == 3u32 and not accepted) status = game.LIMIT;
        outGuardResult(0u32, helper, status, accepted, value);
    } else {
        var reg = Registers();
        if (seedAfter == 0u32) seedGuard(&reg, &words, kind, 0u32);
        var seq: u32 = 1u32;
        while (seq <= opCount and inputOk) {
            let op: Operation = readOperation(seq);
            if (not inputOk or runOperation(&reg, id, seq, op, true) < 0i32) { cleanup(&reg); return 2i64; }
            if (seq == seedAfter) seedGuard(&reg, &words, kind, seq);
            seq = seq + 1u32;
        }
        cleanup(&reg); if (not inputOk) return 2i64;
    }
    io.writeStr("ENDCASE 1\n"); checkEnd(); if (not inputOk) return 2i64;
    io.writeStr("END 1\n"); return 0i64;
}

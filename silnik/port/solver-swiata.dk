fun readNamedTag(tag: str, arity: i32) -> () = {
    let phaseRow: bool = arity == 5i32 and tag.length() == 2i64;
    expectingPhase = phaseRow;
    readRow(); expectingPhase = false; if (not inputOk) return;
    if (phaseRow and rowLength >= 2i32 and rowBytes[0] == 70i32 and rowBytes[1] == 32i32) { invalid("PORT10: INPUT_CAPTURE_UNCLOSED\n"); return; }
    let length: i32 = tag.length() as i32;
    let characters: cptr char = builtins.ptr_from_slice[char](tag) as cptr char;
    var i: i32 = 0i32;
    if (rowLength < length or (rowLength > length and rowBytes[length] != 32i32)) { invalid("PORT10: INPUT_TAG\n"); return; }
    while (i < length) {
        if (rowBytes[i] != characters[i] as i32) { invalid("PORT10: INPUT_TAG\n"); return; }
        i = i + 1i32;
    }
    checkArity(arity); rowPosition = length;
}

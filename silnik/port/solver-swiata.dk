                                    ordinal = ordinal + 1i32;
                                }
                            }
                            owner = owner + 1i32;
                        }
                        kind = kind + 1i32;
                    }
                } else if (group == 13i32) {
                    var ei: i64 = 0i64;
                    while (ei < world.contactBeginEvents.length()) {
                        let begin: raw.ContactBeginEvent = world.contactBeginEvents.at(ei);
                        prefix("EB", id, seq); outDec(wi); outDec(ei as i32); outRawShape(begin.shapeA); outRawShape(begin.shapeB); outManifold(begin.manifold); newline();
                        lines = lines + 1i32; ei = ei + 1i64;
                    }
                } else if (group == 14i32 or group == 15i32) {
                    var endIndex: i64 = 0i64;
                    let endCount: i64 = if group == 14i32 then world.contactEndEvents0.length() else world.contactEndEvents1.length();
                    while (endIndex < endCount) {
                        var end = raw.ContactEndEvent();
                        if (group == 14i32) end = world.contactEndEvents0.at(endIndex);
                        else end = world.contactEndEvents1.at(endIndex);
                        prefix(if group == 14i32 then "EE0" else "EE1", id, seq); outDec(wi); outDec(endIndex as i32); outRawShape(end.shapeA); outRawShape(end.shapeB); newline();
                        lines = lines + 1i32; endIndex = endIndex + 1i64;
                    }
                } else if (group == 16i32) {
                    prefix("EN9", id, seq); outDec(wi); outHex(world.contactBeginEvents.length() as u32); outHex(world.contactEndEvents0.length() as u32);
                    outHex(world.contactEndEvents1.length() as u32); outHex(world.endEventArrayIndex as u32); outHex(world.contactHitEvents.length() as u32); newline(); lines = 1i32;
                }
                execution.n9[group] = execution.n9[group] + lines;
            }
            wi = wi + 1i32;
        }
        group = group + 1i32;
    }
    execution.n9[19] = seq as i32;
}

# Box2D 8c661469, src/contact.h:43-65. Destination collision checks its actual owning world.
# Box2D 8c661469, src/world.c:100.                                                           
fun contactNumberLive(number: game.ContactNumber) -> bool = {
    var wi: i32 = 0i32;
    while (wi < 128i32) {
        if (raw.worlds.at(wi as i64).inUse and words64.equalKey(raw.worlds.at(wi as i64).birthTicket, number.ownerTicket))
            return game.contactStatus(game.WorldNumber(wi, number.ownerTicket), number) == game.OK;
        wi = wi + 1i32;
    }
    return false;
}
# Box2D 8c661469, src/id_pool.h:30-33. Observer counts before and after an operation, never physical capacities.
# Box2D 8c661469, src/world.c:100.                                                           
fun zeroPoolCounts() -> i32[128] = { var values: i32[128]; return values; }
class PoolCounts {
    bodies: i32[128] = zeroPoolCounts();
    shapes: i32[128] = zeroPoolCounts();
    contacts: i32[128] = zeroPoolCounts();
}
# Box2D 8c661469, src/id_pool.h:30-33.
# Box2D 8c661469, src/world.c:100.                                                           
fun poolCounts() -> PoolCounts = {
    var result = PoolCounts(); var i: i32 = 0i32;
    while (i < 128i32) {
        if (raw.worlds.at(i as i64).inUse) {
            result.bodies[i] = raw.worlds.at(i as i64).bodyIdPool.nextIndex;
            result.shapes[i] = raw.worlds.at(i as i64).shapeIdPool.nextIndex;
            result.contacts[i] = raw.worlds.at(i as i64).contactIdPool.nextIndex;
        }
        i = i + 1i32;
    }
    return result;
}
# Box2D 8c661469, src/world.c:100. Frozen corpus limits, not engine limits or allocations.
fun familyLimit(id: u32, kind: i32) -> i32 = {
    if (CONTACT_PROFILE == 4i32) return if kind == 1i32 then 16i32 else 8i32;
    if (id >= 1u32 and id <= 12u32) {
        if (kind == 0i32) return 2i32;
        if (kind == 1i32) return 2i32;
        return 1i32;
    }
    if (id >= 13u32 and id <= 18u32) {
        if (kind == 0i32) return 3i32;
        if (kind == 1i32) return 3i32;
        return 3i32;
    }
    if (id >= 19u32 and id <= 24u32) {
        if (kind == 0i32) return 9i32;
        if (kind == 1i32) return 9i32;
        return 36i32;
    }
    if (id >= 25u32 and id <= 42u32) {
        if (kind == 0i32) return 3i32;
        if (kind == 1i32) return 3i32;
        return if id >= 31u32 and id <= 36u32 then 3i32 else 2i32;
    }
    if (id >= 43u32 and id <= 48u32) {
        if (kind == 0i32) return 4i32;
        if (kind == 1i32) return 4i32;
        return 3i32;
    }
    if (id >= 49u32 and id <= 54u32) {
        if (kind == 0i32) return 2i32;
        if (kind == 1i32) return 2i32;
        return 1i32;
    }
    if (id >= 55u32 and id <= 60u32) {
        if (kind == 0i32) return 3i32;
        if (kind == 1i32) return 3i32;
        return 2i32;
    }
    if (id >= 61u32 and id <= 72u32) {
        if (kind == 0i32) return 4i32;
        if (kind == 1i32) return 6i32;
        return 5i32;
    }
    if (id >= 73u32 and id <= 78u32) {
        if (kind == 0i32) return 6i32;
        if (kind == 1i32) return 6i32;
        return 6i32;
    }
    if (id >= 79u32 and id <= 84u32) {
        if (kind == 0i32) return 14i32;
        if (kind == 1i32) return 26i32;
        return 25i32;
    }
    if (id >= 85u32 and id <= 90u32) {
        if (kind == 0i32) return 18i32;
        if (kind == 1i32) return 34i32;
        return 33i32;
    }
    if (id >= 91u32 and id <= 96u32) {
        if (kind == 0i32) return 4i32;
        if (kind == 1i32) return 14i32;
        return 13i32;
    }
    if (id >= 97u32 and id <= 102u32) {
        if (kind == 0i32) return 70i32;
        if (kind == 1i32) return 70i32;
        return 69i32;
    }
    if (id >= 103u32 and id <= 108u32) {
        if (kind == 0i32) return 10i32;
        if (kind == 1i32) return 18i32;
        return 17i32;
    }
    if (id >= 109u32 and id <= 124u32) {
        if (kind == 0i32) return 8i32;
        if (kind == 1i32) return 16i32;
        return 8i32;
    }
    return 0i32;
}
# Box2D 8c661469, src/world.                                                                     
fun checkPopulation(reg: ref Registers, id: u32, before: ref PoolCounts) -> bool = {
    var worlds: i32 = 0i32; var rawEvents: i64 = 0i64;
    var rawHits: i64 = 0i64; var copyHits: i64 = 0i64;
    var i: i32 = 0i32;
    while (i < 128i32) {
        if (raw.worlds.at(i as i64).inUse) {
            var world: ref raw.World = raw.worlds.at(i as i64); worlds = worlds + 1i32;
            if (world.bodyIdPool.nextIndex > before.bodies[i]) reg.totalBodySlots = reg.totalBodySlots + world.bodyIdPool.nextIndex - before.bodies[i];
            if (world.shapeIdPool.nextIndex > before.shapes[i]) reg.totalShapeSlots = reg.totalShapeSlots + world.shapeIdPool.nextIndex - before.shapes[i];
            if (world.contactIdPool.nextIndex > before.contacts[i]) reg.totalContactSlots = reg.totalContactSlots + world.contactIdPool.nextIndex - before.contacts[i];
            rawEvents = rawEvents + world.contactBeginEvents.length() + world.contactEndEvents0.length() + world.contactEndEvents1.length();
            rawHits = rawHits + world.contactHitEvents.length();
        }
        i = i + 1i32;
    }
    var savedBodies: i32 = 0i32; var savedShapes: i32 = 0i32; var copies: i64 = 0i64;
    var bi: i32 = 0i32; var si: i32 = 0i32; var ki: i32 = 0i32;
    while (bi < 256i32) { if (reg.bodies[bi].saved) savedBodies = savedBodies + 1i32; bi = bi + 1i32; }
    while (si < 512i32) { if (reg.shapes[si].saved) savedShapes = savedShapes + 1i32; si = si + 1i32; }
    while (ki < 4i32) {
        if (reg.events[ki].saved) copies = copies + reg.events[ki].values.begin.length() + reg.events[ki].values.end.length();
        if (reg.events[ki].saved) copyHits = copyHits + reg.events[ki].values.hits.length();
        ki = ki + 1i32;
    }
    let maxB: i32 = familyLimit(id, 0i32); let maxS: i32 = familyLimit(id, 1i32); let maxC: i32 = familyLimit(id, 2i32);
    if (worlds > 2i32 or reg.totalBodySlots > maxB or reg.totalShapeSlots > maxS or reg.totalContactSlots > maxC
        or savedBodies > 2i32 * maxB or savedShapes > 2i32 * maxS or rawEvents > 4i64 * maxC as i64 or copies > 8i64 * maxC as i64
        or rawHits > maxC as i64 or copyHits > 4i64 * maxC as i64) {
        invalid("PORT10: INPUT_POPULATION\n"); return false;
    }
    return true;
}

# Box2D 8c661469, src/world.c:100. Transport structure validation precedes float decoding.
fun prevalidateWords(code: u32, w: ref u32[64]) -> bool = {
    var used: i32 = 0i32;
    var registers: List[i32]; var limits: List[i32]; var booleans: List[i32];
    var geometry: i32 = -1i32; var tagIndex: i32 = -1i32;
    if (code == 54u32) { used = 11i32; registers.push(0i32); limits.push(16i32); booleans.push(1i32); booleans.push(10i32); }
    else if (code == 55u32) { used = 2i32; registers.push(0i32); limits.push(16i32); booleans.push(1i32); }
    else if (code == 0u32) { used = 4i32; registers.push(0i32); limits.push(16i32); }
    else if (code == 1u32) { used = 1i32; registers.push(0i32); limits.push(16i32); }
    else if (code == 2u32 or code == 30u32) {
        used = if code == 2u32 then 11i32 else 16i32;
        registers.push(0i32); limits.push(256i32); registers.push(1i32); limits.push(16i32);
        booleans.push(10i32);
        if (code == 30u32) { booleans.push(14i32); booleans.push(15i32); }
    } else if (code == 10u32 or code == 17u32 or code == 40u32) {
        used = if code == 40u32 then 59i32 else 55i32;
        registers.push(0i32); limits.push(512i32); registers.push(1i32); limits.push(16i32); registers.push(2i32); limits.push(256i32);
        tagIndex = 3i32; geometry = if code == 40u32 then 4i32 else 15i32;
        if (code == 40u32) { booleans.push(55i32); booleans.push(56i32); booleans.push(57i32); booleans.push(58i32); }
        else { booleans.push(5i32); booleans.push(6i32); booleans.push(12i32); }
    } else if (code == 16u32) {
        used = 63i32; registers.push(0i32); limits.push(256i32); registers.push(1i32); limits.push(512i32); registers.push(2i32); limits.push(16i32);
        booleans.push(11i32); booleans.push(14i32); booleans.push(15i32); tagIndex = 12i32; geometry = 23i32;
    } else if (code == 15u32) {
        used = 6i32; registers.push(0i32); limits.push(16i32); registers.push(2i32); limits.push(if w[1] == 2u32 then 256i32 else 512i32); booleans.push(3i32);
    } else if (code == 37u32 or code == 50u32) {
        used = if code == 37u32 then 1i32 else 2i32; registers.push(0i32); limits.push(4i32);
        if (code == 50u32) booleans.push(1i32);
    } else if (code >= 41u32 and code <= 45u32) {
        used = 1i32; registers.push(0i32); limits.push(16i32);
    } else {
        registers.push(0i32); limits.push(16i32);
        if (code != 31u32 and code != 32u32) {
            registers.push(1i32);
            var objectLimit: i32 = 256i32;
            if (code == 11u32 or code == 12u32 or code == 14u32 or code == 18u32 or code == 19u32 or code == 39u32 or code == 46u32 or code == 52u32) objectLimit = 512i32;
            if (code == 49u32) objectLimit = 4i32;
            limits.push(objectLimit);
        }
        if (code == 4u32) used = 6i32;
        else if (code == 11u32 or code == 19u32 or code == 21u32 or code == 38u32 or code == 47u32 or code == 48u32 or code == 53u32) used = 3i32;
        else if (code == 12u32 or code == 32u32 or code == 36u32 or code == 46u32) used = 4i32;
        else if (code == 31u32) used = 3i32;
        else if (code == 33u32 or code == 34u32) used = 8i32;
        else if (code == 35u32) used = 5i32;
        else if (code == 51u32) used = 39i32;
        else if (code == 52u32) used = 7i32;
        else used = 2i32;
        if (code == 32u32) { registers.push(3i32); limits.push(4i32); }
        if (code == 46u32) { registers.push(2i32); limits.push(512i32); registers.push(3i32); limits.push(256i32); }
        if (code == 11u32 or code == 38u32 or code == 47u32 or code == 48u32 or code == 53u32) booleans.push(2i32);
        if (code == 12u32 or code == 36u32) booleans.push(3i32);
        if (code == 35u32) booleans.push(4i32);
        if (code == 33u32 or code == 34u32) booleans.push(7i32);
    }
    var r: i64 = 0i64;
    while (r < registers.length()) {
        let field: i32 = registers.at(r); let bound: i32 = limits.at(r);
        if (w[field] >= bound as u32) { invalid("PORT10: INPUT_REGISTER_RANGE\n"); return false; } r = r + 1i64;
    }
    var enumWord: i32 = 0i32;
    while (enumWord < 64i32) {
        var badEnum: bool = false;
        if (enumWord == tagIndex and w[enumWord] > 4u32) badEnum = true;
        if ((code == 2u32 or code == 30u32) and enumWord == 2i32 and w[2] > 2u32) badEnum = true;
        if (code == 16u32 and enumWord == 3i32 and w[3] > 2u32) badEnum = true;
        if (code == 15u32 and enumWord == 1i32 and w[1] != 2u32 and w[1] != 3u32) badEnum = true;
        if ((code == 33u32 or code == 34u32) and enumWord == 2i32 and w[2] > 5u32) badEnum = true;
        if (badEnum) { invalid("PORT10: INPUT_ENUM\n"); return false; }
        var boolIndex: i64 = 0i64;
        while (boolIndex < booleans.length()) {
            let flag: i32 = booleans.at(boolIndex);
            if (flag == enumWord and w[flag] > 1u32) { invalid("PORT10: INPUT_BOOL\n"); return false; }
            boolIndex = boolIndex + 1i64;
        }
        if (code == 17u32 and enumWord == 5i32 and w[5] != 1u32) { invalid("PORT10: INPUT_BOOL\n"); return false; }
        enumWord = enumWord + 1i32;
    }
    var i: i32 = used;
    while (i < 64i32) { if (w[i] != 0u32) { invalid("PORT10: INPUT_UNUSED\n"); return false; } i = i + 1i32; }
    if (geometry != -1i32) {
        let tag: u32 = w[tagIndex];
        var geometryUsed: i32 = 0i32;
        if (tag == 0u32) geometryUsed = 3i32;
        else if (tag == 1u32) geometryUsed = 5i32;
        else if (tag == 2u32) geometryUsed = 4i32;
        else if (tag == 3u32) geometryUsed = 18i32;
        else geometryUsed = 7i32;
        var gi: i32 = geometryUsed;
        while (gi < 40i32) { if (w[geometry + gi] != 0u32) { invalid("PORT10: INPUT_UNUSED\n"); return false; } gi = gi + 1i32; }
        if (tag == 3u32) {
            var vertex: i32 = 0i32;
            while (vertex < 8i32) {
                if (vertex as u32 >= w[geometry] and (w[geometry + 2i32 + 2i32 * vertex] != 0u32 or w[geometry + 3i32 + 2i32 * vertex] != 0u32)) {
                    invalid("PORT10: INPUT_UNUSED\n"); return false;
                }
                vertex = vertex + 1i32;
            }
        }
    }
    if ((code == 33u32 or code == 34u32) and (((w[2] == 1u32 or w[2] == 4u32) and (w[5] != 0u32 or w[6] != 0u32))
        or ((w[2] == 2u32 or w[2] == 5u32) and (w[4] != 0u32 or w[5] != 0u32 or w[6] != 0u32)))) {
        invalid("PORT10: INPUT_UNUSED\n"); return false;
    }
    return inputOk;
}

# Box2D 8c661469, src/world.c:747-771. Transport of initial values only.
fun decodeSolverParameters(w: ref u32[64]) -> game.SolverWorldParameters = {
    var result = game.SolverWorldParameters();
    result.gravity = math2.Vec2(fromBits(w[2]), fromBits(w[3])); result.maximumLinearSpeed = fromBits(w[4]);
    result.contactHertz = fromBits(w[5]); result.contactDampingRatio = fromBits(w[6]); result.maxContactPushSpeed = fromBits(w[7]);
    result.restitutionThreshold = fromBits(w[8]); result.hitEventThreshold = fromBits(w[9]); result.enableWarmStarting = w[10] != 0u32;
    return result;
}
# Box2D 8c661469, src/solver.c:1744-1752. Observation lifetime is exactly one operation.
fun clearSolverObservations() -> () = {
    var wi: i32 = 0i32;
    while (wi < 128i32) {
        if (raw.worlds.at(wi as i64).inUse) {
            raw.worlds.at(wi as i64).solverTrace = raw.SolverContext();
            raw.worlds.at(wi as i64).stepRequests.clear(); raw.worlds.at(wi as i64).stepCreated.clear();
        }
        wi = wi + 1i32;
    }
}
# Box2D 8c661469, src/solver.h:76-138. Snapshot counters, no physics inputs.
fun zeroN10() -> i32[6] = { var values: i32[6]; return values; }
# Box2D 8c661469, src/world.c:1529-1555.
fun zeroZ10() -> i32[4] = { var values: i32[4]; return values; }
# Box2D 8c661469, include/box2d/types.                                   
fun outHitCopy(events: ref game.ContactEvents, id: u32, seq: u32, slot: i32, phase: i32, execution: ref Execution) -> () = {
    prefix("HC10", id, seq); outDec(slot); outDec(phase); outHex(events.status as u32); outHex(events.hits.length() as u32); newline();
    execution.z10[2] = execution.z10[2] + 1i32;
    var j: i64 = 0i64;
    while (j < events.hits.length()) {
        let hit: game.ContactHit = events.hits.at(j);
        prefix("HG10", id, seq); outDec(slot); outDec(phase); outDec(j as i32);
        outShapeNumber(hit.shapeA); outShapeNumber(hit.shapeB);
        outFloat(hit.point.x); outFloat(hit.point.y); outFloat(hit.normal.x); outFloat(hit.normal.y); outFloat(hit.approachSpeed); newline();
        execution.z10[3] = execution.z10[3] + 1i32; j = j + 1i64;
    }
}

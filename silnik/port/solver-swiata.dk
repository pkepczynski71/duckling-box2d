        resultWorld = reg.worlds[op.a]; kind = 1i32;
        if (op.opcode == 32i32) {
            execution.gameStep = game.step(resultWorld.number, game.StepParameters(op.dt, op.subStepCount));
            status = execution.gameStep.status;
            execution.rawStep.status = status;
            execution.rawStep.effectiveSubSteps = execution.gameStep.effectiveSubSteps;
            execution.rawStep.didSolve = execution.gameStep.didSolve;
            if (status == game.UNSUPPORTED_PAIR) {
                var pairWorld: ref raw.World = raw.worlds.at(resultWorld.number.slot as i64);
                execution.rawStep.shapeA = raw.b2MakeShapeId(pairWorld, execution.gameStep.shapeA.slot);
                execution.rawStep.shapeB = raw.b2MakeShapeId(pairWorld, execution.gameStep.shapeB.slot);
            }
            if (status == game.OK) {
                var retained: List[game.BodyMove];
                var retainedIndex: i64 = 0i64;
                while (retainedIndex < execution.gameStep.values.length()) {
                    let retainedMove: game.BodyMove = execution.gameStep.values.at(retainedIndex);
                    retained.push(retainedMove); retainedIndex = retainedIndex + 1i64;
                }
                reg.copies[op.copySlot].values = move retained; reg.copies[op.copySlot].saved = true;
            }
        } else {
            status = game.worldStatus(resultWorld.number);
            if (status == game.OK) {

fun readFixtureWords(count: i32) -> u32[64] = {
    var words: u32[64]; var i: i32 = 0i32; readingPayload = true;
    while (i < count and inputOk) { words[i] = readWord(); i = i + 1i32; }
    readingPayload = false; endRow(); return words;
}

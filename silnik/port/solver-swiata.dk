        used = 11i32; op.a = w[0] as i32; op.mode = w[1] as i32;
        op.solverParameters = decodeSolverParameters(&w);
        if (op.mode == 0i32 and not game.validSolverWorldParameters(op.solverParameters)) { invalid("PORT10: INPUT_DOMAIN\n"); return op; }

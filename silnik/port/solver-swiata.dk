            prefix("FH10", id, index as u32); outDec((2i64 + 2i64 * j) as i32); outDec(0i32); outHex((j * plan.baseSize) as u32); newline();
            prefix("FH10", id, index as u32); outDec((3i64 + 2i64 * j) as i32); outDec(0i32);
            outHex((if j + 1i64 == plan.blockCount then plan.lastCount else plan.baseSize) as u32); newline(); lines = lines + 2i32; j = j + 1i64;
        }
    } else {
        let a: wmath.FloatW = helperVector(&helper.words, 0i32); let b: wmath.FloatW = helperVector(&helper.words, 4i32);
        let c: wmath.FloatW = helperVector(&helper.words, 8i32); let mask: wmath.FloatW = helperVector(&helper.words, 12i32);
        let countOps: i32 = if helper.kind == 0i32 then 15i32 else 4i32;
        var op: i32 = 0i32;
        while (op < countOps) {
            var result: wmath.FloatW = wmath.b2ZeroW();

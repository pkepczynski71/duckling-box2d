                    prefix("IP", id, seq); outDec(wi); outHex(world.islandIdPool.nextIndex as u32); outHex(world.islandIdPool.freeCount as u32);
                    outHex((world.islandIdPool.nextIndex - world.islandIdPool.freeCount) as u32); newline(); lines = 1i32;
                } else if (group == 10i32) {
                    var fi: i32 = 0i32;
                    while (fi < world.islandIdPool.freeCount) {
                        let freed: i32 = world.islandIdPool.freeArray.at(fi as i64);
                        prefix("IF", id, seq); outDec(wi); outDec(fi); outHex(freed as u32); newline(); lines = lines + 1i32; fi = fi + 1i32;
                    }
                } else if (group == 11i32) {
                    var ii: i32 = 0i32;
                    while (ii < world.islandIdPool.nextIndex) {
                        let island: raw.Island = world.islands.at(ii as i64);
                        prefix("IS", id, seq); outDec(wi); outDec(ii); outIsland(island); newline(); lines = lines + 1i32; ii = ii + 1i32;
                    }
                } else if (group == 12i32) {
                    var dense: i32 = 0i32;
                    while (dense < raw.b2GetSolverSet(world, 2i32).islandCount) {
                        let islandId: i32 = raw.b2GetSolverSet(world, 2i32).islandSims.at(dense as i64);
                        prefix("IL", id, seq); outDec(wi); outDec(0i32); outDec(2i32); outDec(dense); outHex(islandId as u32); newline(); lines = lines + 1i32; dense = dense + 1i32;
                    }
                    var kind: i32 = 1i32;
                    while (kind <= 2i32) {
                        var owner: i32 = 0i32;
                        while (owner < world.islandIdPool.nextIndex) {
                            let listIsland: raw.Island = world.islands.at(owner as i64);
                            if (listIsland.islandId != -1i32) {
                                var item: i32 = if kind == 1i32 then listIsland.headBody else listIsland.headContact;
                                var ordinal: i32 = 0i32;
                                while (item != -1i32) {

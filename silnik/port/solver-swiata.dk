fun floatHelper(op: i32, a: wmath.FloatW, b: wmath.FloatW, c: wmath.FloatW, mask: wmath.FloatW) -> wmath.FloatW = {
    if (op == 0i32) return wmath.b2ZeroW();
    if (op == 1i32) return wmath.b2SplatW(a.x);
    if (op == 2i32) return wmath.b2AddW(a, b);
    if (op == 3i32) return wmath.b2SubW(a, b);
    if (op == 4i32) return wmath.b2MulW(a, b);
    if (op == 5i32) return wmath.b2MulAddW(a, b, c);
    if (op == 6i32) return wmath.b2MulSubW(a, b, c);
    if (op == 7i32) return wmath.b2MinW(a, b);
    if (op == 8i32) return wmath.b2MaxW(a, b);
    if (op == 9i32) return wmath.b2SymClampW(a, b);
    if (op == 10i32) return wmath.b2OrW(a, b);
    if (op == 11i32) return wmath.b2GreaterThanW(a, b);
    if (op == 12i32) return wmath.b2EqualsW(a, b);
    return wmath.b2BlendW(a, b, mask);
}

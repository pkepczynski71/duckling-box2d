fun componentContact(words: ref u32[64]) -> raw.ContactSim = {
    var result = raw.ContactSim();
    result.contactId = words[0] as i32; result.bodySimIndexA = words[1] as i32; result.bodySimIndexB = words[2] as i32;
    result.shapeIdA = words[3] as i32; result.shapeIdB = words[4] as i32;
    result.invMassA = fromBits(words[5]); result.invIA = fromBits(words[6]); result.invMassB = fromBits(words[7]); result.invIB = fromBits(words[8]);
    result.friction = fromBits(words[9]); result.restitution = fromBits(words[10]); result.rollingResistance = fromBits(words[11]); result.tangentSpeed = fromBits(words[12]);
    result.simFlags = words[13]; result.cache.count = words[14] as i32;
    var j: i32 = 0i32;
    if (words[14] > 3u32) { invalid("PORT10: INPUT_FIXTURE_CACHE\n"); return result; }
    while (j < 3i32) {
        if (words[15i32 + j] > 255u32 or words[18i32 + j] > 255u32) { invalid("PORT10: INPUT_FIXTURE_CACHE\n"); return result; }
        result.cache.indexA[j] = words[15i32 + j] as i32; result.cache.indexB[j] = words[18i32 + j] as i32; j = j + 1i32;
    }
    result.manifold = decodeManifold(words, 21i32);
    if (result.manifold.pointCount == 0i32) invalid("PORT10: INPUT_FIXTURE_MANIFOLD\n");
    result.rollingDefined = true; return result;
}

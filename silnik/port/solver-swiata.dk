                let q: wmath.RotW = wmath.RotW(a, b); let v: wmath.Vec2W = wmath.Vec2W(c, mask);
                if (op == 0i32) result = wmath.b2RotateVectorW(q, v).X;
                else if (op == 1i32) result = wmath.b2RotateVectorW(q, v).Y;
                else if (op == 2i32) result = wmath.b2DotW(v, v);
                else result = wmath.b2CrossW(v, v);
            }

                            if (domain == 1i32) count = world.constraintGraph.colors[index].contactCount;
                            if (group == 4i32) {
                                prefix("CA", id, seq); outDec(wi); outDec(domain); outDec(index); outHex(count as u32); newline(); lines = lines + 1i32;
                            } else {
                                var local: i32 = 0i32;

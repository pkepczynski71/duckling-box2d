                                    else sim = world.constraintGraph.colors[index].contactSims.at(local as i64);
                                    prefix("CS", id, seq); outDec(wi); outDec(domain); outDec(index); outDec(local); outContactSim(sim); newline();
                                    lines = lines + 1i32; local = local + 1i32;

    var savedBodies: i32 = 0i32;
    var savedShapes: i32 = 0i32;
    var liveShapes: i32 = 0i32;
    var liveWorlds: i32 = 0i32;
    var liveBodies: i32 = 0i32;
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved) {
            savedWorlds = savedWorlds + 1i32;
            prefix("V", id, seq); outDec(1i32); outDec(wi);
            outHex(raw.b2World_IsValid(reg.worlds[wi].id) as u32);
            outHex((game.worldStatus(reg.worlds[wi].number) == game.OK) as u32); newline();
        }

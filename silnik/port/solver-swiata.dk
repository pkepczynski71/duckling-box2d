    var ki: i32 = 0i32;
    while (ki < 4i32) { if (reg.events[ki].saved) copies = copies + 1i32; ki = ki + 1i32; }
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
            live = live + world.contactIdPool.nextIndex - world.contactIdPool.freeCount;
        }
        wi = wi + 1i32;
    }
    prefix("Z9", id, seq); outHex(saved as u32); outHex(live as u32); outHex(copies as u32);
    var counter: i32 = 3i32;
    while (counter < 10i32) { outHex(execution.z9[counter] as u32); counter = counter + 1i32; }

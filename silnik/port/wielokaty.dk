import fizyka.kola as physics;
import fizyka.wielokaty as polygons;
import core.builtins as builtins;
import core.primitive_io as io;

                                                                                     
extern("C") {
    fundecl write(fd: i32, buffer: cptr char, count: u64) -> i64;
}

var inputOk = true;
var inputEnded = false;

                                                                                  
                                                            
fun fromBits(word: u32) -> f32 = {
    var raw: u32 = word;
    let value: f32 = (&raw as cptr f32)[0];
    return value;
}

                                                                               
fun toBits(value: f32) -> u32 = {
    var raw: f32 = value;
    let word: u32 = (&raw as cptr u32)[0];
    return word;
}

fun error(message: str) -> () = {
    write(2i32, builtins.ptr_from_slice[char](message) as cptr char, message.length() as u64);
}

fun checkBits(word: u32, expected: f32, label: str) -> bool = {
    let decoded: f32 = fromBits(word);
                                                                    
    if (decoded != expected or toBits(expected) != word or toBits(decoded) != word) {
        error("BLAD samosprawdzenia f32 <-> u32: ");
        error(label);
        error("; E72d1df2d36c6 Ee015828237b8 E118553a0da6a E95d3b17f0fb1 Ede7d1b721a1e E2f2457405c54.\n");
        return false;
    }
    return true;
}

fun checkTransport() -> bool = {
    if (not checkBits(0u32, 0.0f32, "+zero")) return false;
    if (not checkBits(2147483648u32, -0.0f32, "-zero")) return false;
    if (not checkBits(1065353216u32, 1.0f32, "+1")) return false;
    if (not checkBits(3212836864u32, -1.0f32, "-1")) return false;
    if (not checkBits(1u32, 1.401298464324817e-45f32, "najmniejsza podnormalna")) return false;
    if (not checkBits(2139095039u32, 3.4028234663852886e38f32, "najwieksza skonczona")) return false;
                                                                              
    if (not checkBits(1073825710u32, 2.02f32, "prog: 0x400147ae")) return false;
    if (not checkBits(1058642330u32, 0.6f32, "obrot: 0x3f19999a")) return false;
    if (not checkBits(1061997773u32, 0.8f32, "obrot: 0x3f4ccccd")) return false;
    if (not checkBits(813694976u32, 0.000000000931322574615478515625f32, "mala skala: 0x30800000")) return false;
    return true;
}

fun blank(c: i32) -> bool = {
    return c == 32i32 or c == 9i32 or c == 10i32 or c == 13i32;
}

                                                                           
                                                                               
fun readWord(allowEnd: bool) -> u32 = {
    if (not inputOk) return 0u32;
    var c: i32 = io.readCharCode();
    while (blank(c)) c = io.readCharCode();
    if (c < 0i32 and allowEnd) {
        inputEnded = true;
        return 0u32;
    }
    if (c < 48i32 or c > 57i32) {
        error("BLAD E95d3b17f0fb1: E946d517eef62 Edcd4a212f815 E68c534c16ec7 u32 (Ed0afe5ed2bd6 Ee67a21a6ca9a Efc403754e0b0).\n");
        inputOk = false;
        return 0u32;
    }
    var value: u64 = 0u64;
    var digits: i32 = 0i32;
    while (c >= 48i32 and c <= 57i32) {
        value = value * 10u64 + (c - 48i32) as u64;
        digits = digits + 1i32;
        if (digits > 10i32 or value > 4294967295u64) {
            error("BLAD E95d3b17f0fb1: E8dc44deebc2b Ea277b9950b3a E0a0f9d1b1051 u32.\n");
            inputOk = false;
            return 0u32;
        }
        c = io.readCharCode();
    }
    if (c >= 0i32 and not blank(c)) {
        error("BLAD E95d3b17f0fb1: Ec00d78b6d8c2 Ee41ba6702c93 E6199aecf23ab E13832048fccd.\n");
        inputOk = false;
    }
    return value as u32;
}

fun readFloat() -> f32 = {
    return fromBits(readWord(false));
}

                                                                                 
fun outUnsigned(x: u64) -> () = {
    if (x >= 10u64) outUnsigned(x / 10u64);
    io.writeChar(('0' as u64 + x % 10u64) as char);
}

                                                                       
fun outWord(x: u32) -> () = {
    io.writeChar(' ');
    outUnsigned(x as u64);
}

fun outFloat(x: f32) -> () = {
    outWord(toBits(x));
}

fun outVec(v: physics.Vec2) -> () = {
    outFloat(v.x);
    outFloat(v.y);
}

fun outPoint(p: physics.ManifoldPoint) -> () = {
    outVec(p.point);
    outVec(p.anchorA);
    outVec(p.anchorB);
    outFloat(p.separation);
    outFloat(p.normalImpulse);
    outFloat(p.tangentImpulse);
    outFloat(p.totalNormalImpulse);
    outFloat(p.normalVelocity);
    outWord(p.id as u32);
    outWord(p.persisted as u32);
}

                                                                        
class CollisionCase {
    id: u32 = 0u32;
    a: polygons.Polygon = polygons.Polygon();
    xfA: physics.Transform = physics.Transform();
    b: polygons.Polygon = polygons.Polygon();
    xfB: physics.Transform = physics.Transform();
}

fun readPolygon() -> polygons.Polygon = {
    var polygon = polygons.Polygon();
    let count: u32 = readWord(false);
    if (count < 3u32 or count > 8u32) {
        error("BLAD E95d3b17f0fb1: count Eb557099e9efd Ea277b9950b3a E0a0f9d1b1051 3..8.\n");
        inputOk = false;
        return polygon;
    }
    polygon.count = count as i32;
    var vertexIndex: i32 = 0i32;
    while (vertexIndex < 8i32) {
                                                  
        let vx: f32 = readFloat();
        let vy: f32 = readFloat();
        polygon.vertices[vertexIndex] = physics.Vec2(vx, vy);
        if (vertexIndex >= polygon.count and (toBits(vx) != 0u32 or toBits(vy) != 0u32)) {
            error("BLAD E95d3b17f0fb1: E36e243bfdfc3 Eba767e0bf6ae Ea43a7f557364 E969da1ced5b4 E256b5bfef295 0.\n");
            inputOk = false;
        }
        vertexIndex = vertexIndex + 1i32;
    }
    var normalIndex: i32 = 0i32;
    while (normalIndex < 8i32) {
        let nx: f32 = readFloat();
        let ny: f32 = readFloat();
        polygon.normals[normalIndex] = physics.Vec2(nx, ny);
        if (normalIndex >= polygon.count and (toBits(nx) != 0u32 or toBits(ny) != 0u32)) {
            error("BLAD E95d3b17f0fb1: E6aadc84cc045 Efa7ebcfc1225 Ea43a7f557364 E969da1ced5b4 E256b5bfef295 0.\n");
            inputOk = false;
        }
        normalIndex = normalIndex + 1i32;
    }
    let cx: f32 = readFloat();
    let cy: f32 = readFloat();
    polygon.centroid = physics.Vec2(cx, cy);
    polygon.radius = readFloat();
    return polygon;
}

fun readTransform() -> physics.Transform = {
    let px: f32 = readFloat();
    let py: f32 = readFloat();
    let qc: f32 = readFloat();
    let qs: f32 = readFloat();
    return physics.Transform(physics.Vec2(px, py), physics.Rot(qc, qs));
}

fun outPolygon(polygon: ref polygons.Polygon) -> () = {
    outWord(polygon.count as u32);
    var vertexIndex: i32 = 0i32;
    while (vertexIndex < 8i32) {
        outVec(polygon.vertices[vertexIndex]);
        vertexIndex = vertexIndex + 1i32;
    }
    var normalIndex: i32 = 0i32;
    while (normalIndex < 8i32) {
        outVec(polygon.normals[normalIndex]);
        normalIndex = normalIndex + 1i32;
    }
    outVec(polygon.centroid);
    outFloat(polygon.radius);
}

fun outTransform(xf: physics.Transform) -> () = {
    outVec(xf.p);
    outFloat(xf.q.c);
    outFloat(xf.q.s);
}

fun main() -> i64 = {
    if (not checkTransport()) return 2i64;
    var cases: List[CollisionCase];
    var expectedId: u32 = 1u32;
    while (not inputEnded and inputOk) {
        let id: u32 = readWord(true);
        if (not inputEnded and inputOk) {
            if (id != expectedId) {
                error("BLAD E95d3b17f0fb1: E1f8f60ae0d6e E1b718fda965b E50859da331a8 Ec035e2494c97 E32f30ea0e83c 1.\n");
                return 3i64;
            }
            var record = CollisionCase();
            record.id = id;
            record.a = readPolygon();
            record.xfA = readTransform();
            record.b = readPolygon();
            record.xfB = readTransform();
            if (not inputOk) return 3i64;
            cases.push(move record);
            expectedId = expectedId + 1u32;
        }
    }
    if (not inputOk) return 3i64;
    let count: i64 = cases.length();
    if (count == 0i64) {
        error("BLAD E95d3b17f0fb1: E946d517eef62 E7ef3142429d2.\n");
        return 3i64;
    }
    io.writeStr("PORT2");
    outWord(count as u32);
    io.writeChar('\n');
    var caseIndex: i64 = 0i64;
    while (caseIndex < count) {
                                                                          
        var current: CollisionCase = cases.at(caseIndex);
        let result: physics.Manifold = polygons.b2CollidePolygons(&current.a, current.xfA, &current.b, current.xfB);
        io.writeChar('R');
        outWord(current.id);
                                                                                 
        outPolygon(&current.a);
        outTransform(current.xfA);
        outPolygon(&current.b);
        outTransform(current.xfB);
        outWord(result.pointCount as u32);
        outVec(result.normal);
        outFloat(result.rollingImpulse);
        outPoint(result.point0);
        outPoint(result.point1);
        io.writeChar('\n');
        caseIndex = caseIndex + 1i64;
    }
    io.writeStr("END");
    outWord(count as u32);
    io.writeChar('\n');
    return 0i64;
}

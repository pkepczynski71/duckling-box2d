class Vec19 { x: f32 = 0.0f32; y: f32 = 0.0f32; }
class Mask19 { low: u32 = 4294967295u32; high: u32 = 4294967295u32; }
class Explosion19 {
    maskBits: Mask19 = Mask19();
    position: Vec19 = Vec19();
    radius: f32 = 0.0f32;
    falloff: f32 = 0.0f32;
    impulsePerLength: f32 = 0.0f32;
}
fun bits19(value: f32) -> u32 = { var localValue: f32 = value; return (&localValue as cptr u32)[0]; }
fun hex19(value: u32) -> () = {
    io.writeChar(' '); var shift: i32 = 28i32;
    while (shift >= 0i32) {
        let digit: u32 = (value >> shift as u32)&15u32;
        io.writeChar((if digit < 10u32 then 48u32+digit else 87u32+digit) as char);
        shift = shift-4i32;
    }
}
fun lf19() -> () = { io.writeChar('\n'); }
fun defaultWords19(value: Explosion19) -> () = {
    hex19(value.maskBits.low); hex19(value.maskBits.high);
    hex19(bits19(value.position.x)); hex19(bits19(value.position.y));
    hex19(bits19(value.radius)); hex19(bits19(value.falloff)); hex19(bits19(value.impulsePerLength));
}

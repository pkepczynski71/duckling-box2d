        di = di + 1i32;
    }
    var ri: i32 = 0i32;
    while (ri < 16i32) {
        if (reg.worlds[ri].saved and game.worldStatus(reg.worlds[ri].number) == game.OK) {
            var rw: ref raw.World = raw.worlds.at(reg.worlds[ri].number.slot as i64);
            var tt: i32 = 0i32;
            while (tt < 3i32) {
                var rt: ref tree.DynamicTree = &rw.broadPhase.trees[tt];
                prefix("RT", id, seq); outDec(ri); outDec(tt);
                outHex(rt.root as u32); outHex(rt.nodeCount as u32); outHex(rt.nodeCapacity as u32); outHex(rt.freeList as u32);
                outHex(rt.proxyCount as u32); outHex(tree.b2DynamicTree_GetHeight(rt) as u32);
                outFloat(tree.b2DynamicTree_GetAreaRatio(rt)); outAABB(tree.b2DynamicTree_GetRootBounds(rt)); newline();
                nRT = nRT + 1i32; tt = tt + 1i32;
            }

            outFloat(stateY.deltaRotation.c); outFloat(stateY.deltaRotation.s);
            outHex(simY.isSpeedCapped as u32); outHex(record.isSpeedCapped as u32); outHex(record.bodyMoveIndex as u32);
            outHex(record.setIndex as u32); outHex(record.localIndex as u32);
            outFloat(simY.linearDamping); outFloat(simY.angularDamping); outFloat(simY.gravityScale);
            outHex(simY.allowFastRotation as u32); outHex(simY.isFast as u32); newline(); nY = nY + 1i32;
        }
        yi = yi + 1i32;
    }
    var di: i32 = 0i32;
    while (di < 16i32) {
        if (reg.worlds[di].saved and game.worldStatus(reg.worlds[di].number) == game.OK) {
            var dw: ref raw.World = raw.worlds.at(reg.worlds[di].number.slot as i64);
            var dense: i32 = 0i32;
            while (dense < raw.b2GetSolverSet(dw, 2i32).bodyCount) {
                let denseId: raw.BodyId = raw.b2MakeBodyId(dw, raw.b2GetSolverSet(dw, 2i32).bodySims.at(dense as i64).bodyId);
                prefix("DN", id, seq); outDec(di); outDec(dense);

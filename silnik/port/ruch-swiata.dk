import fizyka.kola as math2;
import fizyka.swiat as raw;
import fizyka.gra as game;
import fizyka.zbior as words64;
import fizyka.szeroka as broad;
import fizyka.drzewo as tree;
import fizyka.wielokaty as poly;
import fizyka.ruch as mass2;
import core.builtins as builtins;
import core.primitive_io as io;

extern("C") { fundecl write(fd: i32, buffer: cptr char, count: u64) -> i64; }
var inputOk: bool = true;
var failureCode: i64 = 3i64;
var rowBytes: i32[2048];
var rowLength: i32 = 0i32;
var rowPosition: i32 = 0i32;
var rowHasNewline: bool = false;

# Box2D 8c661469, include/box2d/types.h:172. Bit transport, no C algorithm.
fun fromBits(word: u32) -> f32 = {
    var value: u32 = word;
    let result: f32 = (&value as cptr f32)[0];
    return result;
}
# Box2D 8c661469, include/box2d/types.h:172. Bit transport.
fun toBits(value: f32) -> u32 = {
    var bits: f32 = value;
    let result: u32 = (&bits as cptr u32)[0];
    return result;
}
# Box2D 8c661469, src/body.c:177. Invalid transport terminates, never a game status.
fun invalid(message: str) -> () = {
    if (not inputOk) return;
    inputOk = false;
    write(2i32, builtins.ptr_from_slice[char](message) as cptr char, message.length() as u64);
}
# Box2D 8c661469, include/box2d/types.h:81. Transport: kontrola-swiat.c:106-120.
fun readRow() -> () = {
    rowLength = 0i32;
    rowPosition = 0i32;
    rowHasNewline = false;
    if (not inputOk) return;
    var c: i32 = io.readCharCode();
    while (c >= 0i32 and c != 10i32 and inputOk) {
        if (c == 0i32 or c > 127i32 or rowLength == 2047i32) {
            invalid("BLAD: ASCII / dlugosc wiersza.\n"); return;
        }
        rowBytes[rowLength] = c;
        rowLength = rowLength + 1i32;
        c = io.readCharCode();
    }
    rowHasNewline = c == 10i32;
    if (rowHasNewline and rowLength > 0i32 and rowBytes[rowLength - 1i32] == 13i32) rowLength = rowLength - 1i32;
    if (rowLength == 0i32) { invalid("BLAD: pusty lub brakujacy wiersz.\n"); return; }
    var i: i32 = 0i32;
    while (i < rowLength) {
        if (rowBytes[i] == 13i32) { invalid("BLAD: samotny CR.\n"); return; }
        i = i + 1i32;
    }
}
# Box2D 8c661469, include/box2d/types.h:81. Transport: kontrola-swiat.c:121-136.
fun readWord() -> u32 = {
    if (not inputOk) return 0u32;
    if (rowPosition > 0i32) {
        if (rowPosition >= rowLength or rowBytes[rowPosition] != 32i32) {
            invalid("BLAD: wymagana pojedyncza spacja.\n"); return 0u32;
        }
        rowPosition = rowPosition + 1i32;
    }
    if (rowPosition >= rowLength) { invalid("BLAD: E946d517eef62 Edcd4a212f815 u32.\n"); return 0u32; }
    var c: i32 = rowBytes[rowPosition];
    if (c < 48i32 or c > 57i32) { invalid("BLAD: E946d517eef62 Edcd4a212f815 u32.\n"); return 0u32; }
    let leadingZero: bool = c == 48i32;
    var value: u64 = 0u64;
    var digits: i32 = 0i32;
    while (c >= 48i32 and c <= 57i32) {
        value = value * 10u64 + (c - 48i32) as u64;
        digits = digits + 1i32;
        if (digits > 10i32 or value > 4294967295u64 or (leadingZero and digits > 1i32)) {
            invalid("BLAD: niekanoniczne u32.\n"); return 0u32;
        }
        rowPosition = rowPosition + 1i32;
        c = if rowPosition < rowLength then rowBytes[rowPosition] else -1i32;
    }
    return value as u32;
}
# Box2D 8c661469, include/box2d/types.h:81. Transport marker C/O.
fun readTag(tag: i32) -> () = {
    if (not inputOk) return;
    readRow();
    if (not inputOk) return;
    if (rowBytes[0] != tag) { invalid("BLAD: E946d517eef62 C/O.\n"); return; }
    rowPosition = 1i32;
}
# Box2D 8c661469, include/box2d/types.h:81. Transport: kontrola-swiat.c:104-143.
fun endRow() -> () = {
    if (inputOk and rowPosition != rowLength) invalid("BLAD: nadmiar danych w wierszu.\n");
}
# Box2D 8c661469, include/box2d/types.h:81. Reject trailing tokens.
fun checkEnd() -> () = {
    if (not inputOk) return;
    let c: i32 = io.readCharCode();
    if (c >= 0i32) invalid("BLAD: E5659622a1b7e\n");
}
# Box2D 8c661469, src/body.c:180-184. Reject NaN/Inf before any operation.
fun decodeFloat(word: u32) -> f32 = {
    if (not inputOk) return 0.0f32;
    if ((word & 2139095040u32) == 2139095040u32) { invalid("BLAD: NaN/Inf.\n"); return 0.0f32; }
    return fromBits(word);
}
# Box2D 8c661469, src/math_functions.                                         
fun decodeRot(c: u32, s: u32) -> math2.Rot = {
    if (not inputOk) return math2.Rot();
    let q: math2.Rot = math2.Rot(decodeFloat(c), decodeFloat(s));
    if (not inputOk) return q;
    let lengthSquared: f32 = q.s * q.s + q.c * q.c;
    if (not (1.0f32 - 0.0006f32 < lengthSquared and lengthSquared < 1.0f32 + 0.0006f32)) invalid("BLAD: obrot.\n");
    return q;
}
# Box2D 8c661469, include/box2d/id.h:36. Transport bounds only.
fun registerIndex(word: u32, limit: u32) -> i32 = {
    if (not inputOk) return 0i32;
    if (word >= limit) { invalid("BLAD: rejestr poza zakresem.\n"); return 0i32; }
    return word as i32;
}

# Box2D 8c661469, include/box2d/types.h:81,172. Decoded fields, not input buffer.
class Operation {
    opcode: i32 = 0i32;
    a: i32 = 0i32;
    b: i32 = 0i32;
    c: i32 = 0i32;
    capacity: i32 = 0i32;
    kind: i32 = 0i32;
    gravity: math2.Vec2 = math2.Vec2();
    maximumLinearSpeed: f32 = 0.0f32;
    def: raw.BodyDef = raw.BodyDef();
    position: math2.Vec2 = math2.Vec2();
    rotation: math2.Rot = math2.Rot();
    source: raw.ShapeRecord = raw.ShapeRecord();
    tag: i32 = 0i32;
    updateMass: bool = false;
    invoke: bool = false;
    geometryGood: bool = true;
    halfWidth: f32 = 0.0f32;
    halfHeight: f32 = 0.0f32;
    localCenter: math2.Vec2 = math2.Vec2();
    localRotation: math2.Rot = math2.Rot();
    radius: f32 = 0.0f32;
    mode: i32 = 0i32;
    dt: f32 = 0.0f32;
    subStepCount: i32 = 0i32;
    copySlot: i32 = 0i32;
    value: math2.Vec2 = math2.Vec2();
    point: math2.Vec2 = math2.Vec2();
    wake: bool = false;
    mutateCopy: bool = false;
}

# Box2D 8c661469, include/box2d/types.h:307-408. Reject each invalid boolean at its field.
fun decodeBool(word: u32, message: str) -> bool = {
    if (not inputOk) return false;
    if (word > 1u32) { invalid(message); return false; }
    return word == 1u32;
}
# Box2D 8c661469, src/body.c:177-184. Common body description, no hidden defaults from input.
fun decodeBody(w: ref u32[64], offset: i32) -> raw.BodyDef = {
    var def = raw.BodyDef();
    if (not inputOk) return def;
    if (w[offset] > 2u32) { invalid("BLAD: typ ciala.\n"); return def; }
    def.bodyType = w[offset] as i32;
    def.position = math2.Vec2(decodeFloat(w[offset+1i32]), decodeFloat(w[offset+2i32]));
    def.rotation = decodeRot(w[offset+3i32], w[offset+4i32]);
    def.linearVelocity = math2.Vec2(decodeFloat(w[offset+5i32]), decodeFloat(w[offset+6i32]));
    def.angularVelocity = decodeFloat(w[offset+7i32]);
    def.fixedRotation = decodeBool(w[offset+8i32], "BLAD: fixedRotation.\n");
    return def;
}
# Box2D 8c661469, include/box2d/types.h:249-281. Preserve all 64 bits, including bit 63.
fun decodeFilter(w: ref u32[64], offset: i32) -> broad.ShapeFilter = {
    if (not inputOk) return broad.ShapeFilter();
    let category: i64 = ((w[offset+1i32] as i64) << 32i64) | (w[offset] as i64);
    let mask: i64 = ((w[offset+3i32] as i64) << 32i64) | (w[offset+2i32] as i64);
    return broad.ShapeFilter(category, mask, w[offset+4i32] as i32);
}
# Box2D 8c661469, src/body.                                                                     
fun decodeObject(op: ref Operation, w: ref u32[64], offset: i32) -> () = {
    if (not inputOk) return;
    op.source.hasObjectId = decodeBool(w[offset], "BLAD: hasObjectId.\n");
    if (not inputOk) return;
    op.source.objectId = words64.Key64(w[offset+1i32], w[offset+2i32]);
    if (not op.source.hasObjectId and (w[offset+1i32] != 0u32 or w[offset+2i32] != 0u32)) invalid("BLAD: E946d517eef62 objectId.\n");
}
# Box2D 8c661469, src/geometry.                                                                               
fun decodeGeometry(op: ref Operation, w: ref u32[64], offset: i32) -> () = {
    if (not inputOk) return;
    var used: i32 = 0i32;
    if (op.tag == 0i32) {
        used = 3i32;
        op.source.circle = math2.Circle(math2.Vec2(decodeFloat(w[offset]), decodeFloat(w[offset+1i32])), decodeFloat(w[offset+2i32]));
    } else if (op.tag == 1i32) {
        used = 5i32;
        op.source.capsule = raw.Capsule(math2.Vec2(decodeFloat(w[offset]), decodeFloat(w[offset+1i32])),
            math2.Vec2(decodeFloat(w[offset+2i32]), decodeFloat(w[offset+3i32])), decodeFloat(w[offset+4i32]));
    } else if (op.tag == 2i32) {
        used = 4i32;
        op.source.segment = raw.Segment(math2.Vec2(decodeFloat(w[offset]), decodeFloat(w[offset+1i32])),
            math2.Vec2(decodeFloat(w[offset+2i32]), decodeFloat(w[offset+3i32])));
    } else if (op.tag == 3i32) {
        used = 18i32;
        if (w[offset] < 3u32 or w[offset] > 8u32) {
            op.geometryGood = false;
                                                                                            
        }
        op.source.polygon.count = w[offset] as i32;
        op.source.polygon.radius = decodeFloat(w[offset+1i32]);
        let pointCount: i32 = if w[offset] > 8u32 then 8i32 else w[offset] as i32;
        var point: i32 = 0i32;
        while (point < 8i32 and inputOk) {
            op.source.polygon.vertices[point] = math2.Vec2(decodeFloat(w[offset+2i32+2i32*point]), decodeFloat(w[offset+3i32+2i32*point]));
            if (point >= pointCount and (w[offset+2i32+2i32*point] != 0u32 or w[offset+3i32+2i32*point] != 0u32)) { invalid("BLAD: nieuzywany punkt.\n"); return; }
            point = point + 1i32;
        }
        if (not inputOk) return;
        if (op.geometryGood) op.geometryGood = game.preparePolygon(&op.source.polygon);
    } else if (op.tag == 4i32) {
        used = 7i32;
        op.halfWidth = decodeFloat(w[offset]); op.halfHeight = decodeFloat(w[offset+1i32]);
        op.localCenter = math2.Vec2(decodeFloat(w[offset+2i32]), decodeFloat(w[offset+3i32]));
        op.localRotation = decodeRot(w[offset+4i32], w[offset+5i32]);
        op.radius = decodeFloat(w[offset+6i32]);
        if (not inputOk) return;
        op.geometryGood = op.halfWidth > 0.0f32 and op.halfHeight > 0.0f32 and op.radius >= 0.0f32;
        if (op.geometryGood) op.source.polygon = mass2.b2MakeOffsetRoundedBox(op.halfWidth, op.halfHeight, op.localCenter, op.localRotation, op.radius);
    }
    if (not inputOk) return;
    op.source.shapeType = if op.tag == 4i32 then 3i32 else op.tag;
    var padding: i32 = used;
    while (padding < 40i32) {
        if (w[offset+padding] != 0u32) { invalid("BLAD: E296098d67338 Ec2dbf4ab3469 E8886cbca14d1.\n"); return; }
        padding = padding + 1i32;
    }
    if (op.tag == 0i32 and op.source.circle.radius <= 0.0f32) op.geometryGood = false;
    if (op.tag == 1i32 and op.source.capsule.radius <= 0.0f32) op.geometryGood = false;
    if ((op.tag == 3i32 or op.tag == 4i32) and not game.validShapeGeometry(&op.source)) op.geometryGood = false;
    if (op.opcode == 10i32 and not op.geometryGood) invalid("BLAD: geometria raw.\n");
}

# Box2D 8c661469, src/world.                                                             
fun readOperation(expectedSeq: u32) -> Operation = {
    var op = Operation();
    readTag(79i32);
    if (not inputOk) return op;
    let seq: u32 = readWord();
    if (not inputOk) return op;
    let opcode: u32 = readWord();
    if (not inputOk) return op;
    if (seq != expectedSeq) { invalid("BLAD: seq.\n"); return op; }
    if (opcode > 39u32 or opcode == 20u32 or (opcode >= 6u32 and opcode <= 9u32) or (opcode >= 22u32 and opcode <= 29u32)) { invalid("BLAD: opcode.\n"); return op; }
    var w: u32[64];
    var i: i32 = 0i32;
    while (i < 64i32 and inputOk) { w[i] = readWord(); i = i + 1i32; }
    endRow();
    if (not inputOk) return op;
    op.opcode = opcode as i32;
    var used: i32 = 0i32;
    if (opcode == 0u32) {
        used = 4i32; op.a = registerIndex(w[0], 16u32);
        op.gravity = math2.Vec2(decodeFloat(w[1]), decodeFloat(w[2]));
        op.maximumLinearSpeed = decodeFloat(w[3]);
        if (op.maximumLinearSpeed <= 0.0f32) { invalid("BLAD: maximumLinearSpeed.\n"); return op; }
    } else if (opcode == 1u32) {
        used = 1i32; op.a = registerIndex(w[0], 16u32);
    } else if (opcode == 2u32) {
        used = 11i32; op.a = registerIndex(w[0], 256u32); op.b = registerIndex(w[1], 16u32);
        op.def = decodeBody(&w, 2i32);
    } else if (opcode == 3u32 or opcode == 4u32 or opcode == 5u32 or opcode == 13u32 or opcode == 21u32) {
        if (opcode == 4u32) used = 6i32;
        else if (opcode == 21u32) used = 3i32;
        else used = 2i32;
        op.a = registerIndex(w[0], 16u32); op.b = registerIndex(w[1], 256u32);
        if (opcode == 4u32) {
            op.position = math2.Vec2(decodeFloat(w[2]), decodeFloat(w[3])); op.rotation = decodeRot(w[4], w[5]);
        }
        if (opcode == 21u32) {
            if (w[2] > 256u32) { invalid("BLAD: capacity.\n"); return op; } op.capacity = w[2] as i32;
        }
    } else if (opcode == 10u32 or opcode == 17u32) {
        used = 55i32; op.a = registerIndex(w[0], 512u32); op.b = registerIndex(w[1], 16u32); op.c = registerIndex(w[2], 256u32);
        if (w[3] > 4u32) { invalid("BLAD: E2a1073a6e67f E8886cbca14d1.\n"); return op; } op.tag = w[3] as i32;
        op.source.density = decodeFloat(w[4]);
        if (opcode == 10u32 and op.source.density < 0.0f32) { invalid("BLAD: density raw.\n"); return op; }
        op.updateMass = decodeBool(w[5], "BLAD: updateMass.\n"); op.invoke = decodeBool(w[6], "BLAD: invoke.\n");
        if (opcode == 17u32 and not op.updateMass) { invalid("BLAD: updateMass gry.\n"); return op; }
        op.source.filter = decodeFilter(&w, 7i32); decodeObject(&op, &w, 12i32); decodeGeometry(&op, &w, 15i32);
    } else if (opcode == 11u32 or opcode == 12u32 or opcode == 14u32 or opcode == 18u32 or opcode == 19u32) {
        if (opcode == 12u32) used = 4i32;
        else if (opcode == 11u32 or opcode == 19u32) used = 3i32;
        else used = 2i32;
        op.a = registerIndex(w[0], 16u32); op.b = registerIndex(w[1], 512u32);
        if (opcode == 11u32) op.updateMass = decodeBool(w[2], "BLAD: updateMass.\n");
        if (opcode == 12u32 or opcode == 19u32) op.source.density = decodeFloat(w[2]);
        if (opcode == 12u32) op.updateMass = decodeBool(w[3], "BLAD: updateMass.\n");
    } else if (opcode == 15u32) {
        used = 6i32; op.a = registerIndex(w[0], 16u32);
        if (w[1] != 2u32 and w[1] != 3u32) { invalid("BLAD: kind.\n"); return op; } op.kind = w[1] as i32;
        op.b = registerIndex(w[2], if op.kind == 2i32 then 256u32 else 512u32); decodeObject(&op, &w, 3i32);
    } else if (opcode == 16u32) {
        used = 63i32; op.a = registerIndex(w[0], 256u32); op.c = registerIndex(w[1], 512u32); op.b = registerIndex(w[2], 16u32);
        op.def = decodeBody(&w, 3i32);
        if (w[12] > 4u32) { invalid("BLAD: E2a1073a6e67f E8886cbca14d1.\n"); return op; } op.tag = w[12] as i32;
        op.source.density = decodeFloat(w[13]); op.invoke = decodeBool(w[14], "BLAD: invoke.\n");
        decodeObject(&op, &w, 15i32); op.source.filter = decodeFilter(&w, 18i32); decodeGeometry(&op, &w, 23i32);
    } else if (opcode == 30u32) {
        used = 16i32; op.a = registerIndex(w[0], 256u32); op.b = registerIndex(w[1], 16u32);
        op.mode = decodeBool(w[15], "BLAD: mode.\n") as i32;
        op.def.bodyType = w[2] as i32;
        op.def.position = math2.Vec2(fromBits(w[3]), fromBits(w[4]));
        op.def.rotation = math2.Rot(fromBits(w[5]), fromBits(w[6]));
        op.def.linearVelocity = math2.Vec2(fromBits(w[7]), fromBits(w[8]));
        op.def.angularVelocity = fromBits(w[9]);
        op.def.fixedRotation = decodeBool(w[10], "BLAD: fixedRotation.\n");
        op.def.linearDamping = fromBits(w[11]); op.def.angularDamping = fromBits(w[12]);
        op.def.gravityScale = fromBits(w[13]);
        op.def.allowFastRotation = decodeBool(w[14], "BLAD: allowFastRotation.\n");
        if (w[2] > 2u32) { invalid("BLAD: typ ciala.\n"); return op; }
        if (op.mode == 0i32) {
            var fi: i32 = 3i32;
            while (fi < 14i32 and inputOk) { if (fi != 10i32) decodeFloat(w[fi]); fi = fi + 1i32; }
            decodeRot(w[5], w[6]);
            if (op.def.linearDamping < 0.0f32) { invalid("BLAD: linearDamping.\n"); return op; }
            if (op.def.angularDamping < 0.0f32) { invalid("BLAD: angularDamping.\n"); return op; }
        }
    } else if (opcode == 31u32 or opcode == 32u32) {
        used = if opcode == 31u32 then 3i32 else 4i32;
        op.a = registerIndex(w[0], 16u32); op.dt = fromBits(w[1]); op.subStepCount = w[2] as i32;
        if (opcode == 32u32) op.copySlot = registerIndex(w[3], 4u32);
    } else if (opcode == 33u32 or opcode == 34u32) {
        used = 8i32; op.a = registerIndex(w[0], 16u32); op.b = registerIndex(w[1], 256u32);
        if (w[2] > 5u32) { invalid("BLAD: force kind.\n"); return op; } op.kind = w[2] as i32;
        op.value = math2.Vec2(fromBits(w[3]), fromBits(w[4]));
        op.point = math2.Vec2(fromBits(w[5]), fromBits(w[6]));
        op.wake = decodeBool(w[7], "BLAD: wake.\n");
        if ((op.kind == 1i32 or op.kind == 4i32) and (w[5] != 0u32 or w[6] != 0u32)) { invalid("BLAD: nieuzywany punkt.\n"); return op; }
        if ((op.kind == 2i32 or op.kind == 5i32) and (w[4] != 0u32 or w[5] != 0u32 or w[6] != 0u32)) { invalid("BLAD: E296098d67338 Eb9425afde1f5 E4c1a2709e3d2.\n"); return op; }
        if (opcode == 33u32) {
            var ff: i32 = 3i32;
            while (ff <= 6i32 and inputOk) { decodeFloat(w[ff]); ff = ff + 1i32; }
        }
    } else if (opcode == 35u32 or opcode == 36u32) {
        used = if opcode == 35u32 then 5i32 else 4i32;
        op.a = registerIndex(w[0], 16u32); op.b = registerIndex(w[1], 256u32);
        op.mode = decodeBool(w[used - 1i32], "BLAD: mode.\n") as i32;
        op.value.x = fromBits(w[2]);
        if (opcode == 35u32) op.value.y = fromBits(w[3]);
        if (op.mode == 0i32) { decodeFloat(w[2]); if (opcode == 35u32) decodeFloat(w[3]); }
    } else if (opcode == 37u32) {
        used = 1i32; op.copySlot = registerIndex(w[0], 4u32); op.a = op.copySlot;
    } else if (opcode == 38u32 or opcode == 39u32) {
        used = if opcode == 38u32 then 3i32 else 2i32;
        op.a = registerIndex(w[0], 16u32);
        op.b = registerIndex(w[1], if opcode == 38u32 then 256u32 else 512u32);
        if (opcode == 38u32) op.mutateCopy = decodeBool(w[2], "BLAD: zmien kopie.\n");

    }
    if (not inputOk) return op;
    if ((opcode == 10u32 or opcode == 12u32) and op.source.density < 0.0f32) { invalid("BLAD: density raw.\n"); return op; }
    i = used;
    while (i < 64i32) { if (w[i] != 0u32) { invalid("BLAD: E296098d67338 Ec2dbf4ab3469.\n"); return op; } i = i + 1i32; }
    return op;
}

# Box2D 8c661469, include/box2d/id.h:36. Historical handles only, never physical state.
class SavedWorld {
    saved: bool = false;
    number: game.WorldNumber = game.WorldNumber();
    id: raw.WorldId = raw.WorldId();
}
class SavedBody {
    saved: bool = false;
    number: game.BodyNumber = game.BodyNumber();
    owner: game.WorldNumber = game.WorldNumber();
    id: raw.BodyId = raw.BodyId();
}
# Box2D 8c661469, include/box2d/id.h:52. Historical identity, no geometry cached here.
class SavedShape {
    saved: bool = false;
    number: game.ShapeNumber = game.ShapeNumber();
    owner: game.WorldNumber = game.WorldNumber();
    id: broad.ShapeId = broad.ShapeId();

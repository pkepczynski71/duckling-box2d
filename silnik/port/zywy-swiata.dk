        var wi: i32 = 0i32;
        while (wi < 16i32) {
            if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
                var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
                if (group == 0i32) {
                    prefix("W10", id, seq); outDec(wi); outFloat(world.contactHertz); outFloat(world.contactDampingRatio); outFloat(world.maxContactPushSpeed);
                    outFloat(world.restitutionThreshold); outFloat(world.hitEventThreshold); outFloat(world.contactSpeed);
                    outHex(world.enableWarmStarting as u32); outHex(world.enableSpeculative as u32); newline(); execution.n10[0] = execution.n10[0] + 1i32;
                } else if (world.solverTrace.hasTask) outSolverTrace(&world.solverTrace, world, wi, id, seq, 0i32, 7i32, group, execution);

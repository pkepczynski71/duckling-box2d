fun validExtended12(reg: ref Registers, op: Operation) -> bool = {
    if (op.opcode == 89i32 and op.kind >= 2i32) {
        if (not reg.contactCopies12[op.copySlot].saved) { invalid("PORT12: INPUT_COPY\n"); return false; }
        if (reg.phase != 0i32) { invalid("PORT12: INPUT_PHASE\n"); return false; } return true;
    }
    var initialized: bool = reg.worlds[op.a].saved;
    if (op.opcode == 84i32 or (op.opcode == 89i32 and op.kind == 0i32)) initialized = initialized and reg.bodies[op.b].saved;
    if (op.opcode == 88i32 or (op.opcode == 89i32 and op.kind == 1i32)) initialized = initialized and reg.shapes[op.b].saved;
    if (op.opcode == 83i32 or op.opcode == 85i32) {
        if (op.kind == 1i32) initialized = initialized and reg.bodies[op.b].saved;
        if (op.kind == 2i32) initialized = initialized and reg.shapes[op.b].saved;

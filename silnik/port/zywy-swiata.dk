fun prevalidateExtended12(code: u32, w: ref u32[64]) -> bool = {
    var modeIndex: i32 = 2i32;
    if (code == 82u32 or code == 86u32 or code == 88u32) modeIndex = 1i32;
    if (code == 83u32 or code == 85u32) modeIndex = 3i32;
    if (code == 87u32 or code == 89u32) modeIndex = -1i32;
    if (modeIndex >= 0i32 and w[modeIndex] > 1u32) { invalid("PORT12: INPUT_MODE\n"); return false; }
    var used: i32 = 0i32;
    if (code == 82u32) {
        if (w[2] > 5u32) { invalid("PORT12: INPUT_OPCODE\n"); return false; }
        used = if w[2] == 3u32 then 6i32 else (if w[2] == 5u32 then 5i32 else 4i32);
        if (w[2] == 0u32 and w[3] > 1u32) { invalid("PORT12: INPUT_BOOL\n"); return false; }
    } else if (code == 83u32) {
        used = 6i32;
        if (w[1] > 1u32 or w[4] > 2u32) { invalid("PORT12: INPUT_DOMAIN\n"); return false; }
        if (w[5] > 1u32) { invalid("PORT12: INPUT_BOOL\n"); return false; }
    } else if (code == 84u32) {
        used = 37i32;
        if (w[3] > 1u32) { invalid("PORT12: INPUT_BOOL\n"); return false; }
        if (w[4] > 32u32) { invalid("PORT12: INPUT_DOMAIN\n"); return false; }
        var j: i32 = 0i32;
        while (j < 32i32) {
            if (w[5i32+j] > 255u32) { invalid("PORT12: INPUT_WORDS\n"); return false; }
            if (j >= w[4] as i32 and w[5i32+j] != 0u32) { invalid("PORT12: INPUT_UNUSED\n"); return false; }
            j = j + 1i32;
        }
        if (w[3] != 0u32 and w[4] != 0u32) { invalid("PORT12: INPUT_UNUSED\n"); return false; }
    } else if (code == 85u32) {
        used = 7i32;
        if (w[1] > 2u32) { invalid("PORT12: INPUT_DOMAIN\n"); return false; }
        if (w[4] > 1u32) { invalid("PORT12: INPUT_BOOL\n"); return false; }
        if ((w[1] == 0u32 and w[2] != 0u32) or (w[4] == 0u32 and (w[5] != 0u32 or w[6] != 0u32))) { invalid("PORT12: INPUT_UNUSED\n"); return false; }
    } else if (code == 86u32) {
        used = 7i32;
        if (w[2] > 3u32) { invalid("PORT12: INPUT_OPCODE\n"); return false; }
        if (w[3] > 1u32) { invalid("PORT12: INPUT_BOOL\n"); return false; }
        if ((w[1] != 0u32 and (w[4] != 0u32 or w[5] != 0u32 or w[6] != 0u32)) or (w[2] >= 2u32 and (w[5] != 0u32 or w[6] != 0u32))) { invalid("PORT12: INPUT_UNUSED\n"); return false; }
        if (w[1] == 0u32) {
            var valid: bool = w[4] == 0u32;
            if (w[3] != 0u32) {
                if (w[2] == 0u32) valid = w[4] <= 1u32;
                else if (w[2] == 1u32) valid = w[4] <= 2u32 or w[4] == 4u32 or w[4] == 5u32;
                else valid = w[4] == 0u32 or w[4] == 3u32;
            }
            if (not valid) { invalid("PORT12: INPUT_DOMAIN\n"); return false; }
        }
    } else if (code == 87u32) {
        if (w[1] > 3u32) { invalid("PORT12: INPUT_OPCODE\n"); return false; }
        if (w[2] > 1u32) { invalid("PORT12: INPUT_DOMAIN\n"); return false; }
        used = if w[2] == 0u32 then 3i32 else (if w[1] == 1u32 then 12i32 else 6i32);
        if (w[2] != 0u32 and w[1] < 2u32) {
            if (w[5] > 1u32 or (w[1] == 1u32 and w[9] > 1u32)) { invalid("PORT12: INPUT_BOOL\n"); return false; }
            if (w[1] == 1u32 and w[9] == 0u32 and (w[10] != 0u32 or w[11] != 0u32)) { invalid("PORT12: INPUT_UNUSED\n"); return false; }
        }
    } else if (code == 88u32) {
        used = 4i32;
        if (w[1] != 0u32 and w[3] != 0u32) { invalid("PORT12: INPUT_UNUSED\n"); return false; }
        if (w[1] == 0u32 and w[3] > 512u32) { invalid("PORT12: INPUT_DOMAIN\n"); return false; }
    } else {
        used = 4i32;
        if (w[0] > 3u32) { invalid("PORT12: INPUT_DOMAIN\n"); return false; }
        if (w[0] >= 2u32 and (w[1] != 0u32 or w[2] != 0u32)) { invalid("PORT12: INPUT_UNUSED\n"); return false; }
    }
    var i: i32 = used;
    while (i < 64i32) { if (w[i] != 0u32) { invalid("PORT12: INPUT_UNUSED\n"); return false; } i = i + 1i32; }
    let owner: u32 = if code == 89u32 then w[1] else w[0];
    if (owner >= 16u32) { invalid("PORT12: INPUT_REGISTER\n"); return false; }
    if (code == 84u32 and w[1] >= 256u32) { invalid("PORT12: INPUT_REGISTER\n"); return false; }
    if (code == 88u32 and w[2] >= 512u32) { invalid("PORT12: INPUT_REGISTER\n"); return false; }
    if (code == 83u32 or code == 85u32) {
        let target: u32 = if code == 83u32 then w[1]+1u32 else w[1];
        if ((target == 1u32 and w[2] >= 256u32) or (target == 2u32 and w[2] >= 512u32)) { invalid("PORT12: INPUT_REGISTER\n"); return false; }
    }
    if (code == 87u32 and w[2] != 0u32 and w[1] < 2u32 and (w[3] >= 512u32 or w[4] >= 512u32)) { invalid("PORT12: INPUT_REGISTER\n"); return false; }
    if (code == 89u32 and (w[3] >= 4u32 or (w[0] == 0u32 and w[2] >= 256u32) or (w[0] == 1u32 and w[2] >= 512u32))) { invalid("PORT12: INPUT_REGISTER\n"); return false; }
    return true;

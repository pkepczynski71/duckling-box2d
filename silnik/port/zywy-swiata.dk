fun outContactList(list: ref game.ContactList, id: u32, seq: u32, phase: i32) -> i32 = {
    prefix("GL", id, seq); outDec(phase); outDec(0i32); outDec(0i32);
    outHex(list.status as u32); outHex(list.values.length() as u32); newline();

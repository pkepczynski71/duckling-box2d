# Box2D 8c661469, src/world.                                                      
fun outLivePublic(reg: ref Registers, id: u32, seq: u32, op: Operation, execution: ref Execution) -> () = {
    liveCounts = zeroLiveCounts(); privateNames = 0i32;
    if (op.opcode >= 80i32) {
        prefix("AP12", id, seq); outHex(execution.status as u32); outHex(execution.liveReason as u32);
        outHex(execution.liveKind as u32); outHex(execution.liveRegister as u32); newline(); liveCounts[0] = liveCounts[0] + 1i32;
    }
    var api: i64 = 0i64;
    while (api < callbackAP12.length()) {
        let ap: CallbackAP12 = callbackAP12.at(api); prefix("AP12",id,seq); outHex(ap.status as u32); outHex(if ap.status == game.LOCKED then 1u32 else 0u32);
        outHex(ap.kind as u32); outHex(ap.reg as u32); newline(); liveCounts[0] = liveCounts[0]+1i32; api = api+1i64;
    }
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
            prefix("WS12", id, seq); outDec(wi); outFloat(world.gravity.x); outFloat(world.gravity.y); outFloat(world.maxLinearSpeed);
            outFloat(world.contactHertz); outFloat(world.contactDampingRatio); outFloat(world.maxContactPushSpeed);
            outFloat(world.restitutionThreshold); outFloat(world.hitEventThreshold); outHex(world.enableWarmStarting as u32); outHex(world.enableSleep as u32);
            outHex(raw.b2GetSolverSet(world, 2i32).bodyCount as u32); newline(); liveCounts[1] = liveCounts[1] + 1i32;
        }
        wi = wi + 1i32;
    }
    var bi: i32 = 0i32;
    while (bi < 256i32) {
        if (liveBody(reg, bi)) {
            let name: raw.NameValue = raw.b2Body_GetName(reg.bodies[bi].id);
            prefix("NM12", id, seq); outDec(bi); outHex(name.length as u32);
            var nb: i32 = 0i32; while (nb < 32i32) { outHex(name.bytes[nb] as u32); nb = nb + 1i32; } newline(); liveCounts[2] = liveCounts[2] + 1i32;
        }
        bi = bi + 1i32;
    }
    var target: i32 = 0i32;
    while (target < 3i32) {
        var ri: i32 = 0i32; let limit: i32 = if target == 0i32 then 16i32 else (if target == 1i32 then 256i32 else 512i32);
        while (ri < limit) {
            var alive: bool = false; var present: bool = false; var token = words64.Key64();
            if (target == 0i32) {
                alive = reg.worlds[ri].saved and game.worldStatus(reg.worlds[ri].number) == game.OK;
                if (alive) { present = raw.worlds.at(reg.worlds[ri].number.slot as i64).hasObjectId; token = raw.worlds.at(reg.worlds[ri].number.slot as i64).objectId; }
            }
            else if (target == 1i32) {
                alive = liveBody(reg, ri);
                if (alive) {
                    let body: raw.BodyRecord = raw.worlds.at(reg.bodies[ri].owner.slot as i64).bodies.at(reg.bodies[ri].number.slot as i64);
                    present = body.hasObjectId; token = body.objectId;
                }
            } else {
                alive = liveShape(reg, ri);
                if (alive) {
                    let shape: raw.ShapeRecord = raw.worlds.at(reg.shapes[ri].owner.slot as i64).shapes.at(reg.shapes[ri].number.slot as i64);
                    present = shape.hasObjectId; token = shape.objectId;
                }
            }
            if (alive) { prefix("UD12", id, seq); outDec(target); outDec(ri); outHex(present as u32); outPair(token); newline(); liveCounts[3] = liveCounts[3] + 1i32; }
            ri = ri + 1i32;
        }
        target = target + 1i32;
    }
    var si: i32 = 0i32;
    while (si < 512i32) {
        if (liveShape(reg, si)) {
            let flagShape: raw.ShapeRecord = raw.worlds.at(reg.shapes[si].owner.slot as i64).shapes.at(reg.shapes[si].number.slot as i64);
            prefix("EF12", id, seq); outDec(si); outHex(flagShape.enableContactEvents as u32); outHex(flagShape.enableHitEvents as u32); outHex(flagShape.enablePreSolveEvents as u32); newline(); liveCounts[10] = liveCounts[10] + 1i32;
        }
        si = si + 1i32;
    }
    wi = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            prefix("HC12", id, seq); outDec(wi);
            var hookWorld: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
            let hooks: raw.RawCallbacks12 = hookWorld.callbacks12;
            outHex((hooks.filterInstalled as u32) | ((hooks.preInstalled as u32) << 1u32) | ((hooks.frictionInstalled as u32) << 2u32) | ((hooks.restitutionInstalled as u32) << 3u32));
            var hc: i32 = 0i32; while (hc < 4i32) { outHex(reg.worlds[wi].functionIds12[hc]); hc = hc + 1i32; }
            outPair(hooks.filterContext); outPair(hooks.preContext);
            outHex(hookWorld.pairRules12.length() as u32); outHex(hookWorld.preRules12.length() as u32); outHex(hookWorld.frictionRules12.length() as u32); outHex(hookWorld.restitutionRules12.length() as u32);
            newline(); liveCounts[4] = liveCounts[4] + 1i32;
        }
        wi = wi + 1i32;
    }
    wi = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            var ruleWorld: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64); outRules12(ruleWorld,wi,id,seq);
        }
        wi = wi+1i32;
    }
    outHookTraces12(reg,id,seq);
    outLists12(reg,execution,id,seq);
    if (op.opcode == 92i32) {
        prefix("VR12", id, seq); outDec(op.b); outDec(op.kind); outHex(execution.liveVector.status as u32);
        outFloat(execution.liveVector.value.x); outFloat(execution.liveVector.value.y); newline(); liveCounts[9] = 1i32;
    }
}
# Box2D 8c661469, src/body.h:16. NP32 includes every occupied body, not only registered bodies.
fun outLivePrivate(reg: ref Registers, id: u32, seq: u32) -> () = {
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
            var bi: i64 = 0i64;
            while (bi < world.bodies.length()) {
                let body: raw.BodyRecord = world.bodies.at(bi);
                if (body.id != -1i32) {
                    prefix("NP12", id, seq); outDec(wi); outDec(bi as i32);
                    var ni: i32 = 0i32; while (ni < 32i32) { outHex(body.name[ni] as u32); ni = ni + 1i32; } newline(); privateNames = privateNames + 1i32;
                }
                bi = bi + 1i64;
            }
        }
        wi = wi + 1i32;
    }
}
# Box2D 8c661469, src/world.c:695-812. Transport counters, not physics state.
fun outLiveCounters(id: u32, seq: u32) -> () = {
    prefix("I12", id, seq); var i: i32 = 0i32;
    while (i < 11i32) { outHex(liveCounts[i] as u32); i = i + 1i32; } newline();
    prefix("IP12", id, seq); outHex(privateNames as u32); newline();
    prefix("Z12", id, seq); outHex(completedPositiveSteps); outHex(seq); newline();
}

# Box2D 8c661469, src/math_functions.                                                 
                                                                                         
fun componentMain12() -> i64 = {
    readNamedTag("COMPONENT12", 2i32);
    decimalError = "PORT12: INPUT_HEADER\n"; decimalOverflow = "PORT12: INPUT_N_RANGE\n";
    let count: u32 = readWord(); endRow();
    decimalError = "PORT12: INPUT_SEQUENCE\n"; decimalOverflow = decimalError;
    if (not inputOk) return 2i64;
    if (count < 1u32 or count > 32u32) { invalid("PORT12: INPUT_N_RANGE\n"); return 2i64; }
    io.writeStr("COMPONENT12"); outDec(count as i32); newline();
    var caseIndex: u32 = 0u32;
    while (caseIndex < count and inputOk) {
        rowError = "PORT12: INPUT_SEQUENCE\n"; readRow(true); if (not inputOk) return 2i64;
        if (not rowHasNewline) { invalid("PORT12: INPUT_EOF\n"); return 2i64; }
        if (rowLength < 2i32 or rowBytes[1] != 32i32) { invalid(rowError); return 2i64; }
        if (rowBytes[0] == 70i32) {
            rowError = "PORT12: INPUT_WORDS\n"; checkArity(67i32); rowPosition = 1i32;
            let fixtureId: u32 = readWord(); let helperKind: u32 = readWord();
            if (not inputOk) return 2i64;
            if (fixtureId != caseIndex + 1u32) { invalid("PORT12: INPUT_SEQUENCE\n"); return 2i64; }
            if (helperKind != 100u32 and helperKind != 101u32) { invalid("PORT12: INPUT_OPCODE\n"); return 2i64; }
            var words: u32[64]; var i: i32 = 0i32; readingPayload = true;
            while (i < 64i32 and inputOk) { words[i] = readWord(); i = i + 1i32; }
            readingPayload = false; endRow(); if (not inputOk) return 2i64;
            var used: i32 = if helperKind == 100u32 then 2i32 else 4i32;
            while (used < 64i32) { if (words[used] != 0u32) { invalid("PORT12: INPUT_UNUSED\n"); return 2i64; } used = used + 1i32; }
            var value: f32 = 0.0f32;
            if (helperKind == 100u32) value = raw.b2Atan2(decodeFloat(words[0]), decodeFloat(words[1]));
            else {
                let rotationB: math2.Rot = decodeRot(words[0], words[1]); let rotationA: math2.Rot = decodeRot(words[2], words[3]);
                if (not inputOk) return 2i64;
                value = raw.b2RelativeAngle(rotationB, rotationA);
            }
            if (not inputOk) return 2i64;
            io.writeStr("CASE"); outDec(fixtureId as i32); outDec(1i32); newline();
            io.writeStr("FE12"); outDec(fixtureId as i32); outDec(helperKind as i32);
            var e: i32 = 0i32; while (e < 64i32) { outHex(words[e]); e = e + 1i32; } newline();
            io.writeStr("FV12"); outDec(fixtureId as i32); outDec(helperKind as i32); outFloat(value); newline();
            if (caseIndex + 1u32 == count) { checkEnd(); if (not inputOk) return 2i64; }
            io.writeStr("ENDCASE"); outDec(fixtureId as i32); newline();
        } else if (rowBytes[0] == 67i32) {
            checkArity(3i32); rowPosition = 1i32;
            let id: u32 = readWord(); let opCount: u32 = readWord(); endRow(); if (not inputOk) return 2i64;
            if (id != caseIndex + 1u32 or opCount < 1u32 or opCount > 64u32) { invalid("PORT12: INPUT_SEQUENCE\n"); return 2i64; }
            var reg = Registers(); completedPositiveSteps = 0u32;
            io.writeStr("CASE"); outDec(id as i32); outDec(opCount as i32); newline();
            var seq: u32 = 1u32;
            while (seq <= opCount and inputOk) {
                expectingPhase = reg.phase != 0i32; let operation: Operation = readOperation(seq); expectingPhase = false;
                if (not inputOk) { cleanup(&reg); return 2i64; }
                if (runOperation(&reg, id, seq, operation, true) < 0i32) { cleanup(&reg); return failureCode; }
                seq = seq + 1u32;
            }
            if (reg.phase != 0i32) { invalid("PORT12: INPUT_PHASE\n"); cleanup(&reg); return 2i64; }
            if (caseIndex + 1u32 == count) {
                checkEnd(); if (not inputOk) { cleanup(&reg); return 2i64; }
            }
            io.writeStr("ENDCASE"); outDec(id as i32); newline(); cleanup(&reg);
        } else { invalid(rowError); return 2i64; }
        caseIndex = caseIndex + 1u32;
    }
    checkEnd(); if (not inputOk) return 2i64;
    io.writeStr("END"); outDec(count as i32); newline(); return 0i64;
}

# Box2D 8c661469, src/body.                                                   
                                                                                                               
fun guardLive12(kind: u32, seedAfter: u32, opCount: u32, words: ref u32[64]) -> i64 = {
    if (seedAfter != 0u32 or opCount != 0u32) { invalid("PORT12: INPUT_SEQUENCE\n"); return 2i64; }
    let code: u32 = kind - 100u32;
    if (not prevalidateLiveWords(code, words)) return 2i64;
    if (words[2] != 1u32) { invalid("PORT12: INPUT_MODE\n"); return 2i64; }
    var op = Operation(); op.opcode = code as i32; op.words = words;
    decodeLiveOperation(&op, words); if (not inputOk) return 2i64;
    var parameters = game.SolverWorldParameters(); parameters.gravity = math2.Vec2(); parameters.maximumLinearSpeed = 100.0f32;
    let createdWorld: game.WorldResult = game.createSleepWorld(math2.Vec2(), 100.0f32, parameters, true);
    var def = raw.BodyDef(); def.bodyType = 2i32;
    let createdBody: game.BodyResult = game.createBody8(createdWorld.number, def);
    var source = raw.ShapeRecord(); source.circle = math2.Circle(math2.Vec2(), 1.0f32); source.friction = 0.5f32; source.userMaterialId = 3i32;
    let createdShape: game.ShapeResult = game.addPreparedShape(createdWorld.number, createdBody.number, source, false);
    if (createdWorld.status != game.OK or createdBody.status != game.OK or createdShape.status != game.OK) { invalid("PORT12: INPUT_DOMAIN\n"); return 2i64; }
    let owner: game.WorldNumber = createdWorld.number;
    var status: i32 = game.OK;
    if (code == 90u32) {
        if (not game.validBodyDef(op.def) or not game.validName(op.def.name)) status = game.PARAM;
    } else if (code == 92u32) {
        if (not game.finiteVector(op.value)) status = game.PARAM;
    } else if (code == 80u32) {
        if (op.kind == 0i32 and op.words[4] != 2u32) {
            if (not game.safeBodyChange(owner, createdBody.number, op.words[4] as i32, false, false)) status = game.GEOMETRY;
        } else if (op.kind == 2i32) {
            if (not game.validMassData(op.liveMass)) status = game.PARAM;
            else if (not game.safeMassData(owner, createdBody.number, op.liveMass)) status = game.GEOMETRY;
        } else if (op.kind == 3i32 or (op.kind == 7i32 and op.wake)) {
            if (not game.safeBodyChange(owner, createdBody.number, 2i32, op.wake and op.kind == 7i32, op.kind == 7i32)) status = game.GEOMETRY;
        } else if (op.kind == 4i32 or op.kind == 5i32) {
            if (not game.validNonnegative(op.value.x)) status = game.PARAM;
        } else if (op.kind == 6i32) {
            if (not game.finite(op.value.x)) status = game.PARAM;
        } else if (op.kind == 8i32) {
            let target: math2.Transform = math2.Transform(op.position, op.rotation);
            if (not game.validTargetTransform(target, op.dt) or not game.safeTargetTransform(owner, createdBody.number, target, op.dt)) status = game.PARAM;
        }
    } else {
        if (op.kind == 0i32 or op.kind == 1i32) {
            if (not game.validNonnegative(op.value.x)) status = game.PARAM;
        } else if (op.kind == 3i32) {
            if (not game.validSurfaceMaterial(op.liveMaterial)) status = game.PARAM;
        } else if (op.kind >= 5i32) {
            var prepared = raw.ShapeRecord();
            if (not game.prepareReplacement(source, op.source, &prepared)) status = game.GEOMETRY;
            else if (not game.preflight(owner, createdBody.number.slot, 3i32, createdShape.number.slot, prepared, 0.0f32)) status = game.GEOMETRY;
        }
    }
    game.destroyWorld(owner);
    io.writeStr("GUARD12 1\n"); io.writeStr("G 1"); outDec(kind as i32); outDec(0i32); outDec(0i32); newline();
    io.writeStr("GA 1"); outFixtureWords(words, 64i32);
    io.writeStr("CASE 1 0\n"); outGuardResult(0u32, (1000u32 + code) as i32, status, status == game.OK, 0i64);
    checkEnd(); if (not inputOk) return 2i64;
    io.writeStr("ENDCASE 1\nEND 1\n"); return 0i64;
}


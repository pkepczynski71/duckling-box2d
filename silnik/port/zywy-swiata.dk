            raw.worlds.at(owner.slot as i64).bodies.at(created.number.slot as i64).hasObjectId = op.source.hasObjectId;
            raw.worlds.at(owner.slot as i64).bodies.at(created.number.slot as i64).objectId = op.source.objectId;
        }

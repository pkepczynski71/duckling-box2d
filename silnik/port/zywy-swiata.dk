# Box2D 8c661469, src/world.c:100.                                                           
fun outBitSet(set: ref bits.BitSet) -> () = {
    outHex(set.blockCount as u32); outHex(set.blockCapacity as u32);
    var i: i32 = 0i32;
    while (i < set.blockCount) { let blk: words64.Key64 = set.bits.at(i as i64); outPair(blk); i = i + 1i32; }
}

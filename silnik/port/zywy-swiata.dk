        return 19i32;
    }
    if (op.opcode == 61i32) { op.mode = w[1] as i32; op.wake = w[2] != 0u32; return 3i32; }
    op.b = w[1] as i32;
    if (op.opcode == 64i32) { op.kind = w[1] as i32; op.c = w[2] as i32; return 4i32; }
    op.mode = w[2] as i32;
    if (op.opcode == 62i32) return 3i32;
    if (op.opcode == 60i32) {
        op.value.x = fromBits(w[3]);
        if (op.mode == 0i32 and not game.validSleepThreshold(op.value.x)) invalid("PORT12: INPUT_DOMAIN\n");

        used = 63i32; registers.push(0i32); limits.push(256i32); registers.push(1i32); limits.push(512i32); registers.push(2i32); limits.push(16i32);
        booleans.push(11i32); booleans.push(14i32); booleans.push(15i32); tagIndex = 12i32; geometry = 23i32;

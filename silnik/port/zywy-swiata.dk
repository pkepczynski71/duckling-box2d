fun checkTransport() -> bool = {
    return toBits(fromBits(2147483648u32)) == 2147483648u32
        and toBits(fromBits(1u32)) == 1u32 and toBits(fromBits(2139095039u32)) == 2139095039u32
        and fromBits(1065353216u32) == 1.0f32 and fromBits(3212836864u32) == -1.0f32;
}

# Box2D 8c661469, src/world.c:100,263.                                                    
fun main() -> i64 = {
                                                                                                  
    if (CONTACT_PROFILE == 9i32) return guardMain();
    if (CONTACT_PROFILE == 10i32) return componentMain12();
    
    if (not checkTransport()) return 2i64;
    if (CONTACT_PROFILE == 10i32) readNamedTag("COMPONENT12", 2i32);
    else readNamedTag("PORT12", 2i32);
    if (not inputOk) return 2i64;
    decimalError = "PORT12: INPUT_HEADER\n"; decimalOverflow = "PORT12: INPUT_N_RANGE\n";
    let count: u32 = readWord(); endRow();
    decimalError = "PORT12: INPUT_SEQUENCE\n"; decimalOverflow = decimalError;
    if (not inputOk) return 2i64;
    let maximumCases: u32 = if CONTACT_PROFILE == 10i32 then 32u32 else 160u32;
    if (count < 1u32 or count > maximumCases) { invalid("PORT12: INPUT_N_RANGE\n"); return 2i64; }
    io.writeStr(if CONTACT_PROFILE == 10i32 then "COMPONENT12" else "PORT12"); outDec(count as i32); newline();
    var caseIndex: u32 = 0u32;
    while (caseIndex < count and inputOk) {
        readTag(67i32);
        if (not inputOk) return 2i64;
        let id: u32 = readWord();
        if (not inputOk) return 2i64;
        let opCount: u32 = readWord();
        endRow();
        if (not inputOk) return 2i64;
        if (id != caseIndex + 1u32) { invalid("PORT12: INPUT_SEQUENCE\n"); return 2i64; }
        if (opCount < 1u32 or opCount > opMaximum(id)) { invalid("PORT12: INPUT_SEQUENCE\n"); return 2i64; }
        var reg = Registers(); completedPositiveSteps = 0u32;
        io.writeStr("CASE"); outDec(id as i32); outDec(opCount as i32); newline();
        var seq: u32 = 1u32;
        while (seq <= opCount and inputOk) {
            expectingPhase = reg.phase != 0i32;
            let op: Operation = readOperation(seq); expectingPhase = false;
            if (not inputOk) { cleanup(&reg); return 2i64; }
            if (runOperation(&reg, id, seq, op, true) < 0i32) { cleanup(&reg); return failureCode; }
            seq = seq + 1u32;
        }
        if (reg.phase != 0i32) { invalid("PORT12: INPUT_PHASE\n"); cleanup(&reg); return 2i64; }
        if (caseIndex + 1u32 == count) {
            checkEnd(); if (not inputOk) { cleanup(&reg); return 2i64; }
        }
        io.writeStr("ENDCASE"); outDec(id as i32); newline();
        cleanup(&reg);
        caseIndex = caseIndex + 1u32;
    }
    checkEnd();
    if (not inputOk) return 2i64;
    io.writeStr("END"); outDec(count as i32); newline();
    return 0i64;
}


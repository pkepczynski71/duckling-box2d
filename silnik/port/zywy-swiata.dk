fun guardMain() -> i64 = {
    readNamedTag("GUARD12", 2i32);
    decimalError = "PORT12: INPUT_HEADER\n"; decimalOverflow = "PORT12: INPUT_N_RANGE\n";
    let count: u32 = readWord(); endRow();
    decimalError = "PORT12: INPUT_SEQUENCE\n"; decimalOverflow = decimalError;
    if (not inputOk) return 2i64;
    if (count != 1u32) { invalid("PORT12: INPUT_N_RANGE\n"); return 2i64; }
    readNamedTag("G", 5i32); let id: u32 = readWord(); let kind: u32 = readWord(); let seedAfter: u32 = readWord(); let opCount: u32 = readWord(); endRow();

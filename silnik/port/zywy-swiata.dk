                    let valid: bool = game.prepareReplacement(current, op.source, &prepared);
                    status = game.replaceGeometry(owner, shapeNumber, op.source);
                    if (valid and status == game.GEOMETRY) {
                        execution.liveReason = massGeometryReason12(raw.worlds.at(owner.slot as i64), current.bodyId, shapeNumber.slot, prepared);
                    }
                }
            }
        } else {
            status = game.shapeStatus(owner, shapeNumber);
            if (status == game.OK) {
                let shapeId: broad.ShapeId = reg.shapes[op.b].id;
                if (op.kind == 0i32) raw.b2Shape_SetFriction(shapeId, op.value.x);
                else if (op.kind == 1i32) raw.b2Shape_SetRestitution(shapeId, op.value.x);
                else if (op.kind == 2i32) raw.b2Shape_SetMaterial(shapeId, op.words[4] as i32);
                else if (op.kind == 3i32) raw.b2Shape_SetSurfaceMaterial(shapeId, op.liveMaterial);
                else if (op.kind == 4i32) raw.b2Shape_SetFilter(shapeId, op.source.filter);
                else if (op.kind == 5i32) raw.b2Shape_SetCircle(shapeId, op.source.circle);
                else if (op.kind == 6i32) raw.b2Shape_SetCapsule(shapeId, op.source.capsule);
                else if (op.kind == 7i32) raw.b2Shape_SetSegment(shapeId, op.source.segment);
                else raw.b2Shape_SetPolygon(shapeId, op.source.polygon);
            }
        }
    }
    if (status == game.LOCKED) execution.liveReason = 1i32;
    return status;
}


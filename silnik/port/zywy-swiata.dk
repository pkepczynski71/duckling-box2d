fun outManifold(value: math2.Manifold) -> () = {
    outFloat(value.normal.x); outFloat(value.normal.y); outFloat(value.rollingImpulse); outHex(value.pointCount as u32);
    var i: i32 = 0i32; var local: math2.Manifold = value;
    while (i < 2i32) {
        let point: math2.ManifoldPoint = raw.manifoldPoint(&local, i);
        outFloat(point.point.x); outFloat(point.point.y); outFloat(point.anchorA.x); outFloat(point.anchorA.y);
        outFloat(point.anchorB.x); outFloat(point.anchorB.y); outFloat(point.separation);
        outFloat(point.normalImpulse); outFloat(point.tangentImpulse); outFloat(point.totalNormalImpulse); outFloat(point.normalVelocity);
        outHex(point.id as u32); outHex(point.persisted as u32); i = i + 1i32;
    }
}

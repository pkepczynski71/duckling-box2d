        let end: game.ContactEnd = events.end.at(j);
        prefix(tag, id, seq); outDec(slot); outDec(phase); outDec(2i32); outDec(j as i32);
        outShapeNumber(end.shapeA); outShapeNumber(end.shapeB); newline(); j = j + 1i64;

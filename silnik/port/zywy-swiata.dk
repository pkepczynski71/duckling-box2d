fun decodeManifold(w: ref u32[64], offset: i32) -> math2.Manifold = {
    var result = math2.Manifold();
    result.normal = math2.Vec2(fromBits(w[offset]), fromBits(w[offset + 1i32]));
    result.rollingImpulse = fromBits(w[offset + 2i32]);
    if (w[offset + 3i32] > 2u32) { invalid("PORT12: INPUT_DOMAIN\n"); return result; }
    result.pointCount = w[offset + 3i32] as i32;
    var i: i32 = 0i32;
    while (i < 2i32) {
        let base: i32 = offset + 4i32 + 13i32 * i;
        var point: ref math2.ManifoldPoint = raw.manifoldPoint(&result, i);
        point.point = math2.Vec2(fromBits(w[base]), fromBits(w[base + 1i32]));
        point.anchorA = math2.Vec2(fromBits(w[base + 2i32]), fromBits(w[base + 3i32]));
        point.anchorB = math2.Vec2(fromBits(w[base + 4i32]), fromBits(w[base + 5i32]));
        point.separation = fromBits(w[base + 6i32]); point.normalImpulse = fromBits(w[base + 7i32]);
        point.tangentImpulse = fromBits(w[base + 8i32]); point.totalNormalImpulse = fromBits(w[base + 9i32]);
        point.normalVelocity = fromBits(w[base + 10i32]);
        if (w[base + 11i32] > 65535u32 or w[base + 12i32] > 1u32) { invalid("PORT12: INPUT_DOMAIN\n"); return result; }
        point.id = w[base + 11i32] as u16; point.persisted = w[base + 12i32] == 1u32;
        i = i + 1i32;
    }
    var j: i32 = 0i32;
    while (j < 30i32) {
        if (j != 3i32 and j != 15i32 and j != 16i32 and j != 28i32 and j != 29i32
            and not game.finite(fromBits(w[offset + j]))) { invalid("PORT12: INPUT_DOMAIN\n"); return result; }
        j = j + 1i32;
    }
    return result;
}

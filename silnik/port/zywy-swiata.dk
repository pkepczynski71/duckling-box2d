fun outSleepPublic(reg: ref Registers, id: u32, seq: u32, op: Operation) -> () = {
    sleepPublicWorlds = 0i32; sleepPublicBodies = 0i32;
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved) {
            let status: i32 = game.worldStatus(reg.worlds[wi].number);
            var enabled: bool = false;
            if (status == game.OK) enabled = raw.worlds.at(reg.worlds[wi].number.slot as i64).enableSleep;
            prefix("SW11", id, seq); outDec(wi); outHex(status as u32); outHex(enabled as u32); newline(); sleepPublicWorlds = sleepPublicWorlds + 1i32;
        }
        wi = wi + 1i32;
    }
    var bi: i32 = 0i32;
    while (bi < 256i32) {
        if (reg.bodies[bi].saved) {
            var owner: game.WorldNumber = reg.bodies[bi].owner;
            if (op.opcode == 62i32 and bi == op.b) owner = reg.worlds[op.a].number;
            let state: game.SleepState = game.getSleepState(owner, reg.bodies[bi].number);
            prefix("GS11", id, seq); outDec(bi); outHex(state.status as u32);
            outHex(state.number.slot as u32); outPair(state.number.birthTicket); outPair(state.number.ownerTicket);
            outHex(state.isAwake as u32); outHex(state.isSleeping as u32); outHex(state.sleepEnabled as u32); outFloat(state.sleepThreshold); newline(); sleepPublicBodies = sleepPublicBodies + 1i32;
        }
        bi = bi + 1i32;
    }
}

    }
}

# Box2D 8c661469, src/shape.                                                                                                    
fun validRawReplacement12(shape: raw.ShapeRecord) -> bool = {
    if (shape.shapeType == 0i32) return game.finiteVector(shape.circle.center) and game.finite(shape.circle.radius);
    if (shape.shapeType == 1i32) return game.finiteVector(shape.capsule.center1) and game.finiteVector(shape.capsule.center2) and game.finite(shape.capsule.radius);
    if (shape.shapeType == 2i32) return game.finiteVector(shape.segment.point1) and game.finiteVector(shape.segment.point2);
    if (shape.polygon.count < 3i32 or shape.polygon.count > 8i32 or not game.finite(shape.polygon.radius)) return false;
    var i: i32 = 0i32;
    while (i < shape.polygon.count) { if (not game.finiteVector(shape.polygon.vertices[i])) return false; i = i+1i32; } return true;
}

# Box2D 8c661469, src/world.                                                  
fun lockOpcode12(kind: u32) -> bool = {
    if (kind < 200u32) return false; let code: u32 = kind-200u32;
    return code == 1u32 or code == 2u32 or code == 3u32 or code == 4u32 or (code >= 10u32 and code <= 13u32) or (code >= 15u32 and code <= 19u32)
        or code == 30u32 or code == 32u32 or (code >= 34u32 and code <= 36u32) or code == 40u32 or code == 55u32
        or (code >= 57u32 and code <= 61u32) or (code >= 80u32 and code <= 87u32) or code == 90u32;
}
# Box2D 8c661469, src/world.                                                                           
fun setupGuardWorld12(reg: ref Registers,locking: bool,secondShape: bool) -> bool = {
    var params = game.SolverWorldParameters(); params.gravity = math2.Vec2(); params.maximumLinearSpeed = 100.0f32;
    let created: game.WorldResult = game.createSleepWorld(math2.Vec2(),100.0f32,params,not locking);
    if (created.status != game.OK) return false; reg.worlds[0] = SavedWorld(true,created.number,created.id);
    var def = raw.BodyDef(); def.bodyType = if locking then 0i32 else 2i32; def.enableSleep = not locking;
    let first: game.BodyResult = game.createBody8(created.number,def); if (first.status != game.OK) return false;
    reg.bodies[0] = SavedBody(true,first.number,created.number,first.id);
    var shape = raw.ShapeRecord(); shape.circle = math2.Circle(math2.Vec2(),1.0f32); shape.friction = 0.5f32; shape.userMaterialId = 3i32;
    shape.enableContactEvents = locking; shape.enablePreSolveEvents = locking; shape.enableHitEvents = false;
    let firstShape: game.ShapeResult = game.addPreparedShapeFlags12(created.number,first.number,shape,false,true); if (firstShape.status != game.OK) return false;
    reg.shapes[0] = SavedShape(true,firstShape.number,created.number,firstShape.id);
    if (locking or secondShape) {
        def.bodyType = 2i32; if (locking) def.position = math2.Vec2(0.0f32,1.5f32);
        let second: game.BodyResult = game.createBody8(created.number,def); if (second.status != game.OK) return false;
        reg.bodies[1] = SavedBody(true,second.number,created.number,second.id); shape.userMaterialId = if locking then 3i32 else 5i32;
        let secondValue: game.ShapeResult = game.addPreparedShapeFlags12(created.number,second.number,shape,false,true); if (secondValue.status != game.OK) return false;
        reg.shapes[1] = SavedShape(true,secondValue.number,created.number,secondValue.id);
    }
    return true;
}
# Box2D 8c661469, src/world.                                                                           
fun guardExtended12(kind: u32,words: ref u32[64]) -> i64 = {
    let code: u32 = kind-100u32;
    if (not prevalidateLiveWords(code,words)) return 2i64;
    if ((code == 82u32 and words[1] != 1u32) or (code == 84u32 and words[2] != 1u32)) { invalid("PORT12: INPUT_MODE\n"); return 2i64; }
    let op: Operation = decodePayload12(code,words); if (not inputOk) return 2i64;
    var reg = Registers(); if (not setupGuardWorld12(&reg,false,code == 87u32 and op.kind < 2i32)) { invalid("PORT12: INPUT_DOMAIN\n"); return 2i64; }
    var status: i32 = game.OK;
    if (code == 84u32) { if (not game.validName(op.def.name)) status = game.PARAM; }
    else if (code == 82u32) {
        if (op.kind == 5i32) { if (not game.finiteVector(math2.Vec2(fromBits(words[3]),fromBits(words[4])))) status = game.PARAM; }
        else if (op.kind == 4i32) { if (not game.finite(fromBits(words[3])) or fromBits(words[3]) <= 0.0f32) status = game.PARAM; }
        else if (op.kind != 0i32) {
            var i: i32 = 3i32; let stop: i32 = if op.kind == 3i32 then 6i32 else 4i32;
            while (i < stop) { if (not game.validNonnegative(fromBits(words[i]))) status = game.PARAM; i = i+1i32; }
        }
    } else if (words[2] != 0u32) {
        if (op.kind < 2i32) {
            status = game.rulePairStatus12(reg.worlds[0].number,reg.shapes[words[3] as i32].number,reg.shapes[words[4] as i32].number);
            if (status == game.OK and op.kind == 1i32) {
                let rule: game.PreRule12 = game.PreRule12(reg.shapes[words[3] as i32].number,reg.shapes[words[4] as i32].number,words[5] != 0u32,math2.Vec2(fromBits(words[6]),fromBits(words[7])),fromBits(words[8]),words[9] != 0u32,math2.Vec2(fromBits(words[10]),fromBits(words[11])));
                if (not game.validPreRule12(rule)) status = game.PARAM;
            }
        } else if (not game.validNonnegative(fromBits(words[5]))) status = game.PARAM;
    }
    cleanup(&reg); io.writeStr("GUARD12 1\n"); io.writeStr("G 1"); outDec(kind as i32); outDec(0i32); outDec(0i32); newline(); io.writeStr("GA 1"); outFixtureWords(words,64i32);
    io.writeStr("CASE 1 0\n"); outGuardResult(0u32,(1000u32+code) as i32,status,status == game.OK,0i64); checkEnd(); if (not inputOk) return 2i64;
    io.writeStr("ENDCASE 1\nEND 1\n"); return 0i64;
}
var lockReg12: Registers = Registers();
var lockOperation12: Operation = Operation();
var lockStatus12: i32 = -1i32;
var lockCalls12: i32 = 0i32;
# Box2D 8c661469, src/contact.                                                                                         
fun lockPreSolve12(a: broad.ShapeId,b: broad.ShapeId,manifold: ref math2.Manifold,context: words64.Key64) -> bool = {
    lockCalls12 = lockCalls12+1i32;
    if (lockCalls12 == 1i32) lockStatus12 = invokeLockedGame12(&lockReg12,lockOperation12);
    return true;
}
# Box2D 8c661469, src/world.                                                                                                   
fun invokeLockedGame12(reg: ref Registers,op: Operation) -> i32 = {
    if (op.opcode >= 80i32) { var execution = Execution(); var body = SavedBody(); var kind: i32 = 0i32; return runLiveOperation(reg,op,&execution,&body,&kind); }
    var owner: game.WorldNumber = reg.worlds[op.a].number;
    if (op.opcode == 1i32) return game.destroyWorld(owner);
    if (op.opcode == 2i32 or op.opcode == 30i32) {
        let result: game.BodyResult = if op.opcode == 2i32 then game.createBody(reg.worlds[op.b].number,op.def) else game.createBody8(reg.worlds[op.b].number,op.def); return result.status;
    }
    if (op.opcode == 10i32 or op.opcode == 17i32 or op.opcode == 40i32) {
        var shape = game.ShapeResult();
        if (op.opcode == 10i32) shape = game.createShapeRaw(reg.worlds[op.b].number,reg.bodies[op.c].number,op.source,op.updateMass,op.invoke);
        else if (op.tag == 4i32) shape = game.addBoxFlags12(reg.worlds[op.b].number,reg.bodies[op.c].number,game.BoxGeometry(op.halfWidth,op.halfHeight,op.localCenter,op.localRotation,op.radius),op.source,op.invoke,true);
        else shape = game.addShapeFlags12(reg.worlds[op.b].number,reg.bodies[op.c].number,op.source,op.invoke,true);
        return shape.status;
    }
    if (op.opcode == 16i32) {
        var pair = game.PairResult();
        if (op.tag == 4i32) pair = game.createBodyWithBox(reg.worlds[op.b].number,op.def,game.BoxGeometry(op.halfWidth,op.halfHeight,op.localCenter,op.localRotation,op.radius),op.source,op.invoke,op.source.hasObjectId,op.source.objectId);
        else pair = game.createBodyWithShape(reg.worlds[op.b].number,op.def,op.source,op.invoke,op.source.hasObjectId,op.source.objectId); return pair.status;
    }
    if (op.opcode == 32i32) { let stepped: game.StepResult = game.step(owner,game.StepParameters(op.dt,op.subStepCount)); return stepped.status; }
    if (op.opcode == 55i32) return game.enableWarmStarting(owner,op.wake);
    if (op.opcode == 57i32) { let created: game.BodyResult = game.createBody8(reg.worlds[op.b].number,op.def); return created.status; }
    if (op.opcode == 61i32) return game.setSleepingEnabled(owner,op.wake);
    if (op.opcode == 15i32) {
        if (op.kind == 2i32) return game.setBodyObjectId(owner,reg.bodies[op.b].number,op.source.hasObjectId,op.source.objectId);
        return game.setShapeObjectId(owner,reg.shapes[op.b].number,op.source.hasObjectId,op.source.objectId);
    }
    if (op.opcode == 11i32) return game.destroyShapeRaw(owner,reg.shapes[op.b].number,op.updateMass);
    if (op.opcode == 12i32) return game.setDensityRaw(owner,reg.shapes[op.b].number,op.source.density,op.updateMass);
    if (op.opcode == 18i32) return game.destroyShape(owner,reg.shapes[op.b].number);
    if (op.opcode == 19i32) return game.setDensity(owner,reg.shapes[op.b].number,op.source.density);
    let number: game.BodyNumber = reg.bodies[op.b].number;
    if (op.opcode == 3i32) return game.destroyBody(owner,number);
    if (op.opcode == 4i32) return game.setTransform(owner,number,op.position,op.rotation);
    if (op.opcode == 13i32) return game.applyMassRaw(owner,number);
    if (op.opcode == 34i32) return game.applyAction(owner,number,op.kind,op.value,op.point,op.wake);
    if (op.opcode == 35i32) return game.setLinearVelocity(owner,number,op.value);
    if (op.opcode == 36i32) return game.setAngularVelocity(owner,number,op.value.x);
    if (op.opcode == 58i32) return game.setAwake(owner,number,op.wake);
    if (op.opcode == 59i32) return game.setSleepEnabled(owner,number,op.wake);
    if (op.opcode == 60i32) return game.setSleepThreshold(owner,number,op.value.x);
    return game.PARAM;
}
# Box2D 8c661469, src/world.                                                                                               
fun guardLock12(kind: u32,words: ref u32[64]) -> i64 = {
    if (not lockOpcode12(kind)) { invalid("PORT12: INPUT_DOMAIN\n"); return 2i64; }
    let code: u32 = kind-200u32;
    let modeIndex: i32 = lockModeIndex12(code);
    if (modeIndex >= 0i32 and words[modeIndex] != 1u32) { invalid("PORT12: INPUT_MODE\n"); return 2i64; }
    lockOperation12 = decodePayload12(code,words); if (not inputOk) return 2i64;
    var fresh = Registers(); lockReg12 = move fresh;
    if (not setupGuardWorld12(&lockReg12,true,true)) { invalid("PORT12: INPUT_DOMAIN\n"); return 2i64; }
    lockStatus12 = -1i32; lockCalls12 = 0i32;
    raw.b2World_SetPreSolveCallback(lockReg12.worlds[0].id,lockPreSolve12,words64.Key64());
    raw.b2World_Step(lockReg12.worlds[0].id,1.0f32/60.0f32,1i32);
    cleanup(&lockReg12);
    if (lockCalls12 != 1i32 or lockStatus12 < 0i32) { invalid("PORT12: INPUT_DOMAIN\n"); return 2i64; }
    io.writeStr("GUARD12 1\n"); io.writeStr("G 1"); outDec(kind as i32); outDec(0i32); outDec(0i32); newline(); io.writeStr("GA 1"); outFixtureWords(words,64i32);
    io.writeStr("CASE 1 0\n"); outGuardResult(0u32,(2000u32+kind-200u32) as i32,lockStatus12,lockStatus12 == game.OK,0i64);
    checkEnd(); if (not inputOk) return 2i64; io.writeStr("ENDCASE 1\nEND 1\n"); return 0i64;
}

# Box2D 8c661469, src/world.                                                                       
fun lockModeIndex12(code: u32) -> i32 = {
    if (code == 30u32) return 15i32; if (code == 35u32) return 4i32; if (code == 36u32) return 3i32; if (code == 40u32) return 58i32;
    if (code == 61u32 or code == 82u32 or code == 86u32) return 1i32;
    if ((code >= 57u32 and code <= 60u32) or code == 80u32 or code == 81u32 or code == 84u32 or code == 90u32) return 2i32;
    if (code == 83u32 or code == 85u32) return 3i32; return -1i32;
}

# Box2D 8c661469, src/body.                                                                         
                                                                                                        
                                                                                                        
fun massGeometryReason12(world: ref raw.World, bodySlot: i32, replacedSlot: i32, replacement: raw.ShapeRecord) -> i32 = {
    var slot: i32 = world.bodies.at(bodySlot as i64).headShapeId;
    while (slot != -1i32) {
        var shape: raw.ShapeRecord = world.shapes.at(slot as i64);
        let next: i32 = shape.nextShapeId;
        if (slot == replacedSlot) shape = replacement;
        if (not game.validShapeGeometry(&shape)) return 0i32;
        slot = next;
    }
    return 5i32;
}

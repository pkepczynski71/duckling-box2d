    if (code == 54u32) { used = 11i32; registers.push(0i32); limits.push(16i32); booleans.push(1i32); booleans.push(10i32); }
    else if (code == 55u32) { used = 2i32; registers.push(0i32); limits.push(16i32); booleans.push(1i32); }

fun readNamedTag(tag: str, arity: i32) -> () = {
    rowError = "PORT12: INPUT_HEADER\n";
    let length: i32 = tag.length() as i32;
    let characters: cptr char = builtins.ptr_from_slice[char](tag) as cptr char;
    if (length == 1i32 and (characters[0] as i32 == 71i32 or characters[0] as i32 == 67i32)) rowError = "PORT12: INPUT_SEQUENCE\n";
    if ((length == 1i32 and characters[0] as i32 == 70i32) or (length == 2i32 and characters[0] as i32 == 71i32 and characters[1] as i32 == 65i32)) rowError = "PORT12: INPUT_WORDS\n";
    let phaseRow: bool = arity == 5i32 and tag.length() == 2i64;
    expectingPhase = phaseRow;
    readRow(); expectingPhase = false; if (not inputOk) return;
    if (not rowHasNewline) { invalid("PORT12: INPUT_EOF\n"); return; }
    if (phaseRow and rowLength >= 2i32 and rowBytes[0] == 70i32 and rowBytes[1] == 32i32) { invalid("PORT12: INPUT_PHASE\n"); return; }
    var i: i32 = 0i32;
    if (rowLength < length or (rowLength > length and rowBytes[length] != 32i32)) { invalid(rowError); return; }
    while (i < length) {
        if (rowBytes[i] != characters[i] as i32) { invalid(rowError); return; }
        i = i + 1i32;
    }
    checkArity(arity); rowPosition = length;
}

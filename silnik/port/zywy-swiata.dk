fun validSleepOperation(reg: ref Registers, op: Operation) -> bool = {
    var initialized: bool = true; var collision: bool = false;
    if (op.opcode == 56i32) collision = reg.worlds[op.a].saved and game.worldStatus(reg.worlds[op.a].number) == game.OK;
    else if (op.opcode == 57i32) { initialized = reg.worlds[op.b].saved; collision = liveBody(reg, op.a); }
    else {
        initialized = reg.worlds[op.a].saved;
        if (op.opcode != 61i32 and op.opcode != 64i32) initialized = initialized and reg.bodies[op.b].saved;
    }
    if (reg.phase != 0i32) { invalid("PORT12: INPUT_PHASE\n"); return false; }
    if (not initialized or collision) { invalid("PORT12: INPUT_REGISTER\n"); return false; }
    if (op.opcode == 64i32) {
        if (CONTACT_PROFILE != 10i32) { invalid("PORT12: INPUT_PHASE\n"); return false; }
        if (op.words[3] != 0u32) { invalid("PORT12: INPUT_PROFILE\n"); return false; }
    }
    return true;
}

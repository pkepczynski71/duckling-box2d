            let sim: raw.ContactSim = world.constraintGraph.colors[color].contactSims.at(local as i64);
            prefix("TASK", id, seq); outDec(slot); outDec(1i32); outDec(ordinal);
            outHex(1u32); outHex(color as u32); outHex(local as u32); outContactSim(sim); newline();
            ordinal = ordinal + 1i32; execution.n9[17] = execution.n9[17] + 1i32; local = local + 1i32;
        }

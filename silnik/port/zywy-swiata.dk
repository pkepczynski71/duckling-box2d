fun outContactRecord(record: raw.ContactRecord) -> () = {
    let alive: bool = record.contactId != -1i32;
    outHex(alive as u32);
    if (not alive) {
        var i: i32 = 1i32;
        while (i < 20i32) { outHex(if i <= 4i32 then 4294967295u32 else 0u32); i = i + 1i32; }
        return;
    }
    outHex(record.contactId as u32); outHex(record.setIndex as u32); outHex(record.colorIndex as u32); outHex(record.localIndex as u32);
    outHex(record.shapeIdA as u32); outHex(record.shapeIdB as u32);
    outHex(record.edgeA.bodyId as u32); outHex(record.edgeA.prevKey as u32); outHex(record.edgeA.nextKey as u32);
    outHex(record.edgeB.bodyId as u32); outHex(record.edgeB.prevKey as u32); outHex(record.edgeB.nextKey as u32);
    outHex(record.islandId as u32); outHex(record.islandPrev as u32); outHex(record.islandNext as u32);
    outHex(record.flags); outHex(record.isMarked as u32); outPair(record.birthTicket);
}

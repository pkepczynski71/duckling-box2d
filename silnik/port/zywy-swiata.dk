        if (op.kind == 0i32) { execution.liveRegister = op.a; return game.worldStatus(owner); }
        if (op.kind == 1i32) return game.bodyStatus(owner, reg.bodies[op.b].number);
        return game.shapeStatus(owner, reg.shapes[op.b].number);
    }
    if (op.opcode == 92i32) {
        let number: game.BodyNumber = reg.bodies[op.b].number;
        if (op.kind == 0i32) execution.liveVector = game.getLocalPoint(owner, number, op.value);
        else if (op.kind == 1i32) execution.liveVector = game.getWorldPoint(owner, number, op.value);
        else if (op.kind == 2i32) execution.liveVector = game.getLocalVector(owner, number, op.value);
        else if (op.kind == 3i32) execution.liveVector = game.getWorldVector(owner, number, op.value);

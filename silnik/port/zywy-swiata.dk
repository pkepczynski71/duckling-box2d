    let result: u32 = (&rawValue as cptr u32)[0];
    return result;
}
# Box2D 8c661469, src/body.c:177. Invalid transport terminates, never a game status.
fun invalid(message: str) -> () = {
    if (not inputOk) return;
    inputOk = false;
    write(2i32, builtins.ptr_from_slice[char](message) as cptr char, message.length() as u64);
}
# Box2D 8c661469, include/box2d/types.h:81. Transport: kontrola-swiat.c:106-120.
# Box2D 8c661469, src/world.c:100.                                                           
fun readRow(componentFrame: bool = false) -> () = {
    rowLength = 0i32; rowPosition = 0i32; rowHasNewline = false;
    if (not inputOk) return;
    var c: i32 = io.readCharCode();
    if (componentFrame and c != 67i32) rowError = "PORT12: INPUT_WORDS\n";
    if (c < 0i32) {
        if (expectingPhase) invalid("PORT12: INPUT_PHASE\n");
        else invalid("PORT12: INPUT_EOF\n"); return;
    }
    while (c >= 0i32 and c != 10i32 and inputOk) {
        if (c == 0i32 or c > 127i32) { invalid(rowError); return; }
        if (rowLength == 2049i32) { invalid(rowError); return; }
        rowBytes[rowLength] = c; rowLength = rowLength + 1i32; c = io.readCharCode();
    }
    rowHasNewline = c == 10i32;
    if (rowHasNewline and rowLength > 0i32 and rowBytes[rowLength - 1i32] == 13i32) rowLength = rowLength - 1i32;
    if (rowLength > 2048i32) { invalid(rowError); return; }
    var i: i32 = 0i32;
    while (i < rowLength) {
        if (rowBytes[i] == 13i32) { invalid(rowError); return; }
        i = i + 1i32;
    }
    if (rowLength == 0i32) { invalid(rowError); return; }
    i = 0i32;
    while (i < rowLength) {
        if (rowBytes[i] == 9i32 or (rowBytes[i] == 32i32 and (i == 0i32 or i == rowLength - 1i32))) {
            invalid(rowError); return;
        }
        if (i > 0i32 and rowBytes[i] == 32i32 and rowBytes[i - 1i32] == 32i32) { invalid(rowError); return; }
        i = i + 1i32;
    }
}
# Box2D 8c661469, src/world.c:100. Frozen row arity before numerical interpretation.
fun checkArity(expected: i32) -> () = {
    if (not inputOk) return;
    var count: i32 = 1i32; var i: i32 = 0i32;
    while (i < rowLength) { if (rowBytes[i] == 32i32) count = count + 1i32; i = i + 1i32; }
    if (count != expected) {
        if (not rowHasNewline) invalid("PORT12: INPUT_EOF\n");
        else invalid(rowError);
    }
}

# Box2D 8c661469, include/box2d/types.h:81. Transport: kontrola-swiat.c:121-136.
# Box2D 8c661469, src/world.c:100.                                                           
fun readWord() -> u32 = {
    if (not inputOk) return 0u32;
    if (rowPosition > 0i32) {
        if (rowPosition >= rowLength or rowBytes[rowPosition] != 32i32) { invalid("PORT12: INPUT_WORDS\n"); return 0u32; }
        rowPosition = rowPosition + 1i32;
    }
    let message: str = if readingPayload then "PORT12: INPUT_WORDS\n" else decimalError;
    let overflowMessage: str = if readingPayload then "PORT12: INPUT_WORDS\n" else decimalOverflow;
    if (rowPosition >= rowLength) { invalid("PORT12: INPUT_WORDS\n"); return 0u32; }
    var value: u64 = 0u64; var digits: i32 = 0i32;
    let leadingZero: bool = rowBytes[rowPosition] == 48i32;
    while (rowPosition < rowLength and rowBytes[rowPosition] != 32i32) {
        let c: i32 = rowBytes[rowPosition];
        if (c < 48i32 or c > 57i32) { invalid(message); return 0u32; }
        if (digits == 10i32) { invalid(overflowMessage); return 0u32; }
        value = value * 10u64 + (c - 48i32) as u64; digits = digits + 1i32;
        if (value > 4294967295u64) { invalid(overflowMessage); return 0u32; }
        if (leadingZero and digits > 1i32) { invalid(message); return 0u32; }
        rowPosition = rowPosition + 1i32;
    }
    if (digits == 0i32) invalid(message);
    return value as u32;
}

# Box2D 8c661469, include/box2d/types.h:81. Transport marker C/O.
# Box2D 8c661469, src/world.c:100.                                                           
fun readTag(tag: i32) -> () = {
    if (not inputOk) return;
    rowError = if tag == 67i32 then "PORT12: INPUT_SEQUENCE\n" else "PORT12: INPUT_WORDS\n";
    readRow();
    if (not inputOk) return;
    if (tag == 67i32 and not rowHasNewline) { invalid("PORT12: INPUT_EOF\n"); return; }
    if (rowBytes[0] != tag or (rowLength > 1i32 and rowBytes[1] != 32i32)) { invalid(rowError); return; }
    if (tag == 67i32) checkArity(3i32);
    rowPosition = 1i32;
}


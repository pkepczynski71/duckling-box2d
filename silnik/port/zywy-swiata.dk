fun thresholdRouteProbe(route: u32, threshold: f32) -> i32 = {
    var parameters = game.SolverWorldParameters(); parameters.gravity = math2.Vec2();
    let madeWorld: game.WorldResult = game.createSleepWorld(parameters.gravity, parameters.maximumLinearSpeed, parameters, true);
    if (madeWorld.status != game.OK) return madeWorld.status;
    var def = raw.BodyDef(); def.bodyType = 2i32; def.sleepThreshold = threshold;
    var status: i32 = game.PARAM;
    if (route == 0u32) { let created0: game.BodyResult = game.createBody(madeWorld.number, def); status = created0.status; }
    else if (route == 1u32) { let created1: game.BodyResult = game.createBody8(madeWorld.number, def); status = created1.status; }
    else if (route == 2u32) { let created2: game.PairResult = game.createBodyWithShape(madeWorld.number, def, game.circleShape(1.0f32, 1.0f32), true, false, words64.Key64()); status = created2.status; }
    else if (route == 3u32) { let created3: game.PairResult = game.createBodyWithPreparedShape(madeWorld.number, def, game.circleShape(1.0f32, 1.0f32), true, false, words64.Key64()); status = created3.status; }
    else if (route == 4u32) { let created4: game.PairResult = game.createBodyWithBox(madeWorld.number, def, game.BoxGeometry(), raw.ShapeRecord(), true, false, words64.Key64()); status = created4.status; }
    else {
        def.sleepThreshold = 0.05f32;
        let created5: game.BodyResult = game.createBody8(madeWorld.number, def);
        if (created5.status == game.OK) status = game.setSleepThreshold(madeWorld.number, created5.number, threshold);
        else status = created5.status;
    }
    game.destroyWorld(madeWorld.number);
    return status;
}

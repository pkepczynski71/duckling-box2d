fun makeGuardWorld17(reg: ref base.Registers, g: ref GuardInput17, helper: bool) -> () = {
    let c: u32[64] = g.context; var parameters = game.SolverWorldParameters(); parameters.gravity = math2.Vec2();
    let made: game.WorldResult = game.createSleepWorld(math2.Vec2(),400.0f32,parameters,true); reg.worlds[0] = base.SavedWorld(true,made.number,made.id);
    var d = raw.BodyDef(); d.bodyType = if helper then 2i32 else 0i32; d.isEnabled = c[32] != 0u32;
    let a: game.BodyResult = game.createBody8(made.number,d); reg.bodies[0] = base.SavedBody(true,a.number,made.number,a.id);
    d.bodyType = 2i32; d.isEnabled = true; let b: game.BodyResult = game.createBody8(made.number,d); reg.bodies[1] = base.SavedBody(true,b.number,made.number,b.id);
    var shape: raw.ShapeRecord = game.circleShape(if c[19] != 0u32 then 1.0f32 else 0.2f32,1.0f32); shape.isSensor = c[19] != 0u32; shape.enableSensorEvents = c[30] != 0u32;
    let first: game.ShapeResult = game.createShapeRaw(made.number,a.number,shape,true,false); reg.shapes[0] = base.SavedShape(true,first.number,made.number,first.id);
    shape.circle.radius = 0.2f32; shape.isSensor = false; shape.enableSensorEvents = true;
    let second: game.ShapeResult = game.createShapeRaw(made.number,b.number,shape,true,false); reg.shapes[1] = base.SavedShape(true,second.number,made.number,second.id);
    if (c[20] != 0u32) raw.b2World_SetCustomFilterCallback(made.id,raw.b2DefaultFilter12,words64.Key64(),true);
    if (not helper) return;
                                                                           
    var world: ref raw.World = raw.worlds.at(made.number.slot as i64);
    world.birthTicket = words64.Key64(c[5],c[6]); world.bodies.at(0i64).birthTicket = words64.Key64(c[15],c[16]); world.shapes.at(0i64).birthTicket = words64.Key64(c[15],c[16]);
    let owner: game.WorldNumber = game.WorldNumber(c[0] as i32,words64.Key64(c[1],c[2]));
    reg.worlds[0].number = owner;
    reg.bodies[0].number = game.BodyNumber(c[7] as i32,words64.Key64(c[8],c[9]),words64.Key64(c[10],c[11])); reg.bodies[0].owner = owner;
    reg.shapes[0].number = game.ShapeNumber(c[7] as i32,words64.Key64(c[8],c[9]),words64.Key64(c[10],c[11])); reg.shapes[0].owner = owner;
    reg.bodies[1].owner = owner; reg.bodies[1].number.ownerTicket = owner.birthTicket; reg.shapes[1].owner = owner; reg.shapes[1].number.ownerTicket = owner.birthTicket;
    game.lastIssued = words64.Key64(c[22],c[23]);
    if (c[20] != 0u32) raw.b2World_SetCustomFilterCallback(made.id,raw.b2DefaultFilter12,words64.Key64(),true);
}
fun guardCall17(reg: ref base.Registers, banks: ref Banks17, g: ref GuardInput17, helperOnly: bool) -> game.SensorAction = {
    let route: i32 = g.route; let owner: game.WorldNumber = reg.worlds[0].number; let parent: game.BodyNumber = reg.bodies[0].number; let target: game.ShapeNumber = reg.shapes[if g.context[18] as i32 < 0i32 then 1i32 else 0i32].number;
    if (route <= 8i32) {
        let shape: raw.ShapeRecord = guardDescription17(g); let d: raw.BodyDef = guardBodyDescription17(g); let geometry: game.BoxGeometry = guardBox17(g);
        let kind: i32 = if route == 4i32 or route == 5i32 or route == 8i32 then 2i32 else (if route == 2i32 or route == 3i32 or route == 7i32 then 1i32 else 0i32);
        if (helperOnly) { let check: game.CreationCheck17 = game.creationPreflight17(owner,parent,d,shape,geometry,kind,route >= 6i32,route == 1i32 or route == 3i32 or route == 5i32); return game.SensorAction(check.status,check.reason); }
        var made = game.ShapeResult(); var pair = game.PairResult();
        if (route == 0i32) made = game.addShape(owner,parent,shape,false);
        if (route == 1i32) made = game.addShapeFlags12(owner,parent,shape,false,true);
        if (route == 2i32) made = game.addPreparedShape(owner,parent,shape,false);
        if (route == 3i32) made = game.addPreparedShapeFlags12(owner,parent,shape,false,true);
        if (route == 4i32) made = game.addBox(owner,parent,geometry,shape,false);
        if (route == 5i32) made = game.addBoxFlags12(owner,parent,geometry,shape,false,true);
        if (route == 6i32) pair = game.createBodyWithShape(owner,d,shape,false,false,words64.Key64());
        if (route == 7i32) pair = game.createBodyWithPreparedShape(owner,d,shape,false,false,words64.Key64());
        if (route == 8i32) pair = game.createBodyWithBox(owner,d,geometry,shape,false,false,words64.Key64());
        if (route >= 6i32) { if (pair.status == game.OK) { reg.bodies[4] = base.SavedBody(true,pair.body.number,owner,pair.body.id); reg.shapes[4] = base.SavedShape(true,pair.shape.number,owner,pair.shape.id); } return game.SensorAction(pair.status,if pair.status == game.LOCKED then 1i32 else pair.sensorReason17); }
        if (made.status == game.OK) reg.shapes[4] = base.SavedShape(true,made.number,owner,made.id);
        return game.SensorAction(made.status,if made.status == game.LOCKED then 1i32 else made.sensorReason17);
    }
    if (route == 9i32) { let status: i32 = game.enableSensorEvents(owner,target,g.context[31] != 0u32); return game.SensorAction(status,if status == game.LOCKED then 1i32 else 0i32); }
    if (route == 10i32) { let value: game.SensorMeta = game.isSensor(owner,target); return game.SensorAction(value.status,value.reason); }
    if (route == 11i32) { let value: game.SensorMeta = game.areSensorEventsEnabled(owner,target); return game.SensorAction(value.status,value.reason); }
    if (route == 12i32) { let value: game.SensorMeta = game.sensorCapacity(owner,target); return game.SensorAction(value.status,value.reason); }
    if (route == 13i32) { var value: game.SensorOverlaps = game.sensorOverlaps(owner,target); return game.SensorAction(value.status,value.reason); }
    if (route == 14i32) return saveOverlaps17(banks,g.words[2] as i32,owner,target);
    if (route == 15i32) return saveEvents17(banks,g.words[2] as i32,1i32,owner,reg.worlds[0].id);
    if (route == 16i32) { if (helperOnly) return game.pairRulesPreflight17(owner,g.context[31] != 0u32); let status: i32 = game.enablePairRules(owner,g.context[31] != 0u32); return game.SensorAction(status,if status == game.LOCKED then 1i32 else (if status == game.PARAM then game.SENSOR_FILTER17 else 0i32)); }
    if (route == 17i32 or route == 18i32) return guardStep17(reg,true,fromBits17(g.words[1]),g.words[2] as i32,g.words[3] as i32,route == 18i32);
    return game.SensorAction(game.PARAM,0i32);
}

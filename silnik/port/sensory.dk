fun population17(kind: i32) -> i32 = {
    var count: i32 = 0i32; var i: i64 = 0i64;
    while (i < raw.worlds.length()) {
        var world: ref raw.World = raw.worlds.at(i);
        if (world.inUse) {
            if (kind == 0i32) count = count+1i32;
            else if (kind == 1i32) count = count+world.bodyIdPool.nextIndex-world.bodyIdPool.freeCount;
            else count = count+world.shapeIdPool.nextIndex-world.shapeIdPool.freeCount;
        } i = i+1i64;
    } return count;
}

                                                                 

    }
    var count: i32 = 1i32; while (count < 6i32) { guardTraceCounts17[count] = guardTraceCounts17[count]+execution.n10[count]; count = count+1i32; }
    base.outputBuckets14[971].rows.clear(); base.outputBuckets14[976].rows.clear();

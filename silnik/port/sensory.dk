                value.number = game.BodyNumber(slot,solverWorld.bodies.at(slot as i64).birthTicket,owner.birthTicket); value.transform = event.transform;
                value.hasObjectId = event.hasObjectId; value.objectId = event.objectId; value.fellAsleep = event.fellAsleep; reg.copies[copySlot].values.push(value); solverMoveIndex = solverMoveIndex+1i64;
            }
        }
    } else if (checked) {
        execution.gameStep = game.step(owner,game.StepParameters(dt,substeps)); execution.status = execution.gameStep.status; reason = execution.gameStep.sensorReason17;
        execution.rawStep.status = execution.status; execution.rawStep.effectiveSubSteps = execution.gameStep.effectiveSubSteps; execution.rawStep.didSolve = execution.gameStep.didSolve;
        if (execution.status == game.OK) { reg.copies[copySlot].saved = true; reg.copies[copySlot].values = copy execution.gameStep.values; }
    } else { execution.rawStep = game.rawSolverStep12(owner,dt,substeps); execution.status = execution.rawStep.status; }

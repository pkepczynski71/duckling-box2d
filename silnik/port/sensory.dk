var guardExecution17: base.Execution = base.Execution(); var guardObservation17: base.Operation = base.Operation(); var guardStepped17: bool = false;
fun guardStep17(reg: ref base.Registers, checked: bool, dt: f32, substeps: i32, copySlot: i32 = 0i32, solverOnly: bool = false) -> game.SensorAction = {
    var op = base.Operation(); op.opcode = if checked then 32i32 else 31i32; op.a = 0i32; op.dt = dt; op.subStepCount = substeps; op.copySlot = copySlot;
    let owner: game.WorldNumber = reg.worlds[0].number;

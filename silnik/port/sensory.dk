fun renderGuardState17(reg: ref base.Registers, id: u32, phase: u32, op: base.Operation) -> () = {
    var retained: base.OutputBucket14[7] = emptyGuardRows17(); var i: i32 = 0i32;
    while (i < 7i32) {
        let rank: i32 = guardRowRank17(i);
        retained[i].rows = builtins.move_out[List[base.OutputRow14]](ptrof base.outputBuckets14[rank].rows);
        var empty: List[base.OutputRow14] = base.emptyOutputRows14(); builtins.move_in[List[base.OutputRow14]](ptrof base.outputBuckets14[rank].rows,move empty); i = i+1i32;
    }

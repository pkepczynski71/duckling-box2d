        if (base.rowBytes[0] != 71i32) { fail17("TAG"); return; }
        base.consumeTag("G"); let actual: u32 = base.readWord(); let guard: u32 = base.readWord(); let gotPhase: u32 = base.readWord(); let route: u32 = base.readWord(); let n: u32 = base.readWord();
        if (actual != id or guard != id) { fail17("GUARD"); return; }
        if (gotPhase != phase) { fail17("PHASE"); return; }
        if (route > 21u32 or route as i32 != guardRoute17(id)) { fail17("FIXTURE"); return; }
        if (n as i32 != guardSize17(id) or tokens17() != 6i32+n as i32) { fail17("ARITY"); return; }
        var g = GuardInput17(); g.route = route as i32; g.count = n as i32-64i32; var i: i32 = 0i32; base.readingPayload = true;
        while (i < 64i32 and base.inputOk) { g.context[i] = base.readWord(); i = i+1i32; }
        var j: i32 = 0i32; while (j < g.count and base.inputOk) { g.words[j] = base.readWord(); j = j+1i32; } base.readingPayload = false; base.endRow();
        var k: i32 = 38i32; while (k < 64i32) { if (g.context[k] != 0u32) fail17("UNUSED"); k = k+1i32; }
        if (g.context[25] != 0u32) { fail17("DOMAIN"); return; }                                              
        if (base.inputOk) guardPhase17(id,phase,&g); phase = phase+1u32;
    }
}

                                                                        
fun churnRow17(reg: ref base.Registers, id: u32, seq: u32, j: i32, phase: i32, op: ref base.Operation) -> () = {

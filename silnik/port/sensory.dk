fun guardOwnership17(reg: ref base.Registers, banks: ref Banks17, g: ref GuardInput17) -> game.SensorAction = {
    let owner: game.WorldNumber = reg.worlds[0].number;
    guardStep17(reg,false,1.0f32/60.0f32,4i32);
    let list: i32 = g.words[2] as i32;
    if (list == 1i32) { raw.b2Body_SetTransform(reg.bodies[1].id,math2.Vec2(4.0f32,0.0f32),math2.Rot(1.0f32,0.0f32)); guardStep17(reg,false,1.0f32/60.0f32,4i32); }
    if (g.route == 19i32) { saveEvents17(banks,0i32,1i32,owner,reg.worlds[0].id); saveEvents17(banks,1i32,1i32,owner,reg.worlds[0].id); }
    else { saveOverlaps17(banks,0i32,owner,reg.shapes[0].number); saveOverlaps17(banks,1i32,owner,reg.shapes[0].number); }
    if (g.words[1] != 0u32) {
        let field: i32 = g.words[0] as i32; var word: u32 = 0u32;
        if (g.route == 20i32) word = banks.overlaps[0].values.at(0i64).words[field];
        else if (list == 0i32) word = banks.events[0].beginEvents.at(0i64).words[field];
        else word = banks.events[0].endEvents.at(0i64).words[field];
        editCopy17(banks,if g.route == 19i32 then 0i32 else 1i32,0i32,list,0i32,field,word ^ 1u32);
    }

                                                            
                                                                          
                                         
                              
import fizyka.swiat as raw;
import fizyka.gra as game;
import fizyka.kola as math2;
import fizyka.szeroka as broad;
import fizyka.zbior as words64;
import fizyka.ruch as mass2;
import core.primitive_io as io;
import core.builtins as builtins;
import portbase as base;

                                                                   
fun toBits17(value: f32) -> u32 = { var word: f32 = value; return (&word as cptr u32)[0]; }
fun fromBits17(value: u32) -> f32 = { var word: u32 = value; return (&word as cptr f32)[0]; }
fun unsigned17(value: u64) -> () = {
    if (value >= 10u64) unsigned17(value/10u64);
    base.outputChar14(('0' as u64+value%10u64) as char);
}
fun decimal17(value: i32) -> () = { base.outputChar14(' '); unsigned17(value as u64); }
fun hex17(value: u32) -> () = {
    base.outputChar14(' '); var shift: i32 = 28i32;
    while (shift >= 0i32) {
        let digit: u32 = (value >> shift as u32) & 15u32;
        base.outputChar14((if digit < 10u32 then 48u32+digit else 87u32+digit) as char); shift = shift-4i32;
    }
}
fun pair17(value: words64.Key64) -> () = { hex17(value.low); hex17(value.high); }
fun prefix17(tag: str, id: u32, seq: u32) -> () = {
    base.currentOutputRank14 = if base.sameText13(tag,"E17") or base.sameText13(tag,"E16") or base.sameText13(tag,"G17") then 0i32 else (if base.sameText13(tag,"Q17") then 90i32 else (if base.sameText13(tag,"R17") or base.sameText13(tag,"R16") then 199i32 else (if base.sameText13(tag,"U17") then 1281i32 else (if base.sameText13(tag,"W17") then 1282i32 else 1280i32))));
    base.outputString14(tag); decimal17(id as i32); decimal17(seq as i32); }
fun newline17() -> () = { base.outputChar14('\n'); }
fun rawId17(value: broad.ShapeId) -> () = { hex17(value.index1 as u32); hex17(value.world0 as u32); hex17(value.generation as u32); }
fun number17(value: game.ShapeNumber) -> () = { hex17(value.slot as u32); pair17(value.birthTicket); pair17(value.ownerTicket); }
fun echo17(id: u32, seq: u32, opcode: i32, count: i32, words: ref u32[64]) -> () = {
    prefix17(if opcode >= 400i32 then "E17" else "E16",id,seq); decimal17(opcode); decimal17(count); var i: i32 = 0i32;
    while (i < count) { hex17(words[i]); i = i+1i32; } newline17();
}
fun answer17(id: u32, seq: u32, opcode: i32, status: i32, reason: i32, count: i32, words: ref u32[64]) -> () = {
    prefix17(if opcode >= 300i32 and opcode < 400i32 then "R16" else "R17",id,seq); decimal17(opcode); decimal17(status); decimal17(reason); decimal17(count);
    var i: i32 = 0i32; while (i < count) { hex17(if status == game.OK then words[i] else 0u32); i = i+1i32; } newline17();
}
                                                                                                                 
fun shapeDescription17(words: ref u32[64]) -> raw.ShapeRecord = {
    var value = raw.ShapeRecord(); value.shapeType = words[3] as i32;
    if (value.shapeType == 0i32) value.circle = math2.Circle(math2.Vec2(fromBits17(words[4]),fromBits17(words[5])),fromBits17(words[6]));
    if (value.shapeType == 1i32) value.capsule = raw.Capsule(math2.Vec2(fromBits17(words[4]),fromBits17(words[5])),math2.Vec2(fromBits17(words[6]),fromBits17(words[7])),fromBits17(words[8]));
    if (value.shapeType == 2i32) value.segment = raw.Segment(math2.Vec2(fromBits17(words[4]),fromBits17(words[5])),math2.Vec2(fromBits17(words[6]),fromBits17(words[7])));
    if (value.shapeType == 3i32) {
        value.polygon.count = words[4] as i32; value.polygon.radius = fromBits17(words[5]); var i: i32 = 0i32;
        while (i < 8i32) { value.polygon.vertices[i] = math2.Vec2(fromBits17(words[6i32+2i32*i]),fromBits17(words[7i32+2i32*i])); i = i+1i32; }
    }
    value.density = fromBits17(words[44]); value.friction = fromBits17(words[45]); value.restitution = fromBits17(words[46]);
    value.rollingResistance = fromBits17(words[47]); value.tangentSpeed = fromBits17(words[48]); value.userMaterialId = words[49] as i32;
    value.filter.categoryBits = ((words[51] as u64 << 32u64) | words[50] as u64) as i64;
    value.filter.maskBits = ((words[53] as u64 << 32u64) | words[52] as u64) as i64; value.filter.groupIndex = words[54] as i32;
    value.enableContactEvents = words[56] != 0u32; value.enableHitEvents = words[57] != 0u32;
    value.isSensor = words[59] != 0u32; value.enableSensorEvents = words[60] != 0u32; value.enablePreSolveEvents = words[62] != 0u32;
    return value;
}
fun boxDescription17(words: ref u32[64]) -> game.BoxGeometry = {
    return game.BoxGeometry(fromBits17(words[4]),fromBits17(words[5]),math2.Vec2(fromBits17(words[6]),fromBits17(words[7])),
        math2.Rot(fromBits17(words[8]),fromBits17(words[9])),fromBits17(words[10]));
}
                                                                                
fun create17(owner: game.WorldNumber, parent: game.BodyNumber, parentId: raw.BodyId, words: ref u32[64]) -> game.ShapeResult = {
    var shape: raw.ShapeRecord = shapeDescription17(words);
    let invoke: bool = words[55] != 0u32;
    if (words[58] != 0u32) {
        if (words[3] == 4u32) return game.addBoxFlags12(owner,parent,boxDescription17(words),shape,invoke,true);
        return game.addShapeFlags12(owner,parent,shape,invoke,true);
    }
    if (words[3] == 4u32) {
        let boxShape: game.BoxGeometry = boxDescription17(words); shape.shapeType = 3i32;
        shape.polygon = mass2.b2MakeOffsetRoundedBox(boxShape.halfWidth,boxShape.halfHeight,boxShape.center,boxShape.rotation,boxShape.radius);
    }
    if (words[3] == 3u32) raw.b2MakePolygon(&shape.polygon);
    var result = game.ShapeResult(); result.status = game.OK;
    if (game.ticketLimit(game.lastIssued)) { result.status = game.LIMIT; return result; }
    let ticket: words64.Key64 = game.nextTicket(game.lastIssued);
    result.id = raw.b2CreateShape(parentId,shape,words[61] != 0u32,invoke);
    if (result.id.index1 != 0i32) {
        let slot: i32 = result.id.index1-1i32;
        raw.worlds.at(parentId.world0 as i64).shapes.at(slot as i64).birthTicket = ticket;
        game.lastIssued = ticket; result.number = game.ShapeNumber(slot,ticket,owner.birthTicket);
    }
    return result;
}
fun setEvents17(mode: i32, owner: game.WorldNumber, number: game.ShapeNumber, id: broad.ShapeId, flag: bool) -> game.SensorAction = {
    if (mode == 0i32) { raw.b2Shape_EnableSensorEvents(id,flag); return game.SensorAction(); }
    let status: i32 = game.enableSensorEvents(owner,number,flag);
    return game.SensorAction(status,if status == game.LOCKED then 1i32 else 0i32);
}
fun readMeta17(mode: i32, owner: game.WorldNumber, number: game.ShapeNumber, id: broad.ShapeId, kind: i32) -> game.SensorMeta = {
    if (mode == 1i32) {
        if (kind == 0i32) return game.isSensor(owner,number);
        if (kind == 1i32) return game.areSensorEventsEnabled(owner,number);
        return game.sensorCapacity(owner,number);
    }
    if (kind == 0i32) return game.SensorMeta(game.OK,0i32,raw.b2Shape_IsSensor(id) as i32);
    if (kind == 1i32) return game.SensorMeta(game.OK,0i32,raw.b2Shape_AreSensorEventsEnabled(id) as i32);
    return game.SensorMeta(game.OK,0i32,raw.b2Shape_GetSensorCapacity(id));
}
fun touch17(value: raw.SensorEvent) -> game.SensorTouch = { return game.sensorTouch17(value); }
                                                                                             
fun overlaps17(mode: i32, owner: game.WorldNumber, number: game.ShapeNumber, id: broad.ShapeId, capacity: i32) -> game.SensorOverlaps = {
    if (mode == 1i32) return game.sensorOverlaps(owner,number);
    var result = game.SensorOverlaps(); result.status = game.OK;
    var world: ref raw.World = raw.worlds.at(id.world0 as i64);
    if (world.locked) return result;
    let index: i32 = world.shapes.at((id.index1-1i32) as i64).sensorIndex;
    if (index == -1i32) return result;
    var i: i64 = 0i64;
    while (i < capacity as i64 and i < world.sensors.at(index as i64).overlaps2.length()) {
        let r: raw.ShapeRef = world.sensors.at(index as i64).overlaps2.at(i);
        result.values.push(game.SensorOverlap(broad.ShapeId(r.shapeId+1i32,world.worldId,r.generation),game.ShapeNumber(r.shapeId,r.birthTicket,world.birthTicket)));
        i = i+1i64;
    }
    return result;
}
fun zeroCopyWords17() -> u32[16] = { var values: u32[16]; return values; }
class CopyWords17 { words: u32[16] = zeroCopyWords17(); }
fun emptyCopyWords17() -> List[CopyWords17] = { var values: List[CopyWords17]; return values; }
class EventBank17 { saved: bool = false; beginEvents: List[CopyWords17] = emptyCopyWords17(); endEvents: List[CopyWords17] = emptyCopyWords17(); }
class OverlapBank17 { saved: bool = false; sensorSlot: i32 = 0i32; values: List[CopyWords17] = emptyCopyWords17(); }
fun eventBanks17() -> EventBank17[4] = { var values: EventBank17[4]; return values; }
fun overlapBanks17() -> OverlapBank17[4] = { var values: OverlapBank17[4]; return values; }
class Banks17 { events: EventBank17[4] = eventBanks17(); overlaps: OverlapBank17[4] = overlapBanks17(); }
                                                                                                 
fun storeNumber17(words: ref u32[16], offset: i32, value: game.ShapeNumber) -> () = {
    words[offset] = value.slot as u32; words[offset+1i32] = value.birthTicket.low; words[offset+2i32] = value.birthTicket.high;
    words[offset+3i32] = value.ownerTicket.low; words[offset+4i32] = value.ownerTicket.high;
}
fun touchPacket17(value: game.SensorTouch) -> CopyWords17 = {
    var result = CopyWords17(); result.words[0] = value.sensorId.index1 as u32; result.words[1] = value.sensorId.world0 as u32; result.words[2] = value.sensorId.generation as u32;
    result.words[3] = value.visitorId.index1 as u32; result.words[4] = value.visitorId.world0 as u32; result.words[5] = value.visitorId.generation as u32;
    storeNumber17(&result.words,6i32,value.sensor); storeNumber17(&result.words,11i32,value.visitor); return result;
}
fun overlapPacket17(value: game.SensorOverlap) -> CopyWords17 = {
    var result = CopyWords17(); result.words[0] = value.id.index1 as u32; result.words[1] = value.id.world0 as u32; result.words[2] = value.id.generation as u32;
    storeNumber17(&result.words,3i32,value.number); return result;
}
                                                                                              
fun saveEvents17(banks: ref Banks17, slot: i32, mode: i32, owner: game.WorldNumber, id: raw.WorldId) -> game.SensorAction = {
    var value = game.SensorEventCopy();
    if (mode == 1i32) value = game.copySensorEvents(owner);
    else {
        value.status = game.OK; var events: raw.SensorEvents = raw.b2World_GetSensorEvents(id); var i: i64 = 0i64;
        while (i < events.beginEvents.length()) { value.beginEvents.push(touch17(events.beginEvents.at(i))); i = i+1i64; }
        var j: i64 = 0i64; while (j < events.endEvents.length()) { value.endEvents.push(touch17(events.endEvents.at(j))); j = j+1i64; }
    }
    let status: i32 = value.status; let reason: i32 = value.reason;
    if (status == game.OK) {
        var saved = EventBank17(); saved.saved = true; var bi: i64 = 0i64; var ei: i64 = 0i64;
        while (bi < value.beginEvents.length()) { saved.beginEvents.push(touchPacket17(value.beginEvents.at(bi))); bi = bi+1i64; }
        while (ei < value.endEvents.length()) { saved.endEvents.push(touchPacket17(value.endEvents.at(ei))); ei = ei+1i64; }
        banks.events[slot] = move saved;
    }
    return game.SensorAction(status,reason);
}
fun saveOverlaps17(banks: ref Banks17, slot: i32, owner: game.WorldNumber, number: game.ShapeNumber) -> game.SensorAction = {
    var value: game.SensorOverlaps = game.sensorOverlaps(owner,number); let status: i32 = value.status; let reason: i32 = value.reason;
    if (status == game.OK) {
        var saved = OverlapBank17(); saved.saved = true; saved.sensorSlot = number.slot; var i: i64 = 0i64;
        while (i < value.values.length()) { saved.values.push(overlapPacket17(value.values.at(i))); i = i+1i64; }
        banks.overlaps[slot] = move saved;
    }
    return game.SensorAction(status,reason);
}
                                                                                                       
fun editCopy17(banks: ref Banks17, kind: i32, bank: i32, list: i32, index: i32, field: i32, word: u32) -> () = {
    if (kind == 0i32) {
        if (list == 0i32) banks.events[bank].beginEvents.at(index as i64).words[field] = word;
        else banks.events[bank].endEvents.at(index as i64).words[field] = word;
    } else banks.overlaps[bank].values.at(index as i64).words[field] = word;
}
fun list17(id: u32, seq: u32, source: i32, bank: i32, kind: i32, sensorSlot: i32, count: i32) -> () = {
    prefix17("L17",id,seq); base.currentOutputRank14 = 1280i32; decimal17(source); decimal17(bank); decimal17(kind); decimal17(sensorSlot); decimal17(count); newline17();
}
fun touchWords17(value: game.SensorTouch) -> () = { rawId17(value.sensorId); rawId17(value.visitorId); number17(value.sensor); number17(value.visitor); }
fun touches17(id: u32, seq: u32, source: i32, bank: i32, kind: i32, values: ref List[raw.SensorEvent]) -> i32 = {
    list17(id,seq,source,bank,kind,0i32,values.length() as i32); var i: i64 = 0i64;
    while (i < values.length()) {
        prefix17("T17",id,seq); base.currentOutputRank14 = 1280i32; decimal17(source); decimal17(bank); decimal17(kind); decimal17(0i32); decimal17(i as i32); decimal17(16i32);
        touchWords17(touch17(values.at(i))); newline17(); i = i+1i64;
    }
    return values.length() as i32;
}
fun overlapRows17(id: u32, seq: u32, source: i32, bank: i32, sensorSlot: i32, values: ref List[game.SensorOverlap]) -> i32 = {
    list17(id,seq,source,bank,2i32,sensorSlot,values.length() as i32); var i: i64 = 0i64;
    while (i < values.length()) {
        prefix17("T17",id,seq); base.currentOutputRank14 = 1280i32; decimal17(source); decimal17(bank); decimal17(2i32); decimal17(sensorSlot); decimal17(i as i32); decimal17(8i32);
        let value: game.SensorOverlap = values.at(i); rawId17(value.id); number17(value.number); newline17(); i = i+1i64;
    }
    return values.length() as i32;
}
fun savedRows17(id: u32, seq: u32, banks: ref Banks17) -> i32 = {
    var rows: i32 = 0i32; var k: i32 = 0i32;
    while (k < 4i32) {
        if (banks.events[k].saved) {
            rows = rows+packetRows17(id,seq,k,0i32,0i32,16i32,&banks.events[k].beginEvents);
            rows = rows+packetRows17(id,seq,k,1i32,0i32,16i32,&banks.events[k].endEvents);
        }
        if (banks.overlaps[k].saved) rows = rows+packetRows17(id,seq,k,2i32,banks.overlaps[k].sensorSlot,8i32,&banks.overlaps[k].values);
        k = k+1i32;
    }
    return rows;
}
fun packetRows17(id: u32, seq: u32, bank: i32, list: i32, sensorSlot: i32, count: i32, values: ref List[CopyWords17]) -> i32 = {
    list17(id,seq,2i32,bank,list,sensorSlot,values.length() as i32); var i: i64 = 0i64;
    while (i < values.length()) {
        prefix17("T17",id,seq); base.currentOutputRank14 = 1280i32; decimal17(2i32); decimal17(bank); decimal17(list); decimal17(sensorSlot); decimal17(i as i32); decimal17(count);
        var k: i32 = 0i32; while (k < count) { hex17(values.at(i).words[k]); k = k+1i32; } newline17(); i = i+1i64;
    }
    return values.length() as i32;
}
fun defaults17(kind: i32) -> u32[64] = {
    var value = raw.ShapeRecord(); if (kind == 1i32) value = game.sensorDescription(value);
    var words: u32[64]; words[0] = toBits17(value.density); words[1] = value.isSensor as u32; words[2] = value.enableSensorEvents as u32;
    words[3] = value.enableContactEvents as u32; words[4] = value.enableHitEvents as u32; words[5] = value.enablePreSolveEvents as u32; return words;
}
fun compareRefs17(words: ref u32[64]) -> i32 = {
    return raw.b2CompareShapeRefs(raw.ShapeRef(words[1] as i32,words[2] as u16,words64.Key64()),raw.ShapeRef(words[3] as i32,words[4] as u16,words64.Key64()));
}
fun guard17(id: u32, phase: u32, status: i32, reason: i32, accepted: bool) -> () = {
    prefix17("G17",id,phase); decimal17(status); decimal17(reason); decimal17(accepted as i32); decimal17(0i32); newline17();
}
                                                                                          
fun beginOperation17(world: ref raw.World) -> () = { world.sensorQueryTrace.clear(); }
                                                                                                           
fun queries17(id: u32, seq: u32, worldRegister: i32, world: ref raw.World) -> () = {
    var i: i64 = 0i64;
    let count: i64 = if guardObserving17 then guardQueries17.length() else world.sensorQueryTrace.length();
    while (i < count) {
        let q: raw.SensorQueryTrace = if guardObserving17 then guardQueries17.at(i) else world.sensorQueryTrace.at(i);
        prefix17("Q17",id,seq); decimal17(worldRegister); decimal17(i as i32); decimal17(4i32);
        hex17(q.sensorSlot as u32); hex17(q.visitorSlot as u32); hex17(q.treeType as u32); hex17(toBits17(q.distance)); newline17(); i = i+1i64;
    }
}
                                                                                                
                                                                               
                                                                                          
fun flagRow17(id: u32, seq: u32, wr: i32, slot: i32, shape: broad.ShapeId) -> () = {
    prefix17("V17",id,seq); decimal17(wr); decimal17(slot); decimal17(2i32);
    hex17(raw.b2Shape_IsSensor(shape) as u32); hex17(raw.b2Shape_AreSensorEventsEnabled(shape) as u32); newline17();
}
fun currentRows17(reg: ref base.Registers, id: u32, seq: u32, worldRegister: i32, world: ref raw.World) -> i32 = {
    var seen: List[bool]; var i: i64 = 0i64; while (i < world.shapes.length()) { seen.push(false); i = i+1i64; }
    var sr: i32 = 0i32;
    while (sr < 512i32) {
        if (base.liveShape(reg,sr) and reg.shapes[sr].id.world0 == world.worldId) {
            let slot: i32 = reg.shapes[sr].id.index1-1i32;
            if (not seen.at(slot as i64)) { flagRow17(id,seq,worldRegister,slot,reg.shapes[sr].id); seen.at(slot as i64) = true; }
        } sr = sr+1i32;
    }
    var si0: i64 = 0i64; while (si0 < world.shapes.length()) {
        if (world.shapes.at(si0).id != -1i32 and not seen.at(si0)) flagRow17(id,seq,worldRegister,si0 as i32,raw.b2MakeShapeId(world,si0 as i32));
        si0 = si0+1i64;
    }
    var events: raw.SensorEvents = raw.b2World_GetSensorEvents(raw.WorldId((world.worldId+1u16),world.generation));
    var rows: i32 = touches17(id,seq,0i32,worldRegister,0i32,&events.beginEvents);
    rows = rows+touches17(id,seq,0i32,worldRegister,1i32,&events.endEvents);
    var si: i64 = 0i64;
    while (si < world.shapes.length()) {
        if (world.shapes.at(si).id != -1i32 and world.shapes.at(si).sensorIndex != -1i32) {
            let sensorId: broad.ShapeId = raw.b2MakeShapeId(world,si as i32);
            var overlaps: game.SensorOverlaps = overlaps17(0i32,game.WorldNumber(),game.ShapeNumber(),sensorId,raw.b2Shape_GetSensorCapacity(sensorId));
            rows = rows+overlapRows17(id,seq,0i32,worldRegister,si as i32,&overlaps.values);
        }
        si = si+1i64;
    }
    return rows;
}
fun privatePrefix17(id: u32, seq: u32, worldRegister: i32, sensorIndex: i32, group: i32, index: i32, count: i32) -> () = {
    prefix17("U17",id,seq); decimal17(worldRegister); decimal17(sensorIndex); decimal17(group); decimal17(index); decimal17(count);
}
fun refs17(id: u32, seq: u32, worldRegister: i32, sensorIndex: i32, group: i32, values: ref List[raw.ShapeRef]) -> () = {
    var i: i64 = 0i64;
    while (i < values.length()) {
        let value: raw.ShapeRef = values.at(i);
        privatePrefix17(id,seq,worldRegister,sensorIndex,group,i as i32,4i32);
        hex17(value.shapeId as u32); hex17(value.generation as u32); pair17(value.birthTicket); newline17(); i = i+1i64;
    }
}
fun physicalEnd17(id: u32, seq: u32, worldRegister: i32, group: i32, values: ref List[raw.SensorEvent]) -> () = {
    var i: i64 = 0i64;
    while (i < values.length()) {
        privatePrefix17(id,seq,worldRegister,0i32,group,i as i32,16i32); touchWords17(touch17(values.at(i))); newline17(); i = i+1i64;
    }
}
fun privateRows17(id: u32, seq: u32, worldRegister: i32, world: ref raw.World) -> () = {
    var i: i64 = 0i64;
    while (i < world.sensors.length()) {
        var sensor: ref raw.Sensor = world.sensors.at(i);
        privatePrefix17(id,seq,worldRegister,i as i32,0i32,0i32,3i32);
        hex17(sensor.shapeId as u32); hex17(sensor.overlaps1.length() as u32); hex17(sensor.overlaps2.length() as u32); newline17();
        refs17(id,seq,worldRegister,i as i32,1i32,&sensor.overlaps1); refs17(id,seq,worldRegister,i as i32,2i32,&sensor.overlaps2); i = i+1i64;
    }
    var k: i32 = 0i32;
    while (k < world.sensorEventBits.blockCount) {
        privatePrefix17(id,seq,worldRegister,0i32,3i32,k,2i32); pair17(world.sensorEventBits.bits.at(k as i64)); newline17(); k = k+1i32;
    }
    physicalEnd17(id,seq,worldRegister,4i32,&world.sensorEndEvents0); physicalEnd17(id,seq,worldRegister,5i32,&world.sensorEndEvents1);
}
fun counters17(id: u32, seq: u32, worldRegister: i32, listRows: i32, world: ref raw.World) -> () = {
    prefix17("W17",id,seq); decimal17(worldRegister); decimal17(8i32);
    hex17(world.sensors.length() as u32); hex17(world.sensorBeginEvents.length() as u32);
    hex17(world.sensorEndEvents0.length() as u32); hex17(world.sensorEndEvents1.length() as u32); hex17(world.endEventArrayIndex as u32);
    hex17(world.sensorEventBits.blockCount as u32); hex17((if guardObserving17 then guardQueries17.length() else world.sensorQueryTrace.length()) as u32); hex17(listRows as u32); newline17();
}
                                                                                    
fun fail17(kind: str) -> () = {
    if (not base.inputOk) return;
    base.inputOk = false;
    let a: str = "PORT17: INPUT_"; let lf: str = "\n";
    base.write(2i32,builtins.ptr_from_slice[char](a) as cptr char,a.length() as u64);
    base.write(2i32,builtins.ptr_from_slice[char](kind) as cptr char,kind.length() as u64);
    base.write(2i32,builtins.ptr_from_slice[char](lf) as cptr char,1u64);
}

fun tokens17() -> i32 = { var n: i32 = 1i32; var i: i32 = 0i32; while (i < base.rowLength) { if (base.rowBytes[i] == 32i32) n = n+1i32; i = i+1i32; } return n; }

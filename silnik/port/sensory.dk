        if (body) { if (not game.bodyMetadataValid17(c[13] as i32,c[14] as i32,actual,expected)) return game.SensorAction(game.STALE,0i32); }
        else if (not game.shapeMetadataValid17(c[13] as i32,actual,expected)) return game.SensorAction(game.STALE,0i32);
    }
    return game.SensorAction();
}

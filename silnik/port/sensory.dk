fun captureGuardStep17(world: ref raw.World, execution: ref base.Execution) -> () = {
    let id: u32 = base.currentCase13; let phase: u32 = guardPhaseNumber17; var i: i64 = 0i64;
    while (i < world.sensorQueryTrace.length()) { guardQueries17.push(world.sensorQueryTrace.at(i)); i = i+1i64; }

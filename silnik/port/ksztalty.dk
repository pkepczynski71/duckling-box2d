fun encodeBody(w: ref u32[64], offset: i32, def: raw.BodyDef) -> () = {
    w[offset] = def.bodyType as u32;
    w[offset+1i32] = toBits(def.position.x); w[offset+2i32] = toBits(def.position.y);
    w[offset+3i32] = toBits(def.rotation.c); w[offset+4i32] = toBits(def.rotation.s);
    w[offset+5i32] = toBits(def.linearVelocity.x); w[offset+6i32] = toBits(def.linearVelocity.y);
    w[offset+7i32] = toBits(def.angularVelocity); w[offset+8i32] = def.fixedRotation as u32;
}

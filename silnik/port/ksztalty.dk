    if (raw.worlds.at(worldSlot).bodyIdPool.nextIndex != bodyNext or raw.worlds.at(worldSlot).bodyIdPool.freeCount != bodyFree
        or raw.worlds.at(worldSlot).shapeIdPool.nextIndex != shapeNext or raw.worlds.at(worldSlot).shapeIdPool.freeCount != shapeFree
        or raw.worlds.at(worldSlot).islandIdPool.nextIndex != islandNext or raw.worlds.at(worldSlot).broadPhase.moveArray.length() != moves) return false;
    if (raw.worlds.at(worldSlot).broadPhase.trees[2].proxyCount != 0i32 or raw.worlds.at(worldSlot).broadPhase.moveSet.count != 0i32) return false;
                                                                                              
    op.source.circle.radius = -1.0f32;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.GEOMETRY or not words64.equalKey(game.lastIssued, counter)) return false;
    if (not sameBodyRegister(beforeBody, reg.bodies[0]) or not sameShapeRegister(beforeShape, reg.shapes[0])) return false;
                                                                                             
    game.lastIssued = words64.Key64(4294967293u32, 4294967295u32);
    op.source.circle.radius = 0.5f32;
    op.source.hasObjectId = true; op.source.objectId = words64.Key64(0u32, 2147483648u32);
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.OK) return false;
    if (not words64.equalKey(reg.bodies[0].number.birthTicket, words64.Key64(4294967294u32, 4294967295u32))
        or not words64.equalKey(reg.shapes[0].number.birthTicket, maximum) or not words64.equalKey(game.lastIssued, maximum)) return false;
    let savedBody: SavedBody = reg.bodies[0]; let savedShape: SavedShape = reg.shapes[0];
    let emptyBody: SavedBody = reg.bodies[1]; let emptyShape: SavedShape = reg.shapes[1];
    let afterBodyNext: i32 = raw.worlds.at(worldSlot).bodyIdPool.nextIndex;
    let afterShapeNext: i32 = raw.worlds.at(worldSlot).shapeIdPool.nextIndex;
    let afterMoves: i64 = raw.worlds.at(worldSlot).broadPhase.moveArray.length();
    op.a = 1i32; op.c = 1i32;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.LIMIT) return false;
    op = Operation(); op.opcode = 10i32; op.a = 1i32; op.source = game.circleShape(0.5f32, 1.0f32); op.invoke = true; op.updateMass = true;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.LIMIT) return false;
    if (not sameBodyRegister(emptyBody, reg.bodies[1]) or not sameShapeRegister(emptyShape, reg.shapes[1])
        or not sameBodyRegister(savedBody, reg.bodies[0]) or not sameShapeRegister(savedShape, reg.shapes[0])) return false;
    if (raw.worlds.at(worldSlot).bodyIdPool.nextIndex != afterBodyNext or raw.worlds.at(worldSlot).shapeIdPool.nextIndex != afterShapeNext
        or raw.worlds.at(worldSlot).broadPhase.moveArray.length() != afterMoves or raw.worlds.at(worldSlot).broadPhase.trees[2].proxyCount != 1i32) return false;
    op = Operation(); op.opcode = 18i32;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.OK) return false;
    op = Operation(); op.opcode = 10i32; op.source = game.circleShape(0.5f32, 1.0f32); op.updateMass = true; op.invoke = true;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.LIMIT or not sameShapeRegister(savedShape, reg.shapes[0])) return false;
    if (game.shapeStatus(savedShape.owner, savedShape.number) != game.STALE or raw.worlds.at(worldSlot).broadPhase.trees[2].proxyCount != 0i32
        or raw.worlds.at(worldSlot).broadPhase.moveSet.count != 0i32 or raw.worlds.at(worldSlot).broadPhase.moveArray.length() != 0i64) return false;
    cleanup(&reg);
    return words64.equalKey(game.lastIssued, maximum) and liveWorldCount() == 0i32 and checkIntegrity();
}

# Box2D 8c661469, src/world.c:100,263.                                                    
fun main() -> i64 = {
    if (not checkTransport()) return 2i64;
    readRow();
    if (not inputOk) return 3i64;
    if (rowLength == 6i32 and rowBytes[0] == 66i32 and rowBytes[1] == 73i32 and rowBytes[2] == 76i32
        and rowBytes[3] == 69i32 and rowBytes[4] == 84i32 and rowBytes[5] == 89i32) {
        if (not rowHasNewline) { invalid("BLAD: koniec wiersza BILETY.\n"); return 3i64; }
        checkEnd();
        if (not inputOk) return 3i64;
        if (not testTickets()) {
            if (inputOk) invalid("BLAD: proba biletow.\n");
            return failureCode;
        }
        io.writeStr("BILETY OK\n"); return 0i64;
    }
    let count: u32 = readWord();
    endRow();
    if ((count < 1u32 or count > 96u32) or not inputOk) { invalid("BLAD: E8dc44deebc2b E7ef3142429d2.\n"); return 3i64; }
    io.writeStr("PORT7"); outDec(count as i32); newline();
    var caseIndex: u32 = 0u32;
    while (caseIndex < count and inputOk) {
        readTag(67i32);
        let id: u32 = readWord();
        let opCount: u32 = readWord();
        endRow();
        if (id != caseIndex + 1u32 or opCount < 1u32 or opCount > 512u32 or not inputOk) { invalid("BLAD: E2c2adb19413d E823c775f0f46.\n"); return 3i64; }
        var reg = Registers();
        io.writeStr("CASE"); outDec(id as i32); outDec(opCount as i32); newline();
        var seq: u32 = 1u32;
        while (seq <= opCount and inputOk) {
            let op: Operation = readOperation(seq);
            if (not inputOk) { cleanup(&reg); return 3i64; }
            if (runOperation(&reg, id, seq, op, true) < 0i32) { cleanup(&reg); return failureCode; }
            seq = seq + 1u32;
        }
        io.writeStr("ENDCASE"); outDec(id as i32); newline();
        cleanup(&reg);
        caseIndex = caseIndex + 1u32;
    }
    checkEnd();
    if (not inputOk) return 3i64;
    io.writeStr("END"); outDec(count as i32); newline();
    return 0i64;
}

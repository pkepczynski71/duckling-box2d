# Box2D 8c661469, src/world.c:100. Fixture observes allocation independently of registers.
fun liveWorldCount() -> i32 = {
    var count: i32 = 0i32;
    var i: i32 = 0i32;
    while (i < 128i32) {
        if (raw.worlds.at(i as i64).inUse) count = count + 1i32;
        i = i + 1i32;
    }
    return count;
}
# Box2D 8c661469, src/world.                                                                   
                                                                                         
fun testWorldBodyTickets() -> bool = {
    let carry: words64.Key64 = game.nextTicket(words64.Key64(4294967295u32, 0u32));
    if (not words64.equalKey(carry, words64.Key64(0u32, 1u32))) return false;
    let aboveFloat: words64.Key64 = game.nextTicket(words64.Key64(0u32, 2097152u32));
    if (not words64.equalKey(aboveFloat, words64.Key64(1u32, 2097152u32))) return false;
    let maximum: words64.Key64 = words64.Key64(4294967295u32, 4294967295u32);
    if (not game.ticketLimit(maximum) or not words64.equalKey(game.nextTicket(maximum), maximum)) return false;
    var reg = Registers();
    var op = Operation();
    op.maximumLinearSpeed = 400.0f32; op.gravity = math2.Vec2(0.0f32, -10.0f32);
                                                                                           
    game.lastIssued = words64.Key64(4294967293u32, 4294967295u32);
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.OK) return false;
    if (not words64.equalKey(reg.worlds[0].number.birthTicket, words64.Key64(4294967294u32, 4294967295u32))) return false;
    op = Operation(); op.opcode = 2i32; op.def.bodyType = 2i32;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.OK) return false;
    if (not words64.equalKey(reg.bodies[0].number.birthTicket, maximum) or not words64.equalKey(game.lastIssued, maximum)) return false;
    let savedWorld: SavedWorld = reg.worlds[0];
    let savedBody: SavedBody = reg.bodies[0];
    let emptyWorld: SavedWorld = reg.worlds[1];
    let emptyBody: SavedBody = reg.bodies[1];
    let nextWorldGeneration: u16 = raw.worlds.at(1i64).generation;
    let before: game.WorldLookup = game.lookupWorld(savedWorld.number);
    let bodyNext: i32 = raw.worlds.at(savedWorld.number.slot as i64).bodyIdPool.nextIndex;
    let bodyFree: i32 = raw.worlds.at(savedWorld.number.slot as i64).bodyIdPool.freeCount;
    let islandNext: i32 = raw.worlds.at(savedWorld.number.slot as i64).islandIdPool.nextIndex;
    op = Operation(); op.a = 1i32; op.maximumLinearSpeed = 400.0f32; op.gravity = math2.Vec2(0.0f32, -10.0f32);
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.LIMIT) return false;
    op = Operation(); op.opcode = 2i32; op.a = 1i32; op.def.bodyType = 2i32;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.LIMIT) return false;
    if (not sameWorldRegister(reg.worlds[1], emptyWorld) or not sameBodyRegister(reg.bodies[1], emptyBody)) return false;
    if (not sameWorldRegister(reg.worlds[0], savedWorld) or not sameBodyRegister(reg.bodies[0], savedBody)) return false;
    if (not words64.equalKey(game.lastIssued, maximum) or liveWorldCount() != 1i32
        or raw.worlds.at(1i64).generation != nextWorldGeneration) return false;
    let after: game.WorldLookup = game.lookupWorld(savedWorld.number);
    if (before.value.bodyCount != 1i32 or after.value.bodyCount != 1i32 or after.value.islandCount != before.value.islandCount) return false;
    if (game.worldStatus(savedWorld.number) != game.OK or game.bodyStatus(savedBody.owner, savedBody.number) != game.OK) return false;
    if (raw.worlds.at(savedWorld.number.slot as i64).bodyIdPool.nextIndex != bodyNext
        or raw.worlds.at(savedWorld.number.slot as i64).bodyIdPool.freeCount != bodyFree
        or raw.worlds.at(savedWorld.number.slot as i64).islandIdPool.nextIndex != islandNext) return false;
    op = Operation(); op.opcode = 3i32;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.OK) return false;
    op = Operation(); op.opcode = 2i32; op.def.bodyType = 2i32;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.LIMIT) return false;
    let deadView: game.WorldLookup = game.lookupWorld(savedWorld.number);
    if (not sameBodyRegister(reg.bodies[0], savedBody) or game.bodyStatus(savedBody.owner, savedBody.number) != game.STALE
        or deadView.value.bodyCount != 0i32 or deadView.value.islandCount != 0i32
        or not words64.equalKey(game.lastIssued, maximum)) return false;
    if (raw.worlds.at(savedWorld.number.slot as i64).bodyIdPool.nextIndex != bodyNext
        or raw.worlds.at(savedWorld.number.slot as i64).bodyIdPool.freeCount != bodyFree + 1i32) return false;
    op = Operation(); op.opcode = 1i32;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.OK) return false;
    op = Operation(); op.maximumLinearSpeed = 400.0f32; op.gravity = math2.Vec2(0.0f32, -10.0f32);
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.LIMIT) return false;
    if (not sameWorldRegister(reg.worlds[0], savedWorld) or game.worldStatus(savedWorld.number) != game.STALE or liveWorldCount() != 0i32) return false;
    op = Operation(); op.opcode = 2i32; op.def.bodyType = 2i32;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.STALE) return false;
    return sameBodyRegister(reg.bodies[0], savedBody) and words64.equalKey(game.lastIssued, maximum);
}

# Box2D 8c661469, include/box2d/id.h:52,118. Fixture comparison includes the owner number too.
fun sameShapeRegister(a: SavedShape, b: SavedShape) -> bool = {
    return a.saved == b.saved and a.number.slot == b.number.slot
        and words64.equalKey(a.number.birthTicket, b.number.birthTicket) and words64.equalKey(a.number.ownerTicket, b.number.ownerTicket)
        and a.owner.slot == b.owner.slot and words64.equalKey(a.owner.birthTicket, b.owner.birthTicket)
        and a.id.index1 == b.id.index1 and a.id.world0 == b.id.world0 and a.id.generation == b.id.generation;
}

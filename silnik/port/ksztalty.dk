}
# Box2D 8c661469, src/world.                                                                           
fun validOperation(reg: ref Registers, op: Operation) -> bool = {
    var liveW: i32 = 0i32; var liveB: i32 = 0i32; var liveS: i32 = 0i32;
    var wi: i32 = 0i32;
    while (wi < 16i32) { if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) liveW = liveW + 1i32; wi = wi + 1i32; }
    var bi: i32 = 0i32;
    while (bi < 256i32) { if (liveBody(reg, bi)) liveB = liveB + 1i32; bi = bi + 1i32; }
    var si: i32 = 0i32;
    while (si < 512i32) { if (liveShape(reg, si)) liveS = liveS + 1i32; si = si + 1i32; }
    if (op.opcode == 0i32) return not (reg.worlds[op.a].saved and game.worldStatus(reg.worlds[op.a].number) == game.OK) and liveW < 4i32;
    if (op.opcode == 1i32) return reg.worlds[op.a].saved;
    if (op.opcode == 2i32) return reg.worlds[op.b].saved and not liveBody(reg, op.a) and liveB < 128i32;
    if (op.opcode == 10i32 or op.opcode == 17i32) return reg.worlds[op.b].saved and reg.bodies[op.c].saved and not liveShape(reg, op.a) and liveS < 256i32;
    if (op.opcode == 16i32) return reg.worlds[op.b].saved and not liveBody(reg, op.a) and not liveShape(reg, op.c) and liveB < 128i32 and liveS < 256i32;
    if (op.opcode == 20i32) return reg.worlds[op.a].saved and game.bodyStatus(reg.worlds[op.a].number, reg.bodies[op.b].number) == game.OK
        and reg.bodies[op.b].saved and not liveShape(reg, op.c) and op.old != op.c and reg.shapes[op.old].saved and not liveShape(reg, op.old)
        and words64.equalKey(reg.shapes[op.old].number.ownerTicket, reg.worlds[op.a].number.birthTicket) and liveS < 256i32;
    if (op.opcode == 15i32) return reg.worlds[op.a].saved and (if op.kind == 2i32 then reg.bodies[op.b].saved else reg.shapes[op.b].saved);
    if (op.opcode == 3i32 or op.opcode == 4i32 or op.opcode == 5i32 or op.opcode == 13i32 or op.opcode == 21i32) return reg.worlds[op.a].saved and reg.bodies[op.b].saved;
    return reg.worlds[op.a].saved and reg.shapes[op.b].saved;
}

# Box2D 8c661469, src/island.c:68-76.                                               
fun checkIslands() -> bool = {
    var wi: i32 = 0i32;
    while (wi < 128i32) {
        if (raw.worlds.at(wi as i64).inUse) {
            var world: ref raw.World = raw.worlds.at(wi as i64);
            var setIndex: i32 = 0i32;
            while (setIndex <= 2i32) {
                var set: ref raw.SolverSet = raw.b2GetSolverSet(world, setIndex);
                var local: i32 = 0i32;
                var good: bool = set.islandCount >= 0i32 and set.islandCount as i64 <= set.islandSims.length();
                while (local < set.islandCount and good) {
                    let islandId: i32 = set.islandSims.at(local as i64);
                    good = islandId >= 0i32 and islandId as i64 < world.islands.length();
                    if (good) good = world.islands.at(islandId as i64).localIndex == local;
                    local = local + 1i32;
                }
                if (not good) {
                    invalid("BLAD: indeks wyspy.\n"); failureCode = 4i64; return false;
                }
                setIndex = setIndex + 2i32;
            }
        }
        wi = wi + 1i32;
    }
    return true;
}

# Box2D 8c661469, src/shape.                                                                               
fun checkShapeLists() -> bool = {
    var wi: i32 = 0i32;
    while (wi < 128i32) {
        if (raw.worlds.at(wi as i64).inUse) {
            var world: ref raw.World = raw.worlds.at(wi as i64);
            var bi: i64 = 0i64; var total: i32 = 0i32;
            while (bi < world.bodies.length()) {
                let body: raw.BodyRecord = world.bodies.at(bi);
                if (body.id != -1i32) {
                    var previous: i32 = -1i32; var slot: i32 = body.headShapeId; var count: i32 = 0i32;
                    if (body.shapeCount < 0i32) return false;
                    while (slot != -1i32) {
                        if (slot < 0i32 or slot as i64 >= world.shapes.length() or count >= body.shapeCount) return false;
                        let shape: raw.ShapeRecord = world.shapes.at(slot as i64);
                        if (shape.id != slot or shape.bodyId != bi as i32 or shape.prevShapeId != previous) return false;
                        previous = slot; slot = shape.nextShapeId; count = count + 1i32;
                    }
                    if (count != body.shapeCount) return false;
                    total = total + count;
                }
                bi = bi + 1i64;
            }
            var alive: i32 = 0i32; var si: i64 = 0i64;
            while (si < world.shapes.length()) {
                let item: raw.ShapeRecord = world.shapes.at(si);
                if (item.id != -1i32) {
                    alive = alive + 1i32;
                    if (item.id != si as i32 or item.bodyId < 0i32 or item.bodyId as i64 >= world.bodies.length()) return false;
                    if (world.bodies.at(item.bodyId as i64).id != item.bodyId) return false;
                }
                si = si + 1i64;
            }
            if (total != alive or alive != world.shapeIdPool.nextIndex-world.shapeIdPool.freeCount) return false;
        }
        wi = wi + 1i32;
    }
    return true;
}
# Box2D 8c661469, src/island.                                                                  
fun checkIntegrity() -> bool = {
    if (not checkShapeLists()) { invalid("BLAD: lista ksztaltow.\n"); failureCode = 4i64; return false; }
    return checkIslands();
}
# Box2D 8c661469, src/world.                                                       
fun runOperation(reg: ref Registers, id: u32, seq: u32, op: Operation, emit: bool) -> i32 = {
    if (not validOperation(reg, op)) { invalid("BLAD: E1a5e497a2bfa Eefd9469cc3d7.\n"); return -1i32; }
    if (emit) outEcho(id, seq, op);
    var status: i32 = game.OK; var kind: i32 = 0i32;
    var resultWorld = SavedWorld(); var resultBody = SavedBody(); var resultShape = SavedShape();
    var churnRecords: i32 = 0i32;
    if (op.opcode == 0i32) {
        let createdWorld: game.WorldResult = game.createWorld(op.gravity, op.maximumLinearSpeed); status = createdWorld.status;
        if (status == game.OK) {
            resultWorld = SavedWorld(true, createdWorld.number, createdWorld.id); reg.worlds[op.a] = resultWorld; kind = 1i32;
        }
    } else if (op.opcode == 1i32) {
        resultWorld = reg.worlds[op.a]; kind = 1i32; status = game.destroyWorld(resultWorld.number);
    } else if (op.opcode == 2i32) {
        let createdBody: game.BodyResult = game.createBody(reg.worlds[op.b].number, op.def); status = createdBody.status;
        if (status == game.OK) {
            resultBody = SavedBody(true, createdBody.number, reg.worlds[op.b].number, createdBody.id); reg.bodies[op.a] = resultBody; kind = 2i32;
        }
    } else if (op.opcode == 10i32 or op.opcode == 17i32) {
        var createdShape = game.ShapeResult();
        if (op.opcode == 10i32) createdShape = game.createShapeRaw(reg.worlds[op.b].number, reg.bodies[op.c].number, op.source, op.updateMass, op.invoke);
        else {
            createdShape.status = game.bodyStatus(reg.worlds[op.b].number, reg.bodies[op.c].number);
            if (createdShape.status == game.OK) {
                if (not op.geometryGood) createdShape.status = game.GEOMETRY;
                else if (op.tag == 4i32) createdShape = game.addBox(reg.worlds[op.b].number, reg.bodies[op.c].number,
                    game.BoxGeometry(op.halfWidth, op.halfHeight, op.localCenter, op.localRotation, op.radius), op.source, op.invoke);
                else createdShape = game.addShape(reg.worlds[op.b].number, reg.bodies[op.c].number, op.source, op.invoke);
            }
        }
        status = createdShape.status;
        if (status == game.OK) {
            resultShape = SavedShape(true, createdShape.number, reg.worlds[op.b].number, createdShape.id); reg.shapes[op.a] = resultShape; kind = 3i32;
        }
    } else if (op.opcode == 16i32) {
        var pair = game.PairResult(); pair.status = game.worldStatus(reg.worlds[op.b].number);
        if (pair.status == game.OK) {
            if (not op.geometryGood) pair.status = game.GEOMETRY;
            else if (op.tag == 4i32) pair = game.createBodyWithBox(reg.worlds[op.b].number, op.def,
                game.BoxGeometry(op.halfWidth, op.halfHeight, op.localCenter, op.localRotation, op.radius), op.source, op.invoke, op.source.hasObjectId, op.source.objectId);
            else pair = game.createBodyWithShape(reg.worlds[op.b].number, op.def, op.source, op.invoke, op.source.hasObjectId, op.source.objectId);
        }
        status = pair.status;
        if (status == game.OK) {
            resultBody = SavedBody(true, pair.body.number, reg.worlds[op.b].number, pair.body.id);
            resultShape = SavedShape(true, pair.shape.number, reg.worlds[op.b].number, pair.shape.id);
            reg.bodies[op.a] = resultBody; reg.shapes[op.c] = resultShape; kind = 2i32;
        }
    } else if (op.opcode == 20i32) {
        var source = raw.ShapeRecord(); source.circle.radius = 0.5f32;
        var j: i32 = 1i32;
        while (j <= op.repeatCount and status == game.OK) {
            if (j > 1i32) {
                status = game.destroyShapeRaw(reg.worlds[op.a].number, reg.shapes[op.c].number, true);
                if (status != game.OK or not checkIntegrity()) return -1i32;
                if (emit) outChurn(reg, id, seq, j, 0i32, op); churnRecords = churnRecords + 1i32;
            }
            let churnShape: game.ShapeResult = game.createShapeRaw(reg.worlds[op.a].number, reg.bodies[op.b].number, source, true, true);
            status = churnShape.status;
            if (status == game.OK) {
                resultShape = SavedShape(true, churnShape.number, reg.worlds[op.a].number, churnShape.id); reg.shapes[op.c] = resultShape; kind = 3i32;
                if (not checkIntegrity()) return -1i32;
                if (emit) outChurn(reg, id, seq, j, 1i32, op); churnRecords = churnRecords + 1i32;
            }
            j = j + 1i32;
        }
    } else if (op.opcode == 3i32 or op.opcode == 4i32 or op.opcode == 5i32 or op.opcode == 13i32 or op.opcode == 21i32 or (op.opcode == 15i32 and op.kind == 2i32)) {
        resultBody = reg.bodies[op.b]; kind = 2i32;
        if (op.opcode == 3i32) status = game.destroyBody(reg.worlds[op.a].number, resultBody.number);
        else if (op.opcode == 4i32) status = game.setTransform(reg.worlds[op.a].number, resultBody.number, op.position, op.rotation);
        else if (op.opcode == 13i32) status = game.applyMassRaw(reg.worlds[op.a].number, resultBody.number);
        else if (op.opcode == 15i32) status = game.setBodyObjectId(reg.worlds[op.a].number, resultBody.number, op.source.hasObjectId, op.source.objectId);
        else status = game.bodyStatus(reg.worlds[op.a].number, resultBody.number);
    } else {
        resultShape = reg.shapes[op.b]; kind = 3i32;
        if (op.opcode == 11i32) status = game.destroyShapeRaw(reg.worlds[op.a].number, resultShape.number, op.updateMass);
        else if (op.opcode == 12i32) status = game.setDensityRaw(reg.worlds[op.a].number, resultShape.number, op.source.density, op.updateMass);
        else if (op.opcode == 14i32) status = game.shapeStatus(reg.worlds[op.a].number, resultShape.number);
        else if (op.opcode == 15i32) status = game.setShapeObjectId(reg.worlds[op.a].number, resultShape.number, op.source.hasObjectId, op.source.objectId);
        else if (op.opcode == 18i32) status = game.destroyShape(reg.worlds[op.a].number, resultShape.number);
        else status = game.setDensity(reg.worlds[op.a].number, resultShape.number, op.source.density);
    }
    if (not checkIntegrity()) return -1i32;
    if (emit) {
        prefix("R", id, seq); outDec(0i32); outDec(status); outDec(kind);
        if (kind == 1i32) outWorldHandle(resultWorld);
        else if (kind == 2i32) outBodyHandle(resultBody);
        else if (kind == 3i32) outShapeHandle(resultShape);
        else outNull(); newline();
        if (op.opcode == 16i32) {
            prefix("R", id, seq); outDec(1i32); outDec(status); outDec(if status == game.OK then 3i32 else 0i32);
            if (status == game.OK) outShapeHandle(resultShape); else outNull(); newline();
        }
        outState(reg, id, seq, op, churnRecords);
    }
    return if inputOk then status else -1i32;
}

# Box2D 8c661469, src/world.c:263. Same ascending cleanup order as the C driver.
fun cleanup(reg: ref Registers) -> () = {
    var i: i32 = 0i32;
    while (i < 16i32) {
        if (reg.worlds[i].saved and game.worldStatus(reg.worlds[i].number) == game.OK) game.destroyWorld(reg.worlds[i].number);
        i = i + 1i32;
    }
}

# Box2D 8c661469, include/box2d/types.h:81. Bit-cast smoke check from step 5.
fun checkTransport() -> bool = {
    return toBits(fromBits(2147483648u32)) == 2147483648u32
        and toBits(fromBits(1u32)) == 1u32 and toBits(fromBits(2139095039u32)) == 2139095039u32
        and fromBits(1065353216u32) == 1.0f32 and fromBits(3212836864u32) == -1.0f32;
}

# Box2D 8c661469, include/box2d/id.h:36,93. Fixture compares every saved world field.
fun sameWorldRegister(a: SavedWorld, b: SavedWorld) -> bool = {
    return a.saved == b.saved and a.number.slot == b.number.slot
        and words64.equalKey(a.number.birthTicket, b.number.birthTicket)
        and a.id.index1 == b.id.index1 and a.id.generation == b.id.generation;
}
# Box2D 8c661469, include/box2d/id.h:44,106. Fixture compares every saved body field.
fun sameBodyRegister(a: SavedBody, b: SavedBody) -> bool = {
    return a.saved == b.saved and a.number.slot == b.number.slot
        and words64.equalKey(a.number.birthTicket, b.number.birthTicket)
        and words64.equalKey(a.number.ownerTicket, b.number.ownerTicket)
        and a.owner.slot == b.owner.slot and words64.equalKey(a.owner.birthTicket, b.owner.birthTicket)

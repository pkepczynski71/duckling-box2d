    let beforeBody: SavedBody = reg.bodies[0]; let beforeShape: SavedShape = reg.shapes[0];
    let counter: words64.Key64 = game.lastIssued;
    let worldSlot: i64 = beforeWorld.number.slot as i64;
    let bodyNext: i32 = raw.worlds.at(worldSlot).bodyIdPool.nextIndex;
    let bodyFree: i32 = raw.worlds.at(worldSlot).bodyIdPool.freeCount;
    let shapeNext: i32 = raw.worlds.at(worldSlot).shapeIdPool.nextIndex;
    let shapeFree: i32 = raw.worlds.at(worldSlot).shapeIdPool.freeCount;
    let islandNext: i32 = raw.worlds.at(worldSlot).islandIdPool.nextIndex;
    let moves: i64 = raw.worlds.at(worldSlot).broadPhase.moveArray.length();
    op = Operation(); op.opcode = 16i32; op.def.bodyType = 2i32; op.source = game.circleShape(0.5f32, 1.0f32); op.invoke = true;
    if (runOperation(&reg, 0u32, 0u32, op, false) != game.LIMIT) return false;
    if (not sameWorldRegister(beforeWorld, reg.worlds[0]) or not sameBodyRegister(beforeBody, reg.bodies[0])

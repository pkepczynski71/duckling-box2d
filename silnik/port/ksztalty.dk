# Box2D 8c661469, src/geometry.                                                                          
fun encodeGeometry(w: ref u32[64], offset: i32, op: Operation) -> () = {
    if (op.tag == 0i32) {
        w[offset] = toBits(op.source.circle.center.x); w[offset+1i32] = toBits(op.source.circle.center.y); w[offset+2i32] = toBits(op.source.circle.radius);
    } else if (op.tag == 1i32) {
        w[offset] = toBits(op.source.capsule.center1.x); w[offset+1i32] = toBits(op.source.capsule.center1.y);
        w[offset+2i32] = toBits(op.source.capsule.center2.x); w[offset+3i32] = toBits(op.source.capsule.center2.y); w[offset+4i32] = toBits(op.source.capsule.radius);
    } else if (op.tag == 2i32) {
        w[offset] = toBits(op.source.segment.point1.x); w[offset+1i32] = toBits(op.source.segment.point1.y);
        w[offset+2i32] = toBits(op.source.segment.point2.x); w[offset+3i32] = toBits(op.source.segment.point2.y);
    } else if (op.tag == 3i32) {
        w[offset] = op.source.polygon.count as u32; w[offset+1i32] = toBits(op.source.polygon.radius);
        var i: i32 = 0i32;
        while (i < 8i32) {
            w[offset+2i32+2i32*i] = toBits(op.source.polygon.vertices[i].x); w[offset+3i32+2i32*i] = toBits(op.source.polygon.vertices[i].y); i = i + 1i32;
        }
    } else {
        w[offset] = toBits(op.halfWidth); w[offset+1i32] = toBits(op.halfHeight);
        w[offset+2i32] = toBits(op.localCenter.x); w[offset+3i32] = toBits(op.localCenter.y);
        w[offset+4i32] = toBits(op.localRotation.c); w[offset+5i32] = toBits(op.localRotation.s); w[offset+6i32] = toBits(op.radius);
    }
}
# Box2D 8c661469, src/world.                                                               
fun outEcho(id: u32, seq: u32, op: Operation) -> () = {
    prefix("E", id, seq); outDec(op.opcode);
    var w: u32[64]; var i: i32 = 0i32;
    while (i < 64i32) { w[i] = 0u32; i = i + 1i32; }
    w[0] = op.a as u32;
    if (op.opcode == 0i32) {
        w[1] = toBits(op.gravity.x); w[2] = toBits(op.gravity.y); w[3] = toBits(op.maximumLinearSpeed);
    } else if (op.opcode == 2i32) {
        w[1] = op.b as u32; encodeBody(&w, 2i32, op.def);
    } else if (op.opcode == 10i32 or op.opcode == 17i32) {
        w[1] = op.b as u32; w[2] = op.c as u32; w[3] = op.tag as u32; w[4] = toBits(op.source.density);
        w[5] = op.updateMass as u32; w[6] = op.invoke as u32;
        encodeFilter(&w, 7i32, op.source.filter); encodeObject(&w, 12i32, op.source); encodeGeometry(&w, 15i32, op);
    } else if (op.opcode == 16i32) {
        w[1] = op.c as u32; w[2] = op.b as u32; encodeBody(&w, 3i32, op.def);
        w[12] = op.tag as u32; w[13] = toBits(op.source.density); w[14] = op.invoke as u32;
        encodeObject(&w, 15i32, op.source); encodeFilter(&w, 18i32, op.source.filter); encodeGeometry(&w, 23i32, op);
    } else if (op.opcode == 15i32) {
        w[1] = op.kind as u32; w[2] = op.b as u32; encodeObject(&w, 3i32, op.source);
    } else if (op.opcode != 1i32) {
        w[1] = op.b as u32;
        if (op.opcode == 4i32) {
            w[2] = toBits(op.position.x); w[3] = toBits(op.position.y); w[4] = toBits(op.rotation.c); w[5] = toBits(op.rotation.s);
        } else if (op.opcode == 11i32) w[2] = op.updateMass as u32;
        else if (op.opcode == 12i32 or op.opcode == 19i32) {
            w[2] = toBits(op.source.density); if (op.opcode == 12i32) w[3] = op.updateMass as u32;
        } else if (op.opcode == 20i32) { w[2] = op.c as u32; w[3] = op.repeatCount as u32; w[4] = op.old as u32; }
        else if (op.opcode == 21i32) w[2] = op.capacity as u32;
    }
    i = 0i32; while (i < 64i32) { outHex(w[i]); i = i + 1i32; } newline();
}

# Box2D 8c661469, src/shape.c:945-977,1055-1086,1152-1183,1693-1715.
fun outShapeState(saved: SavedShape, id: u32, seq: u32, slot: i32) -> () = {
    var world: ref raw.World = raw.worlds.at(saved.id.world0 as i64);
    var shape: raw.ShapeRecord = world.shapes.at((saved.id.index1-1i32) as i64);
    let body: raw.BodyId = raw.b2MakeBodyId(world, shape.bodyId);
    let worldId: raw.WorldId = raw.WorldId((world.worldId+1u16) as u16, world.generation);
    prefix("S", id, seq); outDec(slot); outShapeHandle(saved);
    outHex(body.index1 as u32); outHex(body.world0 as u32); outHex(body.generation as u32);
    outHex(worldId.index1 as u32); outHex(0u32); outHex(worldId.generation as u32);
    outHex(shape.shapeType as u32); outFloat(shape.density);
    outFloat(shape.friction); outFloat(shape.restitution); outFloat(shape.rollingResistance); outFloat(shape.tangentSpeed);
    outHex(shape.userMaterialId as u32); outHex(shape.customColor);
    outHex(shape.filter.categoryBits as u32); outHex(((shape.filter.categoryBits as u64) >> 32u64) as u32);
    outHex(shape.filter.maskBits as u32); outHex(((shape.filter.maskBits as u64) >> 32u64) as u32); outHex(shape.filter.groupIndex as u32);
    outHex((shape.sensorIndex != -1i32) as u32); outMass(raw.b2ComputeShapeMass(&shape)); outAABB(shape.aabb); outObject(shape.hasObjectId, shape.objectId); newline();
}
# Box2D 8c661469, src/shape.c:1339-1384.                                                           
fun outGeometry(saved: SavedShape, id: u32, seq: u32, slot: i32) -> () = {
    let shape: raw.ShapeRecord = raw.worlds.at(saved.id.world0 as i64).shapes.at((saved.id.index1-1i32) as i64);
    var h: u32[40]; var z: i32 = 0i32;
    while (z < 40i32) { h[z] = 0u32; z = z + 1i32; }
    h[0] = shape.shapeType as u32;
    if (shape.shapeType == 0i32) {
        h[1] = 1u32; h[2] = toBits(shape.circle.radius); h[5] = toBits(shape.circle.center.x); h[6] = toBits(shape.circle.center.y);
    } else if (shape.shapeType == 1i32) {
        h[1] = 2u32; h[2] = toBits(shape.capsule.radius);
        h[5] = toBits(shape.capsule.center1.x); h[6] = toBits(shape.capsule.center1.y);
        h[7] = toBits(shape.capsule.center2.x); h[8] = toBits(shape.capsule.center2.y);
    } else if (shape.shapeType == 2i32) {
        h[1] = 2u32; h[5] = toBits(shape.segment.point1.x); h[6] = toBits(shape.segment.point1.y);
        h[7] = toBits(shape.segment.point2.x); h[8] = toBits(shape.segment.point2.y);
    } else {
        h[1] = shape.polygon.count as u32; h[2] = toBits(shape.polygon.radius);
        h[3] = toBits(shape.polygon.centroid.x); h[4] = toBits(shape.polygon.centroid.y);
        var i: i32 = 0i32;
        while (i < shape.polygon.count) {
            h[5i32+2i32*i] = toBits(shape.polygon.vertices[i].x); h[6i32+2i32*i] = toBits(shape.polygon.vertices[i].y);
            h[21i32+2i32*i] = toBits(shape.polygon.normals[i].x); h[22i32+2i32*i] = toBits(shape.polygon.normals[i].y); i = i + 1i32;
        }
    }
    prefix("G", id, seq); outDec(slot); z = 0i32;
    while (z < 40i32) { outHex(h[z]); z = z + 1i32; } newline();
}
# Box2D 8c661469, src/body.c:1811-1828. Values come from the actual linked list.
fun outShapeList(body: raw.BodyId, capacity: i32) -> () = {
    var shapes: List[broad.ShapeId] = raw.b2Body_GetShapes(body, capacity);
    var i: i64 = 0i64;
    while (i < shapes.length()) {
        let shape: broad.ShapeId = shapes.at(i);
        outHex(shape.index1 as u32); outHex(shape.world0 as u32); outHex(shape.generation as u32); i = i + 1i64;
    }
}
# Box2D 8c661469, src/table.                                                                
fun outSet(set: ref words64.HashSet, id: u32, seq: u32, slot: i32, kind: i32) -> () = {
    prefix("H", id, seq); outDec(slot); outDec(kind); outHex(set.capacity as u32); outHex(set.count as u32);
    var i: i32 = 0i32;
    while (i < set.capacity) {
        let item: words64.SetItem = set.items.at(i as i64); outPair(item.key); outHex(item.hash); i = i + 1i32;
    }
    newline();
}
# Box2D 8c661469, src/body.                                                      
                                                                                         
fun outPrivate(reg: ref Registers, id: u32, seq: u32) -> () = {
    var nX: i32 = 0i32; var nP: i32 = 0i32; var nT: i32 = 0i32;
    var nF: i32 = 0i32; var nU: i32 = 0i32; var nH: i32 = 0i32;
    var bi: i32 = 0i32;
    while (bi < 256i32) {
        if (reg.bodies[bi].saved and game.bodyStatus(reg.bodies[bi].owner, reg.bodies[bi].number) == game.OK) {
            var bw: ref raw.World = raw.worlds.at(reg.bodies[bi].id.world0 as i64);
            let body: raw.BodyRecord = bw.bodies.at(reg.bodies[bi].number.slot as i64);
            var set: ref raw.SolverSet = raw.b2GetSolverSet(bw, body.setIndex);
            let sim: raw.BodySim = set.bodySims.at(body.localIndex as i64);
            prefix("X", id, seq); outDec(bi); outFloat(sim.invMass); outFloat(sim.invInertia);
            outFloat(sim.minExtent); outFloat(sim.maxExtent); outFloat(sim.center0.x); outFloat(sim.center0.y);
            outFloat(sim.rotation0.c); outFloat(sim.rotation0.s); newline(); nX = nX + 1i32;
        }
        bi = bi + 1i32;
    }
    var si: i32 = 0i32;
    while (si < 512i32) {
        if (reg.shapes[si].saved and game.shapeStatus(reg.shapes[si].owner, reg.shapes[si].number) == game.OK) {
            let shape: raw.ShapeRecord = raw.worlds.at(reg.shapes[si].id.world0 as i64).shapes.at(reg.shapes[si].number.slot as i64);
            prefix("P", id, seq); outDec(si); outHex(shape.id as u32); outHex(shape.bodyId as u32);
            outHex(shape.prevShapeId as u32); outHex(shape.nextShapeId as u32); outHex(shape.proxyKey as u32);
            outFloat(shape.localCentroid.x); outFloat(shape.localCentroid.y); outAABB(shape.fatAABB); outHex(shape.enlargedAABB as u32);
            newline(); nP = nP + 1i32;
        }
        si = si + 1i32;
    }
    si = 0i32;
    while (si < 512i32) {
        if (reg.shapes[si].saved and game.shapeStatus(reg.shapes[si].owner, reg.shapes[si].number) == game.OK) {
            var sw: ref raw.World = raw.worlds.at(reg.shapes[si].id.world0 as i64);
            let leafShape: raw.ShapeRecord = sw.shapes.at(reg.shapes[si].number.slot as i64);
            if (leafShape.proxyKey != -1i32) {
                let treeType: i32 = broad.B2_PROXY_TYPE(leafShape.proxyKey);
                let proxyId: i32 = broad.B2_PROXY_ID(leafShape.proxyKey);
                var actualTree: ref tree.DynamicTree = &sw.broadPhase.trees[treeType];
                let category: i64 = tree.b2DynamicTree_GetCategoryBits(actualTree, proxyId);
                let userData: i64 = tree.b2DynamicTree_GetUserData(actualTree, proxyId);
                prefix("T", id, seq); outDec(si); outHex(treeType as u32); outHex(proxyId as u32);
                outAABB(tree.b2DynamicTree_GetAABB(actualTree, proxyId));
                outHex(category as u32); outHex(((category as u64) >> 32u64) as u32);
                outHex(userData as u32); outHex(((userData as u64) >> 32u64) as u32); newline(); nT = nT + 1i32;
            }
        }
        si = si + 1i32;
    }
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            var world: ref raw.World = raw.worlds.at(reg.worlds[wi].number.slot as i64);
            prefix("F", id, seq); outDec(wi); outHex(world.broadPhase.moveArray.length() as u32);
            outHex(world.broadPhase.trees[0].proxyCount as u32); outHex(world.broadPhase.trees[1].proxyCount as u32);
            outHex(world.broadPhase.trees[2].proxyCount as u32); outHex(world.broadPhase.pairSet.count as u32); newline(); nF = nF + 1i32;
            var j: i64 = 0i64;
            while (j < world.broadPhase.moveArray.length()) {
                let key: i32 = world.broadPhase.moveArray.at(j);
                prefix("U", id, seq); outDec(wi); outDec(j as i32); outHex(key as u32); newline(); nU = nU + 1i32; j = j + 1i64;
            }
            outSet(&world.broadPhase.moveSet, id, seq, wi, 0i32); outSet(&world.broadPhase.pairSet, id, seq, wi, 1i32); nH = nH + 2i32;
        }
        wi = wi + 1i32;
    }
    prefix("I", id, seq); outHex(nX as u32); outHex(nP as u32); outHex(nT as u32); outHex(nF as u32); outHex(nU as u32); outHex(nH as u32); newline();
}

# Box2D 8c661469, src/world.                                               
fun outState(reg: ref Registers, id: u32, seq: u32, op: Operation, churnRecords: i32) -> () = {
    var savedWorlds: i32 = 0i32;
    var savedBodies: i32 = 0i32;
    var savedShapes: i32 = 0i32;
    var liveShapes: i32 = 0i32;
    var liveWorlds: i32 = 0i32;
    var liveBodies: i32 = 0i32;
    var wi: i32 = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved) {
            savedWorlds = savedWorlds + 1i32;
            prefix("V", id, seq); outDec(1i32); outDec(wi);
            outHex(raw.b2World_IsValid(reg.worlds[wi].id) as u32);
            outHex((game.worldStatus(reg.worlds[wi].number) == game.OK) as u32); newline();
        }
        wi = wi + 1i32;
    }
    var bi: i32 = 0i32;
    while (bi < 256i32) {
        if (reg.bodies[bi].saved) {
            savedBodies = savedBodies + 1i32;
            prefix("V", id, seq); outDec(2i32); outDec(bi);
            outHex(raw.b2Body_IsValid(reg.bodies[bi].id) as u32);
            outHex((game.bodyStatus(reg.bodies[bi].owner, reg.bodies[bi].number) == game.OK) as u32); newline();
        }
        bi = bi + 1i32;
    }
    var si: i32 = 0i32;
    while (si < 512i32) {
        if (reg.shapes[si].saved) {
            savedShapes = savedShapes + 1i32;
            prefix("V", id, seq); outDec(3i32); outDec(si);
            outHex(raw.b2Shape_IsValid(reg.shapes[si].id) as u32);
            outHex((game.shapeStatus(reg.shapes[si].owner, reg.shapes[si].number) == game.OK) as u32); newline();
        }
        si = si + 1i32;
    }
    wi = 0i32;
    while (wi < 16i32) {
        if (reg.worlds[wi].saved and game.worldStatus(reg.worlds[wi].number) == game.OK) {
            liveWorlds = liveWorlds + 1i32;
            let world: game.WorldLookup = game.lookupWorld(reg.worlds[wi].number);
            prefix("W", id, seq); outDec(wi); outWorldId(reg.worlds[wi].id);
            outPair(reg.worlds[wi].number.birthTicket);
            outFloat(world.value.gravity.x); outFloat(world.value.gravity.y);
            outFloat(world.value.maximumLinearSpeed);
            outHex(world.value.bodyCount as u32); outHex(world.value.shapeCount as u32);
            outHex(world.value.islandCount as u32); newline();
        }
        wi = wi + 1i32;
    }
    bi = 0i32;
    while (bi < 256i32) {
        if (reg.bodies[bi].saved and game.bodyStatus(reg.bodies[bi].owner, reg.bodies[bi].number) == game.OK) {
            liveBodies = liveBodies + 1i32;
            let body: game.BodyLookup = game.lookupBody(reg.bodies[bi].owner, reg.bodies[bi].number);
            prefix("B", id, seq); outDec(bi); outBodyHandle(reg.bodies[bi]);
            outHex(body.value.bodyType as u32);
            outFloat(body.value.transform.p.x); outFloat(body.value.transform.p.y);
            outFloat(body.value.transform.q.c); outFloat(body.value.transform.q.s);
            outFloat(body.value.center.x); outFloat(body.value.center.y);
            outFloat(body.value.linearVelocity.x); outFloat(body.value.linearVelocity.y);
            outFloat(body.value.angularVelocity); outFloat(body.value.mass); outFloat(body.value.inertia);
            outFloat(body.value.localCenter.x); outFloat(body.value.localCenter.y);
            outHex(body.value.shapeCount as u32); outHex(body.value.isAwake as u32);
            outHex(body.value.isEnabled as u32); outHex(body.value.fixedRotation as u32);
            outObject(body.value.hasObjectId, body.value.objectId); newline();
        }
        bi = bi + 1i32;
    }
    si = 0i32;
    while (si < 512i32) {
        if (reg.shapes[si].saved and game.shapeStatus(reg.shapes[si].owner, reg.shapes[si].number) == game.OK) {
            liveShapes = liveShapes + 1i32;
            outShapeState(reg.shapes[si], id, seq, si);
        }
        si = si + 1i32;
    }
    si = 0i32;
    while (si < 512i32) {
        if (reg.shapes[si].saved and game.shapeStatus(reg.shapes[si].owner, reg.shapes[si].number) == game.OK) outGeometry(reg.shapes[si], id, seq, si);
        si = si + 1i32;
    }
    bi = 0i32;
    while (bi < 256i32) {
        if (reg.bodies[bi].saved and game.bodyStatus(reg.bodies[bi].owner, reg.bodies[bi].number) == game.OK) {
            let bodyId: raw.BodyId = reg.bodies[bi].id;
            let bodyCount: i32 = raw.worlds.at(bodyId.world0 as i64).bodies.at((bodyId.index1-1i32) as i64).shapeCount;
            prefix("L", id, seq); outDec(bi); outHex(bodyCount as u32); outShapeList(bodyId, bodyCount); newline();
            prefix("A", id, seq); outDec(bi); outAABB(raw.b2Body_ComputeAABB(bodyId)); newline();
        }
        bi = bi + 1i32;
    }
    var nQ: i32 = 0i32;
    if (op.opcode == 21i32 and game.bodyStatus(reg.worlds[op.a].number, reg.bodies[op.b].number) == game.OK) {
        nQ = 1i32;
        let qId: raw.BodyId = reg.bodies[op.b].id;
        var qValues: List[broad.ShapeId] = raw.b2Body_GetShapes(qId, op.capacity);
        prefix("Q", id, seq); outDec(op.b); outHex(op.capacity as u32); outHex(qValues.length() as u32);
        var qi: i64 = 0i64;
        while (qi < qValues.length()) {
            let qShape: broad.ShapeId = qValues.at(qi);
            outHex(qShape.index1 as u32); outHex(qShape.world0 as u32); outHex(qShape.generation as u32); qi = qi + 1i64;
        }
        newline();
    }
    outPrivate(reg, id, seq);
    prefix("Z", id, seq);
    outHex(savedWorlds as u32); outHex(savedBodies as u32); outHex(savedShapes as u32);
    outHex(liveWorlds as u32); outHex(liveBodies as u32); outHex(liveShapes as u32);
    outHex(1u32); outHex(if op.opcode == 16i32 then 2u32 else 1u32);
    outHex((savedWorlds + savedBodies + savedShapes) as u32); outHex(liveWorlds as u32); outHex(liveBodies as u32);
    outHex(liveShapes as u32); outHex(liveShapes as u32); outHex(liveBodies as u32); outHex(liveBodies as u32);
    outHex(nQ as u32); outHex(churnRecords as u32); outPair(game.lastIssued); newline();
}

# Box2D 8c661469, src/shape.                                                        
fun outChurn(reg: ref Registers, id: u32, seq: u32, j: i32, phase: i32, op: Operation) -> () = {
    prefix("J", id, seq); outDec(j); outDec(phase); outShapeHandle(reg.shapes[op.c]);
    outHex(raw.b2Shape_IsValid(reg.shapes[op.old].id) as u32);
    outHex((game.shapeStatus(reg.shapes[op.old].owner, reg.shapes[op.old].number) == game.OK) as u32);
    let worldView: game.WorldLookup = game.lookupWorld(reg.worlds[op.a].number);
    let bodyView: game.BodyLookup = game.lookupBody(reg.worlds[op.a].number, reg.bodies[op.b].number);
    outHex(worldView.value.shapeCount as u32); outHex(bodyView.value.shapeCount as u32);
    outMass(mass2.MassData(bodyView.value.mass, bodyView.value.localCenter, bodyView.value.inertia)); newline();
}
# Box2D 8c661469, src/world.                                                                    
fun liveBody(reg: ref Registers, slot: i32) -> bool = {
    return reg.bodies[slot].saved and game.bodyStatus(reg.bodies[slot].owner, reg.bodies[slot].number) == game.OK;
}
# Box2D 8c661469, src/world.c:1614-1644.
fun liveShape(reg: ref Registers, slot: i32) -> bool = {

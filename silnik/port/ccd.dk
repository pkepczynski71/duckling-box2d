                                                                    
import fizyka.kola as geo;
import fizyka.odleglosc as distance;
import core.builtins as builtins;
import core.primitive_io as io;
extern("C") { fundecl write(fd: i32, buffer: cptr char, count: u64) -> i64; }

var inputOk: bool = true;
var rowBytes: i32[2049]; var rowLength: i32 = 0i32;
var starts: i32[80]; var lengths: i32[80]; var tokens: i32 = 0i32;
var payload: u32[66];
fun fail(kind: str) -> () = {
    if (not inputOk) return; inputOk = false;
    let errorPrefix: str = "PORT16A: INPUT_"; let lf: str = "\n";
    write(2i32,builtins.ptr_from_slice[char](errorPrefix) as cptr char,errorPrefix.length() as u64);
    write(2i32,builtins.ptr_from_slice[char](kind) as cptr char,kind.length() as u64);
    write(2i32,builtins.ptr_from_slice[char](lf) as cptr char,1u64);
}
fun tokenEquals(index: i32, expected: str) -> bool = {
    if (index >= tokens or lengths[index] as i64 != expected.length()) return false;
    let p: cptr char = builtins.ptr_from_slice[char](expected) as cptr char; var i: i32 = 0i32;
    while (i < lengths[index]) { if (rowBytes[starts[index]+i] != p[i] as i32) return false; i = i+1i32; } return true;
}
fun readRow(first: bool) -> () = {
    rowLength = 0i32; tokens = 0i32; if (not inputOk) return;
    var c: i32 = io.readCharCode(); if (c < 0i32) { fail(if first then "HEADER" else "EOF"); return; }
    var pendingCR: bool = false;
    while (c >= 0i32 and c != 10i32) {
        if (c == 13i32) {
            if (pendingCR) { fail("ASCII"); return; } pendingCR = true;
        }
        else {
            if (pendingCR) { fail("ASCII"); return; }
            if (first and rowLength == 0i32 and c == 239i32) {
                let second: i32 = io.readCharCode(); let third: i32 = io.readCharCode();
                fail(if second == 187i32 and third == 191i32 then "HEADER" else "ASCII"); return;
            }
            if (c < 32i32 or c >= 127i32) { fail("ASCII"); return; }
            if (rowLength == 2048i32) { fail("LINE_LENGTH"); return; }
            rowBytes[rowLength] = c; rowLength = rowLength+1i32;
        }
        c = io.readCharCode();
    }
    if (pendingCR and c < 0i32) { fail("ASCII"); return; }
    if (rowLength == 0i32) { fail(if first then "HEADER" else "ARITY"); return; }
    var pos: i32 = 0i32; var spacing: bool = false;
    while (pos < rowLength and inputOk) {
        if (rowBytes[pos] == 32i32) { spacing = true; pos = pos+1i32; }
        else {
            if (tokens >= 80i32) { fail(if first then "HEADER" else "ARITY"); return; }
            starts[tokens] = pos; var size: i32 = 0i32;
            while (pos < rowLength and rowBytes[pos] != 32i32) { if (rowBytes[pos] == 13i32) { fail("ASCII"); return; } size = size+1i32; pos = pos+1i32; }
            lengths[tokens] = size; tokens = tokens+1i32;
            if (pos < rowLength) { pos = pos+1i32; if (pos == rowLength or rowBytes[pos] == 32i32) spacing = true; }
        }
    }
    if (spacing) fail(if first then "HEADER" else "ARITY");
}
fun number(index: i32, word: bool) -> u32 = {
    let errorKind: str = if word then "WORD" else "NUMBER";
    if (index >= tokens or lengths[index] == 0i32) { fail(errorKind); return 0u32; }
    if (lengths[index] > 1i32 and rowBytes[starts[index]] == 48i32) { fail(errorKind); return 0u32; }
    var value: u64 = 0u64; var i: i32 = 0i32;
    while (i < lengths[index] and inputOk) {
        let digit: i32 = rowBytes[starts[index]+i]-48i32;
        if (digit < 0i32 or digit > 9i32 or value > 429496729u64) { fail(errorKind); return 0u32; }
        value = value*10u64+digit as u64; if (value > 4294967295u64) { fail(errorKind); return 0u32; } i = i+1i32;
    } return value as u32;
}
fun readPayload(offset: i32, count: i32) -> () = { var i: i32 = 0i32; while (i < count and inputOk) { payload[i] = number(offset+i,true); i = i+1i32; } }
fun fromBits(word: u32) -> f32 = { var value: u32 = word; return (&value as cptr f32)[0]; }
fun outUnsigned(value: u64) -> () = { if (value >= 10u64) outUnsigned(value/10u64); io.writeChar((48u64+value%10u64) as char); }
fun outDec(value: i32) -> () = { io.writeChar(' '); outUnsigned(value as u64); }
fun newline() -> () = { io.writeChar('\n'); }
fun outHex(value: u32) -> () = {
    io.writeChar(' '); var shift: i32 = 28i32;
    while (shift >= 0i32) { let digit: u32 = (value >> shift as u32) & 15u32; io.writeChar((if digit < 10u32 then 48u32+digit else 87u32+digit) as char); shift = shift-4i32; }
}
fun outFloat(value: f32) -> () = { outHex(distance.toiBits(value)); }
fun prefix(tag: str, id: i32, seq: i32) -> () = { io.writeStr(tag); outDec(id); outDec(seq); }
fun readSweep(offset: i32) -> distance.Sweep = {
    var s = distance.Sweep(); s.localCenter = geo.Vec2(fromBits(payload[offset]),fromBits(payload[offset+1i32])); s.c1 = geo.Vec2(fromBits(payload[offset+2i32]),fromBits(payload[offset+3i32])); s.c2 = geo.Vec2(fromBits(payload[offset+4i32]),fromBits(payload[offset+5i32])); s.q1 = geo.Rot(fromBits(payload[offset+6i32]),fromBits(payload[offset+7i32])); s.q2 = geo.Rot(fromBits(payload[offset+8i32]),fromBits(payload[offset+9i32])); return s;
}
fun readProxy(offset: i32) -> distance.ShapeProxy = {
    var p = distance.ShapeProxy(); p.count = payload[offset] as i32; p.radius = fromBits(payload[offset+1i32]); var i: i32 = 0i32;
    while (i < 8i32) { p.points[i] = geo.Vec2(fromBits(payload[offset+2i32+2i32*i]),fromBits(payload[offset+3i32+2i32*i])); i = i+1i32; } return p;
}
fun readTOI() -> distance.TOIInput = { return distance.TOIInput(readProxy(1i32),readProxy(19i32),readSweep(37i32),readSweep(47i32),fromBits(payload[57])); }
fun arity(op: i32) -> i32 = { if (op == 300i32) return 12i32; if (op == 301i32) return 58i32; if (op == 306i32) return 66i32; if (op == 307i32) return 63i32; return 0i32; }
fun checkProxy(offset: i32) -> () = {
    let count: u32 = payload[offset]; if (count > 10u32) { fail("POPULATION"); return; }
    var i: i32 = 0i32; while (i < 8i32) { if (i as u32 >= count and (payload[offset+2i32+2i32*i] != 0u32 or payload[offset+3i32+2i32*i] != 0u32)) { fail("UNUSED"); return; } i = i+1i32; }
}
fun domain(op: i32) -> () = {
    if (payload[0] > 1u32 or ((op == 306i32 or op == 307i32) and payload[0] != 0u32)) { fail("MODE"); return; }
    if (op == 307i32 and payload[1] > 2u32) { fail("ENUM"); return; }
    if (op == 306i32) {
        if (payload[57] < 1u32 or payload[57] > 2u32) { fail("CACHE"); return; }
        var ci: i32 = 0i32; while (ci < 3i32) {
            let ca: u32 = payload[58i32+ci]; let cb: u32 = payload[61i32+ci];
            if (ca > 255u32 or cb > 255u32 or (ci as u32 < payload[57] and (ca >= payload[1] or cb >= payload[19]))) { fail("CACHE"); return; }
            if (ci as u32 >= payload[57] and (ca != 0u32 or cb != 0u32)) { fail("UNUSED"); return; } ci = ci+1i32;
        }
    }
    if (op != 300i32) { checkProxy(if op == 307i32 then 6i32 else 1i32); if (not inputOk) return; checkProxy(if op == 307i32 then 24i32 else 19i32); if (not inputOk) return; }
    if (payload[0] == 1u32) return;
    if (op == 300i32) { var s: distance.Sweep = readSweep(1i32); if (distance.validateSweep(&s,fromBits(payload[11])).status != 0i32) fail("DOMAIN"); return; }
    var pA: distance.ShapeProxy = readProxy(if op == 307i32 then 6i32 else 1i32); var pB: distance.ShapeProxy = readProxy(if op == 307i32 then 24i32 else 19i32);
    var sA: distance.Sweep = readSweep(if op == 307i32 then 42i32 else 37i32); var sB: distance.Sweep = readSweep(if op == 307i32 then 52i32 else 47i32);
    var timeIndex: i32 = 62i32; if (op == 301i32) timeIndex = 57i32; else if (op == 306i32) timeIndex = 64i32;
    var ti: distance.TOIInput = distance.TOIInput(pA,pB,sA,sB,fromBits(payload[timeIndex]));
    if (distance.validateTOI(&ti).status != 0i32) { fail("DOMAIN"); return; }
    if (op == 306i32 and not (fromBits(payload[65]) >= 0.0f32 and fromBits(payload[65]) <= 1.0f32)) { fail("DOMAIN"); return; }
    if (op == 307i32) { var j: i32 = 2i32; while (j < 6i32) { if (not distance.finite(fromBits(payload[j]))) { fail("DOMAIN"); return; } j = j+1i32; } }
}
fun outputTrace(id: i32, seq: i32, trace: ref distance.TOITrace) -> () = {
    var i: i64 = 0i64; while (i < trace.events.length()) { let e: distance.TOIEvent = trace.events.at(i); prefix("Q16",id,seq); outDec(16i32); outDec(i as i32); outDec(e.event); outDec(e.count); var w: i32 = 0i32; while (w < e.count) { outHex(e.words[w]); w = w+1i32; } newline(); i = i+1i64; }
}
fun outProxy(p: ref distance.ShapeProxy) -> () = { outHex(p.count as u32); outFloat(p.radius); var i: i32 = 0i32; while (i < 8i32) { outFloat(p.points[i].x); outFloat(p.points[i].y); i = i+1i32; } }
fun outSweep(s: ref distance.Sweep) -> () = { outFloat(s.localCenter.x); outFloat(s.localCenter.y); outFloat(s.c1.x); outFloat(s.c1.y); outFloat(s.c2.x); outFloat(s.c2.y); outFloat(s.q1.c); outFloat(s.q1.s); outFloat(s.q2.c); outFloat(s.q2.s); }
fun outInputValue(id: i32, seq: i32, phase: i32, value: ref distance.TOIInput) -> () = { prefix("V16",id,seq); outDec(phase); outDec(57i32); outProxy(&value.proxyA); outProxy(&value.proxyB); outSweep(&value.sweepA); outSweep(&value.sweepB); outFloat(value.maxFraction); newline(); }
fun outResultValue(id: i32, seq: i32, phase: i32, value: ref distance.TOIOutput) -> () = { prefix("V16",id,seq); outDec(phase); outDec(2i32); outHex(value.state as u32); outFloat(value.fraction); newline(); }
var savedInput: distance.TOIInput = distance.TOIInput(); var savedResult: distance.TOIOutput = distance.TOIOutput();
fun mutateSweep(s: ref distance.Sweep, word: i32) -> () = {
    if (word == 0i32) s.localCenter.x = fromBits(distance.toiBits(s.localCenter.x)^1u32);
    else if (word == 6i32) s.q1.c = fromBits(distance.toiBits(s.q1.c)^1u32);
}
fun copyProof(id: i32, seq: i32, input: ref distance.TOIInput, result: ref distance.TOIOutput) -> () = {
    var original: distance.TOIInput = input; var changed: distance.TOIInput = original;
    let slot: i32 = (id-113i32)%8i32;
    if (slot == 0i32) changed.proxyA.points[0].x = fromBits(distance.toiBits(changed.proxyA.points[0].x)^1u32);
    else if (slot == 1i32) changed.proxyB.points[0].x = fromBits(distance.toiBits(changed.proxyB.points[0].x)^1u32);
    else if (slot == 2i32) mutateSweep(&changed.sweepA,0i32);
    else if (slot == 3i32) mutateSweep(&changed.sweepB,0i32);
    else if (slot == 4i32) mutateSweep(&changed.sweepA,6i32);
    else if (slot == 5i32) mutateSweep(&changed.sweepB,6i32);
    else if (slot == 6i32) changed.maxFraction = fromBits(distance.toiBits(changed.maxFraction)^1u32);
    else changed.proxyA.radius = fromBits(distance.toiBits(changed.proxyA.radius)^1u32);
    outInputValue(id,seq,0i32,&original); outInputValue(id,seq,1i32,&changed); outInputValue(id,seq,2i32,&original);
    var originalResult: distance.TOIOutput = result; var changedResult: distance.TOIOutput = originalResult;
    if ((id-113i32)%2i32 == 0i32) changedResult.state = (changedResult.state as u32^1u32) as i32; else changedResult.fraction = fromBits(distance.toiBits(changedResult.fraction)^1u32);
    outResultValue(id,seq,3i32,&originalResult); outResultValue(id,seq,4i32,&changedResult); outResultValue(id,seq,5i32,&originalResult);
    if (seq == 1i32) { savedInput = original; savedResult = originalResult; }
    else { outInputValue(id,seq,6i32,&savedInput); outResultValue(id,seq,7i32,&savedResult); }
}
fun execute(id: i32, seq: i32, op: i32, n: i32) -> () = {
    prefix("E16",id,seq); outDec(op); outDec(n); var wi: i32 = 0i32; while (wi < n) { outHex(payload[wi]); wi = wi+1i32; } newline();
    var trace = distance.TOITrace(); var status: i32 = 0i32; var reason: i32 = 0i32; var out = geo.Transform(); var result = distance.TOIOutput(); var input = distance.TOIInput();
    var f = distance.SeparationFunction(); var ia: i32 = 0i32; var ib: i32 = 0i32; var separation: f32 = 0.0f32; var evaluated: f32 = 0.0f32;
    if (op == 300i32) { var s: distance.Sweep = readSweep(1i32); if (payload[0] == 0u32) out = distance.b2GetSweepTransform(&s,fromBits(payload[11])); else { let checked: distance.SweepResult = distance.getSweepTransform(&s,fromBits(payload[11])); status = checked.status; reason = checked.reason; out = checked.value; } }
    else if (op == 301i32) {
        input = readTOI();
        if (payload[0] == 0u32) result = distance.b2TimeOfImpactObserved(&input,&trace);
        else { let checkedTOI: distance.TOIResult = distance.timeOfImpactObserved(&input,&trace); status = checkedTOI.status; reason = checkedTOI.reason; result = checkedTOI.value; }
    }
    else {
        var query: f32 = 0.0f32;
        if (op == 306i32) {
            var pA: distance.ShapeProxy = readProxy(1i32); var pB: distance.ShapeProxy = readProxy(19i32); var sA: distance.Sweep = readSweep(37i32); var sB: distance.Sweep = readSweep(47i32); var cache = distance.SimplexCache(); cache.count = payload[57] as i32;
            var ci: i32 = 0i32; while (ci < 3i32) { cache.indexA[ci] = payload[58i32+ci] as i32; cache.indexB[ci] = payload[61i32+ci] as i32; ci = ci+1i32; }
            f = distance.b2MakeSeparationFunction(&cache,&pA,&sA,&pB,&sB,fromBits(payload[64])); distance.observeSeparation(&trace,&f,true); query = fromBits(payload[65]);
        }
        else { f.proxyA = readProxy(6i32); f.proxyB = readProxy(24i32); f.sweepA = readSweep(42i32); f.sweepB = readSweep(52i32); f.sepType = payload[1] as i32; f.axis = geo.Vec2(fromBits(payload[2]),fromBits(payload[3])); f.localPoint = geo.Vec2(fromBits(payload[4]),fromBits(payload[5])); query = fromBits(payload[62]); }
        separation = distance.b2FindMinSeparation(&f,&ia,&ib,query); evaluated = distance.b2EvaluateSeparation(&f,ia,ib,query);
    }
    outputTrace(id,seq,&trace); prefix("R16",id,seq); outDec(op); outDec(status); outDec(reason);
    if (op == 300i32) { outDec(4i32); outFloat(out.p.x); outFloat(out.p.y); outFloat(out.q.c); outFloat(out.q.s); }
    else if (op == 301i32) { outDec(2i32); outHex(result.state as u32); outFloat(result.fraction); }
    else { outDec(9i32); outHex(f.sepType as u32); outFloat(f.axis.x); outFloat(f.axis.y); outFloat(f.localPoint.x); outFloat(f.localPoint.y); outHex(ia as u32); outHex(ib as u32); outFloat(separation); outFloat(evaluated); } newline();
    if (id >= 113i32 and op == 301i32) copyProof(id,seq,&input,&result);
}

fun operationCount(id: i32) -> i32 = {
    if (id <= 48i32) return 2i32;
    if (id <= 80i32) { if (id <= 52i32) return 2i32; return 1i32; }
    if (id <= 112i32) return 2i32; return 6i32;
}
fun run(diagnostic: bool) -> i64 = {
    readRow(true); if (not inputOk) return 2i64;
    if (tokens != 4i32) { fail("HEADER"); return 2i64; }
    if (not tokenEquals(0i32,"PORT16")) { fail("TAG"); return 2i64; }
    if (not tokenEquals(1i32,"A")) { fail("PART"); return 2i64; }
    let guard: bool = tokenEquals(2i32,"GUARD"); if (not guard and not tokenEquals(2i32,"DIRECT")) { fail("PROFILE"); return 2i64; }
    let n: u32 = number(3i32,false); let full: u32 = if guard then 262u32 else 128u32;
    if (not inputOk) return 2i64; if (n == 0u32 or n > full or (not diagnostic and n != full)) { fail("N"); return 2i64; }
    var caseIndex: u32 = 0u32; var previous: u32 = 0u32;
    while (caseIndex < n and inputOk) {
        readRow(false); if (not inputOk) return 2i64;
        if (not tokenEquals(0i32,"C")) { fail("CASE"); return 2i64; } if (tokens != 3i32) { fail("CASE"); return 2i64; }
        let id: u32 = number(1i32,false); let count: u32 = number(2i32,false); if (not inputOk) return 2i64;
        if (id <= previous or id > full or (not diagnostic and id != caseIndex+1u32)) { fail("ID"); return 2i64; }
        if (count != (if guard then 0u32 else operationCount(id as i32) as u32)) { fail("COUNT"); return 2i64; }
        previous = id; prefix("CASE",id as i32,count as i32); newline();
        var seq: u32 = 1u32;
        while (seq <= count and inputOk) {
            readRow(false); if (not inputOk) return 2i64;
            if (not tokenEquals(0i32,"O")) { fail("OPCODE"); return 2i64; }
            if (tokens < 4i32) { fail("ARITY"); return 2i64; }
            let actualSeq: u32 = number(1i32,false); let op: u32 = number(2i32,false); let words: u32 = number(3i32,false); if (not inputOk) return 2i64;
            if (actualSeq != seq) { fail("SEQ"); return 2i64; } let expected: i32 = arity(op as i32);
            if (expected == 0i32) { fail("OPCODE"); return 2i64; }
            if (words != expected as u32 or tokens != 4i32+expected) { fail("ARITY"); return 2i64; }
            readPayload(4i32,expected); if (not inputOk) return 2i64; domain(op as i32); if (not inputOk) return 2i64;
            execute(id as i32,seq as i32,op as i32,expected); seq = seq+1u32;
        }
        if (guard) {
            var pair: i32 = 0i32; while (pair < 2i32 and inputOk) {
                readRow(false); if (not inputOk) return 2i64;
                if (not tokenEquals(0i32,"G") or tokens < 5i32) { fail("GUARD"); return 2i64; }
                let gid: u32 = number(1i32,false); let guardId: u32 = number(2i32,false); let gop: u32 = number(3i32,false); let gn: u32 = number(4i32,false); if (not inputOk) return 2i64;
                if (gid != id or guardId != id or (gop != 300u32 and gop != 301u32)) { fail("GUARD"); return 2i64; }
                let gcount: i32 = arity(gop as i32); if (gn != gcount as u32 or tokens != 5i32+gcount) { fail("ARITY"); return 2i64; }
                readPayload(5i32,gcount); if (not inputOk) return 2i64; if (payload[0] != 1u32) { fail("MODE"); return 2i64; }
                var validation = distance.Validation();
                if (gop == 300u32) { var gs: distance.Sweep = readSweep(1i32); validation = distance.validateSweep(&gs,fromBits(payload[11])); }
                else { var gt: distance.TOIInput = readTOI(); validation = distance.validateTOI(&gt); }
                prefix("G16",id as i32,guardId as i32); outDec(gcount); var gi: i32 = 0i32; while (gi < gcount) { outHex(payload[gi]); gi = gi+1i32; } newline();
                prefix("GA16",id as i32,guardId as i32); outDec(if validation.status == 0i32 then 1i32 else 0i32); outDec(validation.status); outDec(validation.reason); newline(); pair = pair+1i32;
            }
        }
        io.writeStr("ENDCASE"); outDec(id as i32); newline(); caseIndex = caseIndex+1u32;
    }
    if (io.readCharCode() >= 0i32) { fail("TRAILING_DATA"); return 2i64; }
    io.writeStr("END"); outDec(n as i32); newline(); return 0i64;
}
fun main(argc: i32, argv: cptr cptr char) -> i64 = {
    var diagnostic: bool = false;
    if (argc == 2i32) { let arg: cptr char = argv[1]; let text: str = "--diagnostic"; let expected: cptr char = builtins.ptr_from_slice[char](text) as cptr char; var i: i32 = 0i32; diagnostic = true; while (i < 12i32 and diagnostic) { if (arg[i] != expected[i]) diagnostic = false; i = i+1i32; } if (diagnostic and arg[12] != 0 as char) diagnostic = false; }
    return run(diagnostic);
}

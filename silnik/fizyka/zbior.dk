# Box2D 8c661469, src/table.h:12. Unsigned key, low word first.
class Key64 { low: u32 = 0u32; high: u32 = 0u32; }

# Box2D 8c661469, src/table.h:12-16.
class SetItem { key: Key64 = Key64(); hash: u32 = 0u32; }

# Box2D 8c661469, src/table.h:20. Guide rule 23.
fun emptySetItems() -> List[SetItem] = {
    var values: List[SetItem];
    return values;
}

# Box2D 8c661469, src/table.h:18-23. List length is logical slot capacity.
class HashSet {
    items: List[SetItem] = emptySetItems();
    capacity: i32 = 0i32;
    count: i32 = 0i32;
}

# Box2D 8c661469, src/table.                         
fun equalKey(a: Key64, b: Key64) -> bool = {
    return a.low == b.low and a.high == b.high;
}

# Box2D 8c661469, src/table.h:10.
fun B2_SHAPE_PAIR_KEY(a: i32, b: i32) -> Key64 = {
    if (a < b) return Key64(b as u32, a as u32);
    return Key64(a as u32, b as u32);
}

# Box2D 8c661469, src/ctz.h:77. No compiler intrinsic required.
fun b2CLZ32(value: u32) -> i32 = {
    var remaining: u32 = value;
    var count: i32 = 32i32;
    while (remaining != 0u32) {
        remaining = remaining >> 1u32;
        count = count - 1i32;
    }
    return count;
}

# Box2D 8c661469, src/ctz.h:104.
fun b2RoundUpPowerOf2(x: i32) -> i32 = {
    if (x <= 1i32) return 1i32;
    return 1i32 << (32i32 - b2CLZ32((x - 1i32) as u32));
}

# Box2D 8c661469, src/table.c:20.
                                                                                   
fun b2CreateSet(capacity: i32) -> HashSet = {
    var result = HashSet();
    result.capacity = if capacity > 16i32 then b2RoundUpPowerOf2(capacity) else 16i32;
    var i: i32 = 0i32;
    while (i < result.capacity) {
        result.items.push(SetItem());
        i = i + 1i32;
    }
    return result;
}

# Box2D 8c661469, src/table.c:41.
fun b2DestroySet(set: ref HashSet) -> () = {
    set = HashSet();
}

# Box2D 8c661469, src/table.c:49.
fun b2ClearSet(set: ref HashSet) -> () = {
    set.count = 0i32;
    var i: i32 = 0i32;
    while (i < set.capacity) {
        set.items.at(i as i64) = SetItem();
        i = i + 1i32;
    }
}

# Box2D 8c661469, src/table.                                     
                                                                                  
fun multiplyKey(a: Key64, b: Key64) -> Key64 = {
    var aa: u32[4];
    var bb: u32[4];
    var digits: u32[4];
    aa[0] = a.low & 65535u32;
    aa[1] = a.low >> 16u32;
    aa[2] = a.high & 65535u32;
    aa[3] = a.high >> 16u32;
    bb[0] = b.low & 65535u32;
    bb[1] = b.low >> 16u32;
    bb[2] = b.high & 65535u32;
    bb[3] = b.high >> 16u32;
    var carry: i64 = 0i64;
    var i: i32 = 0i32;
    while (i < 4i32) {
        var sum: i64 = carry;
        var j: i32 = 0i32;
        while (j <= i) {
            sum = sum + (aa[j] as i64) * (bb[i - j] as i64);
            j = j + 1i32;
        }
        digits[i] = (sum % 65536i64) as u32;
        carry = sum / 65536i64;
        i = i + 1i32;
    }
    return Key64(digits[0] | (digits[1] << 16u32), digits[2] | (digits[3] << 16u32));
}

# Box2D 8c661469, src/table.c:66,68,70.                         
fun xorShift33(h: Key64) -> Key64 = {
    return Key64(h.low ^ (h.high >> 1u32), h.high);
}

# Box2D 8c661469, src/table.c:61.
fun b2KeyHash(key: Key64) -> u32 = {
    var h: Key64 = xorShift33(key);
    h = multiplyKey(h, Key64(3981806797u32, 4283543511u32));
    h = xorShift33(h);
    h = multiplyKey(h, Key64(444984403u32, 3301882366u32));
    h = xorShift33(h);
    return h.low;
}

# Box2D 8c661469, src/table.c:74.
fun b2FindSlot(set: ref HashSet, key: Key64, hash: u32) -> i32 = {
    var index: i32 = (hash & ((set.capacity - 1i32) as u32)) as i32;
    var item: SetItem = set.items.at(index as i64);
    while (not equalKey(item.key, Key64()) and not equalKey(item.key, key)) {
        index = (index + 1i32) & (set.capacity - 1i32);
        item = set.items.at(index as i64);
    }
    return index;
}

# Box2D 8c661469, src/table.c:94.
fun b2AddKeyHaveCapacity(set: ref HashSet, key: Key64, hash: u32) -> () = {
    let index: i32 = b2FindSlot(set, key, hash);
    set.items.at(index as i64) = SetItem(key, hash);
    set.count = set.count + 1i32;
}

# Box2D 8c661469, src/table.c:105. Ascending old slots, same rehash order.
fun b2GrowTable(set: ref HashSet) -> () = {
    var grown: HashSet = b2CreateSet(2i32 * set.capacity);
    var i: i32 = 0i32;
    while (i < set.capacity) {
        let item: SetItem = set.items.at(i as i64);
        if (not equalKey(item.key, Key64())) b2AddKeyHaveCapacity(&grown, item.key, item.hash);
        i = i + 1i32;
    }
    set = move grown;
}

# Box2D 8c661469, src/table.c:137.
fun b2ContainsKey(set: ref HashSet, key: Key64) -> bool = {
    let hash: u32 = b2KeyHash(key);
    let index: i32 = b2FindSlot(set, key, hash);
    let item: SetItem = set.items.at(index as i64);
    return equalKey(item.key, key);
}

# Box2D 8c661469, src/table.c:151. True means ALREADY present.
fun b2AddKey(set: ref HashSet, key: Key64) -> bool = {
    let hash: u32 = b2KeyHash(key);
    let index: i32 = b2FindSlot(set, key, hash);
    let item: SetItem = set.items.at(index as i64);
    if (not equalKey(item.key, Key64())) return true;
    if (2i32 * set.count >= set.capacity) b2GrowTable(set);
    b2AddKeyHaveCapacity(set, key, hash);
    return false;
}

# Box2D 8c661469, src/table.c:177. Backward-shift deletion, including wraparound.
fun b2RemoveKey(set: ref HashSet, key: Key64) -> bool = {
    let hash: u32 = b2KeyHash(key);
    var i: i32 = b2FindSlot(set, key, hash);
    let first: SetItem = set.items.at(i as i64);
    if (equalKey(first.key, Key64())) return false;
    set.items.at(i as i64) = SetItem();
    set.count = set.count - 1i32;
    var j: i32 = i;
    var searching: bool = true;
    while (searching) {
        j = (j + 1i32) & (set.capacity - 1i32);
        let item: SetItem = set.items.at(j as i64);
        if (equalKey(item.key, Key64())) {
            searching = false;
        } else {
            let k: i32 = (item.hash & ((set.capacity - 1i32) as u32)) as i32;
            var skip: bool = false;
            if (i <= j) skip = i < k and k <= j;
            else skip = i < k or k <= j;
            if (not skip) {
                set.items.at(i as i64) = item;
                set.items.at(j as i64) = SetItem();
                i = j;
            }
        }
    }
    return true;
}

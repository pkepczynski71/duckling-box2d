fun validJointAngle14(value: f32) -> bool = { return value >= -mass2.B2_PI and value <= mass2.B2_PI; }
fun validRevoluteLimits14(lower: f32, upper: f32) -> bool = { return lower >= -0.99f32 * mass2.B2_PI and upper <= 0.99f32 * mass2.B2_PI and lower <= upper; }
fun validJointAxis14(axis: Vec2) -> bool = { return mass2.b2AbsFloat(1.0f32 - mass2.b2Dot(axis,axis)) < 100.0f32 * 0.00000011920928955078125f32; }

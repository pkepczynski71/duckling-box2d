}
# Box2D 8c661469, src/body.c:177.
class BodyResult {
    status: i32 = STALE;
    number: BodyNumber = BodyNumber();
    id: raw.BodyId = raw.BodyId();
}

# Box2D 8c661469, src/world.c:100. LIMIT before touching the physics registry.
fun createWorld(gravity: Vec2, maximumLinearSpeed: f32) -> WorldResult = {
    var result = WorldResult();
    if (ticketLimit(lastIssued)) { result.status = LIMIT; return result; }
    let reserved: Key64 = nextTicket(lastIssued);
    let id: raw.WorldId = raw.b2CreateWorld(gravity, maximumLinearSpeed);
    if (id.index1 == 0u16) { result.status = LIMIT; return result; }
    let slot: i32 = (id.index1 - 1u16) as i32;
    raw.worlds.at(slot as i64).birthTicket = reserved;
    lastIssued = reserved;
    result.status = OK;
    result.number = WorldNumber(slot, reserved);
    result.id = id;
    return result;
}


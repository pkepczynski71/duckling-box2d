# Box2D 8c661469, src/body.c:177. Validate owner, then reserve, then commit on success.
fun createBody(owner: WorldNumber, def: raw.BodyDef) -> BodyResult = {
    var result = BodyResult();
    result.status = worldMutationStatus(owner);
    if (result.status != OK) return result;
    if (not validSleepThreshold(def.sleepThreshold)) { result.status = PARAM; return result; }
    if (ticketLimit(lastIssued)) { result.status = LIMIT; return result; }
    let reserved: Key64 = nextTicket(lastIssued);
    let worldId: raw.WorldId = raw.WorldId((owner.slot + 1i32) as u16,
        raw.worlds.at(owner.slot as i64).generation);
    let id: raw.BodyId = raw.b2CreateBody(worldId, def);
    if (id.index1 == 0i32) { result.status = LIMIT; return result; }
    let slot: i32 = id.index1 - 1i32;
    raw.worlds.at(owner.slot as i64).bodies.at(slot as i64).birthTicket = reserved;
    lastIssued = reserved;
    result.status = OK;
    result.number = BodyNumber(slot, reserved, owner.birthTicket);
    result.id = id;
    return result;
}


fun jointReservationFit(last: Key64, required: u32, slotNext: u32) -> bool = {
    let available: Key64 = Key64(4294967295u32-last.low,4294967295u32-last.high);
    return (available.high != 0u32 or required <= available.low) and slotNext < 2147483647u32;
}
fun bodyTypePreflight14(owner: WorldNumber, number: BodyNumber, bodyType: i32) -> i32 = {
    let status: i32 = bodyMutationStatus(owner,number); if (status != OK) return status;
    if (bodyType < 0i32 or bodyType > 2i32) return PARAM;
    let body: raw.BodyRecord = raw.worlds.at(owner.slot as i64).bodies.at(number.slot as i64);
    if (chainBodyTypeStatus(owner,number,bodyType) != OK) return PARAM;
    if (body.bodyType == bodyType) return OK;
    if (body.jointCount > 0i32) return PARAM;
    if (not safeBodyChange(owner,number,bodyType,body.fixedRotation,false)) return GEOMETRY;
    return OK;
}
fun bodyEnabledPreflight14(owner: WorldNumber, number: BodyNumber, enabled: bool) -> i32 = {
    let status: i32 = bodyMutationStatus(owner,number); if (status != OK) return status;
    let body: raw.BodyRecord = raw.worlds.at(owner.slot as i64).bodies.at(number.slot as i64);
    if (not enabled and body.setIndex != 1i32 and body.jointCount > 0i32) return PARAM;
    return OK;
}

                                                                                             
fun createPairAfterPreflight17(owner: WorldNumber, def: raw.BodyDef, source: raw.ShapeRecord, invoke: bool, hasObjectId: bool, objectId: Key64) -> PairResult = {
    var result = PairResult(); var shape: raw.ShapeRecord = source;
    shape.hasObjectId = hasObjectId; shape.objectId = if hasObjectId then objectId else Key64();
    result.body = createBody(owner,def); if (result.body.status != OK) { result.status = result.body.status; return result; }
    raw.worlds.at(owner.slot as i64).bodies.at(result.body.number.slot as i64).hasObjectId = hasObjectId;
    raw.worlds.at(owner.slot as i64).bodies.at(result.body.number.slot as i64).objectId = shape.objectId;
    result.shape = createShapeRaw(owner,result.body.number,shape,true,invoke); result.status = result.shape.status; return result;
}

                                                                       
class RevoluteDescription {

    localAnchorA: Vec2 = Vec2(); localAnchorB: Vec2 = Vec2();
    referenceAngle: f32 = 0.0f32;
    targetAngle: f32 = 0.0f32;
    hertz: f32 = 0.0f32;
    dampingRatio: f32 = 0.0f32;
    lowerAngle: f32 = 0.0f32;
    upperAngle: f32 = 0.0f32;
    maxMotorTorque: f32 = 0.0f32;
    motorSpeed: f32 = 0.0f32;
    enableSpring: bool = false; enableLimit: bool = false; enableMotor: bool = false;
    collideConnected: bool = false; hasObjectId: bool = false; objectId: Key64 = Key64();
    drawSize: f32 = 0.25f32;
}
fun defaultRevoluteDescription() -> RevoluteDescription = { return RevoluteDescription(); }
fun jointCreatePreflight(owner: WorldNumber, a: BodyNumber, b: BodyNumber, description: RevoluteDescription) -> JointAction = {
    let statusA: i32 = bodyStatus(owner,a); if (statusA != OK) return jointActionStatus14(statusA);
    let statusB: i32 = bodyStatus(owner,b); if (statusB != OK) return jointActionStatus14(statusB);
    if (raw.worlds.at(owner.slot as i64).locked) return JointAction(LOCKED,1i32);
    if (a.slot == b.slot) return JointAction(PARAM,7i32);
    if (not validRevoluteDescription(description)) return JointAction(PARAM,10i32);
    if (not jointReservationFit(lastIssued,1u32,raw.worlds.at(owner.slot as i64).jointIdPool.nextIndex as u32)) return JointAction(LIMIT,0i32);
    return JointAction();
}
fun validRevoluteDescription(value: RevoluteDescription) -> bool = {
    return finiteVector(value.localAnchorA) and finiteVector(value.localAnchorB)
        and validJointAngle14(value.referenceAngle) and validJointAngle14(value.targetAngle) and finite(value.drawSize)
        and validRevoluteLimits14(value.lowerAngle,value.upperAngle)
        and validNonnegative(value.hertz) and validNonnegative(value.dampingRatio)
        and validNonnegative(value.maxMotorTorque) and finite(value.motorSpeed)
        and (value.hasObjectId or (value.objectId.low == 0u32 and value.objectId.high == 0u32));
}
fun createRevoluteJoint(owner: WorldNumber, a: BodyNumber, b: BodyNumber, description: RevoluteDescription) -> JointResult = {
    var result = JointResult(); let check: JointAction = jointCreatePreflight(owner,a,b,description);
    result.status = check.status; result.reason = check.reason; if (check.status != OK) return result;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64); let ticket: Key64 = nextTicket(lastIssued);
    var def = raw.RevoluteJointDef(); def.bodyIdA = raw.b2MakeBodyId(world,a.slot); def.bodyIdB = raw.b2MakeBodyId(world,b.slot);
    def.localAnchorA = description.localAnchorA;
    def.localAnchorB = description.localAnchorB;
    def.referenceAngle = description.referenceAngle;
    def.targetAngle = description.targetAngle;
    def.hertz = description.hertz;
    def.dampingRatio = description.dampingRatio;
    def.lowerAngle = description.lowerAngle;
    def.upperAngle = description.upperAngle;
    def.maxMotorTorque = description.maxMotorTorque;
    def.motorSpeed = description.motorSpeed;
    def.enableSpring = description.enableSpring;
    def.enableLimit = description.enableLimit;
    def.enableMotor = description.enableMotor;
    def.collideConnected = description.collideConnected;
    def.hasObjectId = description.hasObjectId;
    def.objectId = description.objectId;
    def.drawSize = description.drawSize;
    let id: raw.JointId = raw.b2CreateRevoluteJoint(raw.WorldId((owner.slot+1i32) as u16,world.generation),def);
    let slot: i32 = id.index1-1i32; world.joints.at(slot as i64).birthTicket = ticket;
    world.joints.at(slot as i64).ownerTicket = owner.birthTicket; lastIssued = ticket;
    result.status = OK; result.number = JointNumber(slot,ticket,owner.birthTicket); return result;
}

class SolverWorldParameters {
    gravity: Vec2 = Vec2(0.0f32, -10.0f32); maximumLinearSpeed: f32 = 400.0f32;
    contactHertz: f32 = 30.0f32; contactDampingRatio: f32 = 10.0f32; maxContactPushSpeed: f32 = 3.0f32;
    restitutionThreshold: f32 = 1.0f32; hitEventThreshold: f32 = 1.0f32; enableWarmStarting: bool = true;
}
# Box2D 8c661469, src/world.                                                               
fun validSolverWorldParameters(parameters: SolverWorldParameters) -> bool = {
    return finiteVector(parameters.gravity) and finite(parameters.maximumLinearSpeed) and parameters.maximumLinearSpeed > 0.0f32
        and finite(parameters.contactHertz) and parameters.contactHertz >= 0.0f32
        and finite(parameters.contactDampingRatio) and parameters.contactDampingRatio >= 0.0f32
        and finite(parameters.maxContactPushSpeed) and parameters.maxContactPushSpeed >= 0.0f32
        and finite(parameters.restitutionThreshold) and parameters.restitutionThreshold >= 0.0f32
        and finite(parameters.hitEventThreshold) and parameters.hitEventThreshold >= 0.0f32;
}
# Box2D 8c661469, src/world.c:190-220,1746-1761.
fun createSolverWorld(parameters: SolverWorldParameters) -> WorldResult = {
    var result = WorldResult();
    if (not validSolverWorldParameters(parameters)) { result.status = PARAM; return result; }
    result = createWorld(parameters.gravity, parameters.maximumLinearSpeed);
    if (result.status != OK) return result;
    var world: ref raw.World = raw.worlds.at(result.number.slot as i64);
    world.contactHertz = parameters.contactHertz; world.contactDampingRatio = parameters.contactDampingRatio;
    world.maxContactPushSpeed = parameters.maxContactPushSpeed; world.restitutionThreshold = parameters.restitutionThreshold;
    world.hitEventThreshold = parameters.hitEventThreshold;
    raw.b2World_EnableWarmStarting(result.id, parameters.enableWarmStarting);
    return result;
}

# Box2D 8c661469, src/world.                                                      
fun createSleepWorld(gravity: Vec2, maximumLinearSpeed: f32, solverParameters: SolverWorldParameters, enableSleeping: bool = true) -> WorldResult = {
    var parameters: SolverWorldParameters = solverParameters;
    parameters.gravity = gravity; parameters.maximumLinearSpeed = maximumLinearSpeed;
    var result: WorldResult = createSolverWorld(parameters);
    if (result.status != OK) return result;
    raw.worlds.at(result.number.slot as i64).enableSleep = enableSleeping;
    return result;
}

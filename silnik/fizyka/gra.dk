# Box2D 8c661469, src/joint.c:1130-1346, revolute_joint.c/prismatic_joint.                                     
                                                                         
fun jointSetterPreflightB14(owner: WorldNumber, number: JointNumber, kind: i32, value: f32, other: f32) -> JointAction = {
    let status: i32 = jointMutationStatus(owner,number); if (status != OK) return jointActionStatus14(status);
    let typ: i32 = raw.worlds.at(owner.slot as i64).joints.at(number.slot as i64).jointType;
    if ((kind == 2i32 and typ != 4i32 and typ != 5i32) or (kind == 3i32 and typ != 4i32)
        or (kind >= 32i32 and kind <= 40i32 and typ != 5i32) or (kind >= 48i32 and kind <= 56i32 and typ != 4i32)) return JointAction(PARAM,6i32);
    if (kind == 3i32) { if (not validJointAxis14(Vec2(value,other))) return JointAction(PARAM,9i32); }
    else if (kind == 2i32 or kind == 35i32) { if (not validJointAngle14(value)) return JointAction(PARAM,10i32); }
    else if (kind == 37i32) { if (not validRevoluteLimits14(value,other)) return JointAction(PARAM,10i32); }
    else if (kind == 53i32) { if (not finite(value) or not finite(other) or value > other) return JointAction(PARAM,10i32); }
    else if (kind == 33i32 or kind == 34i32 or kind == 40i32 or kind == 49i32 or kind == 50i32 or kind == 56i32) { if (not validNonnegative(value)) return JointAction(PARAM,10i32); }
    else if (kind == 39i32 or kind == 51i32 or kind == 55i32) { if (not finite(value)) return JointAction(PARAM,10i32); }
    return JointAction();
}
fun setJointReferenceAngle(owner: WorldNumber, number: JointNumber, angle: f32) -> JointAction = {
    let check: JointAction = jointSetterPreflightB14(owner,number,2i32,angle,0.0f32); if (check.status != OK) return check;
    raw.b2Joint_SetReferenceAngle(makeJointId14(owner,number),angle); return JointAction();
}
fun setJointLocalAxisA(owner: WorldNumber, number: JointNumber, axis: Vec2) -> JointAction = {
    let check: JointAction = jointSetterPreflightB14(owner,number,3i32,axis.x,axis.y); if (check.status != OK) return check;
    raw.b2Joint_SetLocalAxisA(makeJointId14(owner,number),axis); return JointAction();
}
class JointScalar { status: i32 = STALE; reason: i32 = 0i32; value: f32 = 0.0f32; }
class JointVector { status: i32 = STALE; reason: i32 = 0i32; value: Vec2 = Vec2(); }
fun getJointReferenceAngle(owner: WorldNumber, number: JointNumber) -> JointScalar = {
    let status: i32 = jointStatus(owner, number); if (status != OK) return JointScalar(status, 0i32, 0.0f32);
    let typ: i32 = raw.worlds.at(owner.slot as i64).joints.at(number.slot as i64).jointType;
    if (typ != 4i32 and typ != 5i32) return JointScalar(PARAM,6i32,0.0f32);
    return JointScalar(OK,0i32,raw.b2Joint_GetReferenceAngle(makeJointId14(owner,number)));
}
fun getJointLocalAxisA(owner: WorldNumber, number: JointNumber) -> JointVector = {
    let status: i32 = jointStatus(owner, number); if (status != OK) return JointVector(status, 0i32, Vec2());
    if (raw.worlds.at(owner.slot as i64).joints.at(number.slot as i64).jointType != 4i32) return JointVector(PARAM,6i32,Vec2());
    return JointVector(OK,0i32,raw.b2Joint_GetLocalAxisA(makeJointId14(owner,number)));
}

                                                          

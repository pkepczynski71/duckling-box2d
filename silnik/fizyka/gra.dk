# Box2D 8c661469, src/world.                                                   
                                                                              
var lastIssued: Key64 = Key64();

# Box2D 8c661469, src/world.                                                
fun ticketLimit(last: Key64) -> bool = {
    return last.low == 4294967295u32 and last.high == 4294967295u32;
}

# Box2D 8c661469, src/world.                                      
                                                                                  
fun nextTicket(last: Key64) -> Key64 = {
    if (ticketLimit(last)) return last;
    if (last.low == 4294967295u32) return Key64(0u32, last.high + 1u32);
    return Key64(last.low + 1u32, last.high);
}

# Box2D 8c661469, src/world.c:1557. Stronger game lifetime test before raw access.
                                                                       
fun worldSlotValid17(slot: i32) -> bool = { return slot >= 0i32 and slot < 128i32; }
fun worldMetadataValid17(number: WorldNumber, inUse: bool, birth: Key64) -> bool = { return inUse and equalKey(birth,number.birthTicket); }
fun targetOwnerValid17(owner: Key64, target: Key64) -> bool = { return equalKey(owner,target); }
fun targetSlotValid17(slot: i32, capacity: i64) -> bool = { return slot >= 0i32 and slot as i64 < capacity; }
fun bodyMetadataValid17(id: i32, setIndex: i32, actual: Key64, expected: Key64) -> bool = { return id != -1i32 and setIndex != -1i32 and equalKey(actual,expected); }
fun shapeMetadataValid17(id: i32, actual: Key64, expected: Key64) -> bool = { return id != -1i32 and equalKey(actual,expected); }
fun worldStatus(number: WorldNumber) -> i32 = {
    if (not worldSlotValid17(number.slot)) return STALE;
    var world: ref raw.World = raw.worlds.at(number.slot as i64);
    if (not worldMetadataValid17(number,world.inUse,world.birthTicket)) return STALE;
    let id: raw.WorldId = raw.WorldId((number.slot + 1i32) as u16, world.generation);
    if (not raw.b2World_IsValid(id)) return STALE;
    return OK;
}

# Box2D 8c661469, src/world.c:1576. Buffered contact order is part of the API.
fun bodyStatus(owner: WorldNumber, number: BodyNumber) -> i32 = {
    if (worldStatus(owner) != OK) return STALE;
    if (not targetOwnerValid17(owner.birthTicket,number.ownerTicket)) return FOREIGN;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    if (not targetSlotValid17(number.slot,world.bodies.length())) return STALE;
    let body: raw.BodyRecord = world.bodies.at(number.slot as i64);
    if (not bodyMetadataValid17(body.id,body.setIndex,body.birthTicket,number.birthTicket)) return STALE;
    if (not raw.b2Body_IsValid(raw.b2MakeBodyId(world, number.slot))) return STALE;
    return OK;
}


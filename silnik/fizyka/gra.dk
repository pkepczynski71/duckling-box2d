fun validName(name: raw.NameValue) -> bool = {
    if (name.length < 0i32 or name.length > 31i32) return false;
    var i: i32 = 0i32;
    while (i < name.length) {
        let lead: i32 = name.bytes[i] as i32;
        if (lead == 0i32) return false;
        var count: i32 = 0i32;
        if (lead < 128i32) count = 1i32;
        else if (lead >= 194i32 and lead <= 223i32) count = 2i32;
        else if (lead >= 224i32 and lead <= 239i32) count = 3i32;
        else if (lead >= 240i32 and lead <= 244i32) count = 4i32;
        else return false;
        if (i + count > name.length) return false;
        var j: i32 = 1i32;
        while (j < count) {
            let next: i32 = name.bytes[i + j] as i32;
            if (next < 128i32 or next > 191i32) return false;
            j = j + 1i32;
        }
        if (count >= 3i32) {
            let second: i32 = name.bytes[i + 1i32] as i32;
            if (lead == 224i32 and second < 160i32) return false;
            if (lead == 237i32 and second > 159i32) return false;
            if (lead == 240i32 and second < 144i32) return false;
            if (lead == 244i32 and second > 143i32) return false;
        }
        i = i + count;
    }
    return true;
}

import fizyka.swiat as raw;
import fizyka.kola.*;
import fizyka.zbior.*;
import fizyka.szeroka as broad;
import fizyka.wielokaty as poly;
import fizyka.ruch as mass2;
import fizyka.drzewo as tree;
import fizyka.odleglosc as distance;

                                                                                           
class ExplosionDescription {
    maskBits: Key64 = Key64(4294967295u32,4294967295u32);
    position: Vec2 = Vec2(); radius: f32 = 0.0f32; falloff: f32 = 0.0f32; impulsePerLength: f32 = 0.0f32;
}
const EXPLOSION_DOMAIN: i32 = 25i32;
fun defaultExplosionDescription() -> ExplosionDescription = {
    let value: raw.ExplosionDef = raw.b2DefaultExplosionDef();
    return ExplosionDescription(value.maskBits,value.position,value.radius,value.falloff,value.impulsePerLength);
}
                                                                                            
fun explosionPreflight(owner: WorldNumber, description: ExplosionDescription) -> ChainValidation = {
    let status: i32 = worldMutationStatus(owner);
    if (status != OK) return ChainValidation(status,if status == LOCKED then 1i32 else 0i32);
    if (not finiteVector(description.position) or not finite(description.radius) or not finite(description.falloff)
        or not finite(description.impulsePerLength) or description.radius < 0.0f32 or description.falloff < 0.0f32) return ChainValidation(PARAM,EXPLOSION_DOMAIN);
    let extent: f32 = description.radius + description.falloff;
    if (not finite(extent)) return ChainValidation(PARAM,EXPLOSION_DOMAIN);
    if (not finite(description.position.x-extent)) return ChainValidation(PARAM,EXPLOSION_DOMAIN);
    if (not finite(description.position.y-extent)) return ChainValidation(PARAM,EXPLOSION_DOMAIN);
    if (not finite(description.position.x+extent)) return ChainValidation(PARAM,EXPLOSION_DOMAIN);
    if (not finite(description.position.y+extent)) return ChainValidation(PARAM,EXPLOSION_DOMAIN);
    return ChainValidation();
}
fun explode(owner: WorldNumber, description: ExplosionDescription) -> ChainValidation = {
    let check: ChainValidation = explosionPreflight(owner,description); if (check.status != OK) return check;
    var definition = raw.ExplosionDef(description.maskBits,description.position,description.radius,description.falloff,description.impulsePerLength);
    raw.b2World_Explode(raw.WorldId((owner.slot+1i32) as u16,raw.worlds.at(owner.slot as i64).generation),&definition);
    return check;
}

                                                                            
const SENSOR_FILTER17: i32 = 20i32;
const NOT_SENSOR17: i32 = 21i32;
fun pairRulesPreflight17(owner: WorldNumber, flag: bool) -> SensorAction = {
    let status: i32 = worldMutationStatus(owner);
    if (status != OK) return SensorAction(status,if status == LOCKED then 1i32 else 0i32);
    return SensorAction();
}
                                                                               
fun sensorDescription(geometry: raw.ShapeRecord) -> raw.ShapeRecord = {
    var result: raw.ShapeRecord = geometry; result.density = 0.0f32; result.isSensor = true; result.enableSensorEvents = true;
    return result;
}
class SensorAction { status: i32 = OK; reason: i32 = 0i32; }
class SensorMeta { status: i32 = STALE; reason: i32 = 0i32; value: i32 = 0i32; }
class SensorOverlap { id: broad.ShapeId = broad.ShapeId(); number: ShapeNumber = ShapeNumber(); }
fun emptySensorOverlaps17() -> List[SensorOverlap] = { var values: List[SensorOverlap]; return values; }
class SensorOverlaps { status: i32 = STALE; reason: i32 = 0i32; values: List[SensorOverlap] = emptySensorOverlaps17(); }
class SensorTouch {
    sensorId: broad.ShapeId = broad.ShapeId(); visitorId: broad.ShapeId = broad.ShapeId();
    sensor: ShapeNumber = ShapeNumber(); visitor: ShapeNumber = ShapeNumber();
}
fun emptySensorTouches17() -> List[SensorTouch] = { var values: List[SensorTouch]; return values; }
class SensorEventCopy {
    status: i32 = STALE; reason: i32 = 0i32;
    beginEvents: List[SensorTouch] = emptySensorTouches17(); endEvents: List[SensorTouch] = emptySensorTouches17();
}
                                                                                    
fun sensorReadPreflight17(owner: WorldNumber, number: ShapeNumber) -> SensorAction = {
    let status: i32 = shapeMutationStatus(owner,number);
    if (status != OK) return SensorAction(status,if status == LOCKED then 1i32 else 0i32);
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    if (world.shapes.at(number.slot as i64).sensorIndex == -1i32) return SensorAction(PARAM,NOT_SENSOR17);
    return SensorAction();
}
fun enableSensorEvents(owner: WorldNumber, number: ShapeNumber, flag: bool) -> i32 = {
    let status: i32 = shapeMutationStatus(owner,number); if (status != OK) return status;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    raw.b2Shape_EnableSensorEvents(raw.b2MakeShapeId(world,number.slot),flag); return OK;
}
                                                                                
fun isSensor(owner: WorldNumber, number: ShapeNumber) -> SensorMeta = {
    let status: i32 = shapeStatus(owner,number); if (status != OK) return SensorMeta(status,0i32,0i32);
    let value: i32 = if raw.worlds.at(owner.slot as i64).shapes.at(number.slot as i64).sensorIndex != -1i32 then 1i32 else 0i32;
    return SensorMeta(OK,0i32,value);
}
fun areSensorEventsEnabled(owner: WorldNumber, number: ShapeNumber) -> SensorMeta = {
    let status: i32 = shapeStatus(owner,number); if (status != OK) return SensorMeta(status,0i32,0i32);
    let value: i32 = if raw.worlds.at(owner.slot as i64).shapes.at(number.slot as i64).enableSensorEvents then 1i32 else 0i32;
    return SensorMeta(OK,0i32,value);
}
fun sensorCapacity(owner: WorldNumber, number: ShapeNumber) -> SensorMeta = {
    let check: SensorAction = sensorReadPreflight17(owner,number);
    if (check.status != OK) return SensorMeta(check.status,check.reason,0i32);
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    return SensorMeta(OK,0i32,raw.b2Shape_GetSensorCapacity(raw.b2MakeShapeId(world,number.slot)));
}
fun sensorOverlaps(owner: WorldNumber, number: ShapeNumber) -> SensorOverlaps = {
    var result = SensorOverlaps(); let check: SensorAction = sensorReadPreflight17(owner,number);
    result.status = check.status; result.reason = check.reason; if (check.status != OK) return result;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    let index: i32 = world.shapes.at(number.slot as i64).sensorIndex; var i: i64 = 0i64;
    while (i < world.sensors.at(index as i64).overlaps2.length()) {
        let r: raw.ShapeRef = world.sensors.at(index as i64).overlaps2.at(i);
        result.values.push(SensorOverlap(broad.ShapeId(r.shapeId+1i32,world.worldId,r.generation),ShapeNumber(r.shapeId,r.birthTicket,owner.birthTicket)));
        i = i+1i64;
    }
    return result;
}
fun sensorTouch17(event: raw.SensorEvent) -> SensorTouch = {
    return SensorTouch(event.sensorShapeId,event.visitorShapeId,
        ShapeNumber(event.sensorShapeId.index1-1i32,event.sensorBirth,event.ownerBirth),
        ShapeNumber(event.visitorShapeId.index1-1i32,event.visitorBirth,event.ownerBirth));
}
fun copySensorEvents(owner: WorldNumber) -> SensorEventCopy = {
    var result = SensorEventCopy(); result.status = worldMutationStatus(owner);
    if (result.status != OK) { if (result.status == LOCKED) result.reason = 1i32; return result; }
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    var events: raw.SensorEvents = raw.b2World_GetSensorEvents(raw.WorldId((owner.slot+1i32) as u16,world.generation));
    var i: i64 = 0i64;
    while (i < events.beginEvents.length()) { result.beginEvents.push(sensorTouch17(events.beginEvents.at(i))); i = i+1i64; }
    var j: i64 = 0i64;
    while (j < events.endEvents.length()) { result.endEvents.push(sensorTouch17(events.endEvents.at(j))); j = j+1i64; }
    return result;
}

# Box2D 8c661469, src/manifold.                                                           
class ChainPairResult { status: i32 = 0i32; reason: i32 = 0i32; value: Manifold = Manifold(); }
# Box2D 8c661469, src/manifold.                                                           
                                                                                
fun validateChainPair(kind: i32, segment: ref raw.ChainSegment, xfA: Transform, xfB: Transform, count: i32, radius: f32, points: ref Vec2[8], cache: ref distance.SimplexCache) -> ChainValidation = {
    let countOk: bool = (kind == 0i32 and count == 1i32) or (kind == 1i32 and count == 2i32) or (kind == 2i32 and count >= 3i32 and count <= 8i32);
    if (not distance.validRadius(radius) or not distance.validTransform(xfA) or not distance.validTransform(xfB)) return ChainValidation(PARAM,0i32);
    if (cache.count < 0i32 or cache.count > 3i32) return ChainValidation(PARAM,82i32);
    var ci: i32 = 0i32;
    while (ci < 3i32) {
        if (cache.indexA[ci] < 0i32 or cache.indexA[ci] > 255i32 or cache.indexB[ci] < 0i32 or cache.indexB[ci] > 255i32) return ChainValidation(PARAM,82i32);
        if (kind != 0i32 and countOk and ci < cache.count) {
            if (cache.indexA[ci] >= 2i32 or cache.indexB[ci] >= count) return ChainValidation(PARAM,82i32);
        }
        ci = ci+1i32;
    }
    if (not countOk) return ChainValidation(GEOMETRY,84i32);
    var chainPoints: List[Vec2]; chainPoints.push(segment.ghost1); chainPoints.push(segment.segment.point1); chainPoints.push(segment.segment.point2); chainPoints.push(segment.ghost2);
    let chainReason: i32 = validateChainGeometry(&chainPoints,false);
    if (chainReason != 0i32) return ChainValidation(GEOMETRY,chainReason);
    var pi: i32 = 0i32;
    while (pi < count) { if (not finiteVector(points[pi])) return ChainValidation(GEOMETRY,84i32); pi = pi+1i32; }
    if (kind == 1i32) {
        let delta: Vec2 = b2Sub(points[1],points[0]); let lengthSquared: f32 = mass2.b2LengthSquared(delta);
        if (not finite(lengthSquared) or lengthSquared <= FLT_EPSILON) return ChainValidation(GEOMETRY,84i32);
    }
    if (kind == 2i32) {
        var shape = poly.Polygon(); shape.count = count; shape.radius = radius; shape.vertices = points;
        if (not raw.b2ValidateHull(&shape)) return ChainValidation(GEOMETRY,84i32);
    }
    return ChainValidation();
}
# Box2D 8c661469, src/manifold.                                            
fun chainPairCached(kind: i32, segment: ref raw.ChainSegment, xfA: Transform, xfB: Transform, count: i32, radius: f32, points: ref Vec2[8], cache: ref distance.SimplexCache) -> ChainPairResult = {
    let check: ChainValidation = validateChainPair(kind,segment,xfA,xfB,count,radius,points,cache);
    if (check.status != OK) return ChainPairResult(check.status,check.reason,Manifold());
    if (kind == 0i32) return ChainPairResult(OK,0i32,raw.b2CollideChainSegmentAndCircle(segment,xfA,Circle(points[0],radius),xfB));
    if (kind == 1i32) { var capsule = raw.Capsule(points[0],points[1],radius); return ChainPairResult(OK,0i32,raw.b2CollideChainSegmentAndCapsule(segment,xfA,&capsule,xfB,cache)); }
    var polygon = poly.Polygon(); polygon.count = count; polygon.radius = radius; polygon.vertices = points; raw.b2MakePolygon(&polygon);
    return ChainPairResult(OK,0i32,raw.b2CollideChainSegmentAndPolygon(segment,xfA,&polygon,xfB,cache));
}

# Box2D 8c661469, include/box2d/id.h:36,44. Game-only types, PLAN-6 points 2-5.
class WorldNumber { slot: i32 = -1i32; birthTicket: Key64 = Key64(); }
class BodyNumber {
    slot: i32 = -1i32;
    birthTicket: Key64 = Key64();
    ownerTicket: Key64 = Key64();
}
const OK: i32 = 0i32;
const STALE: i32 = 1i32;
const FOREIGN: i32 = 2i32;
const LIMIT: i32 = 3i32;
const GEOMETRY: i32 = 4i32;
const PARAM: i32 = 5i32;
const UNSUPPORTED_PAIR: i32 = 6i32;
const LOCKED: i32 = 7i32;
# Box2D 8c661469, src/solver.h:53-60. Reason within LIMIT, not an additional status.
const BLOCK_WIDTH: i32 = 1i32;

# Box2D 8c661469, src/shape.                                                   
class ChainNumber { slot: i32 = -1i32; birthTicket: Key64 = Key64(); ownerTicket: Key64 = Key64(); }
class ChainResult { status: i32 = STALE; reason: i32 = 0i32; number: ChainNumber = ChainNumber(); id: raw.ChainId = raw.ChainId(); }
class ChainDescription {
    points: List[Vec2] = raw.emptyChainPoints(); isLoop: bool = false;
    materials: List[raw.SurfaceMaterial] = raw.defaultChainMaterials();
    filter: broad.ShapeFilter = broad.ShapeFilter(); hasObjectId: bool = false; objectId: Key64 = Key64(); enableSensorEvents: bool = false;
}
class ChainView { number: ChainNumber = ChainNumber(); body: BodyNumber = BodyNumber(); segments: List[ShapeNumber] = emptyShapeNumbers(); }
class ChainLookup { status: i32 = STALE; value: ChainView = ChainView(); }
class ParentChainResult { status: i32 = STALE; hasParent: bool = false; number: ChainNumber = ChainNumber(); }
class ChainValidation { status: i32 = OK; reason: i32 = 0i32; }

# Box2D 8c661469, src/world.                                                  
fun chainStatus(owner: WorldNumber, number: ChainNumber) -> i32 = {
    if (worldStatus(owner) != OK) return STALE;
    if (not targetOwnerValid17(owner.birthTicket,number.ownerTicket)) return FOREIGN;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    if ((number.slot as u32) >= (world.chainIdPool.nextIndex as u32)) return STALE;
    if (world.chainShapes.at(number.slot as i64).id != number.slot) return STALE;
    if (not equalKey(world.chainShapes.at(number.slot as i64).birthTicket, number.birthTicket)) return STALE;
    if (not raw.b2Chain_IsValid(raw.b2MakeChainId(world, number.slot))) return STALE;
    return OK;
}
fun chainMutationStatus(owner: WorldNumber, number: ChainNumber) -> i32 = {
    let status: i32 = chainStatus(owner, number); if (status != OK) return status;
    if (raw.worlds.at(owner.slot as i64).locked) return LOCKED; return OK;
}
# Box2D 8c661469, src/shape.                                                                           
fun chainChildStatus(owner: WorldNumber, number: ShapeNumber) -> i32 = {
    let status: i32 = shapeMutationStatus(owner, number); if (status != OK) return status;
    if (raw.worlds.at(owner.slot as i64).shapes.at(number.slot as i64).shapeType == 4i32) return PARAM;
    return OK;
}
fun chainBodyTypeStatus(owner: WorldNumber, number: BodyNumber, bodyType: i32) -> i32 = {
    let status: i32 = bodyMutationStatus(owner, number); if (status != OK) return status;
    if (bodyType != 0i32 and raw.worlds.at(owner.slot as i64).bodies.at(number.slot as i64).headChainId != -1i32) return PARAM;
    return OK;
}
# Box2D 8c661469, src/world.                                                                         
fun chainTicketReservation(last: Key64, segments: i32) -> bool = {
    var value: Key64 = last; var i: i32 = 0i32;
    while (i < 1i32 + segments) { if (ticketLimit(value)) return false; value = nextTicket(value); i = i+1i32; }
    return true;
}
# Box2D 8c661469, src/math_functions.                                                            
fun chainOrientation(a: Vec2, b: Vec2, c: Vec2, result: ref f32) -> bool = {
    let dx: f32 = b.x-a.x; let dy: f32 = b.y-a.y; let cx: f32 = c.x-a.x; let cy: f32 = c.y-a.y;
    if (not finite(dx) or not finite(dy) or not finite(cx) or not finite(cy)) return false;
    let first: f32 = dx*cy; let second: f32 = dy*cx;
    if (not finite(first) or not finite(second)) return false;
    result = first-second; return finite(result);
}
                                                                                       
fun chainOnSegment(a: Vec2, b: Vec2, p: Vec2, orientation: f32) -> bool = {
    return orientation == 0.0f32 and p.x >= poly.b2MinFloat(a.x,b.x) and p.x <= tree.b2MaxFloat(a.x,b.x)
        and p.y >= poly.b2MinFloat(a.y,b.y) and p.y <= tree.b2MaxFloat(a.y,b.y);
}
fun chainOpposite(a: f32, b: f32) -> bool = { return (a < 0.0f32 and b > 0.0f32) or (a > 0.0f32 and b < 0.0f32); }
# Box2D 8c661469, types.                                                                           
                                                                                              
fun validateChainGeometry(points: ref List[Vec2], closed: bool) -> i32 = {
    let n: i64 = points.length(); if (n < 4i64) return 84i32;
    var i: i64 = 0i64;
    while (i < n) { if (not finiteVector(points.at(i))) return 84i32; i = i+1i64; }
    var pi: i64 = 0i64;
    while (pi < n) {
        var pj: i64 = pi+1i64;
        while (pj < n) {
            let a: Vec2 = points.at(pi); let b: Vec2 = points.at(pj);
            let dx: f32 = b.x-a.x; let dy: f32 = b.y-a.y;
            let xx: f32 = dx*dx; let yy: f32 = dy*dy; let d2: f32 = xx+yy;
            if (not finite(dx) or not finite(dy) or not finite(xx) or not finite(yy) or not finite(d2)) return 84i32;
            if (d2 <= B2_LINEAR_SLOP*B2_LINEAR_SLOP) return 84i32;
            pj = pj+1i64;
        }
        pi = pi+1i64;
    }
    let edgeCount: i64 = if closed then n else n-1i64;
    var ei: i64 = 0i64;
    while (ei < edgeCount) {
        let a1: Vec2 = points.at(ei); let a2: Vec2 = points.at((ei+1i64)%n);
        var ej: i64 = ei+1i64;
        while (ej < edgeCount) {
            let b1: Vec2 = points.at(ej); let b2: Vec2 = points.at((ej+1i64)%n);
            var o1: f32 = 0.0f32; var o2: f32 = 0.0f32; var o3: f32 = 0.0f32; var o4: f32 = 0.0f32;
            if (not chainOrientation(a1,a2,b1,&o1) or not chainOrientation(a1,a2,b2,&o2)
                or not chainOrientation(b1,b2,a1,&o3) or not chainOrientation(b1,b2,a2,&o4)) return 84i32;
            let adjacent: bool = ej == ei+1i64 or (closed and ei == 0i64 and ej == edgeCount-1i64);
            if (adjacent) {
                if (o1 == 0.0f32 and o2 == 0.0f32) {
                    var loA: f32 = poly.b2MinFloat(a1.x,a2.x); var hiA: f32 = tree.b2MaxFloat(a1.x,a2.x);
                    var loB: f32 = poly.b2MinFloat(b1.x,b2.x); var hiB: f32 = tree.b2MaxFloat(b1.x,b2.x);
                    if (mass2.b2AbsFloat(a2.y-a1.y) > mass2.b2AbsFloat(a2.x-a1.x)) {
                        loA = poly.b2MinFloat(a1.y,a2.y); hiA = tree.b2MaxFloat(a1.y,a2.y);
                        loB = poly.b2MinFloat(b1.y,b2.y); hiB = tree.b2MaxFloat(b1.y,b2.y);
                    }
                    if (poly.b2MinFloat(hiA,hiB) > tree.b2MaxFloat(loA,loB)) return 85i32;
                }
            } else {
                if ((chainOpposite(o1,o2) and chainOpposite(o3,o4))
                    or chainOnSegment(a1,a2,b1,o1) or chainOnSegment(a1,a2,b2,o2)
                    or chainOnSegment(b1,b2,a1,o3) or chainOnSegment(b1,b2,a2,o4)) return 85i32;
            }
            ej = ej+1i64;
        }
        ei = ei+1i64;
    }
    return 0i32;
}
fun validateChainDescription(description: ref ChainDescription) -> ChainValidation = {
    let n: i64 = description.points.length(); let count: i64 = description.materials.length();
    if (count != 1i64 and count != n) return ChainValidation(PARAM,83i32);
    var i: i64 = 0i64; while (i < count) { if (not validSurfaceMaterial(description.materials.at(i))) return ChainValidation(PARAM,0i32); i = i+1i64; }
    let reason: i32 = validateChainGeometry(&description.points,description.isLoop);
    if (reason != 0i32) return ChainValidation(GEOMETRY,reason); return ChainValidation();
}
fun chainCreatePreflight(owner: WorldNumber, parent: BodyNumber, description: ref ChainDescription) -> ChainValidation = {
    let status: i32 = bodyMutationStatus(owner,parent); if (status != OK) return ChainValidation(status,if status == LOCKED then 1i32 else 0i32);
    if (raw.worlds.at(owner.slot as i64).bodies.at(parent.slot as i64).bodyType != 0i32) return ChainValidation(PARAM,80i32);
    let validation: ChainValidation = validateChainDescription(description); if (validation.status != OK) return validation;
    let count: i32 = if description.isLoop then description.points.length() as i32 else description.points.length() as i32-3i32;
    if (not chainTicketReservation(lastIssued,count)) return ChainValidation(LIMIT,0i32);
    return ChainValidation();
}
fun addChain(owner: WorldNumber, parent: BodyNumber, description: ref ChainDescription) -> ChainResult = {
    var result = ChainResult(); let validation: ChainValidation = chainCreatePreflight(owner,parent,description);
    result.status = validation.status; result.reason = validation.reason; if (result.status != OK) return result;
    var def = raw.ChainDef(); def.points = copy description.points; def.count = description.points.length() as i32; def.isLoop = description.isLoop;
    def.materials = copy description.materials; def.materialCount = description.materials.length() as i32;
    def.filter = description.filter; def.hasObjectId = description.hasObjectId; def.objectId = description.objectId; def.enableSensorEvents = description.enableSensorEvents;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    let id: raw.ChainId = raw.b2CreateChain(raw.b2MakeBodyId(world,parent.slot),&def);
    stampChainTickets(owner,id);
    result.id = id; result.number = ChainNumber(id.index1-1i32,world.chainShapes.at((id.index1-1i32) as i64).birthTicket,owner.birthTicket); return result;
}
                                                                                                  
fun stampChainTickets(owner: WorldNumber, id: raw.ChainId) -> () = {
    var world: ref raw.World = raw.worlds.at(owner.slot as i64); let slot: i64 = (id.index1-1i32) as i64;
    lastIssued = nextTicket(lastIssued); world.chainShapes.at(slot).birthTicket = lastIssued; world.chainShapes.at(slot).ownerTicket = owner.birthTicket;
    var i: i32 = 0i32;
    while (i < world.chainShapes.at(slot).count) {
        lastIssued = nextTicket(lastIssued); let child: i32 = world.chainShapes.at(slot).shapeIndices.at(i as i64);
        world.shapes.at(child as i64).birthTicket = lastIssued; i = i+1i32;
    }
}
fun destroyChain(owner: WorldNumber, number: ChainNumber) -> i32 = {
    let status: i32 = chainMutationStatus(owner,number); if (status != OK) return status;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64); raw.b2DestroyChain(raw.b2MakeChainId(world,number.slot)); return OK;
}
fun chainSegments(owner: WorldNumber, number: ChainNumber) -> ShapeList = {
    var result = ShapeList(); result.status = chainStatus(owner,number); if (result.status != OK) return result;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64); var i: i32 = 0i32;
    while (i < world.chainShapes.at(number.slot as i64).count) {
        let slot: i32 = world.chainShapes.at(number.slot as i64).shapeIndices.at(i as i64);
        result.values.push(ShapeNumber(slot,world.shapes.at(slot as i64).birthTicket,owner.birthTicket)); i = i+1i32;
    }
    return result;
}
fun lookupChain(owner: WorldNumber, number: ChainNumber) -> ChainLookup = {
    var result = ChainLookup(); result.status = chainStatus(owner,number); if (result.status != OK) return result;

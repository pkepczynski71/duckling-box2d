fun getSleepState(owner: WorldNumber, number: BodyNumber) -> SleepState = {
    var result = SleepState(); result.number = number; result.status = bodyStatus(owner, number);
    if (result.status != OK) return result;
    let body: raw.BodyRecord = raw.worlds.at(owner.slot as i64).bodies.at(number.slot as i64);
    result.isAwake = body.setIndex == 2i32;
    result.isSleeping = body.setIndex != 1i32 and body.bodyType != 0i32 and not result.isAwake;

fun canonicalName(name: raw.NameValue) -> raw.NameValue = {
    var result = raw.NameValue(); result.length = name.length;
    var i: i32 = 0i32;
    while (i < name.length) { result.bytes[i] = name.bytes[i]; i = i + 1i32; }
    return result;
}

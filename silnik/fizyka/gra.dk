    let status: i32 = worldMutationStatus(owner); if (status != OK) return status; if (not validNonnegative(rule.value)) return PARAM;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64); var values: List[raw.MaterialRule12]; var i: i64 = 0i64;
    while (i < world.frictionRules12.length()) { let entry: raw.MaterialRule12 = world.frictionRules12.at(i); values.push(entry); i = i + 1i64; }
    values.push(raw.MaterialRule12(rule.materialA, rule.materialB, rule.value)); world.frictionRules12 = move values; return OK;
}

# Box2D 8c661469, src/contact.                               
fun appendRestitutionRule12(owner: WorldNumber, rule: MaterialRule12) -> i32 = {
    let status: i32 = worldMutationStatus(owner); if (status != OK) return status; if (not validNonnegative(rule.value)) return PARAM;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64); var values: List[raw.MaterialRule12]; var i: i64 = 0i64;
    while (i < world.restitutionRules12.length()) { let entry: raw.MaterialRule12 = world.restitutionRules12.at(i); values.push(entry); i = i + 1i64; }
    values.push(raw.MaterialRule12(rule.materialA, rule.materialB, rule.value)); world.restitutionRules12 = move values; return OK;
}

                                                                           
class JointNumber { slot: i32 = -1i32; birthTicket: Key64 = Key64(); ownerTicket: Key64 = Key64(); }
class JointResult { status: i32 = STALE; reason: i32 = 0i32; number: JointNumber = JointNumber(); }
class JointAction { status: i32 = OK; reason: i32 = 0i32; }
class DistanceDescription {
    localAnchorA: Vec2 = Vec2(); localAnchorB: Vec2 = Vec2(); length: f32 = 1.0f32;
    enableSpring: bool = false; hertz: f32 = 0.0f32; dampingRatio: f32 = 0.0f32;
    enableLimit: bool = false; minLength: f32 = 0.0f32; maxLength: f32 = 100000.0f32;
    enableMotor: bool = false; maxMotorForce: f32 = 0.0f32; motorSpeed: f32 = 0.0f32;
    collideConnected: bool = false; hasObjectId: bool = false; objectId: Key64 = Key64();
}
class JointView {
    number: JointNumber = JointNumber(); bodyA: BodyNumber = BodyNumber(); bodyB: BodyNumber = BodyNumber();
    jointType: i32 = 0i32; localAnchorA: Vec2 = Vec2(); localAnchorB: Vec2 = Vec2();
    collideConnected: bool = false; hasObjectId: bool = false; objectId: Key64 = Key64();
    constraintHertz: f32 = 0.0f32; constraintDampingRatio: f32 = 0.0f32;
    distanceParameters: DistanceDescription = DistanceDescription();
    revoluteParameters: RevoluteDescription = RevoluteDescription(); prismaticParameters: PrismaticDescription = PrismaticDescription();
    referenceAngle: f32 = 0.0f32; localAxisA: Vec2 = Vec2();
    angle: f32 = 0.0f32; translation: f32 = 0.0f32; speed: f32 = 0.0f32; motorTorque: f32 = 0.0f32;
    force: Vec2 = Vec2(); torque: f32 = 0.0f32; linearSeparation: f32 = 0.0f32; angularSeparation: f32 = 0.0f32;
    currentLength: f32 = 0.0f32; motorForce: f32 = 0.0f32;
}
class JointLookup { status: i32 = STALE; reason: i32 = 0i32; value: JointView = JointView(); }
class JointList { status: i32 = STALE; reason: i32 = 0i32; values: List[JointNumber] = emptyJointNumbers(); }
fun emptyJointNumbers() -> List[JointNumber] = { var values: List[JointNumber]; return values; }
fun defaultDistanceDescription() -> DistanceDescription = { return DistanceDescription(); }
                                                                                     
                                                                          
fun jointStatus(owner: WorldNumber, number: JointNumber) -> i32 = {
    if (worldStatus(owner) != OK) return STALE;
    if (not targetOwnerValid17(owner.birthTicket,number.ownerTicket)) return FOREIGN;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    if ((number.slot as u32) >= (world.jointIdPool.nextIndex as u32)) return STALE;
    if (world.joints.at(number.slot as i64).jointId == -1i32) return STALE;
    if (not equalKey(world.joints.at(number.slot as i64).birthTicket, number.birthTicket)) return STALE;
    return OK;
}
fun validateJoint(owner: WorldNumber, number: JointNumber) -> i32 = { return jointStatus(owner, number); }
fun jointMutationStatus(owner: WorldNumber, number: JointNumber) -> i32 = {
    let status: i32 = jointStatus(owner, number); if (status != OK) return status;
    if (raw.worlds.at(owner.slot as i64).locked) return LOCKED; return OK;
}
fun jointActionStatus14(status: i32) -> JointAction = { return JointAction(status, if status == LOCKED then 1i32 else 0i32); }
                                                                        
fun validDistanceDescription(value: DistanceDescription) -> bool = {
    return finiteVector(value.localAnchorA) and finiteVector(value.localAnchorB) and finite(value.length) and value.length > 0.0f32
        and validNonnegative(value.hertz) and validNonnegative(value.dampingRatio) and validNonnegative(value.maxMotorForce)
        and finite(value.motorSpeed) and validNonnegative(value.minLength) and validNonnegative(value.maxLength) and value.minLength <= value.maxLength
        and (value.hasObjectId or (value.objectId.low == 0u32 and value.objectId.high == 0u32));
}
fun jointCreatePreflight(owner: WorldNumber, a: BodyNumber, b: BodyNumber, description: DistanceDescription) -> JointAction = {
    let statusA: i32 = bodyStatus(owner, a); if (statusA != OK) return jointActionStatus14(statusA);
    let statusB: i32 = bodyStatus(owner, b); if (statusB != OK) return jointActionStatus14(statusB);
    if (raw.worlds.at(owner.slot as i64).locked) return JointAction(LOCKED, 1i32);
    if (a.slot == b.slot) return JointAction(PARAM, 7i32);
    if (not validDistanceDescription(description)) return JointAction(PARAM, 10i32);
    if (not jointReservationFit(lastIssued,1u32,raw.worlds.at(owner.slot as i64).jointIdPool.nextIndex as u32)) return JointAction(LIMIT, 0i32);
    return JointAction();
}
                                                                                              
fun createDistanceJoint(owner: WorldNumber, a: BodyNumber, b: BodyNumber, description: DistanceDescription) -> JointResult = {
    var result = JointResult(); let check: JointAction = jointCreatePreflight(owner,a,b,description);
    result.status = check.status; result.reason = check.reason; if (check.status != OK) return result;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    let ticket: Key64 = nextTicket(lastIssued);
    var def = raw.DistanceJointDef(); def.bodyIdA = raw.b2MakeBodyId(world, a.slot); def.bodyIdB = raw.b2MakeBodyId(world, b.slot);
    def.localAnchorA = description.localAnchorA; def.localAnchorB = description.localAnchorB; def.length = description.length;
    def.enableSpring = description.enableSpring; def.hertz = description.hertz; def.dampingRatio = description.dampingRatio;
    def.enableLimit = description.enableLimit; def.minLength = description.minLength; def.maxLength = description.maxLength;
    def.enableMotor = description.enableMotor; def.maxMotorForce = description.maxMotorForce; def.motorSpeed = description.motorSpeed;
    def.collideConnected = description.collideConnected; def.hasObjectId = description.hasObjectId; def.objectId = description.objectId;
    let id: raw.JointId = raw.b2CreateDistanceJoint(raw.WorldId((owner.slot + 1i32) as u16, world.generation), def);
    let slot: i32 = id.index1 - 1i32;
    world.joints.at(slot as i64).birthTicket = ticket; world.joints.at(slot as i64).ownerTicket = owner.birthTicket; lastIssued = ticket;
    result.status = OK; result.number = JointNumber(slot, ticket, owner.birthTicket); return result;
}
                                                            
fun makeJointId14(owner: WorldNumber, number: JointNumber) -> raw.JointId = {
    return raw.JointId(number.slot + 1i32, owner.slot as u16, raw.worlds.at(owner.slot as i64).joints.at(number.slot as i64).generation);
}
fun destroyJoint(owner: WorldNumber, number: JointNumber) -> JointAction = {
    let status: i32 = jointMutationStatus(owner, number); if (status != OK) return jointActionStatus14(status);
    raw.b2DestroyJoint(makeJointId14(owner, number)); return JointAction();
}
fun wakeJointBodies(owner: WorldNumber, number: JointNumber) -> JointAction = {
    let status: i32 = jointMutationStatus(owner, number); if (status != OK) return jointActionStatus14(status);
    raw.b2Joint_WakeBodies(makeJointId14(owner, number)); return JointAction();
}
                                                                    
fun bodyJoints(owner: WorldNumber, body: BodyNumber) -> JointList = {
    var result = JointList(); result.status = bodyStatus(owner, body); if (result.status != OK) return result;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    var key: i32 = world.bodies.at(body.slot as i64).headJointKey;
    while (key != -1i32) {
        let id: i32 = key >> 1i32; let side: i32 = key & 1i32;
        let joint: raw.JointRecord = world.joints.at(id as i64);
        result.values.push(JointNumber(id, joint.birthTicket, joint.ownerTicket));
        key = raw.jointEdge(world.joints.at(id as i64), side).nextKey;
    }
    return result;
}
                                                                                   
fun lookupJoint(owner: WorldNumber, number: JointNumber) -> JointLookup = {
    var result = JointLookup(); result.status = jointStatus(owner, number); if (result.status != OK) return result;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    if (world.locked) { result.status = LOCKED; result.reason = 1i32; return result; }
    let record: raw.JointRecord = world.joints.at(number.slot as i64); let sim: raw.JointSim = raw.b2GetJointSim(world, number.slot);
    let id: raw.JointId = makeJointId14(owner, number);
    result.value.number = number;
    result.value.bodyA = BodyNumber(record.edgeA.bodyId, world.bodies.at(record.edgeA.bodyId as i64).birthTicket, owner.birthTicket);
    result.value.bodyB = BodyNumber(record.edgeB.bodyId, world.bodies.at(record.edgeB.bodyId as i64).birthTicket, owner.birthTicket);
    result.value.jointType = record.jointType; result.value.localAnchorA = sim.localOriginAnchorA; result.value.localAnchorB = sim.localOriginAnchorB;
    result.value.collideConnected = record.collideConnected; result.value.hasObjectId = record.hasObjectId; result.value.objectId = record.objectId;
    result.value.constraintHertz = sim.constraintHertz; result.value.constraintDampingRatio = sim.constraintDampingRatio;
    if (record.jointType == 0i32) {
    let joint: raw.DistanceJoint = sim.distanceJoint;
    var d: ref DistanceDescription = &result.value.distanceParameters;
    d.localAnchorA = sim.localOriginAnchorA; d.localAnchorB = sim.localOriginAnchorB; d.length = joint.length;
    d.enableSpring = joint.enableSpring; d.hertz = joint.hertz; d.dampingRatio = joint.dampingRatio;
    d.enableLimit = joint.enableLimit; d.minLength = joint.minLength; d.maxLength = joint.maxLength;
    d.enableMotor = joint.enableMotor; d.maxMotorForce = joint.maxMotorForce; d.motorSpeed = joint.motorSpeed;
    d.collideConnected = record.collideConnected; d.hasObjectId = record.hasObjectId; d.objectId = record.objectId;
    }
    result.value.force = raw.b2Joint_GetConstraintForce(id); result.value.torque = raw.b2Joint_GetConstraintTorque(id);
    result.value.linearSeparation = raw.b2Joint_GetLinearSeparation(id); result.value.angularSeparation = raw.b2Joint_GetAngularSeparation(id);
    if (record.jointType == 0i32) { result.value.currentLength = raw.b2DistanceJoint_GetCurrentLength(id); result.value.motorForce = raw.b2DistanceJoint_GetMotorForce(id); }
    else if (record.jointType == 5i32) {
        result.value.referenceAngle = raw.b2Joint_GetReferenceAngle(id); result.value.angle = raw.b2RevoluteJoint_GetAngle(id);
        result.value.motorTorque = raw.b2RevoluteJoint_GetMotorTorque(id);
        result.value.revoluteParameters.localAnchorA = sim.localOriginAnchorA;
        result.value.revoluteParameters.localAnchorB = sim.localOriginAnchorB;
        result.value.revoluteParameters.referenceAngle = sim.revoluteJoint.referenceAngle;
        result.value.revoluteParameters.targetAngle = sim.revoluteJoint.targetAngle;
        result.value.revoluteParameters.hertz = sim.revoluteJoint.hertz;
        result.value.revoluteParameters.dampingRatio = sim.revoluteJoint.dampingRatio;
        result.value.revoluteParameters.lowerAngle = sim.revoluteJoint.lowerAngle;
        result.value.revoluteParameters.upperAngle = sim.revoluteJoint.upperAngle;
        result.value.revoluteParameters.maxMotorTorque = sim.revoluteJoint.maxMotorTorque;
        result.value.revoluteParameters.motorSpeed = sim.revoluteJoint.motorSpeed;
        result.value.revoluteParameters.enableSpring = sim.revoluteJoint.enableSpring;
        result.value.revoluteParameters.enableLimit = sim.revoluteJoint.enableLimit;
        result.value.revoluteParameters.enableMotor = sim.revoluteJoint.enableMotor;
        result.value.revoluteParameters.collideConnected = record.collideConnected;
        result.value.revoluteParameters.hasObjectId = record.hasObjectId;
        result.value.revoluteParameters.objectId = record.objectId;
        result.value.revoluteParameters.drawSize = record.drawSize;
    } else if (record.jointType == 4i32) {
        result.value.referenceAngle = raw.b2Joint_GetReferenceAngle(id); result.value.localAxisA = raw.b2Joint_GetLocalAxisA(id);
        result.value.translation = raw.b2PrismaticJoint_GetTranslation(id); result.value.speed = raw.b2PrismaticJoint_GetSpeed(id);
        result.value.motorForce = raw.b2PrismaticJoint_GetMotorForce(id);
        result.value.prismaticParameters.localAnchorA = sim.localOriginAnchorA;
        result.value.prismaticParameters.localAnchorB = sim.localOriginAnchorB;
        result.value.prismaticParameters.localAxisA = sim.prismaticJoint.localAxisA;
        result.value.prismaticParameters.referenceAngle = sim.prismaticJoint.referenceAngle;
        result.value.prismaticParameters.targetTranslation = sim.prismaticJoint.targetTranslation;
        result.value.prismaticParameters.hertz = sim.prismaticJoint.hertz;
        result.value.prismaticParameters.dampingRatio = sim.prismaticJoint.dampingRatio;
        result.value.prismaticParameters.lowerTranslation = sim.prismaticJoint.lowerTranslation;
        result.value.prismaticParameters.upperTranslation = sim.prismaticJoint.upperTranslation;
        result.value.prismaticParameters.maxMotorForce = sim.prismaticJoint.maxMotorForce;
        result.value.prismaticParameters.motorSpeed = sim.prismaticJoint.motorSpeed;
        result.value.prismaticParameters.enableSpring = sim.prismaticJoint.enableSpring;
        result.value.prismaticParameters.enableLimit = sim.prismaticJoint.enableLimit;
        result.value.prismaticParameters.enableMotor = sim.prismaticJoint.enableMotor;
        result.value.prismaticParameters.collideConnected = record.collideConnected;
        result.value.prismaticParameters.hasObjectId = record.hasObjectId;
        result.value.prismaticParameters.objectId = record.objectId;
    }
    return result;
}
fun cloneJointView(source: JointView) -> JointView = { return source; }
fun cloneJointList(source: ref JointList) -> JointList = {
    var result = JointList(); result.status = source.status; result.reason = source.reason; result.values = copy source.values; return result;
}
                                                                                 
                                                               
fun jointBlocksFit(count: i64) -> bool = { return count <= 16i64 or count / 4i64 + 3i64 <= 32767i64; }
fun jointUpperBlocksFit(world: ref raw.World) -> bool = {
    let count: i64 = (world.jointIdPool.nextIndex as i64) - (world.jointIdPool.freeCount as i64);
    return jointBlocksFit(count);
}

                                                                        
fun jointPreflight14(owner: WorldNumber, number: JointNumber, distanceOnly: bool) -> JointAction = {
    let status: i32 = jointMutationStatus(owner, number); if (status != OK) return jointActionStatus14(status);
    if (distanceOnly and raw.worlds.at(owner.slot as i64).joints.at(number.slot as i64).jointType != 0i32) return JointAction(PARAM, 6i32);
    return JointAction();
}

                                                                                               

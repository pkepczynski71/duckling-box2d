# Box2D 8c661469, src/math_functions.c:14-27. Finite guards also accept signed zero.
fun finite(value: f32) -> bool = { return value >= -poly.FLT_MAX and value <= poly.FLT_MAX; }
# Box2D 8c661469, src/math_functions.c:29-33.
fun finiteVector(value: Vec2) -> bool = { return finite(value.x) and finite(value.y); }
# Box2D 8c661469, src/body.                                                           
fun validSleepThreshold(threshold: f32) -> bool = { return finite(threshold) and threshold >= 0.0f32; }
# Box2D 8c661469, include/box2d/math_functions.                          
fun validBodyDef(def: raw.BodyDef) -> bool = {
    if (not validSleepThreshold(def.sleepThreshold)) return false;
    let lengthSquared: f32 = def.rotation.s * def.rotation.s + def.rotation.c * def.rotation.c;
    return def.bodyType >= 0i32 and def.bodyType <= 2i32 and finiteVector(def.position)
        and finiteVector(def.linearVelocity) and finite(def.angularVelocity)
        and finite(def.linearDamping) and def.linearDamping >= 0.0f32
        and finite(def.angularDamping) and def.angularDamping >= 0.0f32 and finite(def.gravityScale)
        and finite(def.rotation.c) and finite(def.rotation.s)
        and 1.0f32 - 0.0006f32 < lengthSquared and lengthSquared < 1.0f32 + 0.0006f32;
}

# Box2D 8c661469, src/hull.                                                                    
fun validPolygonPoints(shape: ref poly.Polygon) -> bool = {
    if (shape.count < 3i32 or shape.count > 8i32 or not finite(shape.radius) or shape.radius < 0.0f32) return false;
    var i: i32 = 0i32;
    while (i < shape.count) {
        if (not finiteVector(shape.vertices[i])) return false;
        let next: i32 = if i + 1i32 < shape.count then i + 1i32 else 0i32;
        let edgeSqr: f32 = mass2.b2LengthSquared(b2Sub(shape.vertices[next], shape.vertices[i]));
        if (not finite(edgeSqr) or edgeSqr <= FLT_EPSILON * FLT_EPSILON) return false;
        i = i + 1i32;
    }
    if (not raw.b2ValidateHull(shape)) return false;
    var area: f32 = 0.0f32;
    let origin: Vec2 = shape.vertices[0];
    var triangle: i32 = 1i32;
    while (triangle < shape.count - 1i32) {
        let e1: Vec2 = b2Sub(shape.vertices[triangle], origin);
        let e2: Vec2 = b2Sub(shape.vertices[triangle + 1i32], origin);
        area = area + 0.5f32 * mass2.b2Cross(e1, e2);
        triangle = triangle + 1i32;
    }
    return finite(area) and area > FLT_EPSILON;
}

# Box2D 8c661469, src/geometry.c:56-89. No replacement hull on rejection.
fun preparePolygon(shape: ref poly.Polygon) -> bool = {
    if (not validPolygonPoints(shape)) return false;
    raw.b2MakePolygon(shape);
    if (not finiteVector(shape.centroid)) return false;
    var i: i32 = 0i32;
    while (i < shape.count) {
        if (not finiteVector(shape.normals[i])) return false;
        i = i + 1i32;
    }
    return true;
}

# Box2D 8c661469, src/geometry.c:185-203,220-274,401-454. Geometry portion of S12 preflight.
fun validShapeGeometry(shape: ref raw.ShapeRecord) -> bool = {
    if (not finite(shape.density) or shape.density < 0.0f32) return false;
    if (shape.shapeType == 0i32) return finiteVector(shape.circle.center) and finite(shape.circle.radius) and shape.circle.radius > 0.0f32;
    if (shape.shapeType == 1i32) {
        let capsuleLength: f32 = mass2.b2LengthSquared(b2Sub(shape.capsule.center1, shape.capsule.center2));
        return finiteVector(shape.capsule.center1) and finiteVector(shape.capsule.center2)
            and finite(shape.capsule.radius) and shape.capsule.radius > 0.0f32 and finite(capsuleLength);
    }
    if (shape.shapeType == 2i32) {
        let segmentLength: f32 = mass2.b2LengthSquared(b2Sub(shape.segment.point1, shape.segment.point2));
        return finiteVector(shape.segment.point1) and finiteVector(shape.segment.point2)
            and finite(segmentLength) and segmentLength > B2_LINEAR_SLOP * B2_LINEAR_SLOP;
    }
                                                                               
                                                                                 
    if (shape.shapeType != 3i32 or shape.polygon.count < 3i32 or shape.polygon.count > 8i32
        or not finite(shape.polygon.radius) or shape.polygon.radius < 0.0f32 or not finiteVector(shape.polygon.centroid)) return false;
    var i: i32 = 0i32;
    while (i < shape.polygon.count) {
        if (not finiteVector(shape.polygon.vertices[i]) or not finiteVector(shape.polygon.normals[i])) return false;
        i = i + 1i32;
    }
    return true;
}

# Box2D 8c661469, src/body.c:528-631.                                                              
fun safeMass(body: raw.BodyRecord, sim: raw.BodySim, state: raw.BodyState, shapes: ref List[raw.ShapeRecord]) -> bool = {
    var i: i64 = 0i64;
    while (i < shapes.length()) {
        var shape: raw.ShapeRecord = shapes.at(i);
        if (shape.shapeType == 4i32) {
            let segment: raw.Segment = shape.chainSegment.segment;
            let lengthSquared: f32 = mass2.b2LengthSquared(b2Sub(segment.point2,segment.point1));
            if (not finiteVector(segment.point1) or not finiteVector(segment.point2) or not finite(lengthSquared) or lengthSquared <= B2_LINEAR_SLOP*B2_LINEAR_SLOP) return false;
        } else if (not validShapeGeometry(&shape)) return false;
        let bounds: tree.AABB = raw.b2ComputeShapeAABB(&shape, sim.transform);
        if (not finiteVector(bounds.lowerBound) or not finiteVector(bounds.upperBound)) return false;
                                                                
        let extent: raw.ShapeExtent = raw.b2ComputeShapeExtent(&shape, Vec2());
        if (not finite(extent.minExtent) or not finite(extent.maxExtent)) return false;
        i = i + 1i64;
    }
    let computed: raw.BodyMassResult = raw.computeBodyMass(body, sim, state, shapes);
    if (not finite(computed.mass) or not finite(computed.inertia) or not finite(computed.originInertia)
        or not finite(computed.sim.invMass) or not finite(computed.sim.invInertia)
        or not finiteVector(computed.sim.localCenter) or not finiteVector(computed.sim.center)
        or not finiteVector(computed.state.linearVelocity) or not finite(computed.state.angularVelocity)
        or not finite(computed.sim.minExtent) or not finite(computed.sim.maxExtent)) return false;
    if (body.bodyType == 2i32 and computed.mass > 0.0f32 and not body.fixedRotation and computed.inertia <= 0.0f32) return false;
    return true;
}

# Box2D 8c661469, src/body.c:568-630. Proposed add/remove/density in the exact future head order.
                                                                                      
fun preflight(owner: WorldNumber, bodySlot: i32, mode: i32, shapeSlot: i32, proposed: raw.ShapeRecord, density: f32) -> bool = {
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    let body: raw.BodyRecord = world.bodies.at(bodySlot as i64);
    var set: ref raw.SolverSet = raw.b2GetSolverSet(world, body.setIndex);
    let sim: raw.BodySim = set.bodySims.at(body.localIndex as i64);
    var state = raw.BodyState();
    if (body.setIndex == 2i32) state = set.bodyStates.at(body.localIndex as i64);
    var values: List[raw.ShapeRecord];
    if (mode == 0i32) values.push(raw.resolveShape(proposed));
    var slot: i32 = body.headShapeId;
    while (slot != -1i32) {
        var shape: raw.ShapeRecord = world.shapes.at(slot as i64);
        if (mode == 2i32 and slot == shapeSlot) shape.density = density;
        if (mode == 3i32 and slot == shapeSlot) shape = proposed;
        if (mode != 1i32 or slot != shapeSlot) values.push(shape);
        slot = shape.nextShapeId;
    }
    return safeMass(body, sim, state, &values);
}

# Box2D 8c661469, src/shape.c:163-227. Checked raw semantics, including optional mass update.
fun createShapeRaw(owner: WorldNumber, parent: BodyNumber, source: raw.ShapeRecord, updateMass: bool, invoke: bool) -> ShapeResult = {
    var result = ShapeResult();
    result.status = bodyMutationStatus(owner, parent);
    if (result.status != OK) return result;
    if (source.shapeType == 2i32 and mass2.b2LengthSquared(b2Sub(source.segment.point1, source.segment.point2)) <= B2_LINEAR_SLOP * B2_LINEAR_SLOP) {
        result.status = GEOMETRY; return result;
    }
    if (ticketLimit(lastIssued)) { result.status = LIMIT; return result; }
    let reserved: Key64 = nextTicket(lastIssued);
    var world: ref raw.World = raw.worlds.at(owner.slot as i64);
    let id: broad.ShapeId = raw.b2CreateShape(raw.b2MakeBodyId(world, parent.slot), source, updateMass, invoke);
    if (id.index1 == 0i32) { result.status = GEOMETRY; return result; }
    let slot: i32 = id.index1 - 1i32;
    world.shapes.at(slot as i64).birthTicket = reserved;
    lastIssued = reserved;
    result.status = OK; result.id = id;
    result.number = ShapeNumber(slot, reserved, owner.birthTicket);
    return result;
}


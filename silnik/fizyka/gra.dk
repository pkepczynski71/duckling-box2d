class PrismaticDescription {

    localAnchorA: Vec2 = Vec2(); localAnchorB: Vec2 = Vec2();
    localAxisA: Vec2 = Vec2(1.0f32,0.0f32);
    referenceAngle: f32 = 0.0f32;
    targetTranslation: f32 = 0.0f32;
    hertz: f32 = 0.0f32;
    dampingRatio: f32 = 0.0f32;
    lowerTranslation: f32 = 0.0f32;
    upperTranslation: f32 = 0.0f32;
    maxMotorForce: f32 = 0.0f32;
    motorSpeed: f32 = 0.0f32;
    enableSpring: bool = false; enableLimit: bool = false; enableMotor: bool = false;
    collideConnected: bool = false; hasObjectId: bool = false; objectId: Key64 = Key64();
}
fun defaultPrismaticDescription() -> PrismaticDescription = { return PrismaticDescription(); }
fun jointCreatePreflight(owner: WorldNumber, a: BodyNumber, b: BodyNumber, description: PrismaticDescription) -> JointAction = {
    let statusA: i32 = bodyStatus(owner,a); if (statusA != OK) return jointActionStatus14(statusA);
    let statusB: i32 = bodyStatus(owner,b); if (statusB != OK) return jointActionStatus14(statusB);
    if (raw.worlds.at(owner.slot as i64).locked) return JointAction(LOCKED,1i32);
    if (a.slot == b.slot) return JointAction(PARAM,7i32);
    if (not validJointAxis14(description.localAxisA)) return JointAction(PARAM,9i32);
    if (not validPrismaticDescription(description)) return JointAction(PARAM,10i32);
    if (not jointReservationFit(lastIssued,1u32,raw.worlds.at(owner.slot as i64).jointIdPool.nextIndex as u32)) return JointAction(LIMIT,0i32);
    return JointAction();
}
fun validPrismaticDescription(value: PrismaticDescription) -> bool = {
    return finiteVector(value.localAnchorA) and finiteVector(value.localAnchorB)
        and validJointAngle14(value.referenceAngle) and finite(value.targetTranslation)
        and finite(value.lowerTranslation) and finite(value.upperTranslation) and value.lowerTranslation <= value.upperTranslation
        and validNonnegative(value.hertz) and validNonnegative(value.dampingRatio)
        and validNonnegative(value.maxMotorForce) and finite(value.motorSpeed)
        and (value.hasObjectId or (value.objectId.low == 0u32 and value.objectId.high == 0u32));
}
fun createPrismaticJoint(owner: WorldNumber, a: BodyNumber, b: BodyNumber, description: PrismaticDescription) -> JointResult = {
    var result = JointResult(); let check: JointAction = jointCreatePreflight(owner,a,b,description);
    result.status = check.status; result.reason = check.reason; if (check.status != OK) return result;
    var world: ref raw.World = raw.worlds.at(owner.slot as i64); let ticket: Key64 = nextTicket(lastIssued);
    var def = raw.PrismaticJointDef(); def.bodyIdA = raw.b2MakeBodyId(world,a.slot); def.bodyIdB = raw.b2MakeBodyId(world,b.slot);
    def.localAnchorA = description.localAnchorA;
    def.localAnchorB = description.localAnchorB;
    def.localAxisA = description.localAxisA;
    def.referenceAngle = description.referenceAngle;
    def.targetTranslation = description.targetTranslation;
    def.hertz = description.hertz;
    def.dampingRatio = description.dampingRatio;
    def.lowerTranslation = description.lowerTranslation;
    def.upperTranslation = description.upperTranslation;
    def.maxMotorForce = description.maxMotorForce;
    def.motorSpeed = description.motorSpeed;
    def.enableSpring = description.enableSpring;
    def.enableLimit = description.enableLimit;
    def.enableMotor = description.enableMotor;
    def.collideConnected = description.collideConnected;
    def.hasObjectId = description.hasObjectId;
    def.objectId = description.objectId;
    let id: raw.JointId = raw.b2CreatePrismaticJoint(raw.WorldId((owner.slot+1i32) as u16,world.generation),def);
    let slot: i32 = id.index1-1i32; world.joints.at(slot as i64).birthTicket = ticket;
    world.joints.at(slot as i64).ownerTicket = owner.birthTicket; lastIssued = ticket;
    result.status = OK; result.number = JointNumber(slot,ticket,owner.birthTicket); return result;
}
fun setPrismaticSpring(owner: WorldNumber, number: JointNumber, value: bool) -> JointAction = {
    let check: JointAction = jointSetterPreflightB14(owner,number,48i32,0.0f32,0.0f32); if (check.status != OK) return check;
    raw.b2PrismaticJoint_EnableSpring(makeJointId14(owner,number),value); return JointAction();
}
fun getPrismaticSpring(owner: WorldNumber, number: JointNumber) -> JointBoolean = {
    let status: i32 = jointStatus(owner,number); if (status != OK) return JointBoolean(status,0i32,false);
    if (raw.worlds.at(owner.slot as i64).joints.at(number.slot as i64).jointType != 4i32) return JointBoolean(PARAM,6i32,false);
    return JointBoolean(OK,0i32,raw.b2PrismaticJoint_IsSpringEnabled(makeJointId14(owner,number)));
}

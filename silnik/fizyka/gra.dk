# Box2D 8c661469, src/world.c:747-758. Include underflow/overflow of derived step values.
fun validStepParameters(parameters: StepParameters) -> bool = {
    if (not finite(parameters.dt) or parameters.dt < 0.0f32 or parameters.subStepCount <= 0i32) return false;
    if (parameters.dt == 0.0f32) return true;
    let inv_dt: f32 = 1.0f32 / parameters.dt;
    let h: f32 = parameters.dt / (parameters.subStepCount as f32);
    let inv_h: f32 = (parameters.subStepCount as f32) * inv_dt;
    return h > 0.0f32 and finite(inv_dt) and finite(h) and finite(inv_h);
}


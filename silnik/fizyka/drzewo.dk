# Box2D 8c661469, src/dynamic_tree.c:1114.
fun b2DynamicTree_Query(tree: ref DynamicTree, aabb: AABB, maskBits: i64) -> TreeQueryResult = {
    var result = TreeQueryResult();
    if (tree.nodeCount == 0i32) return result;
    var stack: i32[1024];
    var stackCount: i32 = 0i32;
    stack[stackCount] = tree.root;
    stackCount = stackCount + 1i32;
    while (stackCount > 0i32) {
        stackCount = stackCount - 1i32;
        let nodeId: i32 = stack[stackCount];
        if (nodeId != B2_NULL_INDEX) {
                                                                                  
            var node: ref TreeNode = tree.nodes.at(nodeId as i64);
            result.nodeVisits = result.nodeVisits + 1i32;
            if (b2AABB_Overlaps(node.aabb, aabb) and (node.categoryBits & maskBits) != 0i64) {
                if (b2IsLeaf(node)) {
                    result.hits.push(TreeHit(nodeId, node.userData));
                    result.leafVisits = result.leafVisits + 1i32;
                } else {
                    if (stackCount < B2_TREE_STACK_SIZE - 1i32) {
                        stack[stackCount] = node.child1;
                        stackCount = stackCount + 1i32;
                        stack[stackCount] = node.child2;
                        stackCount = stackCount + 1i32;
                    }
                }
            }
        }
    }
    return result;
}

# Box2D 8c661469, src/dynamic_tree.                                
                                                                                
fun b2PartitionMid(indices: ref List[i32], centers: ref List[Vec2], start: i32, count: i32) -> i32 = {
    if (count <= 2i32) return count / 2i32;
    var lowerBound: Vec2 = centers.at(start as i64);
    var upperBound: Vec2 = centers.at(start as i64);
    var i: i32 = 1i32;
    while (i < count) {
        let center: Vec2 = centers.at((start + i) as i64);
        lowerBound = b2Min(lowerBound, center);
        upperBound = b2Max(upperBound, center);
        i = i + 1i32;
    }
    let d: Vec2 = b2Sub(upperBound, lowerBound);
    let c: Vec2 = Vec2(0.5f32 * (lowerBound.x + upperBound.x),
        0.5f32 * (lowerBound.y + upperBound.y));
    var i1: i32 = 0i32;
    var i2: i32 = count;
    if (d.x > d.y) {
        let pivotX: f32 = c.x;
        while (i1 < i2) {
            while (i1 < i2 and centers.at((start + i1) as i64).x < pivotX) i1 = i1 + 1i32;
            while (i1 < i2 and centers.at((start + i2 - 1i32) as i64).x >= pivotX) i2 = i2 - 1i32;
            if (i1 < i2) {
                let tempIndexX: i32 = indices.at((start + i1) as i64);
                indices.at((start + i1) as i64) = indices.at((start + i2 - 1i32) as i64);
                indices.at((start + i2 - 1i32) as i64) = tempIndexX;
                let tempCenterX: Vec2 = centers.at((start + i1) as i64);
                centers.at((start + i1) as i64) = centers.at((start + i2 - 1i32) as i64);
                centers.at((start + i2 - 1i32) as i64) = tempCenterX;
                i1 = i1 + 1i32;
                i2 = i2 - 1i32;
            }
        }
    } else {
        let pivotY: f32 = c.y;
        while (i1 < i2) {
            while (i1 < i2 and centers.at((start + i1) as i64).y < pivotY) i1 = i1 + 1i32;
            while (i1 < i2 and centers.at((start + i2 - 1i32) as i64).y >= pivotY) i2 = i2 - 1i32;
            if (i1 < i2) {
                let tempIndexY: i32 = indices.at((start + i1) as i64);
                indices.at((start + i1) as i64) = indices.at((start + i2 - 1i32) as i64);
                indices.at((start + i2 - 1i32) as i64) = tempIndexY;
                let tempCenterY: Vec2 = centers.at((start + i1) as i64);
                centers.at((start + i1) as i64) = centers.at((start + i2 - 1i32) as i64);
                centers.at((start + i2 - 1i32) as i64) = tempCenterY;
                i1 = i1 + 1i32;
                i2 = i2 - 1i32;
            }
        }
    }
    if (i1 > 0i32 and i1 < count) return i1;
    return count / 2i32;
}

# Box2D 8c661469, src/dynamic_tree.c:1704.
class RebuildItem {
    nodeIndex: i32 = 0i32;
    childCount: i32 = 0i32;
    startIndex: i32 = 0i32;
    splitIndex: i32 = 0i32;
    endIndex: i32 = 0i32;
}

# Box2D 8c661469, src/dynamic_tree.c:1716.
fun b2BuildTree(tree: ref DynamicTree, leafCount: i32) -> i32 = {
    if (leafCount == 1i32) {
        let singleIndex: i32 = tree.leafIndices.at(0i64);
        tree.nodes.at(singleIndex as i64).parent = B2_NULL_INDEX;
        return singleIndex;
    }
    var stack: RebuildItem[1024];
    var top: i32 = 0i32;
    stack[0].nodeIndex = b2AllocateNode(tree);
    stack[0].childCount = -1i32;
    stack[0].startIndex = 0i32;
    stack[0].endIndex = leafCount;
    stack[0].splitIndex = b2PartitionMid(&tree.leafIndices, &tree.leafCenters, 0i32, leafCount);
    var building: bool = true;
    while (building) {
                                                                              
        var item: ref RebuildItem = &stack[top];
        item.childCount = item.childCount + 1i32;
        if (item.childCount == 2i32) {
            if (top == 0i32) {
                building = false;
            } else {
                let parentIndex: i32 = stack[top - 1i32].nodeIndex;
                if (stack[top - 1i32].childCount == 0i32) {
                    tree.nodes.at(parentIndex as i64).child1 = item.nodeIndex;
                } else {
                    tree.nodes.at(parentIndex as i64).child2 = item.nodeIndex;
                }
                tree.nodes.at(item.nodeIndex as i64).parent = parentIndex;
                let child1: i32 = tree.nodes.at(item.nodeIndex as i64).child1;
                let child2: i32 = tree.nodes.at(item.nodeIndex as i64).child2;
                tree.nodes.at(item.nodeIndex as i64).aabb = b2AABB_Union(tree.nodes.at(child1 as i64).aabb,
                    tree.nodes.at(child2 as i64).aabb);
                tree.nodes.at(item.nodeIndex as i64).height = 1u16 + b2MaxUInt16(tree.nodes.at(child1 as i64).height,
                    tree.nodes.at(child2 as i64).height);
                tree.nodes.at(item.nodeIndex as i64).categoryBits = tree.nodes.at(child1 as i64).categoryBits
                    | tree.nodes.at(child2 as i64).categoryBits;
                top = top - 1i32;
            }
        } else {
            var startIndex: i32 = 0i32;
            var endIndex: i32 = 0i32;
            if (item.childCount == 0i32) {
                startIndex = item.startIndex;
                endIndex = item.splitIndex;
            } else {
                startIndex = item.splitIndex;
                endIndex = item.endIndex;
            }
            let count: i32 = endIndex - startIndex;
            if (count == 1i32) {
                let childIndex: i32 = tree.leafIndices.at(startIndex as i64);
                if (item.childCount == 0i32) {
                    tree.nodes.at(item.nodeIndex as i64).child1 = childIndex;
                } else {
                    tree.nodes.at(item.nodeIndex as i64).child2 = childIndex;
                }
                tree.nodes.at(childIndex as i64).parent = item.nodeIndex;
            } else {
                                                                                
                if (top >= B2_TREE_STACK_SIZE - 1i32) abort();
                top = top + 1i32;
                stack[top].nodeIndex = b2AllocateNode(tree);
                stack[top].childCount = -1i32;
                stack[top].startIndex = startIndex;
                stack[top].endIndex = endIndex;
                stack[top].splitIndex = b2PartitionMid(&tree.leafIndices, &tree.leafCenters, startIndex, count);
                stack[top].splitIndex = stack[top].splitIndex + startIndex;
            }
        }
    }
    let rootIndex: i32 = stack[0].nodeIndex;
    let rootChild1: i32 = tree.nodes.at(rootIndex as i64).child1;
    let rootChild2: i32 = tree.nodes.at(rootIndex as i64).child2;
    tree.nodes.at(rootIndex as i64).aabb = b2AABB_Union(tree.nodes.at(rootChild1 as i64).aabb,
        tree.nodes.at(rootChild2 as i64).aabb);
    tree.nodes.at(rootIndex as i64).height = 1u16 + b2MaxUInt16(tree.nodes.at(rootChild1 as i64).height,
        tree.nodes.at(rootChild2 as i64).height);
    tree.nodes.at(rootIndex as i64).categoryBits = tree.nodes.at(rootChild1 as i64).categoryBits
        | tree.nodes.at(rootChild2 as i64).categoryBits;
    return rootIndex;
}

# Box2D 8c661469, src/dynamic_tree.c:1872.
fun b2DynamicTree_Rebuild(tree: ref DynamicTree, fullBuild: bool) -> i32 = {
    let proxyCount: i32 = tree.proxyCount;
    if (proxyCount == 0i32) return 0i32;
    if (proxyCount > tree.rebuildCapacity) {
        let newCapacity: i32 = proxyCount + proxyCount / 2i32;
        tree.leafIndices = emptyIndices();
        tree.leafCenters = emptyCenters();
        var reserveIndex: i32 = 0i32;
        while (reserveIndex < newCapacity) {
            tree.leafIndices.push(0i32);
            tree.leafCenters.push(Vec2());
            reserveIndex = reserveIndex + 1i32;
        }
        tree.rebuildCapacity = newCapacity;
    }
    var leafCount: i32 = 0i32;
    var stack: i32[1024];
    var stackCount: i32 = 0i32;
    var nodeIndex: i32 = tree.root;
    var gathering: bool = true;
    while (gathering) {
        if (tree.nodes.at(nodeIndex as i64).height == 0u16
            or ((tree.nodes.at(nodeIndex as i64).flags & b2_enlargedNode) == 0u16 and not fullBuild)) {
            tree.leafIndices.at(leafCount as i64) = nodeIndex;
            tree.leafCenters.at(leafCount as i64) = b2AABB_Center(tree.nodes.at(nodeIndex as i64).aabb);
            leafCount = leafCount + 1i32;
            tree.nodes.at(nodeIndex as i64).parent = B2_NULL_INDEX;
            if (stackCount == 0i32) {
                gathering = false;
            } else {
                stackCount = stackCount - 1i32;
                nodeIndex = stack[stackCount];
            }
        } else {
            let doomedNodeIndex: i32 = nodeIndex;
                                                                                 
            let nextChild: i32 = tree.nodes.at(nodeIndex as i64).child1;
            if (stackCount < B2_TREE_STACK_SIZE) {
                stack[stackCount] = tree.nodes.at(nodeIndex as i64).child2;
                stackCount = stackCount + 1i32;
            }
            nodeIndex = nextChild;
            b2FreeNode(tree, doomedNodeIndex);
        }
    }
    tree.root = b2BuildTree(tree, leafCount);
    return leafCount;
}

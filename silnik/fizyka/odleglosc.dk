# Box2D 8c661469, include/box2d/collision.h:347-357. MIT. Seven logical words.
fun zeroCacheIndices() -> i32[3] = { var values: i32[3]; return values; }
class SimplexCache { count: i32 = 0i32; indexA: i32[3] = zeroCacheIndices(); indexB: i32[3] = zeroCacheIndices(); }
# Box2D 8c661469, include/box2d/collision.h:41-51. MIT.
fun zeroProxyPoints() -> Vec2[8] = { var values: Vec2[8]; return values; }
class ShapeProxy { points: Vec2[8] = zeroProxyPoints(); count: i32 = 0i32; radius: f32 = 0.0f32; }
# Box2D 8c661469, include/box2d/collision.h:362-387. MIT.
class DistanceInput { proxyA: ShapeProxy = ShapeProxy(); proxyB: ShapeProxy = ShapeProxy(); transformA: Transform = Transform(); transformB: Transform = Transform(); useRadii: bool = false; }
class DistanceOutput { pointA: Vec2 = Vec2(); pointB: Vec2 = Vec2(); normal: Vec2 = Vec2(); distance: f32 = 0.0f32; iterations: i32 = 0i32; simplexCount: i32 = 0i32; }
# Box2D 8c661469, include/box2d/collision.h:390-407. MIT.
                                                                        
class SimplexVertex { wA: Vec2 = Vec2(); wB: Vec2 = Vec2(); w: Vec2 = Vec2(); a: f32 = 0.0f32; indexA: i32 = 0i32; indexB: i32 = 0i32; aDefined: bool = false; }
class Simplex { v1: SimplexVertex = SimplexVertex(); v2: SimplexVertex = SimplexVertex(); v3: SimplexVertex = SimplexVertex(); count: i32 = 0i32; }
# Box2D 8c661469, src/distance.c:448-453,506-512,567-573. MIT. Output buffer, not local C initialization.
fun emptyTraceSlots() -> Simplex[23] = { var slots: Simplex[23]; var i: i32 = 0i32; while (i < 23i32) { slots[i].count = -1i32; i = i + 1i32; } return slots; }
class SimplexTrace { slots: Simplex[23] = emptyTraceSlots(); stored: i32 = 0i32; }
# Box2D 8c661469, src/distance.c:455. MIT. Named vertex access represents the C pointer array.
fun simplexVertex(s: ref Simplex, index: i32) -> ref SimplexVertex = { if (index == 0i32) return &s.v1; if (index == 1i32) return &s.v2; return &s.v3; }
# Box2D 8c661469, include/box2d/math_functions.h:239-242. MIT.
fun b2MulSub(a: Vec2, scale: f32, b: Vec2) -> Vec2 = { return Vec2(a.x - scale * b.x, a.y - scale * b.y); }
# Box2D 8c661469, include/box2d/math_functions.h:287-292. MIT.
fun b2Distance(a: Vec2, b: Vec2) -> f32 = { let dx: f32 = b.x - a.x; let dy: f32 = b.y - a.y; return math.sqrt(dx * dx + dy * dy); }
# Box2D 8c661469, src/distance.c:108-119. MIT.
fun b2MakeProxy(points: ref Vec2[8], count: i32, radius: f32) -> ShapeProxy = {
    var result = ShapeProxy(); var used: i32 = count; if (used > 8i32) used = 8i32;
    var i: i32 = 0i32; while (i < used) { result.points[i] = points[i]; i = i + 1i32; }
    result.count = used; result.radius = radius; return result;
}
# Box2D 8c661469, src/distance.c:121-136. MIT.
fun b2MakeOffsetProxy(points: ref Vec2[8], count: i32, radius: f32, position: Vec2, rotation: Rot) -> ShapeProxy = {
    var result = ShapeProxy(); var used: i32 = count; if (used > 8i32) used = 8i32;
    let transform: Transform = Transform(position, rotation);
    var i: i32 = 0i32; while (i < used) { result.points[i] = b2TransformPoint(transform, points[i]); i = i + 1i32; }
    result.count = used; result.radius = radius; return result;
}
# Box2D 8c661469, src/distance.c:138-141. MIT.
fun b2Weight2(a1: f32, w1: Vec2, a2: f32, w2: Vec2) -> Vec2 = { return Vec2(a1 * w1.x + a2 * w2.x, a1 * w1.y + a2 * w2.y); }
# Box2D 8c661469, src/distance.c:143-146. MIT.
fun b2Weight3(a1: f32, w1: Vec2, a2: f32, w2: Vec2, a3: f32, w3: Vec2) -> Vec2 = { return Vec2(a1 * w1.x + a2 * w2.x + a3 * w3.x, a1 * w1.y + a2 * w2.y + a3 * w3.y); }
# Box2D 8c661469, src/distance.c:148-166. MIT.
fun b2FindSupport(proxy: ref ShapeProxy, direction: Vec2) -> i32 = {
    var bestIndex: i32 = 0i32; var bestValue: f32 = poly.b2Dot(proxy.points[0i32], direction); var i: i32 = 1i32;
    while (i < proxy.count) { let value: f32 = poly.b2Dot(proxy.points[i], direction); if (value > bestValue) { bestIndex = i; bestValue = value; } i = i + 1i32; } return bestIndex;
}
# Box2D 8c661469, src/distance.c:168-204. MIT.
fun b2MakeSimplexFromCache(cache: ref SimplexCache, proxyA: ref ShapeProxy, proxyB: ref ShapeProxy) -> Simplex = {
    var s = Simplex(); s.count = cache.count; var i: i32 = 0i32;
    while (i < s.count) { var vertex: ref SimplexVertex = simplexVertex(&s, i); vertex.indexA = cache.indexA[i]; vertex.indexB = cache.indexB[i]; vertex.wA = proxyA.points[vertex.indexA]; vertex.wB = proxyB.points[vertex.indexB]; vertex.w = b2Sub(vertex.wA, vertex.wB); vertex.a = -1.0f32; vertex.aDefined = true; i = i + 1i32; }
    if (s.count == 0i32) { s.v1.indexA = 0i32; s.v1.indexB = 0i32; s.v1.wA = proxyA.points[0i32]; s.v1.wB = proxyB.points[0i32]; s.v1.w = b2Sub(s.v1.wA, s.v1.wB); s.v1.a = 1.0f32; s.v1.aDefined = true; s.count = 1i32; } return s;
}
# Box2D 8c661469, src/distance.c:206-215. MIT.
fun b2MakeSimplexCache(cache: ref SimplexCache, simplex: ref Simplex) -> () = { cache.count = simplex.count; var i: i32 = 0i32; while (i < simplex.count) { cache.indexA[i] = simplexVertex(simplex, i).indexA; cache.indexB[i] = simplexVertex(simplex, i).indexB; i = i + 1i32; } }
# Box2D 8c661469, src/distance.c:217-244. MIT.
fun b2ComputeSimplexWitnessPoints(a: ref Vec2, b: ref Vec2, s: ref Simplex) -> () = {
    if (s.count == 1i32) { a = s.v1.wA; b = s.v1.wB; }
    else if (s.count == 2i32) { a = b2Weight2(s.v1.a, s.v1.wA, s.v2.a, s.v2.wA); b = b2Weight2(s.v1.a, s.v1.wB, s.v2.a, s.v2.wB); }
    else if (s.count == 3i32) { a = b2Weight3(s.v1.a, s.v1.wA, s.v2.a, s.v2.wA, s.v3.a, s.v3.wA); b = a; }
    else { a = Vec2(); b = Vec2(); }
}
# Box2D 8c661469, src/distance.c:271-305. MIT.
fun b2SolveSimplex2(s: ref Simplex) -> Vec2 =
{
    let w1: Vec2 = s.v1.w;
    let w2: Vec2 = s.v2.w;
    let e12: Vec2 = b2Sub( w2, w1 );

    let d12_2: f32 = -poly.b2Dot( w1, e12 );
    if ( d12_2 <= 0.0f32 )
    {

        s.v1.a = 1.0f32; s.v1.aDefined = true;
        s.count = 1i32;
        return poly.b2Neg( w1 );
    }

    let d12_1: f32 = poly.b2Dot( w2, e12 );
    if ( d12_1 <= 0.0f32 )
    {

        s.v2.a = 1.0f32; s.v2.aDefined = true;
        s.count = 1i32;
        s.v1 = s.v2;
        return poly.b2Neg( w2 );
    }

    let inv_d12: f32 = 1.0f32 / ( d12_1 + d12_2 );
    s.v1.a = d12_1 * inv_d12; s.v1.aDefined = true;
    s.v2.a = d12_2 * inv_d12; s.v2.aDefined = true;
    s.count = 2i32;
    return poly.b2CrossSV( motion.b2Cross( b2Add( w1, w2 ), e12 ), e12 );
}

# Box2D 8c661469, src/distance.c:306-416. MIT.
fun b2SolveSimplex3(s: ref Simplex) -> Vec2 =
{
    let w1: Vec2 = s.v1.w;
    let w2: Vec2 = s.v2.w;
    let w3: Vec2 = s.v3.w;

    let e12: Vec2 = b2Sub( w2, w1 );
    let w1e12: f32 = poly.b2Dot( w1, e12 );
    let w2e12: f32 = poly.b2Dot( w2, e12 );
    let d12_1: f32 = w2e12;
    let d12_2: f32 = -w1e12;

    let e13: Vec2 = b2Sub( w3, w1 );
    let w1e13: f32 = poly.b2Dot( w1, e13 );
    let w3e13: f32 = poly.b2Dot( w3, e13 );
    let d13_1: f32 = w3e13;
    let d13_2: f32 = -w1e13;

    let e23: Vec2 = b2Sub( w3, w2 );
    let w2e23: f32 = poly.b2Dot( w2, e23 );
    let w3e23: f32 = poly.b2Dot( w3, e23 );
    let d23_1: f32 = w3e23;
    let d23_2: f32 = -w2e23;

    let n123: f32 = motion.b2Cross( e12, e13 );

    let d123_1: f32 = n123 * motion.b2Cross( w2, w3 );
    let d123_2: f32 = n123 * motion.b2Cross( w3, w1 );
    let d123_3: f32 = n123 * motion.b2Cross( w1, w2 );

    if ( d12_2 <= 0.0f32 and d13_2 <= 0.0f32 )
    {
        s.v1.a = 1.0f32; s.v1.aDefined = true;
        s.count = 1i32;
        return poly.b2Neg( w1 );
    }

    if ( d12_1 > 0.0f32 and d12_2 > 0.0f32 and d123_3 <= 0.0f32 )
    {
        let inv_d12: f32 = 1.0f32 / ( d12_1 + d12_2 );
        s.v1.a = d12_1 * inv_d12; s.v1.aDefined = true;
        s.v2.a = d12_2 * inv_d12; s.v2.aDefined = true;
        s.count = 2i32;
        return poly.b2CrossSV( motion.b2Cross( b2Add( w1, w2 ), e12 ), e12 );
    }

    if ( d13_1 > 0.0f32 and d13_2 > 0.0f32 and d123_2 <= 0.0f32 )
    {
        let inv_d13: f32 = 1.0f32 / ( d13_1 + d13_2 );
        s.v1.a = d13_1 * inv_d13; s.v1.aDefined = true;
        s.v3.a = d13_2 * inv_d13; s.v3.aDefined = true;
        s.count = 2i32;
        s.v2 = s.v3;
        return poly.b2CrossSV( motion.b2Cross( b2Add( w1, w3 ), e13 ), e13 );
    }

    if ( d12_1 <= 0.0f32 and d23_2 <= 0.0f32 )
    {
        s.v2.a = 1.0f32; s.v2.aDefined = true;
        s.count = 1i32;
        s.v1 = s.v2;
        return poly.b2Neg( w2 );
    }

    if ( d13_1 <= 0.0f32 and d23_1 <= 0.0f32 )
    {
        s.v3.a = 1.0f32; s.v3.aDefined = true;
        s.count = 1i32;
        s.v1 = s.v3;
        return poly.b2Neg( w3 );
    }

    if ( d23_1 > 0.0f32 and d23_2 > 0.0f32 and d123_1 <= 0.0f32 )
    {
        let inv_d23: f32 = 1.0f32 / ( d23_1 + d23_2 );
        s.v2.a = d23_1 * inv_d23; s.v2.aDefined = true;
        s.v3.a = d23_2 * inv_d23; s.v3.aDefined = true;
        s.count = 2i32;
        s.v1 = s.v3;
        return poly.b2CrossSV( motion.b2Cross( b2Add( w2, w3 ), e23 ), e23 );
    }

    let inv_d123: f32 = 1.0f32 / ( d123_1 + d123_2 + d123_3 );
    s.v1.a = d123_1 * inv_d123; s.v1.aDefined = true;
    s.v2.a = d123_2 * inv_d123; s.v2.aDefined = true;
    s.v3.a = d123_3 * inv_d123; s.v3.aDefined = true;
    s.count = 3i32;

    return Vec2();
}
# Box2D 8c661469, src/distance.c:448-453,506-512,567-573. MIT. Observation only.
fun storeSimplex(trace: ref SimplexTrace, simplex: Simplex, capacity: i32, enabled: bool) -> () = {
    if (enabled and trace.stored < capacity) { trace.slots[trace.stored] = simplex; trace.stored = trace.stored + 1i32; }
}
# Box2D 8c661469, src/distance.c:495-504,514-528. MIT. Both early returns preserve zero output/cache.
fun overlapOutput(input: ref DistanceInput, simplex: ref Simplex) -> DistanceOutput = {
    var result = DistanceOutput(); var localPointA = Vec2(); var localPointB = Vec2();
    b2ComputeSimplexWitnessPoints(&localPointA, &localPointB, simplex);
    result.pointA = b2TransformPoint(input.transformA, localPointA); result.pointB = b2TransformPoint(input.transformA, localPointB); return result;
}
# Box2D 8c661469, src/distance.c:421-605. MIT.                                                     
fun shapeDistanceKernel(input: ref DistanceInput, cache: ref SimplexCache, trace: ref SimplexTrace, capacity: i32, storeTrace: bool, debugTrace: bool) -> DistanceOutput = {
    trace.stored = 0i32;
    var output = DistanceOutput(); var proxyA: ShapeProxy = input.proxyA; var localProxyB = ShapeProxy();
    let transform: Transform = b2InvMulTransforms(input.transformA, input.transformB);
    localProxyB.count = input.proxyB.count; localProxyB.radius = input.proxyB.radius;
    var pi: i32 = 0i32; while (pi < localProxyB.count) { localProxyB.points[pi] = b2TransformPoint(transform, input.proxyB.points[pi]); pi = pi + 1i32; }
    var simplex: Simplex = b2MakeSimplexFromCache(cache, &proxyA, &localProxyB);
    storeSimplex(trace, simplex, capacity, storeTrace);
    var nonUnitNormal = Vec2(); var saveA: i32[3]; var saveB: i32[3];
    let maxIterations: i32 = 20i32; var iteration: i32 = 0i32; var searching: bool = true;
    while (iteration < maxIterations and searching) {
        let saveCount: i32 = simplex.count; var si: i32 = 0i32;
        while (si < saveCount) { saveA[si] = simplexVertex(&simplex, si).indexA; saveB[si] = simplexVertex(&simplex, si).indexB; si = si + 1i32; }
        var direction = Vec2();
        if (simplex.count == 1i32) direction = poly.b2Neg(simplex.v1.w);
        else if (simplex.count == 2i32) direction = b2SolveSimplex2(&simplex);
        else if (simplex.count == 3i32) direction = b2SolveSimplex3(&simplex);
        if (simplex.count == 3i32) return overlapOutput(input, &simplex);
        if (debugTrace) storeSimplex(trace, simplex, capacity, storeTrace);
        if (poly.b2Dot(direction, direction) < FLT_EPSILON * FLT_EPSILON) return overlapOutput(input, &simplex);
        nonUnitNormal = direction;
        var vertex: ref SimplexVertex = simplexVertex(&simplex, simplex.count);
        vertex.indexA = b2FindSupport(&proxyA, direction); vertex.wA = proxyA.points[vertex.indexA];
        vertex.indexB = b2FindSupport(&localProxyB, poly.b2Neg(direction)); vertex.wB = localProxyB.points[vertex.indexB]; vertex.w = b2Sub(vertex.wA, vertex.wB);
        iteration = iteration + 1i32;
        var duplicate: bool = false; var di: i32 = 0i32;
        while (di < saveCount and not duplicate) { if (vertex.indexA == saveA[di] and vertex.indexB == saveB[di]) duplicate = true; di = di + 1i32; }
        if (duplicate) searching = false; else simplex.count = simplex.count + 1i32;
    }
    if (debugTrace) storeSimplex(trace, simplex, capacity, storeTrace);
    var normal: Vec2 = motion.b2Normalize(nonUnitNormal); normal = b2RotateVector(input.transformA.q, normal);
    var localPointA = Vec2(); var localPointB = Vec2(); b2ComputeSimplexWitnessPoints(&localPointA, &localPointB, &simplex);
    output.normal = normal; output.distance = b2Distance(localPointA, localPointB);
    output.pointA = b2TransformPoint(input.transformA, localPointA); output.pointB = b2TransformPoint(input.transformA, localPointB);
    output.iterations = iteration; output.simplexCount = trace.stored;
    b2MakeSimplexCache(cache, &simplex);
    if (input.useRadii) {
        let radiusA: f32 = input.proxyA.radius; let radiusB: f32 = input.proxyB.radius;
        output.distance = tree.b2MaxFloat(0.0f32, output.distance - radiusA - radiusB);
        output.pointA = b2MulAdd(output.pointA, radiusA, normal); output.pointB = b2MulSub(output.pointB, radiusB, normal);
    }
    return output;
}
# Box2D 8c661469, src/distance.c:421-605. MIT. Public raw corresponds to NDEBUG/R.
fun b2ShapeDistance(input: ref DistanceInput, cache: ref SimplexCache, trace: ref SimplexTrace, simplexCapacity: i32, storeTrace: bool) -> DistanceOutput = {
    return shapeDistanceKernel(input, cache, trace, simplexCapacity, storeTrace, false);
}
# Box2D 8c661469, src/distance.c:506-512,567-573. MIT. Explicit D fixture, identical physics.
fun b2ShapeDistanceDebug(input: ref DistanceInput, cache: ref SimplexCache, trace: ref SimplexTrace, simplexCapacity: i32, storeTrace: bool) -> DistanceOutput = {
    return shapeDistanceKernel(input, cache, trace, simplexCapacity, storeTrace, true);
}

                                                                                                  
class Validation { status: i32 = 0i32; reason: i32 = 0i32; }
class ProxyResult { status: i32 = 0i32; reason: i32 = 0i32; value: ShapeProxy = ShapeProxy(); }
class DistanceResult { status: i32 = 0i32; reason: i32 = 0i32; value: DistanceOutput = DistanceOutput(); }
fun finite(value: f32) -> bool = { return value == value and value >= -340282346638528859811704183484516925440.0f32 and value <= 340282346638528859811704183484516925440.0f32; }
fun validRadius(radius: f32) -> bool = { return finite(radius) and radius >= 0.0f32; }
# Box2D 8c661469, include/box2d/math_functions.h:380-385. MIT. Strict norm, no normalization.
fun validTransform(transform: Transform) -> bool = {
    if (not finite(transform.p.x) or not finite(transform.p.y)) return false;
    if (not finite(transform.q.s) or not finite(transform.q.c)) return false;
    let qq: f32 = transform.q.s * transform.q.s + transform.q.c * transform.q.c;
    return 1.0f32 - 0.0006f32 < qq and qq < 1.0f32 + 0.0006f32;
}
fun validProxyCount(count: i32) -> bool = { return count >= 1i32 and count <= 8i32; }
fun validProxyPoints(points: ref Vec2[8], count: i32) -> bool = {
    var i: i32 = 0i32; while (i < 8i32) { if (i < count and (not finite(points[i].x) or not finite(points[i].y))) return false; i = i + 1i32; } return true;
}
fun validCache(cache: ref SimplexCache, countA: i32, countB: i32) -> bool = {
    if (cache.count < 0i32 or cache.count > 3i32) return false;
    var i: i32 = 0i32;
    while (i < 3i32) {
        if (i < cache.count and validProxyCount(countA) and validProxyCount(countB)) {
            if (validProxyCount(countA) and (cache.indexA[i] < 0i32 or cache.indexA[i] >= countA)) return false;
            if (validProxyCount(countB) and (cache.indexB[i] < 0i32 or cache.indexB[i] >= countB)) return false;
        }
        i = i + 1i32;
    }
    return true;
}
fun validateProxy(points: ref Vec2[8], count: i32, radius: f32, transform: Transform, useOffset: bool) -> Validation = {
    if (not validRadius(radius)) return Validation(5i32, 0i32);
    if (useOffset and not validTransform(transform)) return Validation(5i32, 0i32);
    if (not validProxyCount(count)) return Validation(4i32, 0i32);
    if (not validProxyPoints(points, count)) return Validation(4i32, 0i32);
    return Validation();
}
fun validateDistance(input: ref DistanceInput, cache: ref SimplexCache) -> Validation = {
    if (not validRadius(input.proxyA.radius) or not validRadius(input.proxyB.radius)) return Validation(5i32, 0i32);
    if (not validTransform(input.transformA) or not validTransform(input.transformB)) return Validation(5i32, 0i32);
    if (not validCache(cache, input.proxyA.count, input.proxyB.count)) return Validation(5i32, 82i32);
    if (not validProxyCount(input.proxyA.count) or not validProxyCount(input.proxyB.count)) return Validation(4i32, 0i32);
    if (not validProxyPoints(&input.proxyA.points, input.proxyA.count) or not validProxyPoints(&input.proxyB.points, input.proxyB.count)) return Validation(4i32, 0i32);
    return Validation();
}
fun makeProxy(points: ref Vec2[8], count: i32, radius: f32) -> ProxyResult = {
    let check: Validation = validateProxy(points, count, radius, Transform(), false);
    if (check.status != 0i32) return ProxyResult(check.status, check.reason, ShapeProxy());
    return ProxyResult(0i32, 0i32, b2MakeProxy(points, count, radius));
}
fun makeOffsetProxy(points: ref Vec2[8], count: i32, radius: f32, position: Vec2, rotation: Rot) -> ProxyResult = {
    let check: Validation = validateProxy(points, count, radius, Transform(position, rotation), true);
    if (check.status != 0i32) return ProxyResult(check.status, check.reason, ShapeProxy());
    return ProxyResult(0i32, 0i32, b2MakeOffsetProxy(points, count, radius, position, rotation));
}
fun shapeDistanceCached(input: ref DistanceInput, cache: ref SimplexCache, trace: ref SimplexTrace, capacity: i32, storeTrace: bool) -> DistanceResult = {
    let check: Validation = validateDistance(input, cache);
    if (check.status != 0i32) return DistanceResult(check.status, check.reason, DistanceOutput());
    return DistanceResult(0i32, 0i32, b2ShapeDistance(input, cache, trace, capacity, storeTrace));
}
                                                                            
fun shapeDistanceCachedDebug(input: ref DistanceInput, cache: ref SimplexCache, trace: ref SimplexTrace, capacity: i32, storeTrace: bool) -> DistanceResult = {
    let check: Validation = validateDistance(input, cache);
    if (check.status != 0i32) return DistanceResult(check.status, check.reason, DistanceOutput());
    return DistanceResult(0i32, 0i32, b2ShapeDistanceDebug(input, cache, trace, capacity, storeTrace));
}
fun shapeDistance(input: ref DistanceInput) -> DistanceResult = {
    var cache = SimplexCache(); var trace = SimplexTrace(); return shapeDistanceCached(input, &cache, &trace, 0i32, false);
}

# Box2D 8c661469, collision.                                          
                                                                         
class Sweep { localCenter: Vec2 = Vec2(); c1: Vec2 = Vec2(); c2: Vec2 = Vec2(); q1: Rot = Rot(); q2: Rot = Rot(); }
class TOIInput { proxyA: ShapeProxy = ShapeProxy(); proxyB: ShapeProxy = ShapeProxy(); sweepA: Sweep = Sweep(); sweepB: Sweep = Sweep(); maxFraction: f32 = 0.0f32; }
class TOIOutput { state: i32 = 0i32; fraction: f32 = 0.0f32; }
class SweepResult { status: i32 = 0i32; reason: i32 = 0i32; value: Transform = Transform(); }
class TOIResult { status: i32 = 0i32; reason: i32 = 0i32; value: TOIOutput = TOIOutput(); }
class SeparationFunction { proxyA: ShapeProxy = ShapeProxy(); proxyB: ShapeProxy = ShapeProxy(); sweepA: Sweep = Sweep(); sweepB: Sweep = Sweep(); localPoint: Vec2 = Vec2(); axis: Vec2 = Vec2(); sepType: i32 = 0i32; }

                                                                          
fun zeroTOIWords() -> u32[17] = { var values: u32[17]; return values; }
class TOIEvent { event: i32 = 0i32; count: i32 = 0i32; words: u32[17] = zeroTOIWords(); }
fun emptyTOIEvents() -> List[TOIEvent] = { var values: List[TOIEvent]; return values; }
class TOITrace { events: List[TOIEvent] = emptyTOIEvents(); }
fun toiBits(value: f32) -> u32 = { var scalar: f32 = value; return (&scalar as cptr u32)[0]; }
fun observeSeparation(trace: ref TOITrace, f: ref SeparationFunction, enabled: bool) -> () = {
    if (enabled) { var e = TOIEvent(); e.event = 4i32; e.count = 5i32;
        e.words[0] = f.sepType as u32; e.words[1] = toiBits(f.axis.x); e.words[2] = toiBits(f.axis.y); e.words[3] = toiBits(f.localPoint.x); e.words[4] = toiBits(f.localPoint.y); trace.events.push(e); }
}
fun observeTOICache(trace: ref TOITrace, cache: ref SimplexCache, iteration: i32, output: DistanceOutput, after: bool, enabled: bool) -> () = {
    if (enabled) { var e = TOIEvent(); e.event = if after then 8i32 else 7i32; e.count = if after then 17i32 else 8i32;
        e.words[0] = iteration as u32; e.words[1] = cache.count as u32; var i: i32 = 0i32;
        while (i < 3i32) { if (i < cache.count) { e.words[2i32+i] = cache.indexA[i] as u32; e.words[5i32+i] = cache.indexB[i] as u32; } i = i+1i32; }
        if (after) { e.words[8] = toiBits(output.pointA.x); e.words[9] = toiBits(output.pointA.y); e.words[10] = toiBits(output.pointB.x); e.words[11] = toiBits(output.pointB.y); e.words[12] = toiBits(output.normal.x); e.words[13] = toiBits(output.normal.y); e.words[14] = toiBits(output.distance); e.words[15] = output.iterations as u32; e.words[16] = output.simplexCount as u32; } trace.events.push(e); }
}
fun observeTOIRoot(trace: ref TOITrace, iteration: i32, pushBack: i32, root: i32, a1: f32, a2: f32, s1: f32, s2: f32, t: f32, s: f32, enabled: bool) -> () = {
    if (enabled) { var e = TOIEvent(); e.event = 5i32; e.count = 9i32;
        e.words[0] = iteration as u32; e.words[1] = pushBack as u32; e.words[2] = root as u32; e.words[3] = toiBits(a1); e.words[4] = toiBits(a2); e.words[5] = toiBits(s1); e.words[6] = toiBits(s2); e.words[7] = toiBits(t); e.words[8] = toiBits(s); trace.events.push(e); }
}
fun b2CrossVS(v: Vec2, s: f32) -> Vec2 = { return Vec2(s*v.y,-s*v.x); }
fun b2GetSweepTransform(sweep: ref Sweep, time: f32) -> Transform = {
    var xf = Transform();
    xf.p = b2Add(motion.b2MulSV(1.0f32-time,sweep.c1),motion.b2MulSV(time,sweep.c2));
    let q: Rot = Rot((1.0f32-time)*sweep.q1.c+time*sweep.q2.c,(1.0f32-time)*sweep.q1.s+time*sweep.q2.s);
    xf.q = motion.b2NormalizeRot(q); xf.p = b2Sub(xf.p,b2RotateVector(xf.q,sweep.localCenter)); return xf;
}
fun b2MakeSeparationFunction(cache: ref SimplexCache, proxyA: ref ShapeProxy, sweepA: ref Sweep, proxyB: ref ShapeProxy, sweepB: ref Sweep, t1: f32) -> SeparationFunction = {
    var f = SeparationFunction(); f.proxyA = proxyA; f.proxyB = proxyB; f.sweepA = sweepA; f.sweepB = sweepB;
    let xfA: Transform = b2GetSweepTransform(sweepA,t1); let xfB: Transform = b2GetSweepTransform(sweepB,t1);
    if (cache.count == 1i32) {
        f.sepType = 0i32; let localA0: Vec2 = proxyA.points[cache.indexA[0]]; let localB0: Vec2 = proxyB.points[cache.indexB[0]];
        let pointA0: Vec2 = b2TransformPoint(xfA,localA0); let pointB0: Vec2 = b2TransformPoint(xfB,localB0);
        f.axis = motion.b2Normalize(b2Sub(pointB0,pointA0)); f.localPoint = Vec2(); return f;
    }
    if (cache.indexA[0] == cache.indexA[1]) {
        f.sepType = 2i32; let localB1: Vec2 = proxyB.points[cache.indexB[0]]; let localB2: Vec2 = proxyB.points[cache.indexB[1]];
        f.axis = b2CrossVS(b2Sub(localB2,localB1),1.0f32); f.axis = motion.b2Normalize(f.axis);
        let normalB: Vec2 = b2RotateVector(xfB.q,f.axis);
        f.localPoint = Vec2(0.5f32*(localB1.x+localB2.x),0.5f32*(localB1.y+localB2.y));
        let pointB1: Vec2 = b2TransformPoint(xfB,f.localPoint); let localA1: Vec2 = proxyA.points[cache.indexA[0]]; let pointA1: Vec2 = b2TransformPoint(xfA,localA1);
        let separationB: f32 = poly.b2Dot(b2Sub(pointA1,pointB1),normalB); if (separationB < 0.0f32) f.axis = poly.b2Neg(f.axis); return f;
    }
    f.sepType = 1i32; let localA2: Vec2 = proxyA.points[cache.indexA[0]]; let localA3: Vec2 = proxyA.points[cache.indexA[1]];
    f.axis = b2CrossVS(b2Sub(localA3,localA2),1.0f32); f.axis = motion.b2Normalize(f.axis);
    let normalA: Vec2 = b2RotateVector(xfA.q,f.axis);
    f.localPoint = Vec2(0.5f32*(localA2.x+localA3.x),0.5f32*(localA2.y+localA3.y));
    let pointA2: Vec2 = b2TransformPoint(xfA,f.localPoint); let localB3: Vec2 = proxyB.points[cache.indexB[0]]; let pointB2: Vec2 = b2TransformPoint(xfB,localB3);
    let separationA: f32 = poly.b2Dot(b2Sub(pointB2,pointA2),normalA); if (separationA < 0.0f32) f.axis = poly.b2Neg(f.axis); return f;
}
fun b2FindMinSeparation(f: ref SeparationFunction, indexA: ref i32, indexB: ref i32, t: f32) -> f32 = {
    let xfA: Transform = b2GetSweepTransform(&f.sweepA,t); let xfB: Transform = b2GetSweepTransform(&f.sweepB,t);
    if (f.sepType == 0i32) {
        let axisA0: Vec2 = b2InvRotateVector(xfA.q,f.axis); let axisB0: Vec2 = b2InvRotateVector(xfB.q,poly.b2Neg(f.axis));
        indexA = b2FindSupport(&f.proxyA,axisA0); indexB = b2FindSupport(&f.proxyB,axisB0);
        let pointA0: Vec2 = b2TransformPoint(xfA,f.proxyA.points[indexA]); let pointB0: Vec2 = b2TransformPoint(xfB,f.proxyB.points[indexB]);
        return poly.b2Dot(b2Sub(pointB0,pointA0),f.axis);
    }
    if (f.sepType == 1i32) {
        let normalA: Vec2 = b2RotateVector(xfA.q,f.axis); let pointA1: Vec2 = b2TransformPoint(xfA,f.localPoint);
        let axisB1: Vec2 = b2InvRotateVector(xfB.q,poly.b2Neg(normalA)); indexA = -1i32; indexB = b2FindSupport(&f.proxyB,axisB1);
        let pointB1: Vec2 = b2TransformPoint(xfB,f.proxyB.points[indexB]); return poly.b2Dot(b2Sub(pointB1,pointA1),normalA);
    }
    if (f.sepType == 2i32) {
        let normalB: Vec2 = b2RotateVector(xfB.q,f.axis); let pointB2: Vec2 = b2TransformPoint(xfB,f.localPoint);
        let axisA2: Vec2 = b2InvRotateVector(xfA.q,poly.b2Neg(normalB)); indexB = -1i32; indexA = b2FindSupport(&f.proxyA,axisA2);
        let pointA2: Vec2 = b2TransformPoint(xfA,f.proxyA.points[indexA]); return poly.b2Dot(b2Sub(pointA2,pointB2),normalB);
    }
    indexA = -1i32; indexB = -1i32; return 0.0f32;
}
fun b2EvaluateSeparation(f: ref SeparationFunction, indexA: i32, indexB: i32, t: f32) -> f32 = {
    let xfA: Transform = b2GetSweepTransform(&f.sweepA,t); let xfB: Transform = b2GetSweepTransform(&f.sweepB,t);
    if (f.sepType == 0i32) {
        let pointA0: Vec2 = b2TransformPoint(xfA,f.proxyA.points[indexA]); let pointB0: Vec2 = b2TransformPoint(xfB,f.proxyB.points[indexB]); return poly.b2Dot(b2Sub(pointB0,pointA0),f.axis);
    }
    if (f.sepType == 1i32) {
        let normalA: Vec2 = b2RotateVector(xfA.q,f.axis); let pointA1: Vec2 = b2TransformPoint(xfA,f.localPoint); let pointB1: Vec2 = b2TransformPoint(xfB,f.proxyB.points[indexB]); return poly.b2Dot(b2Sub(pointB1,pointA1),normalA);
    }
    if (f.sepType == 2i32) {
        let normalB: Vec2 = b2RotateVector(xfB.q,f.axis); let pointB2: Vec2 = b2TransformPoint(xfB,f.localPoint); let pointA2: Vec2 = b2TransformPoint(xfA,f.proxyA.points[indexA]); return poly.b2Dot(b2Sub(pointA2,pointB2),normalB);
    }
    return 0.0f32;
}
fun timeOfImpactKernel(input: ref TOIInput, observer: ref TOITrace, observed: bool) -> TOIOutput = {
    var output = TOIOutput(); output.fraction = input.maxFraction;
    var sweepA: Sweep = input.sweepA; var sweepB: Sweep = input.sweepB;
    let tMax: f32 = input.maxFraction; let totalRadius: f32 = input.proxyA.radius+input.proxyB.radius;
    let target: f32 = tree.b2MaxFloat(B2_LINEAR_SLOP,totalRadius-B2_LINEAR_SLOP); let tolerance: f32 = 0.25f32*B2_LINEAR_SLOP;
    var t1: f32 = 0.0f32; var distanceIterations: i32 = 0i32; var cache = SimplexCache(); var distanceInput = DistanceInput();
    distanceInput.proxyA = input.proxyA; distanceInput.proxyB = input.proxyB; distanceInput.useRadii = false;
    var searching: bool = true;
    while (searching) {
        let xfA: Transform = b2GetSweepTransform(&sweepA,t1); let xfB: Transform = b2GetSweepTransform(&sweepB,t1);
        distanceInput.transformA = xfA; distanceInput.transformB = xfB;
        observeTOICache(observer,&cache,distanceIterations,DistanceOutput(),false,observed);
        var simplexTrace = SimplexTrace();
        let distanceOutput: DistanceOutput = b2ShapeDistance(&distanceInput,&cache,&simplexTrace,0i32,false);
        distanceIterations = distanceIterations+1i32;
        observeTOICache(observer,&cache,distanceIterations,distanceOutput,true,observed);
        if (distanceOutput.distance <= 0.0f32) { output.state = 2i32; output.fraction = 0.0f32; searching = false; }
        else if (distanceOutput.distance <= target+tolerance) { output.state = 3i32; output.fraction = t1; searching = false; }
        else {
            var fcn: SeparationFunction = b2MakeSeparationFunction(&cache,&input.proxyA,&sweepA,&input.proxyB,&sweepB,t1);
            observeSeparation(observer,&fcn,observed);
            var done: bool = false; var t2: f32 = tMax; var pushBackIterations: i32 = 0i32; var pushing: bool = true;
            while (pushing) {
                var indexA: i32 = 0i32; var indexB: i32 = 0i32;
                var s2: f32 = b2FindMinSeparation(&fcn,&indexA,&indexB,t2);
                if (s2 > target+tolerance) { output.state = 4i32; output.fraction = tMax; done = true; pushing = false; }
                else if (s2 > target-tolerance) { t1 = t2; pushing = false; }
                else {
                    var s1: f32 = b2EvaluateSeparation(&fcn,indexA,indexB,t1);
                    if (s1 < target-tolerance) { output.state = 1i32; output.fraction = t1; done = true; pushing = false; }
                    else if (s1 <= target+tolerance) { output.state = 3i32; output.fraction = t1; done = true; pushing = false; }
                    else {
                        var rootIterationCount: i32 = 0i32; var a1: f32 = t1; var a2: f32 = t2; var rooting: bool = true;
                        while (rooting) {
                            var t: f32 = 0.0f32;
                            if ((rootIterationCount & 1i32) != 0i32) t = a1+(target-s1)*(a2-a1)/(s2-s1); else t = 0.5f32*(a1+a2);
                            rootIterationCount = rootIterationCount+1i32;
                            let separation: f32 = b2EvaluateSeparation(&fcn,indexA,indexB,t);
                            observeTOIRoot(observer,distanceIterations,pushBackIterations,rootIterationCount,a1,a2,s1,s2,t,separation,observed);
                            if (motion.b2AbsFloat(separation-target) < tolerance) { t2 = t; rooting = false; }
                            else {
                                if (separation > target) { a1 = t; s1 = separation; } else { a2 = t; s2 = separation; }
                                if (rootIterationCount == 50i32) rooting = false;
                            }
                        }
                        pushBackIterations = pushBackIterations+1i32; if (pushBackIterations == 8i32) pushing = false;
                    }
                }
            }
            if (done) searching = false;
            else if (distanceIterations == 20i32) { output.state = 1i32; output.fraction = t1; searching = false; }
        }
    }
    if (observed) { var finalEvent = TOIEvent(); finalEvent.event = 6i32; finalEvent.count = 3i32; finalEvent.words[0] = output.state as u32; finalEvent.words[1] = toiBits(output.fraction); finalEvent.words[2] = distanceIterations as u32; observer.events.push(finalEvent); }
    return output;
}
fun b2TimeOfImpact(input: ref TOIInput) -> TOIOutput = { var observer = TOITrace(); return timeOfImpactKernel(input,&observer,false); }
fun b2TimeOfImpactObserved(input: ref TOIInput, observer: ref TOITrace) -> TOIOutput = { return timeOfImpactKernel(input,observer,true); }

                                                                   
fun validSweep(sweep: ref Sweep) -> bool = {
    if (not finite(sweep.localCenter.x) or not finite(sweep.localCenter.y)) return false;
    if (not finite(sweep.c1.x) or not finite(sweep.c1.y)) return false;
    if (not finite(sweep.c2.x) or not finite(sweep.c2.y)) return false;
    if (not validTransform(Transform(Vec2(),sweep.q1))) return false;
    if (not validTransform(Transform(Vec2(),sweep.q2))) return false;
    return true;
}
fun validateSweep(sweep: ref Sweep, time: f32) -> Validation = {
    if (not (time >= 0.0f32 and time <= 1.0f32)) return Validation(5i32,16i32);
    if (not validSweep(sweep)) return Validation(5i32,16i32); return Validation();
}
fun validateTOI(input: ref TOIInput) -> Validation = {
    if (not (input.maxFraction >= 0.0f32 and input.maxFraction <= 1.0f32)) return Validation(5i32,16i32);
    if (not finite(input.proxyA.radius) or not (input.proxyA.radius >= 0.0f32)) return Validation(5i32,16i32);
    if (not finite(input.proxyB.radius) or not (input.proxyB.radius >= 0.0f32)) return Validation(5i32,16i32);
    if (not validSweep(&input.sweepA)) return Validation(5i32,16i32);
    if (not validSweep(&input.sweepB)) return Validation(5i32,16i32);
    if (not validProxyCount(input.proxyA.count)) return Validation(4i32,0i32);
    if (not validProxyCount(input.proxyB.count)) return Validation(4i32,0i32);
    if (not validProxyPoints(&input.proxyA.points,input.proxyA.count)) return Validation(4i32,0i32);
    if (not validProxyPoints(&input.proxyB.points,input.proxyB.count)) return Validation(4i32,0i32);
    return Validation();
}
fun getSweepTransform(sweep: ref Sweep, time: f32) -> SweepResult = {
    let check: Validation = validateSweep(sweep,time); if (check.status != 0i32) return SweepResult(check.status,check.reason,Transform()); return SweepResult(0i32,0i32,b2GetSweepTransform(sweep,time));
}
fun timeOfImpact(input: ref TOIInput) -> TOIResult = {
    let check: Validation = validateTOI(input); if (check.status != 0i32) return TOIResult(check.status,check.reason,TOIOutput()); return TOIResult(0i32,0i32,b2TimeOfImpact(input));
}
fun timeOfImpactObserved(input: ref TOIInput, observer: ref TOITrace) -> TOIResult = {
    let check: Validation = validateTOI(input); if (check.status != 0i32) return TOIResult(check.status,check.reason,TOIOutput()); return TOIResult(0i32,0i32,b2TimeOfImpactObserved(input,observer));
}

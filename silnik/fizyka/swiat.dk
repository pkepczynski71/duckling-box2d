        let last: i32 = b2GetSolverSet(world, 2i32).bodyCount - 1i32;
        if (body.localIndex != last) {
            let moved: BodySim = b2GetSolverSet(world, 2i32).bodySims.at(last as i64);
            let movedState: BodyState = b2GetSolverSet(world, 2i32).bodyStates.at(last as i64);
            b2GetSolverSet(world, 2i32).bodySims.at(body.localIndex as i64) = moved;
            b2GetSolverSet(world, 2i32).bodyStates.at(body.localIndex as i64) = movedState;
            world.bodies.at(moved.bodyId as i64).localIndex = body.localIndex;
        }
        b2GetSolverSet(world, 2i32).bodyCount = last;
        world.bodies.at(bodyId as i64).setIndex = setIndex;
        world.bodies.at(bodyId as i64).localIndex = target;
        var key: i32 = body.headContactKey;
        while (key != -1i32) {
            let contactId: i32 = key >> 1i32;
            let side: i32 = key & 1i32;
            let record: ContactRecord = world.contacts.at(contactId as i64);
            key = contactEdge(world.contacts.at(contactId as i64), side).nextKey;
            if (record.setIndex != 1i32 and record.colorIndex == -1i32) {

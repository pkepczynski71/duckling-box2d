fun b2AbsInt(a: i32) -> i32 = { return if a < 0i32 then -a else a; }
fun b2ClampInt(a: i32, lower: i32, upper: i32) -> i32 = {
    return if a < lower then lower else (if a > upper then upper else a);
}
fun b2Clamp(v: Vec2, lower: Vec2, upper: Vec2) -> Vec2 = {
    return Vec2(poly.b2ClampFloat(v.x,lower.x,upper.x),poly.b2ClampFloat(v.y,lower.y,upper.y));
}
fun b2Mul(a: Vec2, b: Vec2) -> Vec2 = { return Vec2(a.x*b.x,a.y*b.y); }
fun b2MulTransforms(a: Transform, b: Transform) -> Transform = {
    return Transform(b2Add(b2RotateVector(a.q,b.p),a.p),mass2.b2MulRot(a.q,b.q));
}
fun b2SpringDamper(hertz: f32, dampingRatio: f32, position: f32, velocity: f32, timeStep: f32) -> f32 = {
    let omega: f32 = 2.0f32*3.14159265359f32*hertz;
    let omegaH: f32 = omega*timeStep;
    return (velocity-omega*omegaH*position)/(1.0f32+2.0f32*dampingRatio*omegaH+omegaH*omegaH);
}
fun b2UnwindAngle(radians: f32) -> f32 = { return remainderf(radians,2.0f32*3.14159265359f32); }
fun b2IsNormalized(a: Vec2) -> bool = {
    return math.abs(1.0f32-poly.b2Dot(a,a)) < 100.0f32*0.00000011920928955078125f32;
}
                                                                                 
fun b2CTZ32(bitWord: u32) -> u32 = {
    var remaining: u32 = bitWord; var count: u32 = 0u32;
    while (remaining != 0u32 and (remaining & 1u32) == 0u32) { remaining = remaining >> 1u32; count = count+1u32; }
    return count;
}
fun b2IsPowerOf2(x: i32) -> bool = { return (x & (x-1i32)) == 0i32; }
fun b2BoundingPowerOf2(x: i32) -> i32 = {
    if (x <= 1i32) return 1i32;
    return 32i32-b2CLZ32((x as u32)-1u32);
}
                                                                                                                 

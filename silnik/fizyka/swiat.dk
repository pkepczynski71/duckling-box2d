fun b2GatherBodies(world: ref World, packet: ref ContactPacket, side: i32) -> wmath.BodyStateW = {
    var result = wmath.BodyStateW(); var lane: i32 = 0i32;
    while (lane < 4i32) {
        var c: ref ContactConstraint = packetLane(packet, lane);
        let index: i32 = if side == 0i32 then c.indexA else c.indexB;
        let state: BodyState = solverState(world, index);
        wmath.setLane(&result.v.X, lane, state.linearVelocity.x); wmath.setLane(&result.v.Y, lane, state.linearVelocity.y);
        wmath.setLane(&result.w, lane, state.angularVelocity);
        wmath.setLane(&result.dp.X, lane, state.deltaPosition.x); wmath.setLane(&result.dp.Y, lane, state.deltaPosition.y);
        wmath.setLane(&result.dq.C, lane, state.deltaRotation.c); wmath.setLane(&result.dq.S, lane, state.deltaRotation.s);
        lane = lane + 1i32;
    }
    return result;
}
# Box2D 8c661469, src/contact_solver.c:1400-1433.                                                            
fun b2ScatterBodies(world: ref World, packet: ref ContactPacket, side: i32, value: wmath.BodyStateW) -> () = {
    var lane: i32 = 0i32;
    while (lane < 4i32) {
        var c: ref ContactConstraint = packetLane(packet, lane);
        let index: i32 = if side == 0i32 then c.indexA else c.indexB;
        if (index != -1i32) {
            var state: ref BodyState = b2GetSolverSet(world, 2i32).bodyStates.at(index as i64);
            state.linearVelocity = Vec2(wmath.laneValue(value.v.X, lane), wmath.laneValue(value.v.Y, lane));
            state.angularVelocity = wmath.laneValue(value.w, lane);
        }
        lane = lane + 1i32;
    }
}

# Box2D 8c661469, src/solver_set.c:521-556. One owning-set list, value copy then RemoveSwap.
fun b2TransferBody(world: ref World, targetIndex: i32, sourceIndex: i32, bodyId: i32) -> () = {
    if (targetIndex == sourceIndex) return;
    let sourceLocal: i32 = world.bodies.at(bodyId as i64).localIndex;
    let sourceSim: BodySim = b2GetSolverSet(world, sourceIndex).bodySims.at(sourceLocal as i64);
    let targetLocal: i32 = b2GetSolverSet(world, targetIndex).bodyCount;
    var target: ref SolverSet = b2GetSolverSet(world, targetIndex);
    if (targetLocal as i64 == target.bodySims.length()) target.bodySims.push(sourceSim);
    else target.bodySims.at(targetLocal as i64) = sourceSim;
    target.bodyCount = targetLocal + 1i32;
    var source: ref SolverSet = b2GetSolverSet(world, sourceIndex);
    let last: i32 = source.bodyCount - 1i32;
    if (sourceLocal != last) {
        let moved: BodySim = source.bodySims.at(last as i64);
        source.bodySims.at(sourceLocal as i64) = moved;
        world.bodies.at(moved.bodyId as i64).localIndex = sourceLocal;
        if (sourceIndex == 2i32) source.bodyStates.at(sourceLocal as i64) = source.bodyStates.at(last as i64);
    }
    source.bodyCount = last;
    if (sourceIndex != 2i32 and targetIndex == 2i32) {
        if (targetLocal as i64 == target.bodyStates.length()) target.bodyStates.push(BodyState());
        else target.bodyStates.at(targetLocal as i64) = BodyState();
    }
    world.bodies.at(bodyId as i64).setIndex = targetIndex;
    world.bodies.at(bodyId as i64).localIndex = targetLocal;
}


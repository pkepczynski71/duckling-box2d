            let v: Vec2 = b2TransformPoint(xf, shape.polygon.vertices[i]);
            lower = tree.b2Min(lower, v); upper = tree.b2Max(upper, v);
            i = i + 1i32;
        }
        radius = shape.polygon.radius;
    } else {
        var point1: Vec2 = if shape.shapeType == 1i32 then shape.capsule.center1 else shape.segment.point1;
        var point2: Vec2 = if shape.shapeType == 1i32 then shape.capsule.center2 else shape.segment.point2;
        if (shape.shapeType == 4i32) { point1 = shape.chainSegment.segment.point1; point2 = shape.chainSegment.segment.point2; }
        let v1: Vec2 = b2TransformPoint(xf, point1);
        let v2: Vec2 = b2TransformPoint(xf, point2);
        lower = tree.b2Min(v1, v2); upper = tree.b2Max(v1, v2);
        if (shape.shapeType == 1i32) radius = shape.capsule.radius;
        else return tree.AABB(lower, upper);
    }
    return tree.AABB(b2Sub(lower, Vec2(radius, radius)), b2Add(upper, Vec2(radius, radius)));
}

# Box2D 8c661469, src/shape.                            
fun expandAABB(aabb: tree.AABB, margin: f32) -> tree.AABB = {
    return tree.AABB(Vec2(aabb.lowerBound.x - margin, aabb.lowerBound.y - margin),
        Vec2(aabb.upperBound.x + margin, aabb.upperBound.y + margin));
}

# Box2D 8c661469, src/shape.                          
class ShapeExtent { minExtent: f32 = 0.0f32; maxExtent: f32 = 0.0f32; }
# Box2D 8c661469, src/shape.c:724-795.
fun b2ComputeShapeExtent(shape: ref ShapeRecord, localCenter: Vec2) -> ShapeExtent = {
    var result = ShapeExtent();
    if (shape.shapeType == 0i32) {
        result.minExtent = shape.circle.radius;
        result.maxExtent = mass2.b2Length(b2Sub(shape.circle.center, localCenter)) + shape.circle.radius;
    } else if (shape.shapeType == 3i32) {
        var minExtent: f32 = 100000.0f32;
        var maxExtentSqr: f32 = 0.0f32;
        var i: i32 = 0i32;
        while (i < shape.polygon.count) {
            let v: Vec2 = shape.polygon.vertices[i];
            let planeOffset: f32 = poly.b2Dot(shape.polygon.normals[i], b2Sub(v, shape.polygon.centroid));
            minExtent = poly.b2MinFloat(minExtent, planeOffset);
            let distanceSqr: f32 = mass2.b2LengthSquared(b2Sub(v, localCenter));
            maxExtentSqr = tree.b2MaxFloat(maxExtentSqr, distanceSqr);
            i = i + 1i32;
        }
        result.minExtent = minExtent + shape.polygon.radius;
        result.maxExtent = math.sqrt(maxExtentSqr) + shape.polygon.radius;
    } else {
        var p1: Vec2 = if shape.shapeType == 1i32 then shape.capsule.center1 else shape.segment.point1;
        var p2: Vec2 = if shape.shapeType == 1i32 then shape.capsule.center2 else shape.segment.point2;
        if (shape.shapeType == 4i32) { p1 = shape.chainSegment.segment.point1; p2 = shape.chainSegment.segment.point2; }
        let c1: Vec2 = b2Sub(p1, localCenter);
        let c2: Vec2 = b2Sub(p2, localCenter);
        result.maxExtent = math.sqrt(tree.b2MaxFloat(mass2.b2LengthSquared(c1), mass2.b2LengthSquared(c2)));
        if (shape.shapeType == 1i32) {
            result.minExtent = shape.capsule.radius;
            result.maxExtent = result.maxExtent + shape.capsule.radius;
        }
    }
    return result;
}

# Box2D 8c661469, src/hull.c:273-328. Ordered CCW points only, no ComputeHull.
fun b2ValidateHull(shape: ref poly.Polygon) -> bool = {
    if (shape.count < 3i32 or shape.count > 8i32) return false;
    var i: i32 = 0i32;
    while (i < shape.count) {
        let i2: i32 = if i < shape.count - 1i32 then i + 1i32 else 0i32;
        let p: Vec2 = shape.vertices[i];
        let edge: Vec2 = mass2.b2Normalize(b2Sub(shape.vertices[i2], p));
        var j: i32 = 0i32;
        while (j < shape.count) {
            if (j != i and j != i2) {
                let distanceValue: f32 = mass2.b2Cross(b2Sub(shape.vertices[j], p), edge);
                if (distanceValue >= 0.0f32) return false;
            }
            j = j + 1i32;
        }
        i = i + 1i32;
    }
    var k: i32 = 0i32;
    while (k < shape.count) {
        let p1: Vec2 = shape.vertices[k];
        let p2: Vec2 = shape.vertices[(k + 1i32) % shape.count];
        let p3: Vec2 = shape.vertices[(k + 2i32) % shape.count];
        let e: Vec2 = mass2.b2Normalize(b2Sub(p3, p1));
        let d: f32 = mass2.b2Cross(b2Sub(p2, p1), e);
        if (d <= B2_LINEAR_SLOP) return false;
        k = k + 1i32;
    }
    return true;
}

# Box2D 8c661469, src/geometry.c:22-89. Caller validated count/edges/area first.
fun b2MakePolygon(shape: ref poly.Polygon) -> () = {
    var i: i32 = 0i32;
    while (i < shape.count) {
        let next: i32 = if i + 1i32 < shape.count then i + 1i32 else 0i32;
        let edge: Vec2 = b2Sub(shape.vertices[next], shape.vertices[i]);
        shape.normals[i] = mass2.b2Normalize(Vec2(edge.y, -edge.x));
        i = i + 1i32;
    }
    var center = Vec2();
    var area: f32 = 0.0f32;
    let origin: Vec2 = shape.vertices[0];
    let inv3: f32 = 1.0f32 / 3.0f32;
    var triangle: i32 = 1i32;
    while (triangle < shape.count - 1i32) {
        let e1: Vec2 = b2Sub(shape.vertices[triangle], origin);
        let e2: Vec2 = b2Sub(shape.vertices[triangle + 1i32], origin);
        let a: f32 = 0.5f32 * mass2.b2Cross(e1, e2);
        center = b2MulAdd(center, a * inv3, b2Add(e1, e2));
        area = area + a;
        triangle = triangle + 1i32;
    }
    let invArea: f32 = 1.0f32 / area;
    center.x = center.x * invArea; center.y = center.y * invArea;
    shape.centroid = b2Add(origin, center);
}


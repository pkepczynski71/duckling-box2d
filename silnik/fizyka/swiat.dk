fun b2Body_SetType(id: BodyId, bodyType: i32) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    let slot: i32 = id.index1 - 1i32;
    let originalType: i32 = world.bodies.at(slot as i64).bodyType;
    if (originalType == bodyType) return;
    if (world.bodies.at(slot as i64).setIndex == 1i32) {
        world.bodies.at(slot as i64).bodyType = bodyType;
        b2UpdateBodyMassData(world, slot); return;
    }
    b2DestroyBodyContacts(world, slot, false);
    b2WakeBody(world, slot);
    b2MergeAwakeIslands(world);
    b2UnlinkBodyJoints14(world, slot);
    world.bodies.at(slot as i64).bodyType = bodyType;
    let sourceIndex: i32 = world.bodies.at(slot as i64).setIndex;
    let targetIndex: i32 = if bodyType == 0i32 then 0i32 else 2i32;
    b2TransferBody(world, targetIndex, sourceIndex, slot);
    if (originalType == 0i32) {
        let islandId: i32 = b2CreateIslandForBody(world, slot);
        world.bodies.at(slot as i64).islandId = islandId;
    } else if (bodyType == 0i32) {
        b2RemoveBodyFromIsland(world, slot);
    }
    b2RecolorBodyJoints14(world, slot);
    let xf: Transform = b2GetBodySim(world, world.bodies.at(slot as i64)).transform;
    var shapeSlot: i32 = world.bodies.at(slot as i64).headShapeId;
    while (shapeSlot != -1i32) {
        let next: i32 = world.shapes.at(shapeSlot as i64).nextShapeId;
        b2DestroyShapeProxy(world, shapeSlot);
        b2CreateShapeProxy(world, shapeSlot, bodyType, xf, true);
        shapeSlot = next;
    }

fun addContactType(values: ref ContactRegister[25], kind: i32, a: i32, b: i32) -> () = {
    values[5i32 * a + b] = ContactRegister(kind, true);
    if (a != b) values[5i32 * b + a] = ContactRegister(kind, false);
}
# Box2D 8c661469, src/contact.c:166.
fun b2InitializeContactRegisters() -> ContactRegister[25] = {
    var values: ContactRegister[25];
    var i: i32 = 0i32;
    while (i < 25i32) { values[i] = ContactRegister(); i = i + 1i32; }
    addContactType(&values, 0i32, 0i32, 0i32);
    addContactType(&values, 1i32, 1i32, 0i32);
    addContactType(&values, 2i32, 2i32, 0i32);
    addContactType(&values, 3i32, 3i32, 0i32);
    addContactType(&values, 4i32, 1i32, 1i32);
    addContactType(&values, 5i32, 2i32, 1i32);
    addContactType(&values, 6i32, 3i32, 1i32);
    addContactType(&values, 7i32, 2i32, 3i32);
    addContactType(&values, 8i32, 3i32, 3i32);
    addContactType(&values, 9i32, 4i32, 0i32);
    addContactType(&values, 10i32, 4i32, 1i32);
    addContactType(&values, 11i32, 4i32, 3i32);
    return values;
}
var contactRegisters: ContactRegister[25] = b2InitializeContactRegisters();


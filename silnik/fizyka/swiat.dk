    smoothParams.normal2 = b2RightPerp(edge2);
    smoothParams.convex2 = mass2.b2Cross(edge1, edge2) >= convexTol;
    let normal1: Vec2 = b2RightPerp(edge1);
    let behind1: bool = poly.b2Dot(normal1, b2Sub(centroidB, p1)) < 0.0f32;
    var behind0: bool = true; var behind2: bool = true;
    if (smoothParams.convex1) behind0 = poly.b2Dot(smoothParams.normal0, b2Sub(centroidB, p1)) < 0.0f32;
    if (smoothParams.convex2) behind2 = poly.b2Dot(smoothParams.normal2, b2Sub(centroidB, p2)) < 0.0f32;
    if (behind1 and behind0 and behind2) return manifold;

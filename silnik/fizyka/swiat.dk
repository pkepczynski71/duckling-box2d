fun contactIslandRoot(world: ref World, input: i32) -> i32 = {
    var id: i32 = input;
    if (id == -1i32) return id;
    var parentId: i32 = world.islands.at(id as i64).parentIsland;
    while (parentId != -1i32) {
        let grand: i32 = world.islands.at(parentId as i64).parentIsland;
        if (grand != -1i32) world.islands.at(id as i64).parentIsland = grand;
        id = parentId;
        parentId = world.islands.at(id as i64).parentIsland;
    }
    return id;
}
# Box2D 8c661469, src/island.c:120-215. Both awake/sleeping orientations wake before linking.
fun b2LinkContact(world: ref World, id: i32) -> () = {
    let contact: ContactRecord = world.contacts.at(id as i64);
    let setA: i32 = world.bodies.at(contact.edgeA.bodyId as i64).setIndex;
    let setB: i32 = world.bodies.at(contact.edgeB.bodyId as i64).setIndex;
    if (setA == 2i32 and setB >= 3i32) b2WakeSolverSet(world, setB);
    if (setB == 2i32 and setA >= 3i32) b2WakeSolverSet(world, setA);
    let a: i32 = world.bodies.at(contact.edgeA.bodyId as i64).islandId;
    let b: i32 = world.bodies.at(contact.edgeB.bodyId as i64).islandId;
    if (a == b) { b2AddContactToIsland(world, a, id); return; }
    let rootA: i32 = contactIslandRoot(world, a);
    let rootB: i32 = contactIslandRoot(world, b);
    if (rootA != rootB and rootA != -1i32 and rootB != -1i32) world.islands.at(rootB as i64).parentIsland = rootA;
    let target: i32 = if rootA != -1i32 then rootA else rootB;
    b2AddContactToIsland(world, target, id);
}
# Box2D 8c661469, src/island.c:218-262.
fun b2UnlinkContact(world: ref World, id: i32) -> () = {
    let contact: ContactRecord = world.contacts.at(id as i64);
    var island: ref Island = world.islands.at(contact.islandId as i64);
    if (contact.islandPrev != -1i32) world.contacts.at(contact.islandPrev as i64).islandNext = contact.islandNext;
    if (contact.islandNext != -1i32) world.contacts.at(contact.islandNext as i64).islandPrev = contact.islandPrev;
    if (island.headContact == id) island.headContact = contact.islandNext;
    if (island.tailContact == id) island.tailContact = contact.islandPrev;
    island.contactCount = island.contactCount - 1i32;
    island.constraintRemoveCount = island.constraintRemoveCount + 1i32;
    world.contacts.at(id as i64).islandId = -1i32;
    world.contacts.at(id as i64).islandPrev = -1i32;
    world.contacts.at(id as i64).islandNext = -1i32;
}
# Box2D 8c661469, src/island.c:429-453,462-501,529-535. Merge the shared contact and joint island lists.
fun b2MergeIsland(world: ref World, id: i32) -> () = {
    let child: Island = world.islands.at(id as i64);
    let root: i32 = child.parentIsland;
    var body: i32 = child.headBody;
    while (body != -1i32) {
        world.bodies.at(body as i64).islandId = root;
        body = world.bodies.at(body as i64).islandNext;
    }
    var contact: i32 = child.headContact;
    while (contact != -1i32) {
        world.contacts.at(contact as i64).islandId = root;
        contact = world.contacts.at(contact as i64).islandNext;
    }
    var target: ref Island = world.islands.at(root as i64);
    world.bodies.at(target.tailBody as i64).islandNext = child.headBody;
    world.bodies.at(child.headBody as i64).islandPrev = target.tailBody;
    target.tailBody = child.tailBody; target.bodyCount = target.bodyCount + child.bodyCount;
    if (target.headContact == -1i32) {
        target.headContact = child.headContact; target.tailContact = child.tailContact; target.contactCount = child.contactCount;
    } else if (child.headContact != -1i32) {
        world.contacts.at(target.tailContact as i64).islandNext = child.headContact;
        world.contacts.at(child.headContact as i64).islandPrev = target.tailContact;
        target.tailContact = child.tailContact; target.contactCount = target.contactCount + child.contactCount;
    }
                                                               
    var jointId: i32 = child.headJoint;
    while (jointId != -1i32) {
        world.joints.at(jointId as i64).islandId = root;
        jointId = world.joints.at(jointId as i64).islandNext;
    }
    if (target.headJoint == -1i32) {
        target.headJoint = child.headJoint; target.tailJoint = child.tailJoint; target.jointCount = child.jointCount;
    } else if (child.headJoint != -1i32) {
        world.joints.at(target.tailJoint as i64).islandNext = child.headJoint;
        world.joints.at(child.headJoint as i64).islandPrev = target.tailJoint;
        target.tailJoint = child.tailJoint; target.jointCount = target.jointCount + child.jointCount;
    }
    target.constraintRemoveCount = target.constraintRemoveCount + child.constraintRemoveCount;
}
# Box2D 8c661469, src/island.c:547-598. Map every parent before any RemoveSwap.
fun b2MergeAwakeIslands(world: ref World) -> () = {
    let count: i32 = b2GetSolverSet(world, 2i32).islandCount;
    var i: i32 = 0i32;
    while (i < count) {
        let id: i32 = b2GetSolverSet(world, 2i32).islandSims.at(i as i64);
        let root: i32 = contactIslandRoot(world, id);
        if (root != id) world.islands.at(id as i64).parentIsland = root;
        i = i + 1i32;
    }
    var j: i32 = count - 1i32;
    while (j >= 0i32) {
        let child: i32 = b2GetSolverSet(world, 2i32).islandSims.at(j as i64);
        if (world.islands.at(child as i64).parentIsland != -1i32) {
            b2MergeIsland(world, child); b2DestroyIsland(world, child);
        }
        j = j - 1i32;
    }
}
# Box2D 8c661469, src/body.c:99-156.
fun b2RemoveBodyFromIsland(world: ref World, id: i32) -> () = {
    let body: BodyRecord = world.bodies.at(id as i64);
    if (body.islandId == -1i32) return;
    if (body.islandPrev != -1i32) world.bodies.at(body.islandPrev as i64).islandNext = body.islandNext;
    if (body.islandNext != -1i32) world.bodies.at(body.islandNext as i64).islandPrev = body.islandPrev;
    var island: ref Island = world.islands.at(body.islandId as i64);
    island.bodyCount = island.bodyCount - 1i32;
    if (island.headBody == id) {
        island.headBody = body.islandNext;
        if (island.headBody == -1i32) b2DestroyIsland(world, body.islandId);
    } else if (island.tailBody == id) island.tailBody = body.islandPrev;
    world.bodies.at(id as i64).islandId = -1i32;
    world.bodies.at(id as i64).islandPrev = -1i32;
    world.bodies.at(id as i64).islandNext = -1i32;
}
# Box2D 8c661469, src/contact.c:354-364. Stamp historical shape tickets at emission.
fun emitContactEnd(world: ref World, a: i32, b: i32) -> () = {
    var event = ContactEndEvent();
    event.shapeA = b2MakeShapeId(world, a); event.shapeB = b2MakeShapeId(world, b);
    event.birthA = world.shapes.at(a as i64).birthTicket; event.birthB = world.shapes.at(b as i64).birthTicket;
    event.ownerTicket = world.birthTicket;
    if (world.endEventArrayIndex == 0i32) world.contactEndEvents0.push(event);
    else world.contactEndEvents1.push(event);
}
# Box2D 8c661469, src/world.c:632-635.
fun emitContactBegin(world: ref World, a: i32, b: i32, manifold: Manifold) -> () = {
    var event = ContactBeginEvent();
    event.shapeA = b2MakeShapeId(world, a); event.shapeB = b2MakeShapeId(world, b);
    event.manifold = manifold;
    event.birthA = world.shapes.at(a as i64).birthTicket; event.birthB = world.shapes.at(b as i64).birthTicket;
    event.ownerTicket = world.birthTicket;
    world.contactBeginEvents.push(event);
}
# Box2D 8c661469, src/contact.c:337-454. Unlink and free before waking touching endpoints.
fun b2DestroyContact(world: ref World, id: i32, wakeBodies: bool) -> () = {
    let record: ContactRecord = world.contacts.at(id as i64);
    b2RemoveKey(&world.broadPhase.pairSet, B2_SHAPE_PAIR_KEY(record.shapeIdA, record.shapeIdB));
    if ((record.flags & 1u32) != 0u32 and (record.flags & 4u32) != 0u32) emitContactEnd(world, record.shapeIdA, record.shapeIdB);
    var side: i32 = 0i32;
    while (side < 2i32) {
        let edge: ContactEdge = contactEdge(world.contacts.at(id as i64), side);
        if (edge.prevKey != -1i32) contactEdge(world.contacts.at((edge.prevKey >> 1i32) as i64), edge.prevKey & 1i32).nextKey = edge.nextKey;
        if (edge.nextKey != -1i32) contactEdge(world.contacts.at((edge.nextKey >> 1i32) as i64), edge.nextKey & 1i32).prevKey = edge.prevKey;
        if (world.bodies.at(edge.bodyId as i64).headContactKey == 2i32 * id + side) world.bodies.at(edge.bodyId as i64).headContactKey = edge.nextKey;
        world.bodies.at(edge.bodyId as i64).contactCount = world.bodies.at(edge.bodyId as i64).contactCount - 1i32;
        side = side + 1i32;
    }
    if (record.islandId != -1i32) b2UnlinkContact(world, id);
    if (record.colorIndex != -1i32) b2RemoveContactFromGraph(world, record.edgeA.bodyId, record.edgeB.bodyId, record.colorIndex, record.localIndex);
    else b2RemoveNonTouchingContact(world, record.localIndex, record.setIndex);
    world.contacts.at(id as i64).contactId = -1i32; world.contacts.at(id as i64).setIndex = -1i32;
    world.contacts.at(id as i64).colorIndex = -1i32; world.contacts.at(id as i64).localIndex = -1i32;
    b2FreeId(&world.contactIdPool, id);
    if (wakeBodies and (record.flags & 1u32) != 0u32) {
        b2WakeBody(world, record.edgeA.bodyId);
        b2WakeBody(world, record.edgeB.bodyId);
    }
}
# Box2D 8c661469, src/body.c:158-175. Capture next before destroying current edge.
fun b2DestroyBodyContacts(world: ref World, bodyId: i32, wakeBodies: bool) -> () = {
    var key: i32 = world.bodies.at(bodyId as i64).headContactKey;
    while (key != -1i32) {
        let id: i32 = key >> 1i32;
        key = contactEdge(world.contacts.at(id as i64), key & 1i32).nextKey;
        b2DestroyContact(world, id, wakeBodies);
    }
}
# Box2D 8c661469, src/shape.c:257-271. Only this shape, not every shape on its body.
fun b2DestroyShapeContacts(world: ref World, shapeId: i32) -> () = {
    let body: i32 = world.shapes.at(shapeId as i64).bodyId;
    var key: i32 = world.bodies.at(body as i64).headContactKey;
    while (key != -1i32) {
        let id: i32 = key >> 1i32;
        let record: ContactRecord = world.contacts.at(id as i64);
        key = contactEdge(world.contacts.at(id as i64), key & 1i32).nextKey;
        if (record.shapeIdA == shapeId or record.shapeIdB == shapeId) b2DestroyContact(world, id, true);
    }
}
# Box2D 8c661469, src/world.c:707-712. OPEN leaves both end arrays intact.
fun b2OpenContactCapture(world: ref World) -> () = {

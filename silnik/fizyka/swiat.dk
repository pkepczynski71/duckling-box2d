                manifold.point0.anchorB = b2Add(manifold.point0.anchorA, b2Sub(xfA.p, xfB.p));
                manifold.point0.point = b2Add(xfA.p, manifold.point0.anchorA);
                manifold.point0.separation = output.distance - radiusB;

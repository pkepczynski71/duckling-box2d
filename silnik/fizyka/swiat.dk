# Box2D 8c661469, src/world.c:1710-1738.
fun b2World_EnableSleeping(id: WorldId, flag: bool) -> () = {
    var world: ref World = worlds.at((id.index1 - 1u16) as i64);
    if (world.locked or world.enableSleep == flag) return;
    world.enableSleep = flag;
    if (not flag) {
        var i: i32 = 3i32;
        while (i < world.solverSetIdPool.nextIndex) {

fun b2CollideChainSegmentAndPolygon(segmentA: ref ChainSegment, xfA: Transform, polygonB: ref poly.Polygon, xfB: Transform, cache: ref distance.SimplexCache) -> Manifold = {
    var manifold = Manifold();
    let xf: Transform = b2InvMulTransforms(xfA, xfB);
    let centroidB: Vec2 = b2TransformPoint(xf, polygonB.centroid);
    let radiusB: f32 = polygonB.radius;
    let p1: Vec2 = segmentA.segment.point1;
    let p2: Vec2 = segmentA.segment.point2;

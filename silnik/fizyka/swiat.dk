    isSensor: bool = false;
    polygon: poly.Polygon = poly.Polygon();
    density: f32 = 1.0f32;
    friction: f32 = 0.6f32;
    restitution: f32 = 0.0f32;
    rollingResistance: f32 = 0.0f32;

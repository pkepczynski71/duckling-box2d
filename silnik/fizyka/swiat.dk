fun b2SensorQuery(world: ref World, sensorIndex: i32, treeType: i32) -> () = {
    let sensorSlot: i32 = world.sensors.at(sensorIndex as i64).shapeId;
    let sensorShape: ShapeRecord = world.shapes.at(sensorSlot as i64);
    let transform: Transform = b2GetBodySim(world,world.bodies.at(sensorShape.bodyId as i64)).transform;
    var hits: tree.TreeQueryResult = tree.b2DynamicTree_Query(&world.broadPhase.trees[treeType],sensorShape.aabb,sensorShape.filter.maskBits);
    var i: i64 = 0i64;
    while (i < hits.hits.length()) {
        let otherId: i32 = hits.hits.at(i).userData as i32;
        let other: ShapeRecord = world.shapes.at(otherId as i64);
        if (otherId != sensorSlot and other.enableSensorEvents and other.bodyId != sensorShape.bodyId
            and broad.b2ShouldShapesCollide(sensorShape.filter,other.filter)
            and b2InvokeWorldFilter12(b2MakeShapeId(world,sensorSlot),b2MakeShapeId(world,otherId),Key64())) {
            var input = distance.DistanceInput();
            input.proxyA = b2MakeShapeDistanceProxy(world.shapes.at(sensorSlot as i64));
            input.proxyB = b2MakeShapeDistanceProxy(world.shapes.at(otherId as i64));
            input.transformA = transform;
            input.transformB = b2GetBodySim(world,world.bodies.at(other.bodyId as i64)).transform;
            input.useRadii = true;
            var cache = distance.SimplexCache(); var trace = distance.SimplexTrace();
            let output: distance.DistanceOutput = distance.b2ShapeDistance(&input,&cache,&trace,0i32,false);
            world.sensorQueryTrace.push(SensorQueryTrace(sensorSlot,otherId,treeType,output.distance));
            if (output.distance < 10.0f32 * FLT_EPSILON) {
                world.sensors.at(sensorIndex as i64).overlaps2.push(ShapeRef(otherId,other.generation,other.birthTicket));
            }
        }
        i = i+1i64;
    }
}

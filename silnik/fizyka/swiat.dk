        let source: ContactSim = world.constraintGraph.colors[contactRecord.colorIndex].contactSims.at(contactRecord.localIndex as i64);
        let sleepLocal: i32 = b2GetSolverSet(world, setIndex).contactCount;
        b2GetSolverSet(world, setIndex).contactSims.push(source);
        b2GetSolverSet(world, setIndex).contactCount = sleepLocal + 1i32;
        b2RemoveContactFromGraph(world, contactRecord.edgeA.bodyId, contactRecord.edgeB.bodyId, contactRecord.colorIndex, contactRecord.localIndex);
        world.contacts.at(contact as i64).setIndex = setIndex;
        world.contacts.at(contact as i64).colorIndex = -1i32;
        world.contacts.at(contact as i64).localIndex = sleepLocal;
        contact = contactRecord.islandNext;
    }
                                                           
    var jointId: i32 = island.headJoint;
    while (jointId != -1i32) {
        let nextJoint: i32 = world.joints.at(jointId as i64).islandNext;
        b2TransferJoint(world, setIndex, jointId); jointId = nextJoint;
    }
    b2GetSolverSet(world, setIndex).islandSims.push(islandId);
    b2GetSolverSet(world, setIndex).islandCount = 1i32;
    let lastIsland: i32 = b2GetSolverSet(world, 2i32).islandCount - 1i32;
    if (island.localIndex != lastIsland) {
        let movedIsland: i32 = b2GetSolverSet(world, 2i32).islandSims.at(lastIsland as i64);
        b2GetSolverSet(world, 2i32).islandSims.at(island.localIndex as i64) = movedIsland;

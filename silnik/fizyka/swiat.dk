fun b2ResetProxy(world: ref World, slot: i32, wakeBodies: bool, destroyProxy: bool) -> () = {
    let bodyId: i32 = world.shapes.at(slot as i64).bodyId;
    var key: i32 = world.bodies.at(bodyId as i64).headContactKey;
    while (key != -1i32) {
        let contactId: i32 = key >> 1i32;
        let contact: ContactRecord = world.contacts.at(contactId as i64);
        key = contactEdge(world.contacts.at(contactId as i64), key & 1i32).nextKey;
        if (contact.shapeIdA == slot or contact.shapeIdB == slot) b2DestroyContact(world, contactId, wakeBodies);
    }
    let xf: Transform = b2GetBodySim(world, world.bodies.at(bodyId as i64)).transform;
    let proxyKey: i32 = world.shapes.at(slot as i64).proxyKey;
    if (proxyKey != -1i32) {
        let proxyType: i32 = broad.B2_PROXY_TYPE(proxyKey);
        b2UpdateShapeAABBs(world.shapes.at(slot as i64), xf, proxyType);
        if (destroyProxy) {
            b2DestroyShapeProxy(world, slot);
            let shape: ShapeRecord = world.shapes.at(slot as i64);
            let recreated: i32 = broad.b2BroadPhase_CreateProxy(&world.broadPhase, proxyType, shape.fatAABB, shape.filter.categoryBits, slot, true);
            world.shapes.at(slot as i64).proxyKey = recreated;
        } else broad.b2BroadPhase_MoveProxy(&world.broadPhase, proxyKey, world.shapes.at(slot as i64).fatAABB);
    } else b2UpdateShapeAABBs(world.shapes.at(slot as i64), xf, world.bodies.at(bodyId as i64).bodyType);
}

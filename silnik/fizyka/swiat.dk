# Box2D 8c661469, src/shape.           
fun b2CreateChain(bodyId: BodyId, def: ref ChainDef) -> ChainId = {
    var world: ref World = worlds.at(bodyId.world0 as i64);
    if (world.locked) return ChainId();
    let bodySlot: i32 = bodyId.index1 - 1i32;
    let chainSlot: i32 = b2AllocId(&world.chainIdPool);
    if (chainSlot as i64 == world.chainShapes.length()) world.chainShapes.push(ChainShape());
    let generation: u16 = world.chainShapes.at(chainSlot as i64).generation + 1u16;
    var chain = ChainShape(); chain.id = chainSlot; chain.bodyId = bodySlot;
    chain.nextChainId = world.bodies.at(bodySlot as i64).headChainId; chain.generation = generation;
    chain.materialCount = def.materialCount;
    var mi: i32 = 0i32;
    while (mi < def.materialCount) { chain.materials.push(def.materials.at(mi as i64)); mi = mi + 1i32; }
    let n: i32 = def.count;
    chain.count = if def.isLoop then n else n - 3i32;
    world.chainShapes.at(chainSlot as i64) = move chain;
    world.bodies.at(bodySlot as i64).headChainId = chainSlot;
    var source = ShapeRecord(); source.shapeType = 4i32; source.filter = def.filter;
    source.hasObjectId = def.hasObjectId; source.objectId = def.objectId; source.enableSensorEvents = def.enableSensorEvents;
    if (def.isLoop) {
        var previous: i32 = n - 1i32; var i: i32 = 0i32;
        while (i < n - 2i32) {
            source.chainSegment = ChainSegment(def.points.at(previous as i64), Segment(def.points.at(i as i64), def.points.at((i+1i32) as i64)), def.points.at((i+2i32) as i64), chainSlot);
            previous = i;
            let materialIndex: i32 = if def.materialCount == 1i32 then 0i32 else i;
            b2SetShapeRecordMaterial(&source, def.materials.at(materialIndex as i64));
            let child: broad.ShapeId = b2CreateShapeInternal(bodyId, source, true);
            world.chainShapes.at(chainSlot as i64).shapeIndices.push(child.index1 - 1i32);
            i = i + 1i32;
        }
        source.chainSegment = ChainSegment(def.points.at((n-3i32) as i64), Segment(def.points.at((n-2i32) as i64), def.points.at((n-1i32) as i64)), def.points.at(0i64), chainSlot);
        let lastMaterial1: i32 = if def.materialCount == 1i32 then 0i32 else n-2i32;
        b2SetShapeRecordMaterial(&source, def.materials.at(lastMaterial1 as i64));
        let lastChild1: broad.ShapeId = b2CreateShapeInternal(bodyId, source, true);
        world.chainShapes.at(chainSlot as i64).shapeIndices.push(lastChild1.index1-1i32);
        source.chainSegment = ChainSegment(def.points.at((n-2i32) as i64), Segment(def.points.at((n-1i32) as i64), def.points.at(0i64)), def.points.at(1i64), chainSlot);
        let lastMaterial2: i32 = if def.materialCount == 1i32 then 0i32 else n-1i32;
        b2SetShapeRecordMaterial(&source, def.materials.at(lastMaterial2 as i64));
        let lastChild2: broad.ShapeId = b2CreateShapeInternal(bodyId, source, true);
        world.chainShapes.at(chainSlot as i64).shapeIndices.push(lastChild2.index1-1i32);
    } else {
        var j: i32 = 0i32;
        while (j < n - 3i32) {
            source.chainSegment = ChainSegment(def.points.at(j as i64), Segment(def.points.at((j+1i32) as i64), def.points.at((j+2i32) as i64)), def.points.at((j+3i32) as i64), chainSlot);
            let openMaterial: i32 = if def.materialCount == 1i32 then 0i32 else j+1i32;
            b2SetShapeRecordMaterial(&source, def.materials.at(openMaterial as i64));
            let openChild: broad.ShapeId = b2CreateShapeInternal(bodyId, source, true);
            world.chainShapes.at(chainSlot as i64).shapeIndices.push(openChild.index1-1i32);
            j = j + 1i32;
        }
    }
    return b2MakeChainId(world, chainSlot);
}

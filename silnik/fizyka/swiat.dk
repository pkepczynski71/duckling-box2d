# Box2D 8c661469, src/solver.h:140-181.
fun b2MakeSoft(hertz: f32, zeta: f32, h: f32) -> Softness = {
    if (hertz == 0.0f32) return Softness();
    let omega: f32 = 2.0f32 * mass2.B2_PI * hertz;
    let a1: f32 = 2.0f32 * zeta + h * omega;
    let a2: f32 = h * omega * a1;
    let a3: f32 = 1.0f32 / (1.0f32 + a2);
    return Softness(omega / a1, a2 * a3, a3);
}


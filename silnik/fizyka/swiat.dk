fun b2UnpackContactPacket(packet: ref ContactPacket) -> () = {
    var lane: i32 = 0i32;
    while (lane < 4i32) {
        var c: ref ContactConstraint = packetLane(packet, lane);
        c.rollingImpulse = wmath.laneValue(packet.numerical.rollingImpulse, lane);
        c.point0.normalImpulse = wmath.laneValue(packet.numerical.normalImpulse1, lane);
        c.point0.totalNormalImpulse = wmath.laneValue(packet.numerical.totalNormalImpulse1, lane);
        c.point0.tangentImpulse = wmath.laneValue(packet.numerical.tangentImpulse1, lane);
        c.point1.normalImpulse = wmath.laneValue(packet.numerical.normalImpulse2, lane);
        c.point1.totalNormalImpulse = wmath.laneValue(packet.numerical.totalNormalImpulse2, lane);
        c.point1.tangentImpulse = wmath.laneValue(packet.numerical.tangentImpulse2, lane);
        lane = lane + 1i32;
    }
}

fun b2PushSensorEnd(world: ref World, event: SensorEvent) -> () = {
    if (world.endEventArrayIndex == 0i32) world.sensorEndEvents0.push(event);
    else world.sensorEndEvents1.push(event);
}
# Box2D 8c661469, src/sensor.                                                                   
fun b2OverlapSensors(world: ref World) -> () = {
    let count: i32 = world.sensors.length() as i32;
    if (count == 0i32) return;
    bits.b2SetBitCountAndClear(&world.sensorEventBits,count);
    var si: i32 = 0i32;
    while (si < count) {
                                                                                      
        b2SwapSensorOverlaps(world.sensors.at(si as i64));
        world.sensors.at(si as i64).overlaps2.clear();
        let shapeId: i32 = world.sensors.at(si as i64).shapeId;
        let shape: ShapeRecord = world.shapes.at(shapeId as i64);
        let enabled: bool = world.bodies.at(shape.bodyId as i64).setIndex != 1i32 and shape.enableSensorEvents;
        if (enabled) {
            b2SensorQuery(world,si,0i32); b2SensorQuery(world,si,1i32); b2SensorQuery(world,si,2i32);
            b2SortShapeRefs(&world.sensors.at(si as i64).overlaps2);
        }
        var sensor: ref Sensor = world.sensors.at(si as i64);
        var changed: bool = sensor.overlaps1.length() != sensor.overlaps2.length();
        var ri: i64 = 0i64;
        while (not changed and ri < sensor.overlaps1.length()) {
            changed = b2CompareShapeRefs(sensor.overlaps1.at(ri),sensor.overlaps2.at(ri)) != 0i32;
            ri = ri+1i64;
        }
        if (changed) bits.b2SetBit(&world.sensorEventBits,si);
        si = si+1i32;
    }
    si = 0i32;
    while (si < count) {
        if (bits.b2GetBit(&world.sensorEventBits,si)) {
            var publishing: ref Sensor = world.sensors.at(si as i64);
            var i1: i64 = 0i64; var i2: i64 = 0i64;
            while (i1 < publishing.overlaps1.length() and i2 < publishing.overlaps2.length()) {
                let r1: ShapeRef = publishing.overlaps1.at(i1); let r2: ShapeRef = publishing.overlaps2.at(i2);
                let order: i32 = b2CompareShapeRefs(r1,r2);
                if (order < 0i32) { b2PushSensorEnd(world,b2MakeSensorEvent(world,publishing.shapeId,r1)); i1 = i1+1i64; }
                else if (order > 0i32) { world.sensorBeginEvents.push(b2MakeSensorEvent(world,publishing.shapeId,r2)); i2 = i2+1i64; }
                else { i1 = i1+1i64; i2 = i2+1i64; }
            }
            while (i1 < publishing.overlaps1.length()) {
                b2PushSensorEnd(world,b2MakeSensorEvent(world,publishing.shapeId,publishing.overlaps1.at(i1))); i1 = i1+1i64;
            }
            while (i2 < publishing.overlaps2.length()) {
                world.sensorBeginEvents.push(b2MakeSensorEvent(world,publishing.shapeId,publishing.overlaps2.at(i2))); i2 = i2+1i64;
            }
        }
        si = si+1i32;
    }
}
# Box2D 8c661469, src/sensor.                                                                       
fun b2DestroySensor(world: ref World, shapeSlot: i32) -> () = {
    let index: i64 = world.shapes.at(shapeSlot as i64).sensorIndex as i64;
    var i: i64 = 0i64;
    while (i < world.sensors.at(index).overlaps2.length()) {
        b2PushSensorEnd(world,b2MakeSensorEvent(world,shapeSlot,world.sensors.at(index).overlaps2.at(i))); i = i+1i64;
    }
                                                                                     
    var last: Sensor = world.sensors.pop();
    if (index < world.sensors.length()) {
        let movedId: i32 = last.shapeId;
        world.sensors.at(index) = move last;
        world.shapes.at(movedId as i64).sensorIndex = index as i32;
    }
}

# Box2D 8c661469, src/body.c:38,46,70,77. Aggregates the public getters above.
fun b2Body_GetView(id: BodyId) -> BodyView = {
    var world: ref World = worlds.at(id.world0 as i64);
    let body: BodyRecord = world.bodies.at((id.index1 - 1i32) as i64);
    var set: ref SolverSet = b2GetSolverSet(world, body.setIndex);
    let sim: BodySim = set.bodySims.at(body.localIndex as i64);
    var view = BodyView();
    view.bodyType = body.bodyType;
    view.transform = sim.transform;
    view.center = sim.center;
    view.localCenter = sim.localCenter;
    view.mass = body.mass;
    view.inertia = body.inertia;
    view.isAwake = body.setIndex == 2i32;
    view.isEnabled = body.setIndex != 1i32;
    view.fixedRotation = body.fixedRotation;
    view.shapeCount = body.shapeCount;
    view.hasObjectId = body.hasObjectId;
    view.objectId = body.objectId; view.name = b2Body_GetName(id);
    if (view.isAwake) {
        let state: BodyState = set.bodyStates.at(body.localIndex as i64);
        view.linearVelocity = state.linearVelocity;
        view.angularVelocity = state.angularVelocity;
    }
    return view;
}


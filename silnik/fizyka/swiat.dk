fun b2UnlinkJoint(world: ref World, id: i32) -> () = {
    let joint: JointRecord = world.joints.at(id as i64);
    if (joint.islandId == -1i32) return;
    var island: ref Island = world.islands.at(joint.islandId as i64);
    if (joint.islandPrev != -1i32) world.joints.at(joint.islandPrev as i64).islandNext = joint.islandNext;
    if (joint.islandNext != -1i32) world.joints.at(joint.islandNext as i64).islandPrev = joint.islandPrev;
    if (island.headJoint == id) island.headJoint = joint.islandNext;
    if (island.tailJoint == id) island.tailJoint = joint.islandPrev;
    island.jointCount = island.jointCount - 1i32; island.constraintRemoveCount = island.constraintRemoveCount + 1i32;
    world.joints.at(id as i64).islandId = -1i32; world.joints.at(id as i64).islandPrev = -1i32; world.joints.at(id as i64).islandNext = -1i32;
}
                                                       
fun b2MergeSolverSets(world: ref World, inputA: i32, inputB: i32) -> () = {
    var a: i32 = inputA; var b: i32 = inputB;
    if (b2GetSolverSet(world, a).bodyCount < b2GetSolverSet(world, b).bodyCount) { a = inputB; b = inputA; }
    var i: i32 = 0i32;
    while (i < b2GetSolverSet(world, b).bodyCount) {
        let sim: BodySim = b2GetSolverSet(world, b).bodySims.at(i as i64);
        let local: i32 = b2GetSolverSet(world, a).bodyCount;
        if (local as i64 == b2GetSolverSet(world, a).bodySims.length()) b2GetSolverSet(world, a).bodySims.push(sim);
        else b2GetSolverSet(world, a).bodySims.at(local as i64) = sim;
        b2GetSolverSet(world, a).bodyCount = local + 1i32;
        world.bodies.at(sim.bodyId as i64).setIndex = a; world.bodies.at(sim.bodyId as i64).localIndex = local; i = i + 1i32;
    }
    i = 0i32;
    while (i < b2GetSolverSet(world, b).contactCount) {
        let sim: ContactSim = b2GetSolverSet(world, b).contactSims.at(i as i64);
        let local: i32 = b2GetSolverSet(world, a).contactCount;
        if (local as i64 == b2GetSolverSet(world, a).contactSims.length()) b2GetSolverSet(world, a).contactSims.push(sim);
        else b2GetSolverSet(world, a).contactSims.at(local as i64) = sim;
        b2GetSolverSet(world, a).contactCount = local + 1i32;
        world.contacts.at(sim.contactId as i64).setIndex = a; world.contacts.at(sim.contactId as i64).localIndex = local; i = i + 1i32;
    }
    i = 0i32;
    while (i < b2GetSolverSet(world, b).jointCount) {
        let sim: JointSim = b2GetSolverSet(world, b).jointSims.at(i as i64);
        b2AppendJointToSet(world, a, sim.jointId, sim); i = i + 1i32;
    }
    i = 0i32;
    while (i < b2GetSolverSet(world, b).islandCount) {
        let id: i32 = b2GetSolverSet(world, b).islandSims.at(i as i64);
        let local: i32 = b2GetSolverSet(world, a).islandCount;
        if (local as i64 == b2GetSolverSet(world, a).islandSims.length()) b2GetSolverSet(world, a).islandSims.push(id);
        else b2GetSolverSet(world, a).islandSims.at(local as i64) = id;
        b2GetSolverSet(world, a).islandCount = local + 1i32;
        world.islands.at(id as i64).setIndex = a; world.islands.at(id as i64).localIndex = local; i = i + 1i32;
    }
    b2DestroySolverSet(world, b);
}
                                                  
fun b2CreateJoint(world: ref World, a: i32, b: i32, def: DistanceJointDef, jointType: i32 = 0i32, drawSize: f32 = 1.0f32) -> i32 = {
    let id: i32 = b2AllocId(&world.jointIdPool);
    if (id as i64 == world.joints.length()) world.joints.push(JointRecord());
    let generation: u16 = world.joints.at(id as i64).generation + 1u16;
    var joint = JointRecord(); joint.jointId = id; joint.generation = generation;
    joint.jointType = jointType; joint.drawSize = drawSize; joint.collideConnected = def.collideConnected;
    joint.hasObjectId = def.hasObjectId; joint.objectId = def.objectId;
    joint.edgeA = JointEdge(a, -1i32, world.bodies.at(a as i64).headJointKey);
    joint.edgeB = JointEdge(b, -1i32, world.bodies.at(b as i64).headJointKey);
    world.joints.at(id as i64) = joint;
    if (joint.edgeA.nextKey != -1i32) jointEdge(world.joints.at((joint.edgeA.nextKey >> 1i32) as i64), joint.edgeA.nextKey & 1i32).prevKey = id << 1i32;
    world.bodies.at(a as i64).headJointKey = id << 1i32; world.bodies.at(a as i64).jointCount = world.bodies.at(a as i64).jointCount + 1i32;
    if (joint.edgeB.nextKey != -1i32) jointEdge(world.joints.at((joint.edgeB.nextKey >> 1i32) as i64), joint.edgeB.nextKey & 1i32).prevKey = (id << 1i32) | 1i32;
    world.bodies.at(b as i64).headJointKey = (id << 1i32) | 1i32; world.bodies.at(b as i64).jointCount = world.bodies.at(b as i64).jointCount + 1i32;
    let setA: i32 = world.bodies.at(a as i64).setIndex; let setB: i32 = world.bodies.at(b as i64).setIndex;
    let maxSet: i32 = if setA > setB then setA else setB;
    var sim = JointSim(); sim.jointId = id; sim.bodyIdA = a; sim.bodyIdB = b; sim.jointType = jointType;
    if (setA == 1i32 or setB == 1i32) b2AppendJointToSet(world, 1i32, id, sim);
    else if (setA == 0i32 and setB == 0i32) b2AppendJointToSet(world, 0i32, id, sim);
    else if (setA == 2i32 or setB == 2i32) {
        if (maxSet >= 3i32) b2WakeSolverSet(world, maxSet);
        world.joints.at(id as i64).setIndex = 2i32; b2AddJointToGraph(world, id, sim);
    } else {
        b2AppendJointToSet(world, maxSet, id, sim);
        if (setA != setB and setA >= 3i32 and setB >= 3i32) b2MergeSolverSets(world, setA, setB);
    }
    b2GetJointSim(world, id).constraintHertz = 60.0f32; b2GetJointSim(world, id).constraintDampingRatio = 2.0f32;
    b2GetJointSim(world, id).constraintSoftness = Softness(0.0f32, 1.0f32, 0.0f32);
    if (world.joints.at(id as i64).setIndex > 1i32) b2LinkJoint(world, id, true);
    return id;
}
                                                  
fun b2DestroyContactsBetweenBodies(world: ref World, a: i32, b: i32) -> () = {
    let useA: bool = world.bodies.at(a as i64).contactCount < world.bodies.at(b as i64).contactCount;
    var key: i32 = if useA then world.bodies.at(a as i64).headContactKey else world.bodies.at(b as i64).headContactKey;
    let other: i32 = if useA then b else a;
    while (key != -1i32) {
        let id: i32 = key >> 1i32; let side: i32 = key & 1i32;
        key = contactEdge(world.contacts.at(id as i64), side).nextKey;
        if (contactEdge(world.contacts.at(id as i64), side ^ 1i32).bodyId == other) b2DestroyContact(world, id, false);
    }
}
fun b2CreateDistanceJoint(worldId: WorldId, def: DistanceJointDef) -> JointId = {
    var world: ref World = worlds.at((worldId.index1 - 1u16) as i64);
    if (world.locked) return JointId();
    let a: i32 = def.bodyIdA.index1 - 1i32; let b: i32 = def.bodyIdB.index1 - 1i32;
    let id: i32 = b2CreateJoint(world, a, b, def);
    var sim: ref JointSim = b2GetJointSim(world, id);
    sim.localOriginAnchorA = def.localAnchorA; sim.localOriginAnchorB = def.localAnchorB;
    sim.distanceJoint = DistanceJoint();
    sim.distanceJoint.length = tree.b2MaxFloat(def.length, 0.005f32);
    sim.distanceJoint.hertz = def.hertz; sim.distanceJoint.dampingRatio = def.dampingRatio;
    sim.distanceJoint.minLength = tree.b2MaxFloat(def.minLength, 0.005f32);
    sim.distanceJoint.maxLength = tree.b2MaxFloat(def.minLength, def.maxLength);
    sim.distanceJoint.maxMotorForce = def.maxMotorForce; sim.distanceJoint.motorSpeed = def.motorSpeed;
    sim.distanceJoint.enableSpring = def.enableSpring; sim.distanceJoint.enableLimit = def.enableLimit; sim.distanceJoint.enableMotor = def.enableMotor;
    if (not def.collideConnected) b2DestroyContactsBetweenBodies(world, a, b);
    return JointId(id + 1i32, world.worldId, world.joints.at(id as i64).generation);
}
                                                  
fun b2DestroyJointInternal(world: ref World, id: i32, wakeBodies: bool) -> () = {
    let joint: JointRecord = world.joints.at(id as i64);
    var side: i32 = 0i32;
    while (side < 2i32) {
        let edge: JointEdge = jointEdge(world.joints.at(id as i64), side);
        if (edge.prevKey != -1i32) jointEdge(world.joints.at((edge.prevKey >> 1i32) as i64), edge.prevKey & 1i32).nextKey = edge.nextKey;
        if (edge.nextKey != -1i32) jointEdge(world.joints.at((edge.nextKey >> 1i32) as i64), edge.nextKey & 1i32).prevKey = edge.prevKey;
        if (world.bodies.at(edge.bodyId as i64).headJointKey == ((id << 1i32) | side)) world.bodies.at(edge.bodyId as i64).headJointKey = edge.nextKey;
        world.bodies.at(edge.bodyId as i64).jointCount = world.bodies.at(edge.bodyId as i64).jointCount - 1i32; side = side + 1i32;
    }
    if (joint.islandId != -1i32) b2UnlinkJoint(world, id);
    if (joint.setIndex == 2i32) b2RemoveJointFromGraph(world, joint.edgeA.bodyId, joint.edgeB.bodyId, joint.colorIndex, joint.localIndex);
    else b2RemoveJointFromSet(world, joint.setIndex, joint.localIndex);
    world.joints.at(id as i64).setIndex = -1i32; world.joints.at(id as i64).localIndex = -1i32;
    world.joints.at(id as i64).colorIndex = -1i32; world.joints.at(id as i64).jointId = -1i32;
    b2FreeId(&world.jointIdPool, id);
    if (wakeBodies) { b2WakeBody(world, joint.edgeA.bodyId); b2WakeBody(world, joint.edgeB.bodyId); }
}
fun b2DestroyJoint(id: JointId) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    if (not world.locked) b2DestroyJointInternal(world, id.index1 - 1i32, true);
}
                                                                                
fun b2Joint_IsValid(id: JointId) -> bool = {
    if (id.world0 >= 128u16) return false;
    var world: ref World = worlds.at(id.world0 as i64);
    if (not world.inUse or id.index1 < 1i32 or id.index1 > world.jointIdPool.nextIndex) return false;
    let joint: JointRecord = world.joints.at((id.index1 - 1i32) as i64);
    return joint.jointId != -1i32 and joint.generation == id.generation;
}
                                                           
fun b2Joint_GetWorld(id: JointId) -> WorldId = { return WorldId(id.world0 + 1u16, worlds.at(id.world0 as i64).generation); }
fun b2Joint_GetBodyA(id: JointId) -> BodyId = {
    var world: ref World = worlds.at(id.world0 as i64); let a: i32 = b2GetJointFullId(world, id).edgeA.bodyId;
    return BodyId(a + 1i32, id.world0, world.bodies.at(a as i64).generation);
}
fun b2Joint_GetBodyB(id: JointId) -> BodyId = {
    var world: ref World = worlds.at(id.world0 as i64); let b: i32 = b2GetJointFullId(world, id).edgeB.bodyId;
    return BodyId(b + 1i32, id.world0, world.bodies.at(b as i64).generation);
}
fun b2Joint_SetCollideConnected(id: JointId, flag: bool) -> () = {
    var world: ref World = worlds.at(id.world0 as i64); if (world.locked) return;
    let joint: JointRecord = b2GetJointFullId(world, id); if (joint.collideConnected == flag) return;
    b2GetJointFullId(world, id).collideConnected = flag;
    if (flag) {
        let a: BodyRecord = world.bodies.at(joint.edgeA.bodyId as i64); let b: BodyRecord = world.bodies.at(joint.edgeB.bodyId as i64);
        var shapeId: i32 = if a.shapeCount < b.shapeCount then a.headShapeId else b.headShapeId;
        while (shapeId != -1i32) {
            let shape: ShapeRecord = world.shapes.at(shapeId as i64);
            if (shape.proxyKey != -1i32) broad.b2BufferMove(&world.broadPhase, shape.proxyKey);
            shapeId = shape.nextShapeId;
        }
    } else b2DestroyContactsBetweenBodies(world, joint.edgeA.bodyId, joint.edgeB.bodyId);
}
fun b2Joint_WakeBodies(id: JointId) -> () = {
    var world: ref World = worlds.at(id.world0 as i64); if (world.locked) return;
    let joint: JointRecord = b2GetJointFullId(world, id); b2WakeBody(world, joint.edgeA.bodyId); b2WakeBody(world, joint.edgeB.bodyId);
}

                                                           
fun b2PrepareDistanceJoint(world: ref World, base: ref JointSim, context: ref SolverContext) -> () = {
    let a: BodyRecord = world.bodies.at(base.bodyIdA as i64);
    let b: BodyRecord = world.bodies.at(base.bodyIdB as i64);
    let simA: BodySim = b2GetSolverSet(world, a.setIndex).bodySims.at(a.localIndex as i64);
    let simB: BodySim = b2GetSolverSet(world, b.setIndex).bodySims.at(b.localIndex as i64);
    let mA: f32 = simA.invMass; let iA: f32 = simA.invInertia;
    let mB: f32 = simB.invMass; let iB: f32 = simB.invInertia;
    base.invMassA = mA; base.invMassB = mB; base.invIA = iA; base.invIB = iB;
    var joint: ref DistanceJoint = &base.distanceJoint;
    joint.indexA = if a.setIndex == 2i32 then a.localIndex else -1i32;
    joint.indexB = if b.setIndex == 2i32 then b.localIndex else -1i32;
    joint.anchorA = b2RotateVector(simA.transform.q, b2Sub(base.localOriginAnchorA, simA.localCenter));
    joint.anchorB = b2RotateVector(simB.transform.q, b2Sub(base.localOriginAnchorB, simB.localCenter));
    joint.deltaCenter = b2Sub(simB.center, simA.center);
    let rA: Vec2 = joint.anchorA; let rB: Vec2 = joint.anchorB;
    let separation: Vec2 = b2Add(b2Sub(rB, rA), joint.deltaCenter);
    let axis: Vec2 = mass2.b2Normalize(separation);
    let crA: f32 = mass2.b2Cross(rA, axis); let crB: f32 = mass2.b2Cross(rB, axis);
    let k: f32 = mA + mB + iA * crA * crA + iB * crB * crB;
    joint.axialMass = if k > 0.0f32 then 1.0f32 / k else 0.0f32;
    joint.distanceSoftness = b2MakeSoft(joint.hertz, joint.dampingRatio, context.h);
    if (not context.enableWarmStarting) { joint.impulse = 0.0f32; joint.lowerImpulse = 0.0f32; joint.upperImpulse = 0.0f32; joint.motorImpulse = 0.0f32; }
}

                                                           
fun b2WarmStartDistanceJoint(world: ref World, base: ref JointSim, context: ref SolverContext) -> () = {
    var joint: ref DistanceJoint = &base.distanceJoint;
    let mA: f32 = base.invMassA; let mB: f32 = base.invMassB; let iA: f32 = base.invIA; let iB: f32 = base.invIB;
    var stateA = BodyState(); var stateB = BodyState();
    if (joint.indexA != -1i32) stateA = b2GetSolverSet(world, 2i32).bodyStates.at(joint.indexA as i64);
    if (joint.indexB != -1i32) stateB = b2GetSolverSet(world, 2i32).bodyStates.at(joint.indexB as i64);
var rA: Vec2 = b2RotateVector( stateA.deltaRotation, joint.anchorA );
	var rB: Vec2 = b2RotateVector( stateB.deltaRotation, joint.anchorB );

	var ds: Vec2 = b2Add( b2Sub( stateB.deltaPosition, stateA.deltaPosition ), b2Sub( rB, rA ) );
	var separation: Vec2 = b2Add( joint.deltaCenter, ds );
	var axis: Vec2 = mass2.b2Normalize( separation );

	var axialImpulse: f32 = joint.impulse + joint.lowerImpulse - joint.upperImpulse + joint.motorImpulse;
	var P: Vec2 = mass2.b2MulSV( axialImpulse, axis );

	stateA.linearVelocity = distance.b2MulSub( stateA.linearVelocity, mA, P );
	stateA.angularVelocity = stateA.angularVelocity - iA * mass2.b2Cross( rA, P );
	stateB.linearVelocity = b2MulAdd( stateB.linearVelocity, mB, P );
	stateB.angularVelocity = stateB.angularVelocity + iB * mass2.b2Cross( rB, P );

    if (joint.indexA != -1i32) b2GetSolverSet(world, 2i32).bodyStates.at(joint.indexA as i64) = stateA;
    if (joint.indexB != -1i32) b2GetSolverSet(world, 2i32).bodyStates.at(joint.indexB as i64) = stateB;
}

                                                           
fun b2SolveDistanceJoint(world: ref World, base: ref JointSim, context: ref SolverContext, useBias: bool) -> () = {
    var joint: ref DistanceJoint = &base.distanceJoint;
    let mA: f32 = base.invMassA; let mB: f32 = base.invMassB; let iA: f32 = base.invIA; let iB: f32 = base.invIB;
    var stateA = BodyState(); var stateB = BodyState();
    if (joint.indexA != -1i32) stateA = b2GetSolverSet(world, 2i32).bodyStates.at(joint.indexA as i64);
    if (joint.indexB != -1i32) stateB = b2GetSolverSet(world, 2i32).bodyStates.at(joint.indexB as i64);
var vA: Vec2 = stateA.linearVelocity;
	var wA: f32 = stateA.angularVelocity;
	var vB: Vec2 = stateB.linearVelocity;
	var wB: f32 = stateB.angularVelocity;


	var rA: Vec2 = b2RotateVector( stateA.deltaRotation, joint.anchorA );
	var rB: Vec2 = b2RotateVector( stateB.deltaRotation, joint.anchorB );


	var ds: Vec2 = b2Add( b2Sub( stateB.deltaPosition, stateA.deltaPosition ), b2Sub( rB, rA ) );
	var separation: Vec2 = b2Add( joint.deltaCenter, ds );

	var length: f32 = mass2.b2Length( separation );
	var axis: Vec2 = mass2.b2Normalize( separation );




	if ( joint.enableSpring and ( joint.minLength < joint.maxLength or joint.enableLimit == false ) )
	{

		if ( joint.hertz > 0.0f32 )
		{

			var vr: Vec2 = b2Add( b2Sub( vB, vA ), b2Sub( poly.b2CrossSV( wB, rB ), poly.b2CrossSV( wA, rA ) ) );
			var Cdot: f32 = poly.b2Dot( axis, vr );
			var C: f32 = length - joint.length;
			var bias: f32 = joint.distanceSoftness.biasRate * C;

			var m: f32 = joint.distanceSoftness.massScale * joint.axialMass;
			var impulse: f32 = -m * ( Cdot + bias ) - joint.distanceSoftness.impulseScale * joint.impulse;
			joint.impulse = joint.impulse + impulse;

			var P: Vec2 = mass2.b2MulSV( impulse, axis );
			vA = distance.b2MulSub( vA, mA, P );
			wA = wA - iA * mass2.b2Cross( rA, P );
			vB = b2MulAdd( vB, mB, P );
			wB = wB + iB * mass2.b2Cross( rB, P );
		}

		if ( joint.enableLimit )
		{

			{
				var vr: Vec2 = b2Add( b2Sub( vB, vA ), b2Sub( poly.b2CrossSV( wB, rB ), poly.b2CrossSV( wA, rA ) ) );
				var Cdot: f32 = poly.b2Dot( axis, vr );

				var C: f32 = length - joint.minLength;

				var bias: f32 = 0.0f32;
				var massCoeff: f32 = 1.0f32;
				var impulseCoeff: f32 = 0.0f32;
				if ( C > 0.0f32 )
				{

					bias = C * context.inv_h;
				}
				else if ( useBias )
				{
					bias = base.constraintSoftness.biasRate * C;
					massCoeff = base.constraintSoftness.massScale;
					impulseCoeff = base.constraintSoftness.impulseScale;
				}

				var impulse: f32 = -massCoeff * joint.axialMass * ( Cdot + bias ) - impulseCoeff * joint.lowerImpulse;
				var newImpulse: f32 = tree.b2MaxFloat( 0.0f32, joint.lowerImpulse + impulse );
				impulse = newImpulse - joint.lowerImpulse;
				joint.lowerImpulse = newImpulse;

				var P: Vec2 = mass2.b2MulSV( impulse, axis );
				vA = distance.b2MulSub( vA, mA, P );
				wA = wA - iA * mass2.b2Cross( rA, P );
				vB = b2MulAdd( vB, mB, P );
				wB = wB + iB * mass2.b2Cross( rB, P );
			};


			{
				var vr: Vec2 = b2Add( b2Sub( vA, vB ), b2Sub( poly.b2CrossSV( wA, rA ), poly.b2CrossSV( wB, rB ) ) );
				var Cdot: f32 = poly.b2Dot( axis, vr );

				var C: f32 = joint.maxLength - length;

				var bias: f32 = 0.0f32;
				var massScale: f32 = 1.0f32;
				var impulseScale: f32 = 0.0f32;
				if ( C > 0.0f32 )
				{

					bias = C * context.inv_h;
				}
				else if ( useBias )
				{
					bias = base.constraintSoftness.biasRate * C;
					massScale = base.constraintSoftness.massScale;
					impulseScale = base.constraintSoftness.impulseScale;
				}

				var impulse: f32 = -massScale * joint.axialMass * ( Cdot + bias ) - impulseScale * joint.upperImpulse;
				var newImpulse: f32 = tree.b2MaxFloat( 0.0f32, joint.upperImpulse + impulse );
				impulse = newImpulse - joint.upperImpulse;
				joint.upperImpulse = newImpulse;

				var P: Vec2 = mass2.b2MulSV( -impulse, axis );
				vA = distance.b2MulSub( vA, mA, P );
				wA = wA - iA * mass2.b2Cross( rA, P );
				vB = b2MulAdd( vB, mB, P );
				wB = wB + iB * mass2.b2Cross( rB, P );
			};
		}

		if ( joint.enableMotor )
		{
			var vr: Vec2 = b2Add( b2Sub( vB, vA ), b2Sub( poly.b2CrossSV( wB, rB ), poly.b2CrossSV( wA, rA ) ) );
			var Cdot: f32 = poly.b2Dot( axis, vr );
			var impulse: f32 = joint.axialMass * ( joint.motorSpeed - Cdot );
			var oldImpulse: f32 = joint.motorImpulse;
			var maxImpulse: f32 = context.h * joint.maxMotorForce;
			joint.motorImpulse = poly.b2ClampFloat( joint.motorImpulse + impulse, -maxImpulse, maxImpulse );
			impulse = joint.motorImpulse - oldImpulse;

			var P: Vec2 = mass2.b2MulSV( impulse, axis );
			vA = distance.b2MulSub( vA, mA, P );
			wA = wA - iA * mass2.b2Cross( rA, P );
			vB = b2MulAdd( vB, mB, P );
			wB = wB + iB * mass2.b2Cross( rB, P );
		}
	}
	else
	{

		var vr: Vec2 = b2Add( b2Sub( vB, vA ), b2Sub( poly.b2CrossSV( wB, rB ), poly.b2CrossSV( wA, rA ) ) );
		var Cdot: f32 = poly.b2Dot( axis, vr );

		var C: f32 = length - joint.length;

		var bias: f32 = 0.0f32;
		var massScale: f32 = 1.0f32;
		var impulseScale: f32 = 0.0f32;
		if ( useBias )
		{
			bias = base.constraintSoftness.biasRate * C;
			massScale = base.constraintSoftness.massScale;
			impulseScale = base.constraintSoftness.impulseScale;
		}

		var impulse: f32 = -massScale * joint.axialMass * ( Cdot + bias ) - impulseScale * joint.impulse;
		joint.impulse = joint.impulse + impulse;

		var P: Vec2 = mass2.b2MulSV( impulse, axis );
		vA = distance.b2MulSub( vA, mA, P );
		wA = wA - iA * mass2.b2Cross( rA, P );
		vB = b2MulAdd( vB, mB, P );
		wB = wB + iB * mass2.b2Cross( rB, P );
	}

	stateA.linearVelocity = vA;
	stateA.angularVelocity = wA;
	stateB.linearVelocity = vB;
	stateB.angularVelocity = wB;
    if (joint.indexA != -1i32) b2GetSolverSet(world, 2i32).bodyStates.at(joint.indexA as i64) = stateA;
    if (joint.indexB != -1i32) b2GetSolverSet(world, 2i32).bodyStates.at(joint.indexB as i64) = stateB;
}

                                                                             
class JointCall14 {
    sub: i32 = 0i32; phase: i32 = 0i32; color: i32 = -1i32; ordinal: i32 = 0i32;
    jointId: i32 = -1i32; setIndex: i32 = -1i32; localIndex: i32 = -1i32;
}
fun emptyJointCalls14() -> List[JointCall14] = { var values: List[JointCall14]; return values; }
fun b2JointPhase14(world: ref World, context: ref SolverContext, phase: i32, color: i32, start: i64, end: i64) -> () = {
    var i: i64 = start;
    while (i < end) {
        var id: i32 = -1i32;
        if (color == -1i32) id = context.jointIds.at(i);
        else id = world.constraintGraph.colors[color].jointSims.at(i).jointId;
        let record: JointRecord = world.joints.at(id as i64);
        var callPhase: i32 = 3i32;
        if (phase == 0i32) callPhase = 0i32;
        else if (phase == 2i32) callPhase = 1i32;
        else if (phase == 3i32) callPhase = 2i32;
        world.jointCalls14.push(JointCall14(context.subStepIndex, callPhase, color, i as i32, id, record.setIndex, record.localIndex));
        var sim: ref JointSim = b2GetJointSim(world, id);
        if (phase == 0i32) {
            let hertz: f32 = poly.b2MinFloat(sim.constraintHertz, 0.25f32 * context.inv_h);
            sim.constraintSoftness = b2MakeSoft(hertz, sim.constraintDampingRatio, context.h);
            if (sim.jointType == 5i32) b2PrepareRevoluteJoint(world,sim,context);
            else if (sim.jointType == 4i32) b2PreparePrismaticJoint(world,sim,context);
            else b2PrepareDistanceJoint(world, sim, context);
        } else if (phase == 2i32) {
            if (sim.jointType == 5i32) b2WarmStartRevoluteJoint(world,sim,context);
            else if (sim.jointType == 4i32) b2WarmStartPrismaticJoint(world,sim,context);
            else b2WarmStartDistanceJoint(world,sim,context);
        } else {
            if (sim.jointType == 5i32) b2SolveRevoluteJoint(world,sim,context,phase == 3i32);
            else if (sim.jointType == 4i32) b2SolvePrismaticJoint(world,sim,context,phase == 3i32);
            else b2SolveDistanceJoint(world,sim,context,phase == 3i32);
        }
        i = i + 1i64;
    }
}

                                                                                      
fun b2UnlinkBodyJoints14(world: ref World, slot: i32) -> () = {
    var key: i32 = world.bodies.at(slot as i64).headJointKey;
    while (key != -1i32) {
        let id: i32 = key >> 1i32; let side: i32 = key & 1i32;
        let joint: JointRecord = world.joints.at(id as i64);
        key = jointEdge(world.joints.at(id as i64), side).nextKey;
        if (joint.setIndex != 1i32) {
            b2WakeBody(world, joint.edgeA.bodyId); b2WakeBody(world, joint.edgeB.bodyId);
            b2UnlinkJoint(world, id);
            b2TransferJoint(world, 0i32, id);
        }
    }
}
                                                                                             
fun b2RecolorBodyJoints14(world: ref World, slot: i32) -> () = {
    var key: i32 = world.bodies.at(slot as i64).headJointKey;
    while (key != -1i32) {
        let id: i32 = key >> 1i32; let side: i32 = key & 1i32;
        let joint: JointRecord = world.joints.at(id as i64);
        key = jointEdge(world.joints.at(id as i64), side).nextKey;
        if (joint.setIndex != 1i32) {
            let setA: i32 = world.bodies.at(joint.edgeA.bodyId as i64).setIndex;
            let setB: i32 = world.bodies.at(joint.edgeB.bodyId as i64).setIndex;
            if (setA == 2i32 or setB == 2i32) b2TransferJoint(world, 2i32, id);
        }
    }
}
                                                   
fun b2RelinkBodyJoints14(world: ref World, slot: i32) -> () = {
    var key: i32 = world.bodies.at(slot as i64).headJointKey;
    while (key != -1i32) {
        let id: i32 = key >> 1i32; let side: i32 = key & 1i32;
        key = jointEdge(world.joints.at(id as i64), side).nextKey;
        let other: i32 = jointEdge(world.joints.at(id as i64), side ^ 1i32).bodyId;
        if (world.bodies.at(other as i64).setIndex != 1i32 and not (world.bodies.at(slot as i64).bodyType == 0i32 and world.bodies.at(other as i64).bodyType == 0i32)) b2LinkJoint(world, id, false);
    }
}

                                                  
fun b2GetJointSimCheckType(id: JointId) -> ref JointSim = {
    return b2GetJointSim(worlds.at(id.world0 as i64), id.index1 - 1i32);
}
                                                         
fun b2DistanceJoint_SetLength(id: JointId, length: f32) -> () = {
    var joint: ref DistanceJoint = &b2GetJointSimCheckType(id).distanceJoint;
    joint.length = poly.b2ClampFloat(length, 0.005f32, 100000.0f32);
    joint.impulse = 0.0f32; joint.lowerImpulse = 0.0f32; joint.upperImpulse = 0.0f32;
}
                                                         
fun b2DistanceJoint_SetLengthRange(id: JointId, minLength: f32, maxLength: f32) -> () = {
    var joint: ref DistanceJoint = &b2GetJointSimCheckType(id).distanceJoint;
    let a: f32 = poly.b2ClampFloat(minLength, 0.005f32, 100000.0f32);
    let b: f32 = poly.b2ClampFloat(maxLength, 0.005f32, 100000.0f32);
    joint.minLength = poly.b2MinFloat(a, b); joint.maxLength = tree.b2MaxFloat(a, b);
    joint.impulse = 0.0f32; joint.lowerImpulse = 0.0f32; joint.upperImpulse = 0.0f32;
}
                                                                  
fun distanceSeparation14(world: ref World, base: ref JointSim) -> Vec2 = {
    let xfA: Transform = b2GetBodySim(world, world.bodies.at(base.bodyIdA as i64)).transform;
    let xfB: Transform = b2GetBodySim(world, world.bodies.at(base.bodyIdB as i64)).transform;
    return b2Sub(b2TransformPoint(xfB, base.localOriginAnchorB), b2TransformPoint(xfA, base.localOriginAnchorA));
}
fun b2DistanceJoint_GetCurrentLength(id: JointId) -> f32 = {
    var world: ref World = worlds.at(id.world0 as i64); if (world.locked) return 0.0f32;
    return mass2.b2Length(distanceSeparation14(world, b2GetJointSimCheckType(id)));
}
fun b2Joint_GetConstraintForce(id: JointId) -> Vec2 = {
    var world: ref World = worlds.at(id.world0 as i64); var sim: ref JointSim = b2GetJointSimCheckType(id);
    if (sim.jointType == 5i32) return mass2.b2MulSV(world.inv_h,sim.revoluteJoint.linearImpulse);
    if (sim.jointType == 4i32) {
        let jointP: PrismaticJoint = sim.prismaticJoint;
        let xfA: Transform = b2GetBodySim(world,world.bodies.at(sim.bodyIdA as i64)).transform;
        let axisA: Vec2 = b2RotateVector(xfA.q,jointP.localAxisA); let perpA: Vec2 = b2LeftPerp(axisA);
        let perpForce: f32 = world.inv_h * jointP.impulse.x;
        let axialForce: f32 = world.inv_h * (jointP.motorImpulse + jointP.lowerImpulse - jointP.upperImpulse);
        return b2Add(mass2.b2MulSV(perpForce,perpA),mass2.b2MulSV(axialForce,axisA));
    }
    let joint: DistanceJoint = sim.distanceJoint;
    let force: f32 = (joint.impulse + joint.lowerImpulse - joint.upperImpulse + joint.motorImpulse) * world.inv_h;
    return mass2.b2MulSV(force, mass2.b2Normalize(distanceSeparation14(world, sim)));
}
                                                                              
fun b2Joint_GetConstraintTorque(id: JointId) -> f32 = {
    var world: ref World = worlds.at(id.world0 as i64); var sim: ref JointSim = b2GetJointSimCheckType(id);
    if (sim.jointType == 5i32) return world.inv_h * (sim.revoluteJoint.motorImpulse + sim.revoluteJoint.lowerImpulse - sim.revoluteJoint.upperImpulse);
    if (sim.jointType == 4i32) return world.inv_h * sim.prismaticJoint.impulse.y;
    return 0.0f32;
}
                                                           
fun b2DistanceJoint_EnableMotor(id: JointId, enabled: bool) -> () = {
    var joint: ref DistanceJoint = &b2GetJointSimCheckType(id).distanceJoint;
    if (joint.enableMotor != enabled) { joint.enableMotor = enabled; joint.motorImpulse = 0.0f32; }
}
                                                           
fun b2DistanceJoint_GetMotorForce(id: JointId) -> f32 = { return worlds.at(id.world0 as i64).inv_h * b2GetJointSimCheckType(id).distanceJoint.motorImpulse; }

                                                      
fun b2DistanceJoint_GetLength(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).distanceJoint.length; }

                                                      
fun b2DistanceJoint_GetMinLength(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).distanceJoint.minLength; }

                                                      
fun b2DistanceJoint_GetMaxLength(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).distanceJoint.maxLength; }

                                                       
fun b2DistanceJoint_GetSpringHertz(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).distanceJoint.hertz; }

                                                       
fun b2DistanceJoint_GetSpringDampingRatio(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).distanceJoint.dampingRatio; }

                                                       
fun b2DistanceJoint_GetMotorSpeed(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).distanceJoint.motorSpeed; }

                                                       

fun b2ExplosionCallback(world: ref World, shapeId: i32, definition: ref ExplosionDef) -> bool = {
    let bodyId: i32 = world.shapes.at(shapeId as i64).bodyId;
    let transform: Transform = b2GetBodySim(world,world.bodies.at(bodyId as i64)).transform;
    var input = distance.DistanceInput(); input.proxyA = b2MakeShapeDistanceProxy(world.shapes.at(shapeId as i64));
    var point: Vec2[8]; point[0] = definition.position;
    input.proxyB = distance.b2MakeProxy(&point,1i32,0.0f32);
    input.transformA = transform; input.transformB = Transform(Vec2(),Rot(1.0f32,0.0f32)); input.useRadii = true;
    var cache = distance.SimplexCache(); var trace = distance.SimplexTrace();
    let output: distance.DistanceOutput = distance.b2ShapeDistance(&input,&cache,&trace,0i32,false);
    var observed = ExplosionTrace19(); observed.shapeId = shapeId; observed.bodyId = bodyId; observed.distance = output.distance;
    let radius: f32 = definition.radius; let falloff: f32 = definition.falloff;
    if (output.distance > radius+falloff) { world.explosionTrace19.push(observed); return true; }
    b2WakeBody(world,bodyId);
    if (world.bodies.at(bodyId as i64).setIndex != 2i32) { observed.phase = 1i32; world.explosionTrace19.push(observed); return true; }
    var closestPoint: Vec2 = output.pointA;
    if (output.distance == 0.0f32) closestPoint = b2TransformPoint(transform,b2GetShapeCentroid(world.shapes.at(shapeId as i64)));
    var direction: Vec2 = b2Sub(closestPoint,definition.position);
    if (mass2.b2LengthSquared(direction) > 100.0f32 * FLT_EPSILON * FLT_EPSILON) direction = mass2.b2Normalize(direction);
    else direction = Vec2(1.0f32,0.0f32);
    let localLine: Vec2 = b2InvRotateVector(transform.q,b2LeftPerp(direction));
    let perimeter: f32 = b2GetShapeProjectedPerimeter(world.shapes.at(shapeId as i64),localLine);
    var scale: f32 = 1.0f32;
    if (output.distance > radius and falloff > 0.0f32) scale = poly.b2ClampFloat((radius+falloff-output.distance)/falloff,0.0f32,1.0f32);
    let magnitude: f32 = definition.impulsePerLength * perimeter * scale;
    let impulse: Vec2 = mass2.b2MulSV(magnitude,direction);
                                                                                                      
    let localIndex: i32 = world.bodies.at(bodyId as i64).localIndex;
    var sim: ref BodySim = b2GetSolverSet(world,2i32).bodySims.at(localIndex as i64);
    var state: ref BodyState = b2GetSolverSet(world,2i32).bodyStates.at(localIndex as i64);
    state.linearVelocity = b2MulAdd(state.linearVelocity,sim.invMass,impulse);
    state.angularVelocity = state.angularVelocity + sim.invInertia * mass2.b2Cross(b2Sub(closestPoint,sim.center),impulse);
    observed.phase = 2i32; observed.closestPoint = closestPoint; observed.direction = direction;
    observed.perimeter = perimeter; observed.scale = scale; observed.magnitude = magnitude; observed.impulse = impulse;
    world.explosionTrace19.push(observed); return true;
}
# Box2D 8c661469, src/world.                                                             
fun b2World_Explode(id: WorldId, definition: ref ExplosionDef) -> () = {
    var world: ref World = worlds.at((id.index1-1u16) as i64);
    if (world.locked) return;
    world.explosionTrace19.clear();
    let extent: f32 = definition.radius+definition.falloff;
    let bounds: tree.AABB = tree.AABB(Vec2(definition.position.x-extent,definition.position.y-extent),Vec2(definition.position.x+extent,definition.position.y+extent));
    let maskBits: i64 = ((definition.maskBits.high as u64 << 32u64) | definition.maskBits.low as u64) as i64;
    var hits: tree.TreeQueryResult = tree.b2DynamicTree_Query(&world.broadPhase.trees[2],bounds,maskBits);
    var i: i64 = 0i64;
    while (i < hits.hits.length()) { b2ExplosionCallback(world,hits.hits.at(i).userData as i32,definition); i = i+1i64; }
}

        let source: BodySim = b2GetSolverSet(world, setIndex).bodySims.at(bi as i64);
        let bodyId: i32 = source.bodyId;
        let target: i32 = b2GetSolverSet(world, 2i32).bodyCount;
        world.bodies.at(bodyId as i64).setIndex = 2i32;
        world.bodies.at(bodyId as i64).localIndex = target;
        world.bodies.at(bodyId as i64).sleepTime = 0.0f32;
        if (target as i64 == b2GetSolverSet(world, 2i32).bodySims.length()) b2GetSolverSet(world, 2i32).bodySims.push(source);
        else b2GetSolverSet(world, 2i32).bodySims.at(target as i64) = source;
        if (target as i64 == b2GetSolverSet(world, 2i32).bodyStates.length()) b2GetSolverSet(world, 2i32).bodyStates.push(BodyState());
        else b2GetSolverSet(world, 2i32).bodyStates.at(target as i64) = BodyState();
        b2GetSolverSet(world, 2i32).bodyCount = target + 1i32;
        var key: i32 = world.bodies.at(bodyId as i64).headContactKey;
        while (key != -1i32) {
            let contactId: i32 = key >> 1i32;
            let edgeIndex: i32 = key & 1i32;
            let record: ContactRecord = world.contacts.at(contactId as i64);
            key = contactEdge(world.contacts.at(contactId as i64), edgeIndex).nextKey;
            if (record.setIndex == 1i32) {
                let sim: ContactSim = b2GetSolverSet(world, 1i32).contactSims.at(record.localIndex as i64);
                b2AddNonTouchingContact(world, contactId, sim);
                b2RemoveNonTouchingContact(world, record.localIndex, 1i32);
            }
        }
        bi = bi + 1i32;
    }
    let contactCount: i32 = b2GetSolverSet(world, setIndex).contactCount;
    var ci: i32 = 0i32;
    while (ci < contactCount) {
        let contactSim: ContactSim = b2GetSolverSet(world, setIndex).contactSims.at(ci as i64);
        b2AddContactToGraph(world, contactSim.contactId, contactSim);
        world.contacts.at(contactSim.contactId as i64).setIndex = 2i32;
        ci = ci + 1i32;
    }
                                                           
    var ji: i32 = 0i32;
    while (ji < b2GetSolverSet(world, setIndex).jointCount) {
        let sim: JointSim = b2GetSolverSet(world, setIndex).jointSims.at(ji as i64);
        b2AddJointToGraph(world, sim.jointId, sim); world.joints.at(sim.jointId as i64).setIndex = 2i32;
        ji = ji + 1i32;
    }
    let islandCount: i32 = b2GetSolverSet(world, setIndex).islandCount;
    var ii: i32 = 0i32;
    while (ii < islandCount) {
        let islandId: i32 = b2GetSolverSet(world, setIndex).islandSims.at(ii as i64);
        let local: i32 = b2GetSolverSet(world, 2i32).islandCount;
        world.islands.at(islandId as i64).setIndex = 2i32;
        world.islands.at(islandId as i64).localIndex = local;
        if (local as i64 == b2GetSolverSet(world, 2i32).islandSims.length()) b2GetSolverSet(world, 2i32).islandSims.push(islandId);
        else b2GetSolverSet(world, 2i32).islandSims.at(local as i64) = islandId;
        b2GetSolverSet(world, 2i32).islandCount = local + 1i32;
        ii = ii + 1i32;
    }
    b2DestroySolverSet(world, setIndex);
}

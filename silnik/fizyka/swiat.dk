    let t: f32 = -0.094097948f32 * q - 0.33213072f32;
    r = r * s + t; r = r * c + a;
    if (ay > ax) r = 1.57079637f32 - r;
    if (x < 0.0f32) r = 3.14159274f32 - r;
    if (y < 0.0f32) r = -r;
    return r;
}

    appendSolverBlocks(context, context.packets.length(), 1i32, 2i32, -1i32, 0i32);
    appendSolverBlocks(context, b2GetSolverSet(world, 2i32).bodyCount as i64, 0i32, 0i32, -1i32, 1i32);
    var phase: i32 = 2i32;
    while (phase <= 6i32) {
        if (phase == 4i32) appendSolverBlocks(context, b2GetSolverSet(world, 2i32).bodyCount as i64, 0i32, 0i32, -1i32, phase);
        else {
            var ci: i32 = 0i32;
            while (ci < 11i32) {
                let pc: i64 = ((world.constraintGraph.colors[ci].contactCount + 3i32) / 4i32) as i64;
                appendSolverBlocks(context, world.constraintGraph.colors[ci].jointCount as i64, 2i32, 3i32, ci, phase);
                appendSolverBlocks(context, pc, 2i32, 4i32, ci, phase); ci = ci + 1i32;

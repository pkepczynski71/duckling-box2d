fun b2Body_IsAwake(id: BodyId) -> bool = { return worlds.at(id.world0 as i64).bodies.at((id.index1 - 1i32) as i64).setIndex == 2i32; }
# Box2D 8c661469, src/body.c:1483-1507. Split synchronously, then reacquire body.islandId.
fun b2Body_SetAwake(id: BodyId, awake: bool) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    if (world.locked) return;
    let body: BodyRecord = world.bodies.at((id.index1 - 1i32) as i64);
    if (awake and body.setIndex >= 3i32) b2WakeBody(world, body.id);
    else if (not awake and body.setIndex == 2i32) {
        if (world.islands.at(body.islandId as i64).constraintRemoveCount > 0i32) b2SplitIsland(world, body.islandId);
        b2TrySleepIsland(world, world.bodies.at(body.id as i64).islandId);
    }
}

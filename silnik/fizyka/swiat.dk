fun b2Atan2(y: f32, x: f32) -> f32 = {
    if (x == 0.0f32 and y == 0.0f32) return 0.0f32;
    let ax: f32 = mass2.b2AbsFloat(x); let ay: f32 = mass2.b2AbsFloat(y);

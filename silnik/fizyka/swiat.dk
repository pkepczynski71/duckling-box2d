# Box2D 8c661469, src/world.c:357-428. No dense transfer occurs while this task runs.
fun b2CollideTask(world: ref World, sim: ref ContactSim) -> () = {
    var a: ref ShapeRecord = world.shapes.at(sim.shapeIdA as i64);
    var b: ref ShapeRecord = world.shapes.at(sim.shapeIdB as i64);
    if (not tree.b2AABB_Overlaps(a.fatAABB, b.fatAABB)) {
        sim.simFlags = (sim.simFlags | 131072u32) & (4294967295u32 ^ 65536u32);
        bits.b2SetBit(&world.contactStateBitSet, sim.contactId);
        return;
    }
    let wasTouching: bool = (sim.simFlags & 65536u32) != 0u32;
    var bodyA: ref BodyRecord = world.bodies.at(a.bodyId as i64);
    var bodyB: ref BodyRecord = world.bodies.at(b.bodyId as i64);
    var bodySimA: ref BodySim = b2GetBodySim(world, bodyA);
    var bodySimB: ref BodySim = b2GetBodySim(world, bodyB);
    sim.bodySimIndexA = if bodyA.setIndex == 2i32 then bodyA.localIndex else -1i32;
    sim.bodySimIndexB = if bodyB.setIndex == 2i32 then bodyB.localIndex else -1i32;
    sim.invMassA = bodySimA.invMass; sim.invIA = bodySimA.invInertia;
    sim.invMassB = bodySimB.invMass; sim.invIB = bodySimB.invInertia;
    let xfA: Transform = bodySimA.transform; let xfB: Transform = bodySimB.transform;
    let offsetA: Vec2 = b2RotateVector(xfA.q, bodySimA.localCenter);
    let offsetB: Vec2 = b2RotateVector(xfB.q, bodySimB.localCenter);
    let touching: bool = b2UpdateContact(world, sim, a, xfA, offsetA, b, xfB, offsetB);
    if (touching and not wasTouching) {
        sim.simFlags = sim.simFlags | 262144u32; bits.b2SetBit(&world.contactStateBitSet, sim.contactId);
    } else if (not touching and wasTouching) {
        sim.simFlags = sim.simFlags | 524288u32; bits.b2SetBit(&world.contactStateBitSet, sim.contactId);
    }
}
# Box2D 8c661469, src/world.c:487-568. Split only at the observer point, never repeats task work.
fun b2CollideTasks(world: ref World) -> i32 = {
    broad.b2BroadPhase_RebuildTrees(&world.broadPhase);
    var count: i32 = b2GetSolverSet(world, 2i32).contactCount;
    var i: i32 = 0i32;
    while (i < 12i32) { count = count + world.constraintGraph.colors[i].contactCount; i = i + 1i32; }
    if (count == 0i32) return count;
    bits.b2SetBitCountAndClear(&world.contactStateBitSet, world.contactIdPool.nextIndex);
    var color: i32 = 0i32;
    while (color < 12i32) {
        var j: i32 = 0i32;
        while (j < world.constraintGraph.colors[color].contactCount) {
            b2CollideTask(world, world.constraintGraph.colors[color].contactSims.at(j as i64)); j = j + 1i32;
        }
        color = color + 1i32;
    }
    var k: i32 = 0i32;
    while (k < b2GetSolverSet(world, 2i32).contactCount) { b2CollideTask(world, b2GetSolverSet(world, 2i32).contactSims.at(k as i64)); k = k + 1i32; }
    return count;
}
# Box2D 8c661469, src/world.c:586-687. Iterate set bits in increasing contactId order.
fun b2CollideChanges(world: ref World) -> () = {
    var id: i32 = 0i32;
    while (id < world.contactIdPool.nextIndex) {
        if (bits.b2GetBit(&world.contactStateBitSet, id)) {
            let record: ContactRecord = world.contacts.at(id as i64);
            let flags: u32 = b2GetContactSim(world, world.contacts.at(id as i64)).simFlags;
            if ((flags & 131072u32) != 0u32) b2DestroyContact(world, id, false);
            else if ((flags & 262144u32) != 0u32) {
                if ((record.flags & 4u32) != 0u32) emitContactBegin(world, record.shapeIdA, record.shapeIdB,
                    b2GetContactSim(world, world.contacts.at(id as i64)).manifold);
                world.contacts.at(id as i64).flags = record.flags | 1u32;
                b2LinkContact(world, id);
                                                                                  
                var fresh: ref ContactSim = b2GetSolverSet(world, 2i32).contactSims.at(record.localIndex as i64);
                fresh.simFlags = fresh.simFlags & (4294967295u32 ^ 262144u32);
                let transfer: ContactSim = fresh;
                b2AddContactToGraph(world, id, transfer);
                b2RemoveNonTouchingContact(world, record.localIndex);
            } else if ((flags & 524288u32) != 0u32) {
                var stopped: ref ContactSim = b2GetContactSim(world, world.contacts.at(id as i64));
                stopped.simFlags = stopped.simFlags & (4294967295u32 ^ 524288u32);
                world.contacts.at(id as i64).flags = record.flags & (4294967295u32 ^ 1u32);
                if ((record.flags & 4u32) != 0u32) emitContactEnd(world, record.shapeIdA, record.shapeIdB);
                b2UnlinkContact(world, id);
                let stoppedCopy: ContactSim = stopped;
                b2AddNonTouchingContact(world, id, stoppedCopy);
                b2RemoveContactFromGraph(world, record.edgeA.bodyId, record.edgeB.bodyId, record.colorIndex, record.localIndex);
            }
        }
        id = id + 1i32;
    }
}
# Box2D 8c661469, src/world.c:487-693. Production component path, no solver.
fun b2Collide(world: ref World) -> () = {
    let count: i32 = b2CollideTasks(world);
    if (count > 0i32) b2CollideChanges(world);
}

# Box2D 8c661469, src/body.c:449-458.
fun b2Body_GetContactCapacity(id: BodyId) -> i32 = {

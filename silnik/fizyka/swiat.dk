fun b2Joint_GetLinearSeparation(id: JointId) -> f32 = {
    var world: ref World = worlds.at(id.world0 as i64); var sim: ref JointSim = b2GetJointSimCheckType(id);
    if (sim.jointType == 5i32) return mass2.b2Length(distanceSeparation14(world,sim));
    if (sim.jointType == 4i32) {
        let jointP: PrismaticJoint = sim.prismaticJoint;
        let xfA: Transform = b2GetBodySim(world,world.bodies.at(sim.bodyIdA as i64)).transform;
        let axisA: Vec2 = b2RotateVector(xfA.q,jointP.localAxisA);
        let dp: Vec2 = distanceSeparation14(world,sim);
        let perpendicularSeparation: f32 = mass2.b2AbsFloat(mass2.b2Dot(b2LeftPerp(axisA),dp));
        var limitSeparation: f32 = 0.0f32;
        if (jointP.enableLimit) {
            let translation: f32 = mass2.b2Dot(axisA,dp);
            if (translation < jointP.lowerTranslation) limitSeparation = jointP.lowerTranslation - translation;
            if (jointP.upperTranslation < translation) limitSeparation = translation - jointP.upperTranslation;
        }
        return math.sqrt(perpendicularSeparation * perpendicularSeparation + limitSeparation * limitSeparation);
    }
    let joint: DistanceJoint = sim.distanceJoint; let length: f32 = mass2.b2Length(distanceSeparation14(world, sim));
    if (joint.enableSpring) {
        if (joint.enableLimit) {
            if (length < joint.minLength) return joint.minLength - length;
            else if (length > joint.maxLength) return length - joint.maxLength;
        }
        return 0.0f32;
    }
    return mass2.b2AbsFloat(length - joint.length);
}
fun b2Joint_GetAngularSeparation(id: JointId) -> f32 = {

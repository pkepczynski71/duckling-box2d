}
# Box2D 8c661469, src/contact_solver.c:1400-1431.                                                
fun scatterSolverState(world: ref World, index: i32, value: BodyState) -> () = {
    if (index == -1i32) return;
    var target: ref BodyState = b2GetSolverSet(world, 2i32).bodyStates.at(index as i64);
    target.linearVelocity = value.linearVelocity; target.angularVelocity = value.angularVelocity;
}
# Box2D 8c661469, src/contact_solver.c:24-153,1449-1663.
fun b2PrepareContact(world: ref World, sim: ref ContactSim, context: ref SolverContext) -> ContactConstraint = {
    var c = ContactConstraint(); c.contactId = sim.contactId; c.indexA = sim.bodySimIndexA; c.indexB = sim.bodySimIndexB;
    c.pointCount = sim.manifold.pointCount; c.normal = sim.manifold.normal;
    c.invMassA = sim.invMassA; c.invIA = sim.invIA; c.invMassB = sim.invMassB; c.invIB = sim.invIB;
    c.friction = sim.friction; c.restitution = sim.restitution; c.tangentSpeed = sim.tangentSpeed;
    c.rollingResistance = sim.rollingResistance;
    let warmScale: f32 = if context.enableWarmStarting then 1.0f32 else 0.0f32;
    c.rollingImpulse = warmScale * sim.manifold.rollingImpulse;
    let k: f32 = c.invIA + c.invIB;
    c.rollingMass = if k > 0.0f32 then 1.0f32 / k else 0.0f32;
    c.softness = context.contactSoftness;
    if (c.indexA == -1i32 or c.indexB == -1i32) c.softness = context.staticSoftness;
    let a: BodyState = solverState(world, c.indexA); let b: BodyState = solverState(world, c.indexB);
    let tangent: Vec2 = Vec2(c.normal.y, -c.normal.x);
    var j: i32 = 0i32;
    while (j < c.pointCount) {
        var mp: ref ManifoldPoint = manifoldPoint(&sim.manifold, j);
        var cp: ref ContactConstraintPoint = constraintPoint(&c, j);
        cp.normalImpulse = warmScale * mp.normalImpulse; cp.tangentImpulse = warmScale * mp.tangentImpulse;
        cp.totalNormalImpulse = cp.normalImpulse; cp.anchorA = mp.anchorA; cp.anchorB = mp.anchorB;
        cp.baseSeparation = mp.separation - poly.b2Dot(b2Sub(mp.anchorB, mp.anchorA), c.normal);
        let rnA: f32 = mass2.b2Cross(mp.anchorA, c.normal); let rnB: f32 = mass2.b2Cross(mp.anchorB, c.normal);
        let kNormal: f32 = c.invMassA + c.invMassB + c.invIA * rnA * rnA + c.invIB * rnB * rnB;
        cp.normalMass = if kNormal > 0.0f32 then 1.0f32 / kNormal else 0.0f32;
        let rtA: f32 = mass2.b2Cross(mp.anchorA, tangent); let rtB: f32 = mass2.b2Cross(mp.anchorB, tangent);
        let kTangent: f32 = c.invMassA + c.invMassB + c.invIA * rtA * rtA + c.invIB * rtB * rtB;
        cp.tangentMass = if kTangent > 0.0f32 then 1.0f32 / kTangent else 0.0f32;
        let vrA: Vec2 = b2Add(a.linearVelocity, poly.b2CrossSV(a.angularVelocity, mp.anchorA));
        let vrB: Vec2 = b2Add(b.linearVelocity, poly.b2CrossSV(b.angularVelocity, mp.anchorB));
        cp.relativeVelocity = poly.b2Dot(c.normal, b2Sub(vrB, vrA));
        j = j + 1i32;
    }

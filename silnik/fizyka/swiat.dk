                            world.joints.at(jointId as i64).islandId = islandId;
                            if (tailJoint != -1i32) world.joints.at(tailJoint as i64).islandNext = jointId;
                            world.joints.at(jointId as i64).islandPrev = tailJoint; world.joints.at(jointId as i64).islandNext = -1i32;
                            world.islands.at(islandId as i64).tailJoint = jointId;
                            if (world.islands.at(islandId as i64).headJoint == -1i32) world.islands.at(islandId as i64).headJoint = jointId;
                            world.islands.at(islandId as i64).jointCount = world.islands.at(islandId as i64).jointCount + 1i32;
                        }
                    }
                }
            }
        }
        seedOrdinal = seedOrdinal + 1i64;
    }
}

# Box2D 8c661469, src/types.                                                                              
class BodyDef {
    enableSleep: bool = true;
    isAwake: bool = true;
    sleepThreshold: f32 = 0.05f32;
    bodyType: i32 = 0i32;
    position: Vec2 = Vec2();
    rotation: Rot = Rot(1.0f32, 0.0f32);
    linearVelocity: Vec2 = Vec2();
    angularVelocity: f32 = 0.0f32;
    fixedRotation: bool = false;
    linearDamping: f32 = 0.0f32;
    angularDamping: f32 = 0.0f32;
    gravityScale: f32 = 1.0f32;
    allowFastRotation: bool = false;
    isEnabled: bool = true;
    name: NameValue = NameValue();
}

# Box2D 8c661469, src/body.c:177,197-260,263-328.
fun b2CreateBody(worldId: WorldId, def: BodyDef) -> BodyId = {
    var world: ref World = worlds.at((worldId.index1 - 1u16) as i64);
    let id: i32 = b2AllocId(&world.bodyIdPool);
    var sim = BodySim();
    sim.transform = Transform(def.position, def.rotation);
    sim.center = def.position;
    sim.center0 = def.position;
    sim.rotation0 = def.rotation;
    sim.bodyId = id;
    sim.linearDamping = def.linearDamping;
    sim.angularDamping = def.angularDamping;
    sim.gravityScale = def.gravityScale;
    sim.allowFastRotation = def.allowFastRotation;
    var setIndex: i32 = 0i32;
    if (not def.isEnabled) setIndex = 1i32;
    else if (def.bodyType != 0i32) {
        if (def.isAwake or not def.enableSleep) setIndex = 2i32;
        else setIndex = b2CreateSleepingSet(world);
    }
    var set: ref SolverSet = b2GetSolverSet(world, setIndex);
    let local: i32 = set.bodyCount;
    if (local as i64 == set.bodySims.length()) set.bodySims.push(sim);
    else set.bodySims.at(local as i64) = sim;
    if (setIndex == 2i32) {
        let state: BodyState = BodyState(def.linearVelocity, def.angularVelocity);
        if (local as i64 == set.bodyStates.length()) set.bodyStates.push(state);
        else set.bodyStates.at(local as i64) = state;
    }
    set.bodyCount = local + 1i32;
    if (id as i64 == world.bodies.length()) world.bodies.push(BodyRecord());
    let generation: u16 = world.bodies.at(id as i64).generation;
    var body = BodyRecord();
    body.id = id;
    body.setIndex = setIndex;
    body.localIndex = local;
    body.generation = generation + 1u16;
    body.bodyType = def.bodyType;
    body.fixedRotation = def.fixedRotation;
    body.enableSleep = def.enableSleep;
    body.sleepThreshold = def.sleepThreshold;
    var nameIndex: i32 = 0i32;
    while (nameIndex < 31i32 and def.name.bytes[nameIndex] != 0u8) {
        body.name[nameIndex] = def.name.bytes[nameIndex]; nameIndex = nameIndex + 1i32;
    }
    while (nameIndex < 32i32) { body.name[nameIndex] = 0u8; nameIndex = nameIndex + 1i32; }
    world.bodies.at(id as i64) = body;
    if (setIndex >= 2i32) {
        let islandId: i32 = b2CreateIslandForBody(world, id);
        world.bodies.at(id as i64).islandId = islandId;
    }
    return b2MakeBodyId(world, id);
}

# Box2D 8c661469, src/body.c:343,406-444. RemoveSwap for both sim and awake state.
fun b2DestroyBody(id: BodyId) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    let slot: i64 = (id.index1 - 1i32) as i64;
                                                     
    while (world.bodies.at(slot).headJointKey != -1i32) b2DestroyJointInternal(world, world.bodies.at(slot).headJointKey >> 1i32, true);
    b2DestroyBodyContacts(world, id.index1 - 1i32, true);
    let body: BodyRecord = world.bodies.at(slot);
    var shapeSlot: i32 = body.headShapeId;
    while (shapeSlot != -1i32) {
        let nextShape: i32 = world.shapes.at(shapeSlot as i64).nextShapeId;
        b2DestroyShapeProxy(world, shapeSlot);
        if (world.shapes.at(shapeSlot as i64).sensorIndex != -1i32) b2DestroySensor(world, shapeSlot);
        b2FreeId(&world.shapeIdPool, shapeSlot);
        world.shapes.at(shapeSlot as i64).id = -1i32;
        shapeSlot = nextShape;
    }
    world.bodies.at(slot).headShapeId = -1i32;
    world.bodies.at(slot).shapeCount = 0i32;
    var chainSlot: i32 = body.headChainId;
    while (chainSlot != -1i32) {
        let nextChain: i32 = world.chainShapes.at(chainSlot as i64).nextChainId;
        b2FreeChainData(world.chainShapes.at(chainSlot as i64));
        b2FreeId(&world.chainIdPool, chainSlot);
        world.chainShapes.at(chainSlot as i64).id = -1i32;
        chainSlot = nextChain;
    }
    world.bodies.at(slot).headChainId = -1i32;
    b2RemoveBodyFromIsland(world, body.id);
    var set: ref SolverSet = b2GetSolverSet(world, body.setIndex);
    let last: i32 = set.bodyCount - 1i32;
    if (body.localIndex != last) {
        let movedSim: BodySim = set.bodySims.at(last as i64);
        set.bodySims.at(body.localIndex as i64) = movedSim;
        world.bodies.at(movedSim.bodyId as i64).localIndex = body.localIndex;
        if (body.setIndex == 2i32) {
            let movedState: BodyState = set.bodyStates.at(last as i64);
            set.bodyStates.at(body.localIndex as i64) = movedState;
        }
    }
    set.bodyCount = last;
    if (last == 0i32 and body.setIndex >= 3i32) b2DestroySolverSet(world, body.setIndex);
    b2FreeId(&world.bodyIdPool, body.id);
    world.bodies.at(slot).id = -1i32;
    world.bodies.at(slot).setIndex = -1i32;
    world.bodies.at(slot).localIndex = -1i32;
    world.bodies.at(slot).islandId = -1i32;
}

# Box2D 8c661469, src/body.c:688-741.
fun b2Body_SetTransform(id: BodyId, position: Vec2, rotation: Rot) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    let body: BodyRecord = world.bodies.at((id.index1 - 1i32) as i64);
    var set: ref SolverSet = b2GetSolverSet(world, body.setIndex);
    var sim: ref BodySim = set.bodySims.at(body.localIndex as i64);
    sim.transform = Transform(position, rotation);
    sim.center = b2TransformPoint(sim.transform, sim.localCenter);

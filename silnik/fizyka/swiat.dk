fun b2ReportHitEvents(world: ref World) -> () = {
    var color: i32 = 0i32;
    while (color < 12i32) {
        var j: i32 = 0i32;
        while (j < world.constraintGraph.colors[color].contactCount) {
            var sim: ref ContactSim = world.constraintGraph.colors[color].contactSims.at(j as i64);
            if ((sim.simFlags & 1048576u32) != 0u32) {
                var event = ContactHitEvent(); event.approachSpeed = world.hitEventThreshold;
                var hit: bool = false; var k: i32 = 0i32;
                while (k < sim.manifold.pointCount) {
                    var mp: ref ManifoldPoint = manifoldPoint(&sim.manifold, k);
                    let speed: f32 = -mp.normalVelocity;
                    if (speed > event.approachSpeed and mp.totalNormalImpulse > 0.0f32) { event.approachSpeed = speed; event.point = mp.point; hit = true; }
                    k = k + 1i32;
                }
                if (hit) {
                    event.normal = sim.manifold.normal; event.shapeA = b2MakeShapeId(world, sim.shapeIdA); event.shapeB = b2MakeShapeId(world, sim.shapeIdB);
                    event.birthA = world.shapes.at(sim.shapeIdA as i64).birthTicket; event.birthB = world.shapes.at(sim.shapeIdB as i64).birthTicket;
                    event.ownerTicket = world.birthTicket; world.contactHitEvents.push(event);
                }
            }
            j = j + 1i32;
        }
        color = color + 1i32;
    }
}


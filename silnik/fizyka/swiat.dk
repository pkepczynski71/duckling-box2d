    world.joints.at(id as i64).colorIndex = -1i32; world.joints.at(id as i64).localIndex = local;
}
fun b2TransferJoint(world: ref World, target: i32, id: i32) -> () = {
    let joint: JointRecord = world.joints.at(id as i64);
    if (target == joint.setIndex) return;
    let source: JointSim = b2GetJointSim(world, id);
    if (target == 2i32) { b2AddJointToGraph(world, id, source); world.joints.at(id as i64).setIndex = 2i32; }
    else b2AppendJointToSet(world, target, id, source);

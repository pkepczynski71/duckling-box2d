    if (lower2 < lower1 and upper2 - lower2 > FLT_EPSILON) vLower = b2Lerp(b2, b1, (lower1 - lower2) / (upper2 - lower2));
    else vLower = b2;
    var vUpper = Vec2();
    if (upper2 > upper1 and upper2 - lower2 > FLT_EPSILON) vUpper = b2Lerp(b2, b1, (upper1 - lower2) / (upper2 - lower2));
    else vUpper = b1;
    let separationLower: f32 = poly.b2Dot(b2Sub(vLower, a1), normal);
    let separationUpper: f32 = poly.b2Dot(b2Sub(vUpper, a1), normal);
    vLower = b2MulAdd(vLower, 0.5f32 * (ra - rb - separationLower), normal);
    vUpper = b2MulAdd(vUpper, 0.5f32 * (ra - rb - separationUpper), normal);
    let radius: f32 = ra + rb;
    manifold.normal = normal;
    manifold.point0.anchorA = vLower;
    manifold.point0.separation = separationLower - radius;
    manifold.point0.id = id1;
    manifold.point1.anchorA = vUpper;
    manifold.point1.separation = separationUpper - radius;
    manifold.point1.id = id2;

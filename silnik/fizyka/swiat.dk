fun b2ClipSegments(a1: Vec2, a2: Vec2, b1: Vec2, b2: Vec2, normal: Vec2, ra: f32, rb: f32, id1: u16, id2: u16) -> Manifold = {
    var manifold = Manifold();
    let tangent: Vec2 = b2LeftPerp(normal);
    let lower1: f32 = 0.0f32;
    let upper1: f32 = poly.b2Dot(b2Sub(a2, a1), tangent);
    let upper2: f32 = poly.b2Dot(b2Sub(b1, a1), tangent);
    let lower2: f32 = poly.b2Dot(b2Sub(b2, a1), tangent);

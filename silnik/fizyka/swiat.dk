    var input = distance.DistanceInput();
    var segmentPoints: Vec2[8]; segmentPoints[0] = p1; segmentPoints[1] = p2;
    input.proxyA = distance.b2MakeProxy(&segmentPoints, 2i32, 0.0f32);
    input.proxyB = distance.b2MakeProxy(&vertices, count, 0.0f32);
    input.transformA = Transform(Vec2(), Rot(1.0f32, 0.0f32));
    input.transformB = Transform(Vec2(), Rot(1.0f32, 0.0f32));
    input.useRadii = false;

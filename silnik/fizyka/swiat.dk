# Box2D 8c661469, src/sensor.h:12-29. MIT. Birth is an owned sidecar, never part of the raw comparator.
class ShapeRef { shapeId: i32 = -1i32; generation: u16 = 0u16; birthTicket: Key64 = Key64(); }
fun emptyShapeRefs() -> List[ShapeRef] = { var values: List[ShapeRef]; return values; }
class Sensor { shapeId: i32 = -1i32; overlaps1: List[ShapeRef] = emptyShapeRefs(); overlaps2: List[ShapeRef] = emptyShapeRefs(); }
fun emptySensors() -> List[Sensor] = { var values: List[Sensor]; return values; }
                                                                                                      
fun b2SwapSensorOverlaps(sensor: ref Sensor) -> () = {
    var first: List[ShapeRef] = builtins17.move_out[List[ShapeRef]](ptrof sensor.overlaps1);
    var second: List[ShapeRef] = builtins17.move_out[List[ShapeRef]](ptrof sensor.overlaps2);
    builtins17.move_in[List[ShapeRef]](ptrof sensor.overlaps1,move second);
    builtins17.move_in[List[ShapeRef]](ptrof sensor.overlaps2,move first);
}
# Box2D 8c661469, include/box2d/types.h:1070-1107. Historical raw IDs and game birth sidecars travel together.
class SensorEvent {
    sensorShapeId: broad.ShapeId = broad.ShapeId(); visitorShapeId: broad.ShapeId = broad.ShapeId();
    sensorBirth: Key64 = Key64(); visitorBirth: Key64 = Key64(); ownerBirth: Key64 = Key64();
}
fun emptySensorEvents() -> List[SensorEvent] = { var values: List[SensorEvent]; return values; }
class SensorEvents { beginEvents: List[SensorEvent] = emptySensorEvents(); endEvents: List[SensorEvent] = emptySensorEvents(); }
                                                                  
class SensorQueryTrace { sensorSlot: i32 = -1i32; visitorSlot: i32 = -1i32; treeType: i32 = 0i32; distance: f32 = 0.0f32; }
fun emptySensorQueryTrace() -> List[SensorQueryTrace] = { var values: List[SensorQueryTrace]; return values; }

                                                                                    
extern("C") { fundecl remainderf(value: f32, divisor: f32) -> f32; }

# Box2D 8c661469, include/box2d/collision.h:115,149.
class Capsule { center1: Vec2 = Vec2(); center2: Vec2 = Vec2(); radius: f32 = 0.0f32; }
class Segment { point1: Vec2 = Vec2(); point2: Vec2 = Vec2(); }

# Box2D 8c661469, include/box2d/collision.               
class ChainSegment { ghost1: Vec2 = Vec2(); segment: Segment = Segment(); ghost2: Vec2 = Vec2(); chainId: i32 = -1i32; }

# Box2D 8c661469, src/manifold.c:77.
fun b2CollideCapsuleAndCircle(capsuleA: ref Capsule, xfA: Transform, circleB: Circle, xfB: Transform) -> Manifold = {
    var manifold = Manifold();
    let xf: Transform = b2InvMulTransforms(xfA, xfB);
    let pB: Vec2 = b2TransformPoint(xf, circleB.center);
    let p1: Vec2 = capsuleA.center1;
    let p2: Vec2 = capsuleA.center2;
    let e: Vec2 = b2Sub(p2, p1);
    var pA = Vec2();
    let s1: f32 = poly.b2Dot(b2Sub(pB, p1), e);
    let s2: f32 = poly.b2Dot(b2Sub(p2, pB), e);
    if (s1 < 0.0f32) {
        pA = p1;
    } else if (s2 < 0.0f32) {
        pA = p2;
    } else {
        let s: f32 = s1 / poly.b2Dot(e, e);
        pA = b2MulAdd(p1, s, e);
    }
    var distanceValue: f32 = 0.0f32;
    let normal: Vec2 = b2GetLengthAndNormalize(&distanceValue, b2Sub(pB, pA));
    let radiusA: f32 = capsuleA.radius;
    let radiusB: f32 = circleB.radius;
    let separation: f32 = distanceValue - radiusA - radiusB;
    if (separation > B2_SPECULATIVE_DISTANCE) return manifold;
    let cA: Vec2 = b2MulAdd(pA, radiusA, normal);
    let cB: Vec2 = b2MulAdd(pB, -radiusB, normal);
    let contactPointA: Vec2 = b2Lerp(cA, cB, 0.5f32);
    manifold.normal = b2RotateVector(xfA.q, normal);
    manifold.point0.anchorA = b2RotateVector(xfA.q, contactPointA);
    manifold.point0.anchorB = b2Add(manifold.point0.anchorA, b2Sub(xfA.p, xfB.p));
    manifold.point0.point = b2Add(xfA.p, manifold.point0.anchorA);
    manifold.point0.separation = separation;
    manifold.point0.id = 0u16;
    manifold.pointCount = 1i32;
    return manifold;
}

# Box2D 8c661469, src/manifold.c:1077.
fun b2CollideSegmentAndCircle(segmentA: ref Segment, xfA: Transform, circleB: Circle, xfB: Transform) -> Manifold = {
    var capsuleA = Capsule(segmentA.point1, segmentA.point2, 0.0f32);
    return b2CollideCapsuleAndCircle(&capsuleA, xfA, circleB, xfB);
}

# Box2D 8c661469, src/manifold.c:141.
fun b2CollidePolygonAndCircle(polygonA: ref poly.Polygon, xfA: Transform, circleB: Circle, xfB: Transform) -> Manifold = {
    var manifold = Manifold();
    let speculativeDistance: f32 = B2_SPECULATIVE_DISTANCE;
    let xf: Transform = b2InvMulTransforms(xfA, xfB);
    let center: Vec2 = b2TransformPoint(xf, circleB.center);
    let radiusA: f32 = polygonA.radius;
    let radiusB: f32 = circleB.radius;
    let radius: f32 = radiusA + radiusB;
    var normalIndex: i32 = 0i32;
    var separation: f32 = -poly.FLT_MAX;
    let vertexCount: i32 = polygonA.count;
    var i: i32 = 0i32;
    while (i < vertexCount) {
        let s: f32 = poly.b2Dot(polygonA.normals[i], b2Sub(center, polygonA.vertices[i]));
        if (s > separation) { separation = s; normalIndex = i; }
        i = i + 1i32;
    }
    if (separation > radius + speculativeDistance) return manifold;
    let vertIndex1: i32 = normalIndex;
    let vertIndex2: i32 = if vertIndex1 + 1i32 < vertexCount then vertIndex1 + 1i32 else 0i32;
    let v1: Vec2 = polygonA.vertices[vertIndex1];
    let v2: Vec2 = polygonA.vertices[vertIndex2];
    let u1: f32 = poly.b2Dot(b2Sub(center, v1), b2Sub(v2, v1));
    let u2: f32 = poly.b2Dot(b2Sub(center, v2), b2Sub(v1, v2));
    if (u1 < 0.0f32 and separation > FLT_EPSILON) {
        let normal1: Vec2 = mass2.b2Normalize(b2Sub(center, v1));
        separation = poly.b2Dot(b2Sub(center, v1), normal1);
        if (separation > radius + speculativeDistance) return manifold;
        let cA1: Vec2 = b2MulAdd(v1, radiusA, normal1);
        let cB1: Vec2 = b2Sub(center, mass2.b2MulSV(radiusB, normal1));
        let contactPointA1: Vec2 = b2Lerp(cA1, cB1, 0.5f32);
        manifold.normal = b2RotateVector(xfA.q, normal1);
        manifold.point0.anchorA = b2RotateVector(xfA.q, contactPointA1);
        manifold.point0.anchorB = b2Add(manifold.point0.anchorA, b2Sub(xfA.p, xfB.p));
        manifold.point0.point = b2Add(xfA.p, manifold.point0.anchorA);
        manifold.point0.separation = poly.b2Dot(b2Sub(cB1, cA1), normal1);
        manifold.point0.id = 0u16;
        manifold.pointCount = 1i32;
    } else if (u2 < 0.0f32 and separation > FLT_EPSILON) {
        let normal2: Vec2 = mass2.b2Normalize(b2Sub(center, v2));
        separation = poly.b2Dot(b2Sub(center, v2), normal2);
        if (separation > radius + speculativeDistance) return manifold;
        let cA2: Vec2 = b2MulAdd(v2, radiusA, normal2);
        let cB2: Vec2 = b2Sub(center, mass2.b2MulSV(radiusB, normal2));
        let contactPointA2: Vec2 = b2Lerp(cA2, cB2, 0.5f32);
        manifold.normal = b2RotateVector(xfA.q, normal2);
        manifold.point0.anchorA = b2RotateVector(xfA.q, contactPointA2);
        manifold.point0.anchorB = b2Add(manifold.point0.anchorA, b2Sub(xfA.p, xfB.p));
        manifold.point0.point = b2Add(xfA.p, manifold.point0.anchorA);
        manifold.point0.separation = poly.b2Dot(b2Sub(cB2, cA2), normal2);
        manifold.point0.id = 0u16;
        manifold.pointCount = 1i32;
    } else {
        let normalEdge: Vec2 = polygonA.normals[normalIndex];
        manifold.normal = b2RotateVector(xfA.q, normalEdge);
        let cAEdge: Vec2 = b2MulAdd(center, radiusA - poly.b2Dot(b2Sub(center, v1), normalEdge), normalEdge);
        let cBEdge: Vec2 = b2Sub(center, mass2.b2MulSV(radiusB, normalEdge));
        let contactPointAEdge: Vec2 = b2Lerp(cAEdge, cBEdge, 0.5f32);
        manifold.point0.anchorA = b2RotateVector(xfA.q, contactPointAEdge);
        manifold.point0.anchorB = b2Add(manifold.point0.anchorA, b2Sub(xfA.p, xfB.p));
        manifold.point0.point = b2Add(xfA.p, manifold.point0.anchorA);
        manifold.point0.separation = separation - radius;
        manifold.point0.id = 0u16;
        manifold.pointCount = 1i32;
    }
    return manifold;
}

# Box2D 8c661469, src/manifold.c:261.
fun b2CollideCapsules(capsuleA: ref Capsule, xfA: Transform, capsuleB: ref Capsule, xfB: Transform) -> Manifold = {
    let origin: Vec2 = capsuleA.center1;
    let sfA: Transform = Transform(b2Add(xfA.p, b2RotateVector(xfA.q, origin)), xfA.q);
    let xf: Transform = b2InvMulTransforms(sfA, xfB);
    let p1: Vec2 = Vec2();
    let q1: Vec2 = b2Sub(capsuleA.center2, origin);
    let p2: Vec2 = b2TransformPoint(xf, capsuleB.center1);
    let q2: Vec2 = b2TransformPoint(xf, capsuleB.center2);
    let d1: Vec2 = b2Sub(q1, p1);
    let d2: Vec2 = b2Sub(q2, p2);
    let dd1: f32 = poly.b2Dot(d1, d1);
    let dd2: f32 = poly.b2Dot(d2, d2);
    let epsSqr: f32 = FLT_EPSILON * FLT_EPSILON;
                                                              
    let r: Vec2 = b2Sub(p1, p2);
    let rd1: f32 = poly.b2Dot(r, d1);
    let rd2: f32 = poly.b2Dot(r, d2);
    let d12: f32 = poly.b2Dot(d1, d2);
    let denom: f32 = dd1 * dd2 - d12 * d12;
    var f1: f32 = 0.0f32;
    if (denom != 0.0f32) f1 = poly.b2ClampFloat((d12 * rd2 - rd1 * dd2) / denom, 0.0f32, 1.0f32);
    var f2: f32 = (d12 * f1 + rd2) / dd2;
    if (f2 < 0.0f32) {
        f2 = 0.0f32;
        f1 = poly.b2ClampFloat(-rd1 / dd1, 0.0f32, 1.0f32);
    } else if (f2 > 1.0f32) {
        f2 = 1.0f32;
        f1 = poly.b2ClampFloat((d12 - rd1) / dd1, 0.0f32, 1.0f32);
    }
    let closest1: Vec2 = b2MulAdd(p1, f1, d1);
    let closest2: Vec2 = b2MulAdd(p2, f2, d2);
    let distanceSquared: f32 = poly.b2DistanceSquared(closest1, closest2);
    var manifold = Manifold();
    let radiusA: f32 = capsuleA.radius;
    let radiusB: f32 = capsuleB.radius;
    let radius: f32 = radiusA + radiusB;
    let maxDistance: f32 = radius + B2_SPECULATIVE_DISTANCE;
    if (distanceSquared > maxDistance * maxDistance) return manifold;
    let distanceValue: f32 = math.sqrt(distanceSquared);
    var length1: f32 = 0.0f32;
    var length2: f32 = 0.0f32;
    let u1: Vec2 = b2GetLengthAndNormalize(&length1, d1);
    let u2: Vec2 = b2GetLengthAndNormalize(&length2, d2);
    let fp2: f32 = poly.b2Dot(b2Sub(p2, p1), u1);
    let fq2: f32 = poly.b2Dot(b2Sub(q2, p1), u1);
    let outsideA: bool = (fp2 <= 0.0f32 and fq2 <= 0.0f32) or (fp2 >= length1 and fq2 >= length1);
    let fp1: f32 = poly.b2Dot(b2Sub(p1, p2), u2);
    let fq1: f32 = poly.b2Dot(b2Sub(q1, p2), u2);
    let outsideB: bool = (fp1 <= 0.0f32 and fq1 <= 0.0f32) or (fp1 >= length2 and fq1 >= length2);
    if (outsideA == false and outsideB == false) {
        var normalA = Vec2(-u1.y, u1.x);
        var separationA: f32 = 0.0f32;
        let ssA1: f32 = poly.b2Dot(b2Sub(p2, p1), normalA);
        let ssA2: f32 = poly.b2Dot(b2Sub(q2, p1), normalA);
        let sAp: f32 = if ssA1 < ssA2 then ssA1 else ssA2;
        let sAn: f32 = if -ssA1 < -ssA2 then -ssA1 else -ssA2;
        if (sAp > sAn) separationA = sAp;
        else { separationA = sAn; normalA = poly.b2Neg(normalA); }
        var normalB = Vec2(-u2.y, u2.x);
        var separationB: f32 = 0.0f32;
        let ssB1: f32 = poly.b2Dot(b2Sub(p1, p2), normalB);
        let ssB2: f32 = poly.b2Dot(b2Sub(q1, p2), normalB);
        let sBp: f32 = if ssB1 < ssB2 then ssB1 else ssB2;
        let sBn: f32 = if -ssB1 < -ssB2 then -ssB1 else -ssB2;
        if (sBp > sBn) separationB = sBp;
        else { separationB = sBn; normalB = poly.b2Neg(normalB); }
        if (separationA + 0.1f32 * B2_LINEAR_SLOP >= separationB) {
            manifold.normal = normalA;
            var cpA: Vec2 = p2;
            var cqA: Vec2 = q2;
            if (fp2 < 0.0f32 and fq2 > 0.0f32) cpA = b2Lerp(p2, q2, (0.0f32 - fp2) / (fq2 - fp2));
            else if (fq2 < 0.0f32 and fp2 > 0.0f32) cqA = b2Lerp(q2, p2, (0.0f32 - fq2) / (fp2 - fq2));
            if (fp2 > length1 and fq2 < length1) cpA = b2Lerp(p2, q2, (fp2 - length1) / (fp2 - fq2));
            else if (fq2 > length1 and fp2 < length1) cqA = b2Lerp(q2, p2, (fq2 - length1) / (fq2 - fp2));
            let spA: f32 = poly.b2Dot(b2Sub(cpA, p1), normalA);
            let sqA: f32 = poly.b2Dot(b2Sub(cqA, p1), normalA);
            if (spA <= distanceValue + B2_LINEAR_SLOP or sqA <= distanceValue + B2_LINEAR_SLOP) {
                manifold.point0.anchorA = b2MulAdd(cpA, 0.5f32 * (radiusA - radiusB - spA), normalA);
                manifold.point0.separation = spA - radius;
                manifold.point0.id = poly.B2_MAKE_ID(0i32, 0i32);
                manifold.point1.anchorA = b2MulAdd(cqA, 0.5f32 * (radiusA - radiusB - sqA), normalA);
                manifold.point1.separation = sqA - radius;
                manifold.point1.id = poly.B2_MAKE_ID(0i32, 1i32);
                manifold.pointCount = 2i32;
            }
        } else {
            manifold.normal = poly.b2Neg(normalB);
            var cpB: Vec2 = p1;
            var cqB: Vec2 = q1;
            if (fp1 < 0.0f32 and fq1 > 0.0f32) cpB = b2Lerp(p1, q1, (0.0f32 - fp1) / (fq1 - fp1));
            else if (fq1 < 0.0f32 and fp1 > 0.0f32) cqB = b2Lerp(q1, p1, (0.0f32 - fq1) / (fp1 - fq1));
            if (fp1 > length2 and fq1 < length2) cpB = b2Lerp(p1, q1, (fp1 - length2) / (fp1 - fq1));
            else if (fq1 > length2 and fp1 < length2) cqB = b2Lerp(q1, p1, (fq1 - length2) / (fq1 - fp1));
            let spB: f32 = poly.b2Dot(b2Sub(cpB, p2), normalB);
            let sqB: f32 = poly.b2Dot(b2Sub(cqB, p2), normalB);
            if (spB <= distanceValue + B2_LINEAR_SLOP or sqB <= distanceValue + B2_LINEAR_SLOP) {
                manifold.point0.anchorA = b2MulAdd(cpB, 0.5f32 * (radiusB - radiusA - spB), normalB);
                manifold.point0.separation = spB - radius;
                manifold.point0.id = poly.B2_MAKE_ID(0i32, 0i32);
                manifold.point1.anchorA = b2MulAdd(cqB, 0.5f32 * (radiusB - radiusA - sqB), normalB);
                manifold.point1.separation = sqB - radius;
                manifold.point1.id = poly.B2_MAKE_ID(1i32, 0i32);
                manifold.pointCount = 2i32;
            }
        }
    }
    if (manifold.pointCount == 0i32) {
        var normal: Vec2 = b2Sub(closest2, closest1);
        if (poly.b2Dot(normal, normal) > epsSqr) normal = mass2.b2Normalize(normal);
        else normal = Vec2(-u1.y, u1.x);
        let c1: Vec2 = b2MulAdd(closest1, radiusA, normal);
        let c2: Vec2 = b2MulAdd(closest2, -radiusB, normal);
        let i1: i32 = if f1 == 0.0f32 then 0i32 else 1i32;
        let i2: i32 = if f2 == 0.0f32 then 0i32 else 1i32;
        manifold.normal = normal;
        manifold.point0.anchorA = b2Lerp(c1, c2, 0.5f32);
        manifold.point0.separation = math.sqrt(distanceSquared) - radius;
        manifold.point0.id = poly.B2_MAKE_ID(i1, i2);
        manifold.pointCount = 1i32;
    }
    manifold.normal = b2RotateVector(xfA.q, manifold.normal);
    manifold.point0.anchorA = b2RotateVector(xfA.q, b2Add(manifold.point0.anchorA, origin));
    manifold.point0.anchorB = b2Add(manifold.point0.anchorA, b2Sub(xfA.p, xfB.p));
    manifold.point0.point = b2Add(xfA.p, manifold.point0.anchorA);
    if (manifold.pointCount > 1i32) {
        manifold.point1.anchorA = b2RotateVector(xfA.q, b2Add(manifold.point1.anchorA, origin));
        manifold.point1.anchorB = b2Add(manifold.point1.anchorA, b2Sub(xfA.p, xfB.p));
        manifold.point1.point = b2Add(xfA.p, manifold.point1.anchorA);
    }
    return manifold;
}

# Box2D 8c661469, src/manifold.c:532.
fun b2CollideSegmentAndCapsule(segmentA: ref Segment, xfA: Transform, capsuleB: ref Capsule, xfB: Transform) -> Manifold = {
    var capsuleA = Capsule(segmentA.point1, segmentA.point2, 0.0f32);
    return b2CollideCapsules(&capsuleA, xfA, capsuleB, xfB);
}

# Box2D 8c661469, src/manifold.c:16.
fun b2MakeCapsule(p1: Vec2, p2: Vec2, radius: f32) -> poly.Polygon = {
    var shape = poly.Polygon();
    shape.vertices[0] = p1;
    shape.vertices[1] = p2;
    shape.centroid = b2Lerp(p1, p2, 0.5f32);
    let d: Vec2 = b2Sub(p2, p1);
                                                              
    let axis: Vec2 = mass2.b2Normalize(d);
    let normal: Vec2 = Vec2(axis.y, -axis.x);
    shape.normals[0] = normal;
    shape.normals[1] = poly.b2Neg(normal);
    shape.count = 2i32;
    shape.radius = radius;
    return shape;
}

# Box2D 8c661469, src/manifold.c:538.
fun b2CollidePolygonAndCapsule(polygonA: ref poly.Polygon, xfA: Transform, capsuleB: ref Capsule, xfB: Transform) -> Manifold = {
    var polyB: poly.Polygon = b2MakeCapsule(capsuleB.center1, capsuleB.center2, capsuleB.radius);
    return poly.b2CollidePolygons(polygonA, xfA, &polyB, xfB);
}

# Box2D 8c661469, src/manifold.c:1083.
fun b2CollideSegmentAndPolygon(segmentA: ref Segment, xfA: Transform, polygonB: ref poly.Polygon, xfB: Transform) -> Manifold = {
    var polyA: poly.Polygon = b2MakeCapsule(segmentA.point1, segmentA.point2, 0.0f32);
    return poly.b2CollidePolygons(&polyA, xfA, polygonB, xfB);
}

# Box2D 8c661469, src/manifold.c:1089-1175. MIT.
fun b2CollideChainSegmentAndCircle(segmentA: ref ChainSegment, xfA: Transform, circleB: Circle, xfB: Transform) -> Manifold = {
    var manifold = Manifold();
    let xf: Transform = b2InvMulTransforms(xfA, xfB);
    let pB: Vec2 = b2TransformPoint(xf, circleB.center);
    let p1: Vec2 = segmentA.segment.point1;
    let p2: Vec2 = segmentA.segment.point2;
    let e: Vec2 = b2Sub(p2, p1);
    let offset: f32 = poly.b2Dot(b2RightPerp(e), b2Sub(pB, p1));
    if (offset < 0.0f32) return manifold;
    let u: f32 = poly.b2Dot(e, b2Sub(p2, pB));
    let v: f32 = poly.b2Dot(e, b2Sub(pB, p1));
    var pA = Vec2();
    if (v <= 0.0f32) {
        let prevEdge: Vec2 = b2Sub(p1, segmentA.ghost1);
        let uPrev: f32 = poly.b2Dot(prevEdge, b2Sub(pB, p1));
        if (uPrev <= 0.0f32) return manifold;
        pA = p1;
    } else if (u <= 0.0f32) {
        let nextEdge: Vec2 = b2Sub(segmentA.ghost2, p2);
        let vNext: f32 = poly.b2Dot(nextEdge, b2Sub(pB, p2));
        if (vNext > 0.0f32) return manifold;
        pA = p2;
    } else {
        let ee: f32 = poly.b2Dot(e, e);
        pA = Vec2(u * p1.x + v * p2.x, u * p1.y + v * p2.y);
        if (ee > 0.0f32) pA = mass2.b2MulSV(1.0f32 / ee, pA); else pA = p1;
    }
    var length: f32 = 0.0f32;
    let normal: Vec2 = b2GetLengthAndNormalize(&length, b2Sub(pB, pA));
    let radius: f32 = circleB.radius;
    let separation: f32 = length - radius;
    if (separation > B2_SPECULATIVE_DISTANCE) return manifold;
    let cA: Vec2 = pA;
    let cB: Vec2 = b2MulAdd(pB, -radius, normal);
    let contactPointA: Vec2 = b2Lerp(cA, cB, 0.5f32);
    manifold.normal = b2RotateVector(xfA.q, normal);
    manifold.point0.anchorA = b2RotateVector(xfA.q, contactPointA);

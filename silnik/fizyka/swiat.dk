    var joint: ref PrismaticJoint = &b2GetJointSimCheckType(id).prismaticJoint;
    if (lower != joint.lowerTranslation or upper != joint.upperTranslation) {
        joint.lowerTranslation = poly.b2MinFloat(lower,upper); joint.upperTranslation = tree.b2MaxFloat(lower,upper);
        joint.lowerImpulse = 0.0f32; joint.upperImpulse = 0.0f32;

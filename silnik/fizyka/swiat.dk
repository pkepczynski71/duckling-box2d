fun emptyShapeRecords() -> List[ShapeRecord] = { var values: List[ShapeRecord]; return values; }

# Box2D 8c661469, src/geometry.c:234-274.
fun b2ComputeCapsuleMass(shape: ref Capsule, density: f32) -> mass2.MassData = {
    var result: mass2.MassData = b2ComputeCapsuleMassCentral(shape, density);
    result.rotationalInertia = result.rotationalInertia + result.mass * poly.b2Dot(result.center, result.center);
    return result;
}

fun b2ComputeCapsuleMassCentral(shape: ref Capsule, density: f32) -> mass2.MassData = {
    return mass2.b2ComputeCapsuleMassCentral(shape.center1, shape.center2, shape.radius, density);
}

# Box2D 8c661469, src/shape.c:707-721. Do not pass the full enum to ruch.BodyShape.
fun b2ComputeShapeMass(shape: ref ShapeRecord) -> mass2.MassData = {
    if (shape.shapeType == 0i32) return mass2.b2ComputeCircleMass(&shape.circle, shape.density);
    if (shape.shapeType == 1i32) return b2ComputeCapsuleMass(&shape.capsule, shape.density);
    if (shape.shapeType == 3i32) return mass2.b2ComputePolygonMass(&shape.polygon, shape.density);
    return mass2.MassData();
}

fun b2ComputeShapeMassCentral(shape: ref ShapeRecord) -> mass2.MassData = {
    if (shape.shapeType == 0i32) return mass2.b2ComputeCircleMassCentral(&shape.circle, shape.density);
    if (shape.shapeType == 1i32) return b2ComputeCapsuleMassCentral(&shape.capsule, shape.density);
    if (shape.shapeType == 3i32) return mass2.b2ComputePolygonMassCentral(&shape.polygon, shape.density);
    return mass2.MassData();
}

# Box2D 8c661469, src/shape.c:599-618.
fun b2GetShapeCentroid(shape: ref ShapeRecord) -> Vec2 = {
    if (shape.shapeType == 4i32) return b2Lerp(shape.chainSegment.segment.point1, shape.chainSegment.segment.point2, 0.5f32);
    if (shape.shapeType == 0i32) return shape.circle.center;
    if (shape.shapeType == 1i32) return b2Lerp(shape.capsule.center1, shape.capsule.center2, 0.5f32);
    if (shape.shapeType == 2i32) return b2Lerp(shape.segment.point1, shape.segment.point2, 0.5f32);
    return shape.polygon.centroid;
}

# Box2D 8c661469, src/shape.                                                      
fun b2GetShapePerimeter(shape: ref ShapeRecord) -> f32 = {
    if (shape.shapeType == 0i32) return 2.0f32 * mass2.B2_PI * shape.circle.radius;
    if (shape.shapeType == 1i32) return 2.0f32 * mass2.b2Length(b2Sub(shape.capsule.center1,shape.capsule.center2)) + 2.0f32 * mass2.B2_PI * shape.capsule.radius;
    if (shape.shapeType == 2i32) return 2.0f32 * mass2.b2Length(b2Sub(shape.segment.point1,shape.segment.point2));
    if (shape.shapeType == 4i32) return 2.0f32 * mass2.b2Length(b2Sub(shape.chainSegment.segment.point1,shape.chainSegment.segment.point2));
    if (shape.shapeType == 3i32) {
        var perimeter: f32 = 2.0f32 * mass2.B2_PI * shape.polygon.radius;
        var prev: Vec2 = shape.polygon.vertices[shape.polygon.count-1i32];
        var i: i32 = 0i32;
        while (i < shape.polygon.count) {
            let next: Vec2 = shape.polygon.vertices[i];
            perimeter = perimeter + mass2.b2Length(b2Sub(next,prev)); prev = next; i = i+1i32;
        }
        return perimeter;
    }
    return 0.0f32;
}
fun b2GetShapeProjectedPerimeter(shape: ref ShapeRecord, line: Vec2) -> f32 = {
    if (shape.shapeType == 0i32) return 2.0f32 * shape.circle.radius;
    if (shape.shapeType == 1i32) {
        let axis: Vec2 = b2Sub(shape.capsule.center2,shape.capsule.center1);
        return mass2.b2AbsFloat(poly.b2Dot(axis,line)) + 2.0f32 * shape.capsule.radius;
    }
    if (shape.shapeType == 3i32) {
        var value: f32 = poly.b2Dot(shape.polygon.vertices[0],line);
        var lower: f32 = value; var upper: f32 = value; var i: i32 = 1i32;
        while (i < shape.polygon.count) {
            value = poly.b2Dot(shape.polygon.vertices[i],line);
            lower = poly.b2MinFloat(lower,value); upper = tree.b2MaxFloat(upper,value); i = i+1i32;
        }
        return (upper-lower) + 2.0f32 * shape.polygon.radius;
    }
    if (shape.shapeType == 2i32) {
        let value1: f32 = poly.b2Dot(shape.segment.point1,line);
        let value2: f32 = poly.b2Dot(shape.segment.point2,line); return mass2.b2AbsFloat(value2-value1);
    }
    if (shape.shapeType == 4i32) {
        let value1: f32 = poly.b2Dot(shape.chainSegment.segment.point1,line);
        let value2: f32 = poly.b2Dot(shape.chainSegment.segment.point2,line); return mass2.b2AbsFloat(value2-value1);
    }
    return 0.0f32;
}


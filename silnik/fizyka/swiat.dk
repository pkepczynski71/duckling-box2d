    var stack: List[i32];
    var nextBody: i32 = base.headBody;
    while (nextBody != -1i32) {
        bodyIds.push(nextBody);
        world.bodies.at(nextBody as i64).isMarked = false;
        nextBody = world.bodies.at(nextBody as i64).islandNext;
    }
    var nextContact: i32 = base.headContact;
    while (nextContact != -1i32) {
        world.contacts.at(nextContact as i64).isMarked = false;
        nextContact = world.contacts.at(nextContact as i64).islandNext;
    }
                                                       
    var nextJoint: i32 = base.headJoint;
    while (nextJoint != -1i32) {
        world.joints.at(nextJoint as i64).isMarked = false;
        nextJoint = world.joints.at(nextJoint as i64).islandNext;
    }
                                                                         
    b2DestroyIsland(world, baseId);
    var seedOrdinal: i64 = 0i64;
    while (seedOrdinal < bodyIds.length()) {
        let seedId: i32 = bodyIds.at(seedOrdinal);
        if (not world.bodies.at(seedId as i64).isMarked) {
            var stackCount: i64 = 1i64;
            if (stack.length() == 0i64) stack.push(seedId);
            else stack.at(0i64) = seedId;
            world.bodies.at(seedId as i64).isMarked = true;
            let islandId: i32 = b2CreateIsland(world, setIndex);
            while (stackCount > 0i64) {
                stackCount = stackCount - 1i64;
                let bodyId: i32 = stack.at(stackCount);
                let tailBody: i32 = world.islands.at(islandId as i64).tailBody;
                world.bodies.at(bodyId as i64).islandId = islandId;
                if (tailBody != -1i32) world.bodies.at(tailBody as i64).islandNext = bodyId;
                world.bodies.at(bodyId as i64).islandPrev = tailBody;
                world.bodies.at(bodyId as i64).islandNext = -1i32;
                world.islands.at(islandId as i64).tailBody = bodyId;
                if (world.islands.at(islandId as i64).headBody == -1i32) world.islands.at(islandId as i64).headBody = bodyId;
                world.islands.at(islandId as i64).bodyCount = world.islands.at(islandId as i64).bodyCount + 1i32;
                var contactKey: i32 = world.bodies.at(bodyId as i64).headContactKey;
                while (contactKey != -1i32) {
                    let contactId: i32 = contactKey >> 1i32;
                    let edgeIndex: i32 = contactKey & 1i32;
                    let contact: ContactRecord = world.contacts.at(contactId as i64);
                    if (edgeIndex == 0i32) contactKey = contact.edgeA.nextKey;
                    else contactKey = contact.edgeB.nextKey;
                    if (not contact.isMarked and (contact.flags & 1u32) != 0u32) {
                        world.contacts.at(contactId as i64).isMarked = true;
                        var otherId: i32 = contact.edgeA.bodyId;
                        if (edgeIndex == 0i32) otherId = contact.edgeB.bodyId;
                        if (not world.bodies.at(otherId as i64).isMarked and world.bodies.at(otherId as i64).setIndex != 0i32) {
                            if (stackCount == stack.length()) stack.push(otherId);
                            else stack.at(stackCount) = otherId;
                            stackCount = stackCount + 1i64;
                            world.bodies.at(otherId as i64).isMarked = true;
                        }
                        let tailContact: i32 = world.islands.at(islandId as i64).tailContact;
                        world.contacts.at(contactId as i64).islandId = islandId;
                        if (tailContact != -1i32) world.contacts.at(tailContact as i64).islandNext = contactId;
                        world.contacts.at(contactId as i64).islandPrev = tailContact;
                        world.contacts.at(contactId as i64).islandNext = -1i32;
                        world.islands.at(islandId as i64).tailContact = contactId;
                        if (world.islands.at(islandId as i64).headContact == -1i32) world.islands.at(islandId as i64).headContact = contactId;
                        world.islands.at(islandId as i64).contactCount = world.islands.at(islandId as i64).contactCount + 1i32;
                    }
                }
                                                                   
                var jointKey: i32 = world.bodies.at(bodyId as i64).headJointKey;
                while (jointKey != -1i32) {
                    let jointId: i32 = jointKey >> 1i32; let side: i32 = jointKey & 1i32;
                    let joint: JointRecord = world.joints.at(jointId as i64);
                    jointKey = jointEdge(world.joints.at(jointId as i64), side).nextKey;
                    if (not joint.isMarked) {
                        world.joints.at(jointId as i64).isMarked = true;
                        let otherId: i32 = jointEdge(world.joints.at(jointId as i64), side ^ 1i32).bodyId;
                        if (world.bodies.at(otherId as i64).setIndex != 1i32) {
                            if (not world.bodies.at(otherId as i64).isMarked and world.bodies.at(otherId as i64).setIndex == 2i32) {
                                if (stackCount == stack.length()) stack.push(otherId); else stack.at(stackCount) = otherId;
                                stackCount = stackCount + 1i64; world.bodies.at(otherId as i64).isMarked = true;
                            }

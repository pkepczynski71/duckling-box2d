fun b2AddJointToGraph(world: ref World, id: i32, source: JointSim) -> () = {
    let joint: JointRecord = world.joints.at(id as i64);
    let a: i32 = joint.edgeA.bodyId; let b: i32 = joint.edgeB.bodyId;
    let staticA: bool = world.bodies.at(a as i64).setIndex == 0i32;
    let staticB: bool = world.bodies.at(b as i64).setIndex == 0i32;
    var selected: i32 = 11i32; var i: i32 = 0i32;
    while (i < 11i32 and selected == 11i32) {
        var color: ref GraphColor = &world.constraintGraph.colors[i];
        if ((staticA or not bits.b2GetBit(&color.bodySet, a)) and (staticB or not bits.b2GetBit(&color.bodySet, b))) {
            if (not staticA) bits.b2SetBitGrow(&color.bodySet, a);
            if (not staticB) bits.b2SetBitGrow(&color.bodySet, b);
            selected = i;
        }
        i = i + 1i32;
    }
    var selectedColor: ref GraphColor = &world.constraintGraph.colors[selected];
    let local: i32 = selectedColor.jointCount;
    if (local as i64 == selectedColor.jointSims.length()) selectedColor.jointSims.push(source);
    else selectedColor.jointSims.at(local as i64) = source;
    selectedColor.jointCount = local + 1i32;
    world.joints.at(id as i64).colorIndex = selected; world.joints.at(id as i64).localIndex = local;
}
fun b2RemoveJointFromGraph(world: ref World, a: i32, b: i32, colorIndex: i32, local: i32) -> () = {
    var color: ref GraphColor = &world.constraintGraph.colors[colorIndex];
    if (colorIndex != 11i32) { bits.b2ClearBit(&color.bodySet, a); bits.b2ClearBit(&color.bodySet, b); }
    let last: i32 = color.jointCount - 1i32;
    if (last != local) {
        let moved: JointSim = color.jointSims.at(last as i64);
        color.jointSims.at(local as i64) = moved; world.joints.at(moved.jointId as i64).localIndex = local;
    }
    color.jointCount = last;
}
                                                       
fun b2RemoveJointFromSet(world: ref World, setIndex: i32, local: i32) -> () = {
    var set: ref SolverSet = b2GetSolverSet(world, setIndex);
    let last: i32 = set.jointCount - 1i32;
    if (last != local) {
        let moved: JointSim = set.jointSims.at(last as i64);
        set.jointSims.at(local as i64) = moved; world.joints.at(moved.jointId as i64).localIndex = local;
    }
    set.jointCount = last;
}
fun b2AppendJointToSet(world: ref World, setIndex: i32, id: i32, source: JointSim) -> () = {

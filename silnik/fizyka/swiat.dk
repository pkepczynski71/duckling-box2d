    while (shapeSlot != -1i32) {
        var shape: ref ShapeRecord = world.shapes.at(shapeSlot as i64);
        let aabb: tree.AABB = expandAABB(b2ComputeShapeAABB(shape, transform), B2_SPECULATIVE_DISTANCE);
        shape.aabb = aabb;
        if (not tree.b2AABB_Contains(shape.fatAABB, aabb)) {
            shape.fatAABB = expandAABB(aabb, 0.05f32);
            if (shape.proxyKey != -1i32) broad.b2BroadPhase_MoveProxy(&world.broadPhase, shape.proxyKey, shape.fatAABB);
        }
        shapeSlot = shape.nextShapeId;
    }
}


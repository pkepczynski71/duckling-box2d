# Box2D 8c661469, src/shape.                                                                      
fun b2MakeShapeDistanceProxy(shape: ref ShapeRecord) -> distance.ShapeProxy = {
    var points: Vec2[8];
    if (shape.shapeType == 0i32) { points[0] = shape.circle.center; return distance.b2MakeProxy(&points,1i32,shape.circle.radius); }
    if (shape.shapeType == 1i32) { points[0] = shape.capsule.center1; points[1] = shape.capsule.center2; return distance.b2MakeProxy(&points,2i32,shape.capsule.radius); }
    if (shape.shapeType == 3i32) return distance.b2MakeProxy(&shape.polygon.vertices,shape.polygon.count,shape.polygon.radius);
    if (shape.shapeType == 2i32) { points[0] = shape.segment.point1; points[1] = shape.segment.point2; }
    else { points[0] = shape.chainSegment.segment.point1; points[1] = shape.chainSegment.segment.point2; }
    return distance.b2MakeProxy(&points,2i32,0.0f32);
}

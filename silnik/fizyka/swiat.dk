fun b2Body_Disable(id: BodyId) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    if (world.locked) return;
    let slot: i32 = id.index1 - 1i32;
    if (world.bodies.at(slot as i64).setIndex == 1i32) return;
    b2DestroyBodyContacts(world, slot, true);
                                                                      
    var jointKey: i32 = world.bodies.at(slot as i64).headJointKey;
    while (jointKey != -1i32) {
        let jointId: i32 = jointKey >> 1i32; let side: i32 = jointKey & 1i32;
        let joint: JointRecord = world.joints.at(jointId as i64);
        jointKey = jointEdge(world.joints.at(jointId as i64), side).nextKey;
        if (joint.setIndex != 1i32) {
            if (joint.islandId != -1i32) b2UnlinkJoint(world, jointId);
            b2TransferJoint(world, 1i32, jointId);
        }
    }
    var shapeSlot: i32 = world.bodies.at(slot as i64).headShapeId;
    while (shapeSlot != -1i32) {
        b2DestroyShapeProxy(world, shapeSlot);
        shapeSlot = world.shapes.at(shapeSlot as i64).nextShapeId;
    }
    b2RemoveBodyFromIsland(world, slot);
    let sourceIndex: i32 = world.bodies.at(slot as i64).setIndex;
    b2TransferBody(world, 1i32, sourceIndex, slot);
}
# Box2D 8c661469, src/body.c:1628-1720.
fun b2Body_Enable(id: BodyId) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    if (world.locked) return;
    let slot: i32 = id.index1 - 1i32;
    if (world.bodies.at(slot as i64).setIndex != 1i32) return;
    let bodyType: i32 = world.bodies.at(slot as i64).bodyType;
    let targetIndex: i32 = if bodyType == 0i32 then 0i32 else 2i32;
    b2TransferBody(world, targetIndex, 1i32, slot);
    let xf: Transform = b2GetBodySim(world, world.bodies.at(slot as i64)).transform;
    var shapeSlot: i32 = world.bodies.at(slot as i64).headShapeId;
    while (shapeSlot != -1i32) {
        b2CreateShapeProxy(world, shapeSlot, bodyType, xf, true);
        shapeSlot = world.shapes.at(shapeSlot as i64).nextShapeId;
    }
    if (targetIndex != 0i32) {
        let islandId: i32 = b2CreateIslandForBody(world, slot);
        world.bodies.at(slot as i64).islandId = islandId;
    }
                                                       
    var jointKey: i32 = world.bodies.at(slot as i64).headJointKey;
    while (jointKey != -1i32) {
        let jointId: i32 = jointKey >> 1i32; let side: i32 = jointKey & 1i32;
        let joint: JointRecord = world.joints.at(jointId as i64);
        jointKey = jointEdge(world.joints.at(jointId as i64), side).nextKey;
        let setA: i32 = world.bodies.at(joint.edgeA.bodyId as i64).setIndex;
        let setB: i32 = world.bodies.at(joint.edgeB.bodyId as i64).setIndex;
        if (setA != 1i32 and setB != 1i32) {
            let jointSet: i32 = if setA == 0i32 then setB else setA;
            b2TransferJoint(world, jointSet, jointId);

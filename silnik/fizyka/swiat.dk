# Box2D 8c661469, src/world.c:807-810.
fun b2CloseContactCapture(world: ref World) -> () = {
    world.endEventArrayIndex = 1i32 - world.endEventArrayIndex;
    if (world.endEventArrayIndex == 0i32) world.contactEndEvents0.clear();
    else world.contactEndEvents1.clear();

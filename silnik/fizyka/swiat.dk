    let output: distance.DistanceOutput = distance.b2ShapeDistance(&input, cache, &trace, 0i32, false);
    if (output.distance > radiusB + B2_SPECULATIVE_DISTANCE) return manifold;
    let n0: Vec2 = if smoothParams.convex1 then smoothParams.normal0 else normal1;
    let n2: Vec2 = if smoothParams.convex2 then smoothParams.normal2 else normal1;

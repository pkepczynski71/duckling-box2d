# Box2D 8c661469, src/shape.           
fun b2DestroyChain(id: ChainId) -> () = {
    var world: ref World = worlds.at(id.world0 as i64); if (world.locked) return;
    let slot: i32 = id.index1 - 1i32;
    let bodySlot: i32 = world.chainShapes.at(slot as i64).bodyId;
    let nextChain: i32 = world.chainShapes.at(slot as i64).nextChainId;
    var current: i32 = world.bodies.at(bodySlot as i64).headChainId; var previous: i32 = -1i32;
    while (current != -1i32 and current != slot) { previous = current; current = world.chainShapes.at(current as i64).nextChainId; }
    if (current == -1i32) return;
    if (previous == -1i32) world.bodies.at(bodySlot as i64).headChainId = nextChain;
    else world.chainShapes.at(previous as i64).nextChainId = nextChain;
    var i: i32 = 0i32;
    while (i < world.chainShapes.at(slot as i64).count) {
        let child: i32 = world.chainShapes.at(slot as i64).shapeIndices.at(i as i64);
        b2DestroyShape(b2MakeShapeId(world, child), false); i = i + 1i32;
    }
    b2FreeChainData(world.chainShapes.at(slot as i64)); b2FreeId(&world.chainIdPool, slot); world.chainShapes.at(slot as i64).id = -1i32;
}

fun b2CompareShapeRefs(a: ShapeRef, b: ShapeRef) -> i32 = {
    if (a.shapeId < b.shapeId) return -1i32;
    if (a.shapeId == b.shapeId) {
        if (a.generation < b.generation) return -1i32;
        if (a.generation == b.generation) return 0i32;
    }
    return 1i32;
}
# Box2D 8c661469, src/sensor.                                                                               
fun b2SortShapeRefs(values: ref List[ShapeRef]) -> () = {
    var i: i64 = 1i64;
    while (i < values.length()) {
        let value: ShapeRef = values.at(i); var j: i64 = i;
        while (j > 0i64 and b2CompareShapeRefs(value,values.at(j-1i64)) < 0i32) {
            values.at(j) = values.at(j-1i64); j = j-1i64;
        }
        values.at(j) = value; i = i+1i64;
    }
}

            while (i < count) { let neighborS0: f32 = poly.b2Dot(smoothParams.normal0, b2Sub(vertices[i], p1)); if (neighborS0 < s0) s0 = neighborS0; i = i + 1i32; }
            if (s0 > edgeSeparation) { edgeSeparation = s0; incidentIndex = -1i32; }

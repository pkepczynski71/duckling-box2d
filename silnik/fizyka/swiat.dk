}

# Box2D 8c661469, src/manifold.c:1256-1275. MIT. C enum encoded as named constants.
const b2_normalSkip: i32 = 0i32;
const b2_normalAdmit: i32 = 1i32;
const b2_normalSnap: i32 = 2i32;
class ChainSegmentParams { edge1: Vec2 = Vec2(); normal0: Vec2 = Vec2(); normal2: Vec2 = Vec2(); convex1: bool = false; convex2: bool = false; }

# Box2D 8c661469, src/manifold.c:1279-1317. MIT.
fun b2ClassifyNormal(params: ChainSegmentParams, normal: Vec2) -> i32 = {
    let sinTol: f32 = 0.01f32;
    if (poly.b2Dot(normal, params.edge1) <= 0.0f32) {
        if (params.convex1) {
            if (mass2.b2Cross(normal, params.normal0) > sinTol) return b2_normalSkip;
            return b2_normalAdmit;
        } else return b2_normalSnap;
    } else {
        if (params.convex2) {
            if (mass2.b2Cross(params.normal2, normal) > sinTol) return b2_normalSkip;
            return b2_normalAdmit;
        } else return b2_normalSnap;
    }

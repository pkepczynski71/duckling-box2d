fun b2Shape_GetSensorCapacity(id: broad.ShapeId) -> i32 = {
    var world: ref World = worlds.at(id.world0 as i64);
    if (world.locked) return 0i32;
    let index: i32 = world.shapes.at((id.index1-1i32) as i64).sensorIndex;
    if (index == -1i32) return 0i32;
    return world.sensors.at(index as i64).overlaps2.length() as i32;
}
# Box2D 8c661469, src/shape.                                                                              
fun b2Shape_GetSensorOverlaps(id: broad.ShapeId, capacity: i32) -> List[broad.ShapeId] = {
    var values: List[broad.ShapeId]; var world: ref World = worlds.at(id.world0 as i64);
    if (world.locked) return values;
    let index: i32 = world.shapes.at((id.index1-1i32) as i64).sensorIndex;
    if (index == -1i32) return values;
    var i: i32 = 0i32;
    while (i < capacity and i as i64 < world.sensors.at(index as i64).overlaps2.length()) {
        let r: ShapeRef = world.sensors.at(index as i64).overlaps2.at(i as i64);
        values.push(broad.ShapeId(r.shapeId+1i32,world.worldId,r.generation)); i = i+1i32;
    }
    return values;
}
# Box2D 8c661469, src/world.                                                                 
fun b2World_GetSensorEvents(id: WorldId) -> SensorEvents = {
    var result = SensorEvents(); var world: ref World = worlds.at((id.index1-1u16) as i64);
    if (world.locked) return result;
    result.beginEvents = copy world.sensorBeginEvents;
    if (world.endEventArrayIndex == 0i32) result.endEvents = copy world.sensorEndEvents1;
    else result.endEvents = copy world.sensorEndEvents0;
    return result;
}


                                                            
class Mat22 { cx: Vec2 = Vec2(); cy: Vec2 = Vec2(); }
fun b2Solve22(A: Mat22, b: Vec2) -> Vec2 = {
    let a11: f32 = A.cx.x; let a12: f32 = A.cy.x;
    let a21: f32 = A.cx.y; let a22: f32 = A.cy.y;
    var det: f32 = a11 * a22 - a12 * a21;
    if (det != 0.0f32) det = 1.0f32 / det;
    return Vec2(det * (a22 * b.x - a12 * b.y), det * (a11 * b.y - a21 * b.x));
}

                                                 
fun b2DefaultRevoluteJointDef() -> RevoluteJointDef = { return RevoluteJointDef(); }
fun b2CreateRevoluteJoint(worldId: WorldId, def: RevoluteJointDef) -> JointId = {
    var world: ref World = worlds.at((worldId.index1 - 1u16) as i64);
    if (world.locked) return JointId();
    let a: i32 = def.bodyIdA.index1 - 1i32; let b: i32 = def.bodyIdB.index1 - 1i32;
    var common = DistanceJointDef(); common.collideConnected = def.collideConnected;
    common.hasObjectId = def.hasObjectId; common.objectId = def.objectId;
    let id: i32 = b2CreateJoint(world,a,b,common,5i32,def.drawSize);
    var sim: ref JointSim = b2GetJointSim(world,id);
    sim.localOriginAnchorA = def.localAnchorA; sim.localOriginAnchorB = def.localAnchorB;
    sim.revoluteJoint = RevoluteJoint();
    sim.revoluteJoint.referenceAngle = mass2.b2ClampFloat(def.referenceAngle,-mass2.B2_PI,mass2.B2_PI);
    sim.revoluteJoint.targetAngle = mass2.b2ClampFloat(def.targetAngle,-mass2.B2_PI,mass2.B2_PI);
    sim.revoluteJoint.hertz = def.hertz;
    sim.revoluteJoint.dampingRatio = def.dampingRatio;
    sim.revoluteJoint.lowerAngle = def.lowerAngle;
    sim.revoluteJoint.upperAngle = def.upperAngle;
    sim.revoluteJoint.maxMotorTorque = def.maxMotorTorque;
    sim.revoluteJoint.motorSpeed = def.motorSpeed;
    sim.revoluteJoint.enableSpring = def.enableSpring;
    sim.revoluteJoint.enableLimit = def.enableLimit;
    sim.revoluteJoint.enableMotor = def.enableMotor;
    if (not def.collideConnected) b2DestroyContactsBetweenBodies(world,a,b);
    return JointId(id+1i32,world.worldId,world.joints.at(id as i64).generation);
}
fun b2RevoluteJoint_SetSpringHertz(id: JointId, value: f32) -> () = { b2GetJointSimCheckType(id).revoluteJoint.hertz = value; }
fun b2RevoluteJoint_GetSpringHertz(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).revoluteJoint.hertz; }
fun b2RevoluteJoint_SetSpringDampingRatio(id: JointId, value: f32) -> () = { b2GetJointSimCheckType(id).revoluteJoint.dampingRatio = value; }
fun b2RevoluteJoint_GetSpringDampingRatio(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).revoluteJoint.dampingRatio; }
fun b2RevoluteJoint_SetTargetAngle(id: JointId, value: f32) -> () = { b2GetJointSimCheckType(id).revoluteJoint.targetAngle = value; }
fun b2RevoluteJoint_GetTargetAngle(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).revoluteJoint.targetAngle; }
fun b2RevoluteJoint_SetMotorSpeed(id: JointId, value: f32) -> () = { b2GetJointSimCheckType(id).revoluteJoint.motorSpeed = value; }
fun b2RevoluteJoint_GetMotorSpeed(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).revoluteJoint.motorSpeed; }
fun b2RevoluteJoint_SetMaxMotorTorque(id: JointId, value: f32) -> () = { b2GetJointSimCheckType(id).revoluteJoint.maxMotorTorque = value; }
fun b2RevoluteJoint_GetMaxMotorTorque(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).revoluteJoint.maxMotorTorque; }
fun b2RevoluteJoint_EnableSpring(id: JointId, value: bool) -> () = {
    var joint: ref RevoluteJoint = &b2GetJointSimCheckType(id).revoluteJoint;
    if (joint.enableSpring != value) { joint.enableSpring = value; joint.springImpulse = 0.0f32; }
}
fun b2RevoluteJoint_IsSpringEnabled(id: JointId) -> bool = { return b2GetJointSimCheckType(id).revoluteJoint.enableSpring; }
fun b2RevoluteJoint_EnableLimit(id: JointId, value: bool) -> () = {
    var joint: ref RevoluteJoint = &b2GetJointSimCheckType(id).revoluteJoint;
    if (joint.enableLimit != value) { joint.enableLimit = value; joint.lowerImpulse = 0.0f32; joint.upperImpulse = 0.0f32; }
}
fun b2RevoluteJoint_IsLimitEnabled(id: JointId) -> bool = { return b2GetJointSimCheckType(id).revoluteJoint.enableLimit; }
fun b2RevoluteJoint_EnableMotor(id: JointId, value: bool) -> () = {
    var joint: ref RevoluteJoint = &b2GetJointSimCheckType(id).revoluteJoint;
    if (joint.enableMotor != value) { joint.enableMotor = value; joint.motorImpulse = 0.0f32; }
}
fun b2RevoluteJoint_IsMotorEnabled(id: JointId) -> bool = { return b2GetJointSimCheckType(id).revoluteJoint.enableMotor; }
fun b2RevoluteJoint_SetLimits(id: JointId, lower: f32, upper: f32) -> () = {
    var joint: ref RevoluteJoint = &b2GetJointSimCheckType(id).revoluteJoint;
    if (lower != joint.lowerAngle or upper != joint.upperAngle) {
        joint.lowerAngle = poly.b2MinFloat(lower,upper); joint.upperAngle = tree.b2MaxFloat(lower,upper);
        joint.lowerImpulse = 0.0f32; joint.upperImpulse = 0.0f32;
    }
}
fun b2RevoluteJoint_GetLowerLimit(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).revoluteJoint.lowerAngle; }
fun b2RevoluteJoint_GetUpperLimit(id: JointId) -> f32 = { return b2GetJointSimCheckType(id).revoluteJoint.upperAngle; }
fun b2RevoluteJoint_GetMotorTorque(id: JointId) -> f32 = { return worlds.at(id.world0 as i64).inv_h * b2GetJointSimCheckType(id).revoluteJoint.motorImpulse; }

                                                  
fun b2PrepareRevoluteJoint(world: ref World, base: ref JointSim, context: ref SolverContext) -> () = {
    let bodyA: BodyRecord = world.bodies.at(base.bodyIdA as i64);
    let bodyB: BodyRecord = world.bodies.at(base.bodyIdB as i64);
    let bodySimA: BodySim = b2GetSolverSet(world,bodyA.setIndex).bodySims.at(bodyA.localIndex as i64);
    let bodySimB: BodySim = b2GetSolverSet(world,bodyB.setIndex).bodySims.at(bodyB.localIndex as i64);
    let mA: f32 = bodySimA.invMass; let iA: f32 = bodySimA.invInertia;
    let mB: f32 = bodySimB.invMass; let iB: f32 = bodySimB.invInertia;
    base.invMassA = mA; base.invMassB = mB; base.invIA = iA; base.invIB = iB;
    var joint: ref RevoluteJoint = &base.revoluteJoint;
joint.indexA = if bodyA.setIndex == 2i32 then bodyA.localIndex else -1i32;
	joint.indexB = if bodyB.setIndex == 2i32 then bodyB.localIndex else -1i32;


	joint.anchorA = b2RotateVector( bodySimA.transform.q, b2Sub( base.localOriginAnchorA, bodySimA.localCenter ) );
	joint.anchorB = b2RotateVector( bodySimB.transform.q, b2Sub( base.localOriginAnchorB, bodySimB.localCenter ) );
	joint.deltaCenter = b2Sub( bodySimB.center, bodySimA.center );
	joint.deltaAngle = b2RelativeAngle( bodySimB.transform.q, bodySimA.transform.q );

	var k: f32 = iA + iB;
	joint.axialMass = if k > 0.0f32 then 1.0f32 / k else 0.0f32;

	joint.springSoftness = b2MakeSoft( joint.hertz, joint.dampingRatio, context.h );

	if ( context.enableWarmStarting == false )
	{
		joint.linearImpulse = Vec2();
		joint.springImpulse = 0.0f32;
		joint.motorImpulse = 0.0f32;
		joint.lowerImpulse = 0.0f32;
		joint.upperImpulse = 0.0f32;
	}
}
fun b2WarmStartRevoluteJoint(world: ref World, base: ref JointSim, context: ref SolverContext) -> () = {



	var mA: f32 = base.invMassA;
	var mB: f32 = base.invMassB;
	var iA: f32 = base.invIA;
	var iB: f32 = base.invIB;



	var joint: ref RevoluteJoint = &base.revoluteJoint;
	var stateA = BodyState();
    if (joint.indexA != -1i32) stateA = b2GetSolverSet(world,2i32).bodyStates.at(joint.indexA as i64);
	var stateB = BodyState();
    if (joint.indexB != -1i32) stateB = b2GetSolverSet(world,2i32).bodyStates.at(joint.indexB as i64);

	var rA: Vec2 = b2RotateVector( stateA.deltaRotation, joint.anchorA );
	var rB: Vec2 = b2RotateVector( stateB.deltaRotation, joint.anchorB );

	var axialImpulse: f32 = joint.springImpulse + joint.motorImpulse + joint.lowerImpulse - joint.upperImpulse;

	stateA.linearVelocity = distance.b2MulSub( stateA.linearVelocity, mA, joint.linearImpulse );
	stateA.angularVelocity = stateA.angularVelocity - iA * ( mass2.b2Cross( rA, joint.linearImpulse ) + axialImpulse );

	stateB.linearVelocity = b2MulAdd( stateB.linearVelocity, mB, joint.linearImpulse );
	stateB.angularVelocity = stateB.angularVelocity + iB * ( mass2.b2Cross( rB, joint.linearImpulse ) + axialImpulse );
    if (joint.indexA != -1i32) b2GetSolverSet(world,2i32).bodyStates.at(joint.indexA as i64) = stateA;
    if (joint.indexB != -1i32) b2GetSolverSet(world,2i32).bodyStates.at(joint.indexB as i64) = stateB;
}
fun b2SolveRevoluteJoint(world: ref World, base: ref JointSim, context: ref SolverContext, useBias: bool) -> () = {



	var mA: f32 = base.invMassA;
	var mB: f32 = base.invMassB;
	var iA: f32 = base.invIA;
	var iB: f32 = base.invIB;



	var joint: ref RevoluteJoint = &base.revoluteJoint;

	var stateA = BodyState();
    if (joint.indexA != -1i32) stateA = b2GetSolverSet(world,2i32).bodyStates.at(joint.indexA as i64);
	var stateB = BodyState();
    if (joint.indexB != -1i32) stateB = b2GetSolverSet(world,2i32).bodyStates.at(joint.indexB as i64);

	var vA: Vec2 = stateA.linearVelocity;
	var wA: f32 = stateA.angularVelocity;
	var vB: Vec2 = stateB.linearVelocity;
	var wB: f32 = stateB.angularVelocity;

	var dqA: Rot = stateA.deltaRotation;
	var dqB: Rot = stateB.deltaRotation;

	var fixedRotation: bool = ( iA + iB == 0.0f32 );


	if ( joint.enableSpring and fixedRotation == false )
	{
		var jointAngle: f32 = b2RelativeAngle( stateB.deltaRotation, stateA.deltaRotation ) + joint.deltaAngle;
		var jointAngleDelta: f32 = b2UnwindAngle( jointAngle - joint.targetAngle );

		var C: f32 = jointAngleDelta;
		var bias: f32 = joint.springSoftness.biasRate * C;
		var massScale: f32 = joint.springSoftness.massScale;
		var impulseScale: f32 = joint.springSoftness.impulseScale;

		var Cdot: f32 = wB - wA;
		var impulse: f32 = -massScale * joint.axialMass * ( Cdot + bias ) - impulseScale * joint.springImpulse;
		joint.springImpulse = joint.springImpulse + impulse;

		wA = wA - iA * impulse;
		wB = wB + iB * impulse;
	}


	if ( joint.enableMotor and fixedRotation == false )
	{
		var Cdot2: f32 = wB - wA - joint.motorSpeed;
		var impulse2: f32 = -joint.axialMass * Cdot2;
		var oldImpulse: f32 = joint.motorImpulse;
		var maxImpulse: f32 = context.h * joint.maxMotorTorque;
		joint.motorImpulse = mass2.b2ClampFloat( joint.motorImpulse + impulse2, -maxImpulse, maxImpulse );
		impulse2 = joint.motorImpulse - oldImpulse;

		wA = wA - iA * impulse2;
		wB = wB + iB * impulse2;
	}

	if ( joint.enableLimit and fixedRotation == false )
	{
		var jointAngle2: f32 = b2RelativeAngle( dqB, dqA ) + joint.deltaAngle - joint.referenceAngle;
		jointAngle2 = b2UnwindAngle( jointAngle2 );


		if (true) {
			var C2: f32 = jointAngle2 - joint.lowerAngle;
			var bias2: f32 = 0.0f32;
			var massScale2: f32 = 1.0f32;
			var impulseScale2: f32 = 0.0f32;
			if ( C2 > 0.0f32 )
			{
				bias2 = C2 * context.inv_h;
			}
			else if ( useBias )
			{
				bias2 = base.constraintSoftness.biasRate * C2;
				massScale2 = base.constraintSoftness.massScale;
				impulseScale2 = base.constraintSoftness.impulseScale;
			}

			var Cdot3: f32 = wB - wA;
			var oldImpulse2: f32 = joint.lowerImpulse;
			var impulse3: f32 = -massScale2 * joint.axialMass * ( Cdot3 + bias2 ) - impulseScale2 * oldImpulse2;
			joint.lowerImpulse = tree.b2MaxFloat( oldImpulse2 + impulse3, 0.0f32 );
			impulse3 = joint.lowerImpulse - oldImpulse2;

			wA = wA - iA * impulse3;
			wB = wB + iB * impulse3;
		}




		if (true) {
			var C3: f32 = joint.upperAngle - jointAngle2;
			var bias3: f32 = 0.0f32;
			var massScale3: f32 = 1.0f32;
			var impulseScale3: f32 = 0.0f32;
			if ( C3 > 0.0f32 )
			{
				bias3 = C3 * context.inv_h;
			}
			else if ( useBias )
			{
				bias3 = base.constraintSoftness.biasRate * C3;
				massScale3 = base.constraintSoftness.massScale;
				impulseScale3 = base.constraintSoftness.impulseScale;
			}


			var Cdot4: f32 = wA - wB;
			var oldImpulse3: f32 = joint.upperImpulse;
			var impulse4: f32 = -massScale3 * joint.axialMass * ( Cdot4 + bias3 ) - impulseScale3 * oldImpulse3;
			joint.upperImpulse = tree.b2MaxFloat( oldImpulse3 + impulse4, 0.0f32 );
			impulse4 = joint.upperImpulse - oldImpulse3;


			wA = wA + iA * impulse4;
			wB = wB - iB * impulse4;
		}
	}


	if (true) {
		var rA: Vec2 = b2RotateVector( stateA.deltaRotation, joint.anchorA );
		var rB: Vec2 = b2RotateVector( stateB.deltaRotation, joint.anchorB );

		var Cdot5: Vec2 = b2Sub( b2Add( vB, mass2.b2CrossSV( wB, rB ) ), b2Add( vA, mass2.b2CrossSV( wA, rA ) ) );

		var bias4: Vec2 = Vec2();
		var massScale4: f32 = 1.0f32;
		var impulseScale4: f32 = 0.0f32;
		if ( useBias )
		{
			var dcA: Vec2 = stateA.deltaPosition;
			var dcB: Vec2 = stateB.deltaPosition;

			var separation: Vec2 = b2Add( b2Add( b2Sub( dcB, dcA ), b2Sub( rB, rA ) ), joint.deltaCenter );
			bias4 = mass2.b2MulSV( base.constraintSoftness.biasRate, separation );
			massScale4 = base.constraintSoftness.massScale;
			impulseScale4 = base.constraintSoftness.impulseScale;
		}

		var K: Mat22 = Mat22();
		K.cx.x = mA + mB + rA.y * rA.y * iA + rB.y * rB.y * iB;
		K.cy.x = -rA.y * rA.x * iA - rB.y * rB.x * iB;
		K.cx.y = K.cy.x;
		K.cy.y = mA + mB + rA.x * rA.x * iA + rB.x * rB.x * iB;
		var b: Vec2 = b2Solve22( K, b2Add( Cdot5, bias4 ) );

		var impulse5: Vec2 = Vec2();
		impulse5.x = -massScale4 * b.x - impulseScale4 * joint.linearImpulse.x;
		impulse5.y = -massScale4 * b.y - impulseScale4 * joint.linearImpulse.y;
		joint.linearImpulse.x = joint.linearImpulse.x + impulse5.x;
		joint.linearImpulse.y = joint.linearImpulse.y + impulse5.y;

		vA = distance.b2MulSub( vA, mA, impulse5 );
		wA = wA - iA * mass2.b2Cross( rA, impulse5 );
		vB = b2MulAdd( vB, mB, impulse5 );
		wB = wB + iB * mass2.b2Cross( rB, impulse5 );
	}

	stateA.linearVelocity = vA;
	stateA.angularVelocity = wA;
	stateB.linearVelocity = vB;
	stateB.angularVelocity = wB;
    if (joint.indexA != -1i32) b2GetSolverSet(world,2i32).bodyStates.at(joint.indexA as i64) = stateA;
    if (joint.indexB != -1i32) b2GetSolverSet(world,2i32).bodyStates.at(joint.indexB as i64) = stateB;
}

                                                 
fun b2DefaultPrismaticJointDef() -> PrismaticJointDef = { return PrismaticJointDef(); }
fun b2CreatePrismaticJoint(worldId: WorldId, def: PrismaticJointDef) -> JointId = {
    var world: ref World = worlds.at((worldId.index1 - 1u16) as i64);
    if (world.locked) return JointId();
    let a: i32 = def.bodyIdA.index1 - 1i32; let b: i32 = def.bodyIdB.index1 - 1i32;
    var common = DistanceJointDef(); common.collideConnected = def.collideConnected;
    common.hasObjectId = def.hasObjectId; common.objectId = def.objectId;
    let id: i32 = b2CreateJoint(world,a,b,common,4i32,1.0f32);
    var sim: ref JointSim = b2GetJointSim(world,id);
    sim.localOriginAnchorA = def.localAnchorA; sim.localOriginAnchorB = def.localAnchorB;
    sim.prismaticJoint = PrismaticJoint();
    sim.prismaticJoint.referenceAngle = def.referenceAngle;
    sim.prismaticJoint.targetTranslation = def.targetTranslation;
    sim.prismaticJoint.hertz = def.hertz;
    sim.prismaticJoint.dampingRatio = def.dampingRatio;
    sim.prismaticJoint.lowerTranslation = def.lowerTranslation;
    sim.prismaticJoint.upperTranslation = def.upperTranslation;
    sim.prismaticJoint.maxMotorForce = def.maxMotorForce;
    sim.prismaticJoint.motorSpeed = def.motorSpeed;
    sim.prismaticJoint.enableSpring = def.enableSpring;
    sim.prismaticJoint.enableLimit = def.enableLimit;
    sim.prismaticJoint.enableMotor = def.enableMotor;
    sim.prismaticJoint.localAxisA = mass2.b2Normalize(def.localAxisA);
    if (not def.collideConnected) b2DestroyContactsBetweenBodies(world,a,b);
    return JointId(id+1i32,world.worldId,world.joints.at(id as i64).generation);
}

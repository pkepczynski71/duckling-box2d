}

# Box2D 8c661469, src/body.c:528-631. Shared pure calculation for raw update and S12 preflight.
class BodyMassResult {
    mass: f32 = 0.0f32;
    inertia: f32 = 0.0f32;
    originInertia: f32 = 0.0f32;
    sim: BodySim = BodySim();
    state: BodyState = BodyState();
}
# Box2D 8c661469, src/body.c:528-631. Shapes are already in head-to-tail order.
fun computeBodyMass(body: BodyRecord, sim: BodySim, state: BodyState, shapes: ref List[ShapeRecord]) -> BodyMassResult = {
    var result = BodyMassResult();
    result.sim = sim;
    result.state = state;
    result.sim.invMass = 0.0f32; result.sim.invInertia = 0.0f32;
    result.sim.localCenter = Vec2();
    result.sim.minExtent = 100000.0f32; result.sim.maxExtent = 0.0f32;
    if (body.bodyType != 2i32) {
        result.sim.center = sim.transform.p;
        result.sim.center0 = result.sim.center;
        if (body.bodyType == 1i32) {
            var k: i64 = 0i64;
            while (k < shapes.length()) {
                var kshape: ShapeRecord = shapes.at(k);
                let kextent: ShapeExtent = b2ComputeShapeExtent(&kshape, Vec2());
                result.sim.minExtent = poly.b2MinFloat(result.sim.minExtent, kextent.minExtent);
                result.sim.maxExtent = tree.b2MaxFloat(result.sim.maxExtent, kextent.maxExtent);
                k = k + 1i64;
            }
        }
        return result;
    }
    var localCenter = Vec2();
    var i: i64 = 0i64;
    while (i < shapes.length()) {
        var shape: ShapeRecord = shapes.at(i);
        if (shape.density != 0.0f32) {
            let md: mass2.MassData = b2ComputeShapeMassCentral(&shape);
            result.mass = result.mass + md.mass;
            localCenter = b2MulAdd(localCenter, md.mass, md.center);
            result.originInertia = result.originInertia + (md.rotationalInertia + md.mass * poly.b2Dot(md.center, md.center));
        }
        i = i + 1i64;
    }
    if (result.mass > 0.0f32) {
        result.sim.invMass = 1.0f32 / result.mass;
        localCenter = mass2.b2MulSV(result.sim.invMass, localCenter);
    }
    i = 0i64;
    while (i < shapes.length()) {
        var shape: ShapeRecord = shapes.at(i);
        if (shape.density != 0.0f32) {
            let md: mass2.MassData = b2ComputeShapeMassCentral(&shape);
            let offset: Vec2 = b2Sub(md.center, localCenter);
            result.inertia = result.inertia + (md.rotationalInertia + md.mass * poly.b2Dot(offset, offset));
        }
        i = i + 1i64;
    }
    if (result.inertia > 0.0f32 and not body.fixedRotation) {
        result.sim.invInertia = 1.0f32 / result.inertia;
    } else result.inertia = 0.0f32;
    result.sim.localCenter = localCenter;
    result.sim.center = b2TransformPoint(sim.transform, localCenter);
    result.sim.center0 = result.sim.center;
    let deltaLinear: Vec2 = poly.b2CrossSV(state.angularVelocity, b2Sub(result.sim.center, sim.center));
    result.state.linearVelocity = b2Add(state.linearVelocity, deltaLinear);
    var e: i64 = 0i64;
    while (e < shapes.length()) {
        var eshape: ShapeRecord = shapes.at(e);
        let extent: ShapeExtent = b2ComputeShapeExtent(&eshape, localCenter);
        result.sim.minExtent = poly.b2MinFloat(result.sim.minExtent, extent.minExtent);
        result.sim.maxExtent = tree.b2MaxFloat(result.sim.maxExtent, extent.maxExtent);
        e = e + 1i64;
    }
    return result;
}

# Box2D 8c661469, src/body.c:568-585,619-630. Value snapshot, no retained list references.
fun bodyShapes(world: ref World, bodySlot: i32) -> List[ShapeRecord] = {
    var values: List[ShapeRecord];
    var slot: i32 = world.bodies.at(bodySlot as i64).headShapeId;
    while (slot != -1i32) {
        let shape: ShapeRecord = world.shapes.at(slot as i64);
        values.push(shape);
        slot = shape.nextShapeId;
    }
    return values;
}

# Box2D 8c661469, src/body.c:528-631,1393-1403.
fun b2UpdateBodyMassData(world: ref World, bodySlot: i32) -> () = {
    let body: BodyRecord = world.bodies.at(bodySlot as i64);
    var set: ref SolverSet = b2GetSolverSet(world, body.setIndex);
    let sim: BodySim = set.bodySims.at(body.localIndex as i64);
    var state = BodyState();
    if (body.setIndex == 2i32) state = set.bodyStates.at(body.localIndex as i64);
    var shapes: List[ShapeRecord] = bodyShapes(world, bodySlot);
    let computed: BodyMassResult = computeBodyMass(body, sim, state, &shapes);
    world.bodies.at(bodySlot as i64).mass = computed.mass;
    world.bodies.at(bodySlot as i64).inertia = computed.inertia;
    set.bodySims.at(body.localIndex as i64) = computed.sim;
    if (body.setIndex == 2i32) set.bodyStates.at(body.localIndex as i64) = computed.state;
}

# Box2D 8c661469, include/box2d/id.                      
fun b2MakeShapeId(world: ref World, slot: i32) -> broad.ShapeId = {
    return broad.ShapeId(slot + 1i32, world.worldId, world.shapes.at(slot as i64).generation);
}
# Box2D 8c661469, include/box2d/id.h:118-129.
fun b2StoreShapeId(id: broad.ShapeId) -> Key64 = {
    return Key64(((id.world0 as u32) << 16u32) | (id.generation as u32), id.index1 as u32);
}
# Box2D 8c661469, src/world.c:1614-1644.
fun b2Shape_IsValid(id: broad.ShapeId) -> bool = {
    if (id.world0 >= 128u16) return false;
    var world: ref World = worlds.at(id.world0 as i64);
    if (world.worldId != id.world0) return false;
    if (id.index1 < 1i32 or id.index1 as i64 > world.shapes.length()) return false;
    let shape: ShapeRecord = world.shapes.at((id.index1 - 1i32) as i64);
    return shape.id != -1i32 and shape.generation == id.generation;
}

# Box2D 8c661469, src/shape.c:199-227. Conversion and rejection precede allocation.
fun resolveShape(source: ShapeRecord) -> ShapeRecord = {
    var shape: ShapeRecord = source;
    if (shape.shapeType == 1i32) {
        let distanceSqr: f32 = mass2.b2LengthSquared(b2Sub(shape.capsule.center1, shape.capsule.center2));
        if (distanceSqr <= B2_LINEAR_SLOP * B2_LINEAR_SLOP) {
            shape.shapeType = 0i32;
            shape.circle = Circle(b2Lerp(shape.capsule.center1, shape.capsule.center2, 0.5f32), shape.capsule.radius);
        }
    }
    return shape;
}

# Box2D 8c661469, src/shape.c:59-141,163-227,901-911.
fun b2CreateShape(bodyId: BodyId, source: ShapeRecord, updateBodyMass: bool, invokeContactCreation: bool) -> broad.ShapeId = {
    var shape: ShapeRecord = resolveShape(source);
    if (shape.shapeType == 2i32
        and mass2.b2LengthSquared(b2Sub(shape.segment.point1, shape.segment.point2)) <= B2_LINEAR_SLOP * B2_LINEAR_SLOP) return broad.ShapeId();
    let result: broad.ShapeId = b2CreateShapeInternal(bodyId, shape, invokeContactCreation);
    if (updateBodyMass) b2UpdateBodyMassData(worlds.at(bodyId.world0 as i64), bodyId.index1 - 1i32);
    return result;
}

# Box2D 8c661469, src/shape.                                                                             
fun b2CreateShapeInternal(bodyId: BodyId, source: ShapeRecord, invokeContactCreation: bool) -> broad.ShapeId = {
    var shape: ShapeRecord = source;
    var world: ref World = worlds.at(bodyId.world0 as i64);
    let bodySlot: i32 = bodyId.index1 - 1i32;
    let body: BodyRecord = world.bodies.at(bodySlot as i64);
    var set: ref SolverSet = b2GetSolverSet(world, body.setIndex);
    let xf: Transform = set.bodySims.at(body.localIndex as i64).transform;
    let slot: i32 = b2AllocId(&world.shapeIdPool);
    if (slot as i64 == world.shapes.length()) world.shapes.push(ShapeRecord());
    shape.generation = world.shapes.at(slot as i64).generation + 1u16;
    shape.id = slot; shape.bodyId = bodySlot;
    shape.localCentroid = b2GetShapeCentroid(&shape);
    shape.aabb = tree.AABB(); shape.fatAABB = tree.AABB(); shape.proxyKey = -1i32;
    if (body.setIndex != 1i32) {
        b2UpdateShapeAABBs(&shape, xf, body.bodyType);
        shape.proxyKey = broad.b2BroadPhase_CreateProxy(&world.broadPhase, body.bodyType, shape.fatAABB,
            shape.filter.categoryBits, slot, invokeContactCreation or shape.isSensor);
    }
    shape.enlargedAABB = false;
    shape.sensorIndex = -1i32;
    if (shape.isSensor) {
        shape.sensorIndex = world.sensors.length() as i32;
        var sensor = Sensor(); sensor.shapeId = slot;
        world.sensors.push(move sensor);
    }
    shape.prevShapeId = -1i32;
    shape.nextShapeId = body.headShapeId;
    if (body.headShapeId != -1i32) world.shapes.at(body.headShapeId as i64).prevShapeId = slot;
    world.shapes.at(slot as i64) = shape;
    world.bodies.at(bodySlot as i64).headShapeId = slot;
    world.bodies.at(bodySlot as i64).shapeCount = body.shapeCount + 1i32;
    return b2MakeShapeId(world, slot);
}

# Box2D 8c661469, src/shape.c:230-336. Destroy shape, contacts and its dense sensor entry.
fun b2DestroyShape(id: broad.ShapeId, updateBodyMass: bool) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    let slot: i32 = id.index1 - 1i32;
    let shape: ShapeRecord = world.shapes.at(slot as i64);
    if (shape.prevShapeId != -1i32) world.shapes.at(shape.prevShapeId as i64).nextShapeId = shape.nextShapeId;
    if (shape.nextShapeId != -1i32) world.shapes.at(shape.nextShapeId as i64).prevShapeId = shape.prevShapeId;
    if (world.bodies.at(shape.bodyId as i64).headShapeId == slot) world.bodies.at(shape.bodyId as i64).headShapeId = shape.nextShapeId;
    world.bodies.at(shape.bodyId as i64).shapeCount = world.bodies.at(shape.bodyId as i64).shapeCount - 1i32;
    b2DestroyShapeProxy(world, slot);
    b2DestroyShapeContacts(world, slot);
    if (shape.sensorIndex != -1i32) b2DestroySensor(world, slot);
    b2FreeId(&world.shapeIdPool, slot);
    world.shapes.at(slot as i64).id = -1i32;
    if (updateBodyMass) b2UpdateBodyMassData(world, shape.bodyId);
}

# Box2D 8c661469, src/shape.c:1055-1078. Equality returns even when update was requested.
fun b2Shape_SetDensity(id: broad.ShapeId, density: f32, updateBodyMass: bool) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    let slot: i64 = (id.index1 - 1i32) as i64;
    if (world.shapes.at(slot).density == density) return;
    world.shapes.at(slot).density = density;
    if (updateBodyMass) b2UpdateBodyMassData(world, world.shapes.at(slot).bodyId);
}

# Box2D 8c661469, src/body.c:502-525. Public AABB uses stored speculative boxes.
fun b2Body_ComputeAABB(id: BodyId) -> tree.AABB = {
    var world: ref World = worlds.at(id.world0 as i64);
    let body: BodyRecord = world.bodies.at((id.index1 - 1i32) as i64);
    var slot: i32 = body.headShapeId;
    if (slot == -1i32) {
        var set: ref SolverSet = b2GetSolverSet(world, body.setIndex);
        let p: Vec2 = set.bodySims.at(body.localIndex as i64).transform.p;
        return tree.AABB(p, p);
    }
    var result: tree.AABB = world.shapes.at(slot as i64).aabb;
    slot = world.shapes.at(slot as i64).nextShapeId;
    while (slot != -1i32) {
        result = tree.b2AABB_Union(result, world.shapes.at(slot as i64).aabb);
        slot = world.shapes.at(slot as i64).nextShapeId;
    }
    return result;
}

# Box2D 8c661469, src/body.c:1811-1828. Capacity-limited value copy in list order.
fun b2Body_GetShapes(id: BodyId, capacity: i32) -> List[broad.ShapeId] = {
    var values: List[broad.ShapeId];
    var world: ref World = worlds.at(id.world0 as i64);
    var slot: i32 = world.bodies.at((id.index1 - 1i32) as i64).headShapeId;
    while (slot != -1i32 and values.length() < capacity as i64) {
        values.push(b2MakeShapeId(world, slot));
        slot = world.shapes.at(slot as i64).nextShapeId;
    }
    return values;
}

# Box2D 8c661469, src/body.c:767-813.                                                     
fun b2Body_SetLinearVelocity(id: BodyId, velocity: Vec2) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    let body: BodyRecord = world.bodies.at((id.index1 - 1i32) as i64);
    if (body.bodyType == 0i32) return;
    if (mass2.b2LengthSquared(velocity) > 0.0f32) b2WakeBody(world, body.id);
    let current: BodyRecord = world.bodies.at(body.id as i64);
    if (current.setIndex == 2i32) b2GetSolverSet(world, 2i32).bodyStates.at(current.localIndex as i64).linearVelocity = velocity;
}
# Box2D 8c661469, src/body.c:790-813. A fixed-rotation setter is a no-op.
fun b2Body_SetAngularVelocity(id: BodyId, velocity: f32) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    let body: BodyRecord = world.bodies.at((id.index1 - 1i32) as i64);
    if (body.bodyType == 0i32 or body.fixedRotation) return;
    if (velocity != 0.0f32) b2WakeBody(world, body.id);
    let current: BodyRecord = world.bodies.at(body.id as i64);
    if (current.setIndex == 2i32) b2GetSolverSet(world, 2i32).bodyStates.at(current.localIndex as i64).angularVelocity = velocity;
}

# Box2D 8c661469, src/body.c:900-1020. Shared access for the six public actions.
                                                      
fun b2Body_ApplyAction(id: BodyId, kind: i32, value: Vec2, point: Vec2, wake: bool) -> () = {
    var world: ref World = worlds.at(id.world0 as i64);
    if (wake) b2WakeBody(world, id.index1 - 1i32);
    let body: BodyRecord = world.bodies.at((id.index1 - 1i32) as i64);
    if (body.setIndex != 2i32) return;
    var sim: ref BodySim = b2GetSolverSet(world, 2i32).bodySims.at(body.localIndex as i64);
    var state: ref BodyState = b2GetSolverSet(world, 2i32).bodyStates.at(body.localIndex as i64);
    if (kind == 0i32 or kind == 1i32) {
        sim.force = b2Add(sim.force, value);
        if (kind == 0i32) sim.torque = sim.torque + mass2.b2Cross(b2Sub(point, sim.center), value);
    } else if (kind == 2i32) sim.torque = sim.torque + value.x;
    else if (kind == 3i32 or kind == 4i32) {
        state.linearVelocity = b2MulAdd(state.linearVelocity, sim.invMass, value);
        if (kind == 3i32) state.angularVelocity = state.angularVelocity + sim.invInertia * mass2.b2Cross(b2Sub(point, sim.center), value);
        let speedSquared: f32 = mass2.b2LengthSquared(state.linearVelocity);
        if (speedSquared > world.maxLinearSpeed * world.maxLinearSpeed) {
            state.linearVelocity = mass2.b2MulSV(world.maxLinearSpeed / math.sqrt(speedSquared), state.linearVelocity);
        }
    } else if (kind == 5i32) state.angularVelocity = state.angularVelocity + sim.invInertia * value.x;
}
# Box2D 8c661469, src/body.c:900.
fun b2Body_ApplyForce(id: BodyId, force: Vec2, point: Vec2, wake: bool) -> () = { b2Body_ApplyAction(id, 0i32, force, point, wake); }
# Box2D 8c661469, src/body.c:918.
fun b2Body_ApplyForceToCenter(id: BodyId, force: Vec2, wake: bool) -> () = { b2Body_ApplyAction(id, 1i32, force, Vec2(), wake); }
# Box2D 8c661469, src/body.c:935.
fun b2Body_ApplyTorque(id: BodyId, torque: f32, wake: bool) -> () = { b2Body_ApplyAction(id, 2i32, Vec2(torque, 0.0f32), Vec2(), wake); }
# Box2D 8c661469, src/body.c:952.
fun b2Body_ApplyLinearImpulse(id: BodyId, impulse: Vec2, point: Vec2, wake: bool) -> () = { b2Body_ApplyAction(id, 3i32, impulse, point, wake); }
# Box2D 8c661469, src/body.c:975.
fun b2Body_ApplyLinearImpulseToCenter(id: BodyId, impulse: Vec2, wake: bool) -> () = { b2Body_ApplyAction(id, 4i32, impulse, Vec2(), wake); }
# Box2D 8c661469, src/body.c:997.
fun b2Body_ApplyAngularImpulse(id: BodyId, impulse: f32, wake: bool) -> () = { b2Body_ApplyAction(id, 5i32, Vec2(impulse, 0.0f32), Vec2(), wake); }

# Box2D 8c661469, src/broad_phase.c:234-277. Snapshot from the one real owner.
fun collisionView(world: ref World) -> broad.CollisionView = {
    var view = broad.CollisionView(); view.worldId = world.worldId;
    var bi: i64 = 0i64;
    while (bi < world.bodies.length()) {
        let body: BodyRecord = world.bodies.at(bi);
        var bv = broad.BodyView(); bv.id = body.id; bv.bodyType = body.bodyType; bv.headJointKey = body.headJointKey; bv.jointCount = body.jointCount;
        view.bodies.push(bv); bi = bi + 1i64;
    }
    var si: i64 = 0i64;
    while (si < world.shapes.length()) {
        let shape: ShapeRecord = world.shapes.at(si);
        view.shapes.push(broad.ShapeView(shape.id, shape.bodyId, shape.sensorIndex, shape.proxyKey, shape.filter, shape.generation));
        si = si + 1i64;
    }
                                                                                          
    var ji: i64 = 0i64;
    while (ji < world.joints.length()) {
        let joint: JointRecord = world.joints.at(ji);
        view.joints.push(broad.JointView(joint.edgeA.bodyId, joint.edgeB.bodyId, joint.edgeA.nextKey, joint.edgeB.nextKey, joint.collideConnected));
        ji = ji + 1i64;
    }
    return view;
}

# Box2D 8c661469, src/solver.c:65-129. Same f32 expressions as ruch.dk, plus the cap flag.
fun b2IntegrateVelocity(sim: ref BodySim, state: ref BodyState, gravity: Vec2, h: f32, inv_dt: f32, maxLinearSpeed: f32) -> () = {
    let maxAngularSpeed: f32 = mass2.B2_MAX_ROTATION * inv_dt;
    var v: Vec2 = state.linearVelocity;
    var w: f32 = state.angularVelocity;
    let linearDamping: f32 = 1.0f32 / (1.0f32 + h * sim.linearDamping);
    let angularDamping: f32 = 1.0f32 / (1.0f32 + h * sim.angularDamping);
    let gravityScale: f32 = if sim.invMass > 0.0f32 then sim.gravityScale else 0.0f32;
    let linearVelocityDelta: Vec2 = b2Add(mass2.b2MulSV(h * sim.invMass, sim.force), mass2.b2MulSV(h * gravityScale, gravity));
    let angularVelocityDelta: f32 = h * sim.invInertia * sim.torque;
    v = b2MulAdd(linearVelocityDelta, linearDamping, v);
    w = angularVelocityDelta + angularDamping * w;
    if (poly.b2Dot(v, v) > maxLinearSpeed * maxLinearSpeed) {
        v = mass2.b2MulSV(maxLinearSpeed / mass2.b2Length(v), v); sim.isSpeedCapped = true;
    }
    if (w * w > maxAngularSpeed * maxAngularSpeed and not sim.allowFastRotation) {
        w = w * (maxAngularSpeed / mass2.b2AbsFloat(w)); sim.isSpeedCapped = true;
    }
    state.linearVelocity = v; state.angularVelocity = w;
}

# Box2D 8c661469, src/solver.c:543-726. Finalize once, after all substeps.
fun b2FinalizeBody(world: ref World, local: i32) -> () = {
    var sim: BodySim = b2GetSolverSet(world, 2i32).bodySims.at(local as i64);
    var state: BodyState = b2GetSolverSet(world, 2i32).bodyStates.at(local as i64);

# Box2D 8c661469, src/world.            
fun b2Chain_IsValid(id: ChainId) -> bool = {
    if (id.world0 >= 128u16) return false;
    var world: ref World = worlds.at(id.world0 as i64);
    if (world.worldId != id.world0) return false;
    let slot: i32 = id.index1 - 1i32;
    if (slot < 0i32 or slot as i64 >= world.chainShapes.length()) return false;
    return world.chainShapes.at(slot as i64).id != -1i32 and world.chainShapes.at(slot as i64).generation == id.generation;
}

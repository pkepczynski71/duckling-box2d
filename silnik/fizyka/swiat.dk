# Box2D 8c661469, src/world.c:100.                                                 
fun b2CreateWorld(gravity: Vec2, maxLinearSpeed: f32) -> WorldId = {
    var i: i32 = 0i32;
    while (i < 128i32) {
        if (not worlds.at(i as i64).inUse) {
            let generation: u16 = worlds.at(i as i64).generation;
            var created = World();
            created.worldId = i as u16;
            created.generation = generation;
            created.inUse = true;
            created.gravity = gravity;
            created.maxLinearSpeed = maxLinearSpeed;
            broad.b2CreateBroadPhase(&created.broadPhase);
            b2CreateGraph(&created.constraintGraph, 16i32);
            created.contactStateBitSet = bits.b2CreateBitSet(1024i32);
            worlds.at(i as i64) = move created;
            return WorldId((i + 1i32) as u16, generation);
        }
        i = i + 1i32;
    }
    return WorldId();
}

# Box2D 8c661469, src/world.c:1746-1756. The sole raw warm-start setter required by step10.
fun b2World_EnableWarmStarting(id: WorldId, flag: bool) -> () = {
    var world: ref World = worlds.at((id.index1 - 1u16) as i64);
    if (world.locked) return;
    world.enableWarmStarting = flag;
}

# Box2D 8c661469, src/world.                                   
fun b2DestroyWorld(id: WorldId) -> () = {
    let slot: i64 = (id.index1 - 1u16) as i64;
    let generation: u16 = worlds.at(slot).generation;
    var chainSlot: i32 = 0i32;
    while (chainSlot < worlds.at(slot).chainIdPool.nextIndex) {
        if (worlds.at(slot).chainShapes.at(chainSlot as i64).id != -1i32) b2FreeChainData(worlds.at(slot).chainShapes.at(chainSlot as i64));
        chainSlot = chainSlot + 1i32;
    }
    b2DestroyGraph(&worlds.at(slot).constraintGraph);
    bits.b2DestroyBitSet(&worlds.at(slot).contactStateBitSet);
    broad.b2DestroyBroadPhase(&worlds.at(slot).broadPhase);
    var cleared = World();
    cleared.generation = generation + 1u16;
    worlds.at(slot) = move cleared;
}

# Box2D 8c661469, src/world.c:1557. Deliberately the raw predicate, not the game guard.
fun b2World_IsValid(id: WorldId) -> bool = {
    if (id.index1 < 1u16 or id.index1 > 128u16) return false;
    let slot: i64 = (id.index1 - 1u16) as i64;
    return worlds.at(slot).worldId == id.index1 - 1u16
        and worlds.at(slot).generation == id.generation;
}

# Box2D 8c661469, src/world.c:1576.
fun b2Body_IsValid(id: BodyId) -> bool = {
    if (id.world0 >= 128u16) return false;
    var world: ref World = worlds.at(id.world0 as i64);
    if (world.worldId != id.world0) return false;
    if (id.index1 < 1i32 or id.index1 as i64 > world.bodies.length()) return false;
    let record: BodyRecord = world.bodies.at((id.index1 - 1i32) as i64);
    return record.setIndex != -1i32 and record.generation == id.generation;
}

# Box2D 8c661469, include/box2d/id.h:93.
fun b2StoreWorldId(id: WorldId) -> u32 = {
    return ((id.index1 as u32) << 16u32) | (id.generation as u32);
}
# Box2D 8c661469, include/box2d/id.h:106.
fun b2StoreBodyId(id: BodyId) -> Key64 = {
    return Key64(((id.world0 as u32) << 16u32) | (id.generation as u32), id.index1 as u32);
}

# Box2D 8c661469, src/body.c:63.
fun b2MakeBodyId(world: ref World, slot: i32) -> BodyId = {
    return BodyId(slot + 1i32, world.worldId, world.bodies.at(slot as i64).generation);
}

# Box2D 8c661469, src/island.c:18-56. Empty island, initialized before linking bodies.
fun b2CreateIsland(world: ref World, setIndex: i32) -> i32 = {
    let id: i32 = b2AllocId(&world.islandIdPool);
    var island = Island();
    island.islandId = id;
    island.setIndex = setIndex;
    island.localIndex = b2GetSolverSet(world, setIndex).islandCount;
    if (id as i64 == world.islands.length()) world.islands.push(island);
    else world.islands.at(id as i64) = island;
    let local: i32 = b2GetSolverSet(world, setIndex).islandCount;
    if (local as i64 == b2GetSolverSet(world, setIndex).islandSims.length()) b2GetSolverSet(world, setIndex).islandSims.push(id);
    else b2GetSolverSet(world, setIndex).islandSims.at(local as i64) = id;
    b2GetSolverSet(world, setIndex).islandCount = local + 1i32;
    return id;
}

# Box2D 8c661469, src/body.c:84-97. Singleton uses the same island allocator as Split.
fun b2CreateIslandForBody(world: ref World, bodyId: i32) -> i32 = {
    let id: i32 = b2CreateIsland(world, world.bodies.at(bodyId as i64).setIndex);
    world.islands.at(id as i64).headBody = bodyId;
    world.islands.at(id as i64).tailBody = bodyId;
    world.islands.at(id as i64).bodyCount = 1i32;
    return id;
}

# Box2D 8c661469, src/island.                                                                    
fun b2DestroyIsland(world: ref World, id: i32) -> () = {
    if (world.splitIslandId == id) world.splitIslandId = -1i32;
    let setIndex: i32 = world.islands.at(id as i64).setIndex;
    let local: i32 = world.islands.at(id as i64).localIndex;
    let last: i32 = b2GetSolverSet(world, setIndex).islandCount - 1i32;
    if (local != last) {
        let movedId: i32 = b2GetSolverSet(world, setIndex).islandSims.at(last as i64);
        b2GetSolverSet(world, setIndex).islandSims.at(local as i64) = movedId;
        world.islands.at(movedId as i64).localIndex = local;
    }
    b2GetSolverSet(world, setIndex).islandCount = last;
    world.islands.at(id as i64).islandId = -1i32;
    world.islands.at(id as i64).setIndex = -1i32;
    world.islands.at(id as i64).localIndex = -1i32;
    b2FreeId(&world.islandIdPool, id);
}

# Box2D 8c661469, src/island.c:602-837.                                                                    
fun b2SplitIsland(world: ref World, baseId: i32) -> () = {

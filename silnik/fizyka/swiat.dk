fun b2PreparePrismaticJoint(world: ref World, base: ref JointSim, context: ref SolverContext) -> () = {
    let bodyA: BodyRecord = world.bodies.at(base.bodyIdA as i64);
    let bodyB: BodyRecord = world.bodies.at(base.bodyIdB as i64);
    let bodySimA: BodySim = b2GetSolverSet(world,bodyA.setIndex).bodySims.at(bodyA.localIndex as i64);
    let bodySimB: BodySim = b2GetSolverSet(world,bodyB.setIndex).bodySims.at(bodyB.localIndex as i64);
    let mA: f32 = bodySimA.invMass; let iA: f32 = bodySimA.invInertia;
    let mB: f32 = bodySimB.invMass; let iB: f32 = bodySimB.invInertia;
    base.invMassA = mA; base.invMassB = mB; base.invIA = iA; base.invIB = iB;
    var joint: ref PrismaticJoint = &base.prismaticJoint;
joint.indexA = if bodyA.setIndex == 2i32 then bodyA.localIndex else -1i32;
	joint.indexB = if bodyB.setIndex == 2i32 then bodyB.localIndex else -1i32;

	var qA: Rot = bodySimA.transform.q;
	var qB: Rot = bodySimB.transform.q;

	joint.anchorA = b2RotateVector( qA, b2Sub( base.localOriginAnchorA, bodySimA.localCenter ) );
	joint.anchorB = b2RotateVector( qB, b2Sub( base.localOriginAnchorB, bodySimB.localCenter ) );
	joint.axisA = b2RotateVector( qA, joint.localAxisA );
	joint.deltaCenter = b2Sub( bodySimB.center, bodySimA.center );
	joint.deltaAngle = b2RelativeAngle( qB, qA ) - joint.referenceAngle;
	joint.deltaAngle = b2UnwindAngle( joint.deltaAngle );

	var rA: Vec2 = joint.anchorA;
	var rB: Vec2 = joint.anchorB;

	var d: Vec2 = b2Add( joint.deltaCenter, b2Sub( rB, rA ) );
	var a1: f32 = mass2.b2Cross( b2Add( d, rA ), joint.axisA );
	var a2: f32 = mass2.b2Cross( rB, joint.axisA );


	var k: f32 = mA + mB + iA * a1 * a1 + iB * a2 * a2;
	joint.axialMass = if k > 0.0f32 then 1.0f32 / k else 0.0f32;

	joint.springSoftness = b2MakeSoft( joint.hertz, joint.dampingRatio, context.h );

	if ( context.enableWarmStarting == false )
	{
		joint.impulse = Vec2();
		joint.springImpulse = 0.0f32;
		joint.motorImpulse = 0.0f32;
		joint.lowerImpulse = 0.0f32;
		joint.upperImpulse = 0.0f32;
	}
}
fun b2WarmStartPrismaticJoint(world: ref World, base: ref JointSim, context: ref SolverContext) -> () = {



	var mA: f32 = base.invMassA;
	var mB: f32 = base.invMassB;
	var iA: f32 = base.invIA;
	var iB: f32 = base.invIB;



	var joint: ref PrismaticJoint = &base.prismaticJoint;

	var stateA = BodyState();
    if (joint.indexA != -1i32) stateA = b2GetSolverSet(world,2i32).bodyStates.at(joint.indexA as i64);
	var stateB = BodyState();
    if (joint.indexB != -1i32) stateB = b2GetSolverSet(world,2i32).bodyStates.at(joint.indexB as i64);

	var rA: Vec2 = b2RotateVector( stateA.deltaRotation, joint.anchorA );
	var rB: Vec2 = b2RotateVector( stateB.deltaRotation, joint.anchorB );

	var d: Vec2 = b2Add( b2Add( b2Sub( stateB.deltaPosition, stateA.deltaPosition ), joint.deltaCenter ), b2Sub( rB, rA ) );
	var axisA: Vec2 = b2RotateVector( stateA.deltaRotation, joint.axisA );


	var a1: f32 = mass2.b2Cross( b2Add( d, rA ), axisA );
	var a2: f32 = mass2.b2Cross( rB, axisA );
	var axialImpulse: f32 = joint.springImpulse + joint.motorImpulse + joint.lowerImpulse - joint.upperImpulse;


	var perpA: Vec2 = b2LeftPerp( axisA );
	var s1: f32 = mass2.b2Cross( b2Add( d, rA ), perpA );
	var s2: f32 = mass2.b2Cross( rB, perpA );
	var perpImpulse: f32 = joint.impulse.x;
	var angleImpulse: f32 = joint.impulse.y;

	var P: Vec2 = b2Add( mass2.b2MulSV( axialImpulse, axisA ), mass2.b2MulSV( perpImpulse, perpA ) );
	var LA: f32 = axialImpulse * a1 + perpImpulse * s1 + angleImpulse;
	var LB: f32 = axialImpulse * a2 + perpImpulse * s2 + angleImpulse;

	stateA.linearVelocity = distance.b2MulSub( stateA.linearVelocity, mA, P );
	stateA.angularVelocity = stateA.angularVelocity - iA * LA;
	stateB.linearVelocity = b2MulAdd( stateB.linearVelocity, mB, P );
	stateB.angularVelocity = stateB.angularVelocity + iB * LB;
    if (joint.indexA != -1i32) b2GetSolverSet(world,2i32).bodyStates.at(joint.indexA as i64) = stateA;
    if (joint.indexB != -1i32) b2GetSolverSet(world,2i32).bodyStates.at(joint.indexB as i64) = stateB;
}
fun b2SolvePrismaticJoint(world: ref World, base: ref JointSim, context: ref SolverContext, useBias: bool) -> () = {



	var mA: f32 = base.invMassA;
	var mB: f32 = base.invMassB;
	var iA: f32 = base.invIA;
	var iB: f32 = base.invIB;



	var joint: ref PrismaticJoint = &base.prismaticJoint;

	var stateA = BodyState();
    if (joint.indexA != -1i32) stateA = b2GetSolverSet(world,2i32).bodyStates.at(joint.indexA as i64);
	var stateB = BodyState();
    if (joint.indexB != -1i32) stateB = b2GetSolverSet(world,2i32).bodyStates.at(joint.indexB as i64);

	var vA: Vec2 = stateA.linearVelocity;
	var wA: f32 = stateA.angularVelocity;
	var vB: Vec2 = stateB.linearVelocity;
	var wB: f32 = stateB.angularVelocity;


	var rA: Vec2 = b2RotateVector( stateA.deltaRotation, joint.anchorA );
	var rB: Vec2 = b2RotateVector( stateB.deltaRotation, joint.anchorB );

	var d: Vec2 = b2Add( b2Add( b2Sub( stateB.deltaPosition, stateA.deltaPosition ), joint.deltaCenter ), b2Sub( rB, rA ) );
	var axisA: Vec2 = b2RotateVector( stateA.deltaRotation, joint.axisA );
	var translation: f32 = mass2.b2Dot( axisA, d );


	var a1: f32 = mass2.b2Cross( b2Add( d, rA ), axisA );
	var a2: f32 = mass2.b2Cross( rB, axisA );


	if ( joint.enableSpring )
	{
		var C: f32 = translation - joint.targetTranslation;
		var bias: f32 = joint.springSoftness.biasRate * C;
		var massScale: f32 = joint.springSoftness.massScale;
		var impulseScale: f32 = joint.springSoftness.impulseScale;

		var Cdot: f32 = mass2.b2Dot( axisA, b2Sub( vB, vA ) ) + a2 * wB - a1 * wA;
		var deltaImpulse: f32 = -massScale * joint.axialMass * ( Cdot + bias ) - impulseScale * joint.springImpulse;
		joint.springImpulse = joint.springImpulse + deltaImpulse;

		var P: Vec2 = mass2.b2MulSV( deltaImpulse, axisA );
		var LA: f32 = deltaImpulse * a1;
		var LB: f32 = deltaImpulse * a2;

		vA = distance.b2MulSub( vA, mA, P );
		wA = wA - iA * LA;
		vB = b2MulAdd( vB, mB, P );
		wB = wB + iB * LB;
	}


	if ( joint.enableMotor )
	{
		var Cdot2: f32 = mass2.b2Dot( axisA, b2Sub( vB, vA ) ) + a2 * wB - a1 * wA;
		var impulse: f32 = joint.axialMass * ( joint.motorSpeed - Cdot2 );
		var oldImpulse: f32 = joint.motorImpulse;
		var maxImpulse: f32 = context.h * joint.maxMotorForce;
		joint.motorImpulse = mass2.b2ClampFloat( joint.motorImpulse + impulse, -maxImpulse, maxImpulse );
		impulse = joint.motorImpulse - oldImpulse;

		var P2: Vec2 = mass2.b2MulSV( impulse, axisA );
		var LA2: f32 = impulse * a1;
		var LB2: f32 = impulse * a2;

		vA = distance.b2MulSub( vA, mA, P2 );
		wA = wA - iA * LA2;
		vB = b2MulAdd( vB, mB, P2 );
		wB = wB + iB * LB2;
	}

	if ( joint.enableLimit )
	{
		if (true) {
			var C2: f32 = translation - joint.lowerTranslation;
			var bias2: f32 = 0.0f32;
			var massScale2: f32 = 1.0f32;
			var impulseScale2: f32 = 0.0f32;

			if ( C2 > 0.0f32 )
			{
				bias2 = C2 * context.inv_h;
			}
			else if ( useBias )
			{
				bias2 = base.constraintSoftness.biasRate * C2;
				massScale2 = base.constraintSoftness.massScale;
				impulseScale2 = base.constraintSoftness.impulseScale;
			}

			var oldImpulse2: f32 = joint.lowerImpulse;
			var Cdot3: f32 = mass2.b2Dot( axisA, b2Sub( vB, vA ) ) + a2 * wB - a1 * wA;
			var impulse2: f32 = -joint.axialMass * massScale2 * ( Cdot3 + bias2 ) - impulseScale2 * oldImpulse2;
			joint.lowerImpulse = tree.b2MaxFloat( oldImpulse2 + impulse2, 0.0f32 );
			impulse2 = joint.lowerImpulse - oldImpulse2;

			var P3: Vec2 = mass2.b2MulSV( impulse2, axisA );
			var LA3: f32 = impulse2 * a1;
			var LB3: f32 = impulse2 * a2;

			vA = distance.b2MulSub( vA, mA, P3 );
			wA = wA - iA * LA3;
			vB = b2MulAdd( vB, mB, P3 );
			wB = wB + iB * LB3;
		}




		if (true) {
			var C3: f32 = joint.upperTranslation - translation;
			var bias3: f32 = 0.0f32;
			var massScale3: f32 = 1.0f32;
			var impulseScale3: f32 = 0.0f32;

			if ( C3 > 0.0f32 )
			{
				bias3 = C3 * context.inv_h;
			}
			else if ( useBias )
			{
				bias3 = base.constraintSoftness.biasRate * C3;
				massScale3 = base.constraintSoftness.massScale;
				impulseScale3 = base.constraintSoftness.impulseScale;
			}

			var oldImpulse3: f32 = joint.upperImpulse;

			var Cdot4: f32 = mass2.b2Dot( axisA, b2Sub( vA, vB ) ) + a1 * wA - a2 * wB;
			var impulse3: f32 = -joint.axialMass * massScale3 * ( Cdot4 + bias3 ) - impulseScale3 * oldImpulse3;
			joint.upperImpulse = tree.b2MaxFloat( oldImpulse3 + impulse3, 0.0f32 );
			impulse3 = joint.upperImpulse - oldImpulse3;

			var P4: Vec2 = mass2.b2MulSV( impulse3, axisA );
			var LA4: f32 = impulse3 * a1;
			var LB4: f32 = impulse3 * a2;


			vA = b2MulAdd( vA, mA, P4 );
			wA = wA + iA * LA4;
			vB = distance.b2MulSub( vB, mB, P4 );
			wB = wB - iB * LB4;
		}
	}


	if (true) {
		var perpA: Vec2 = b2LeftPerp( axisA );


		var s1: f32 = mass2.b2Cross( b2Add( d, rA ), perpA );
		var s2: f32 = mass2.b2Cross( rB, perpA );

		var Cdot5: Vec2 = Vec2();
		Cdot5.x = mass2.b2Dot( perpA, b2Sub( vB, vA ) ) + s2 * wB - s1 * wA;
		Cdot5.y = wB - wA;

		var bias4: Vec2 = Vec2();
		var massScale4: f32 = 1.0f32;
		var impulseScale4: f32 = 0.0f32;
		if ( useBias )
		{
			var C4: Vec2 = Vec2();
			C4.x = mass2.b2Dot( perpA, d );
			C4.y = b2RelativeAngle( stateB.deltaRotation, stateA.deltaRotation ) + joint.deltaAngle;

			bias4 = mass2.b2MulSV( base.constraintSoftness.biasRate, C4 );
			massScale4 = base.constraintSoftness.massScale;
			impulseScale4 = base.constraintSoftness.impulseScale;
		}

		var k11: f32 = mA + mB + iA * s1 * s1 + iB * s2 * s2;
		var k12: f32 = iA * s1 + iB * s2;
		var k22: f32 = iA + iB;
		if ( k22 == 0.0f32 )
		{
			k22 = 1.0f32;
		}

		var K: Mat22 = Mat22(Vec2(k11,k12),Vec2(k12,k22));

		var b: Vec2 = b2Solve22( K, b2Add( Cdot5, bias4 ) );
		var impulse4: Vec2 = Vec2();
		impulse4.x = -massScale4 * b.x - impulseScale4 * joint.impulse.x;
		impulse4.y = -massScale4 * b.y - impulseScale4 * joint.impulse.y;

		joint.impulse.x = joint.impulse.x + impulse4.x;
		joint.impulse.y = joint.impulse.y + impulse4.y;

		var P5: Vec2 = mass2.b2MulSV( impulse4.x, perpA );
		var LA5: f32 = impulse4.x * s1 + impulse4.y;
		var LB5: f32 = impulse4.x * s2 + impulse4.y;

		vA = distance.b2MulSub( vA, mA, P5 );
		wA = wA - iA * LA5;
		vB = b2MulAdd( vB, mB, P5 );
		wB = wB + iB * LB5;
	}

	stateA.linearVelocity = vA;
	stateA.angularVelocity = wA;
	stateB.linearVelocity = vB;
	stateB.angularVelocity = wB;
    if (joint.indexA != -1i32) b2GetSolverSet(world,2i32).bodyStates.at(joint.indexA as i64) = stateA;
    if (joint.indexB != -1i32) b2GetSolverSet(world,2i32).bodyStates.at(joint.indexB as i64) = stateB;
}

                                                                               
fun b2RevoluteJoint_GetAngle(id: JointId) -> f32 = {
    var world: ref World = worlds.at(id.world0 as i64); var sim: ref JointSim = b2GetJointSimCheckType(id);
    let xfA: Transform = b2GetBodySim(world,world.bodies.at(sim.bodyIdA as i64)).transform;
    let xfB: Transform = b2GetBodySim(world,world.bodies.at(sim.bodyIdB as i64)).transform;
    return b2UnwindAngle(b2RelativeAngle(xfB.q,xfA.q) - sim.revoluteJoint.referenceAngle);
}
fun b2PrismaticJoint_GetTranslation(id: JointId) -> f32 = {
    var world: ref World = worlds.at(id.world0 as i64); var sim: ref JointSim = b2GetJointSimCheckType(id);
    let xfA: Transform = b2GetBodySim(world,world.bodies.at(sim.bodyIdA as i64)).transform;
    let axisA: Vec2 = b2RotateVector(xfA.q,sim.prismaticJoint.localAxisA);
    return mass2.b2Dot(distanceSeparation14(world,sim),axisA);
}
fun b2PrismaticJoint_GetSpeed(id: JointId) -> f32 = {
    var world: ref World = worlds.at(id.world0 as i64); var sim: ref JointSim = b2GetJointSimCheckType(id);
    let bodyA: BodyRecord = world.bodies.at(sim.bodyIdA as i64); let bodyB: BodyRecord = world.bodies.at(sim.bodyIdB as i64);
    let simA: BodySim = b2GetSolverSet(world,bodyA.setIndex).bodySims.at(bodyA.localIndex as i64);
    let simB: BodySim = b2GetSolverSet(world,bodyB.setIndex).bodySims.at(bodyB.localIndex as i64);
    let axisA: Vec2 = b2RotateVector(simA.transform.q,sim.prismaticJoint.localAxisA);
    let rA: Vec2 = b2RotateVector(simA.transform.q,b2Sub(sim.localOriginAnchorA,simA.localCenter));
    let rB: Vec2 = b2RotateVector(simB.transform.q,b2Sub(sim.localOriginAnchorB,simB.localCenter));
    let d: Vec2 = b2Add(b2Sub(simB.center,simA.center),b2Sub(rB,rA));
    var stateA = BodyState(); var stateB = BodyState();
    if (bodyA.setIndex == 2i32) stateA = b2GetSolverSet(world,2i32).bodyStates.at(bodyA.localIndex as i64);
    if (bodyB.setIndex == 2i32) stateB = b2GetSolverSet(world,2i32).bodyStates.at(bodyB.localIndex as i64);
    let vRel: Vec2 = b2Sub(b2Add(stateB.linearVelocity,mass2.b2CrossSV(stateB.angularVelocity,rB)),b2Add(stateA.linearVelocity,mass2.b2CrossSV(stateA.angularVelocity,rA)));
    return mass2.b2Dot(d,mass2.b2CrossSV(stateA.angularVelocity,axisA)) + mass2.b2Dot(axisA,vRel);
}

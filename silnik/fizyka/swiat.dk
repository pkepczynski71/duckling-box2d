    if (kind == 3i32) return b2CollidePolygonAndCircle(&a.polygon, xfA, b.circle, xfB);
    if (kind == 4i32) return b2CollideCapsules(&a.capsule, xfA, &b.capsule, xfB);
    if (kind == 5i32) return b2CollideSegmentAndCapsule(&a.segment, xfA, &b.capsule, xfB);
    if (kind == 6i32) return b2CollidePolygonAndCapsule(&a.polygon, xfA, &b.capsule, xfB);
    if (kind == 7i32) return b2CollideSegmentAndPolygon(&a.segment, xfA, &b.polygon, xfB);
    if (kind == 8i32) return poly.b2CollidePolygons(&a.polygon, xfA, &b.polygon, xfB);
    if (kind == 9i32) return b2ChainSegmentAndCircleManifold(a, xfA, b, xfB, cache);
    if (kind == 10i32) return b2ChainSegmentAndCapsuleManifold(a, xfA, b, xfB, cache);
    if (kind == 11i32) return b2ChainSegmentAndPolygonManifold(a, xfA, b, xfB, cache);
    return Manifold();
}

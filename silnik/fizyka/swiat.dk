    let setIndex: i32 = base.setIndex;
    let traceIndex: i64 = world.sleepTrace.length();
    world.sleepTrace.push(SleepTransferTrace(3i32, baseId, setIndex, setIndex, base.bodyCount, base.contactCount, false));
    if (setIndex != 2i32 or base.constraintRemoveCount == 0i32) return;

fun b2Body_GetJoints(id: BodyId, capacity: i32) -> List[JointId] = {
    var values: List[JointId]; var world: ref World = worlds.at(id.world0 as i64);
    var key: i32 = world.bodies.at((id.index1 - 1i32) as i64).headJointKey;
    while (key != -1i32 and values.length() < capacity as i64) {
        let jointId: i32 = key >> 1i32; let side: i32 = key & 1i32;
        let joint: JointRecord = world.joints.at(jointId as i64);
        values.push(JointId(jointId + 1i32, id.world0, joint.generation));
        key = jointEdge(world.joints.at(jointId as i64), side).nextKey;
    }
    return values;
}

                                                                       

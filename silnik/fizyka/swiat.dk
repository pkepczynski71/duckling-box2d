# Box2D 8c661469, src/shape.           
fun b2Chain_GetSegments(id: ChainId, capacity: i32) -> List[broad.ShapeId] = {
    var result: List[broad.ShapeId]; var world: ref World = worlds.at(id.world0 as i64); if (world.locked) return result;
    var i: i32 = 0i32; let slot: i64 = (id.index1-1i32) as i64;
    while (i < world.chainShapes.at(slot).count and i < capacity) { result.push(b2MakeShapeId(world, world.chainShapes.at(slot).shapeIndices.at(i as i64))); i = i+1i32; }
    return result;
}

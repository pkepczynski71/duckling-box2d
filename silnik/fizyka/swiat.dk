fun b2AddJointToIsland(world: ref World, islandId: i32, id: i32) -> () = {
    var island: ref Island = world.islands.at(islandId as i64);
    if (island.headJoint != -1i32) {
        world.joints.at(id as i64).islandNext = island.headJoint;
        world.joints.at(island.headJoint as i64).islandPrev = id;
    }
    island.headJoint = id; if (island.tailJoint == -1i32) island.tailJoint = id;
    island.jointCount = island.jointCount + 1i32; world.joints.at(id as i64).islandId = islandId;
}
fun b2LinkJoint(world: ref World, id: i32, mergeIslands: bool) -> () = {
    let joint: JointRecord = world.joints.at(id as i64);
    let setA: i32 = world.bodies.at(joint.edgeA.bodyId as i64).setIndex;
    let setB: i32 = world.bodies.at(joint.edgeB.bodyId as i64).setIndex;
    if (setA == 2i32 and setB >= 3i32) b2WakeSolverSet(world, setB);
    else if (setB == 2i32 and setA >= 3i32) b2WakeSolverSet(world, setA);
    let a: i32 = world.bodies.at(joint.edgeA.bodyId as i64).islandId;
    let b: i32 = world.bodies.at(joint.edgeB.bodyId as i64).islandId;
    if (a == b) { b2AddJointToIsland(world, a, id); return; }
    let rootA: i32 = contactIslandRoot(world, a); let rootB: i32 = contactIslandRoot(world, b);
    if (rootA != rootB and rootA != -1i32 and rootB != -1i32) world.islands.at(rootB as i64).parentIsland = rootA;
    b2AddJointToIsland(world, if rootA != -1i32 then rootA else rootB, id);
    if (mergeIslands) b2MergeAwakeIslands(world);

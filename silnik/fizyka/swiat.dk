# Box2D 8c661469, src/id_pool.                     
fun emptyInts() -> List[i32] = { var values: List[i32]; return values; }
class IdPool {
    freeArray: List[i32] = emptyInts();
    freeCount: i32 = 0i32;
    nextIndex: i32 = 0i32;
}

# Box2D 8c661469, src/id_pool.c:19. Retained List slots are capacity, not live entries.
fun b2AllocId(pool: ref IdPool) -> i32 = {
    if (pool.freeCount > 0i32) {
        pool.freeCount = pool.freeCount - 1i32;
        let recycled: i32 = pool.freeArray.at(pool.freeCount as i64);
        return recycled;
    }
    let result: i32 = pool.nextIndex;
    pool.nextIndex = pool.nextIndex + 1i32;
    return result;
}

# Box2D 8c661469, src/id_pool.c:33.
fun b2FreeId(pool: ref IdPool, id: i32) -> () = {
    if (pool.freeCount as i64 == pool.freeArray.length()) pool.freeArray.push(id);
    else pool.freeArray.at(pool.freeCount as i64) = id;
    pool.freeCount = pool.freeCount + 1i32;
}


# Box2D 8c661469, include/box2d/types.                           
class ContactData {
    shapeA: broad.ShapeId = broad.ShapeId();
    shapeB: broad.ShapeId = broad.ShapeId();
    manifold: Manifold = Manifold();
}
# Box2D 8c661469, src/body.c:460-495.
fun b2Body_GetContactData(id: BodyId, capacity: i32) -> List[ContactData] = {
    var result: List[ContactData];
    var world: ref World = worlds.at(id.world0 as i64);
    var key: i32 = world.bodies.at((id.index1 - 1i32) as i64).headContactKey;
    while (key != -1i32 and result.length() < capacity as i64) {
        let record: ContactRecord = world.contacts.at((key >> 1i32) as i64);
        key = contactEdge(world.contacts.at((key >> 1i32) as i64), key & 1i32).nextKey;
        if ((record.flags & 1u32) != 0u32) result.push(ContactData(b2MakeShapeId(world, record.shapeIdA), b2MakeShapeId(world, record.shapeIdB),
            b2GetContactSim(world, world.contacts.at(record.contactId as i64)).manifold));
    }
    return result;
}

# Box2D 8c661469, src/world.c:747-771.                                                   
fun b2MakeSolverContext(world: ref World, dt: f32, requested: i32) -> SolverContext = {
    var context = SolverContext(); context.dt = dt;
    context.subStepCount = if requested > 0i32 then requested else 1i32;
    if (dt > 0.0f32) {
        context.inv_dt = 1.0f32 / dt; context.h = dt / (context.subStepCount as f32);
        context.inv_h = (context.subStepCount as f32) * context.inv_dt;
    }
    world.inv_h = context.inv_h;
    let hertz: f32 = poly.b2MinFloat(world.contactHertz, 0.125f32 * context.inv_h);
    context.contactSoftness = b2MakeSoft(hertz, world.contactDampingRatio, context.h);
    context.staticSoftness = b2MakeSoft(2.0f32 * hertz, world.contactDampingRatio, context.h);
    world.contactSpeed = world.maxContactPushSpeed / context.staticSoftness.massScale;
    context.restitutionThreshold = world.restitutionThreshold; context.maxLinearVelocity = world.maxLinearSpeed;
    context.enableWarmStarting = world.enableWarmStarting;
    return context;
}
# Box2D 8c661469, src/contact_solver.c:90-108,1376-1384.
fun solverState(world: ref World, index: i32) -> BodyState = {

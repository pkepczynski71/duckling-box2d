        let body: BodyRecord = world.bodies.at(bodyId as i64);
        if (body.bodyMoveIndex != -1i32) {
                                                                                        
            if (body.bodyMoveIndex as i64 < world.bodyMoveEvents.length()) world.bodyMoveEvents.at(body.bodyMoveIndex as i64).fellAsleep = true;
            world.bodies.at(bodyId as i64).bodyMoveIndex = -1i32;
        }
        let sim: BodySim = b2GetSolverSet(world, 2i32).bodySims.at(body.localIndex as i64);
        let target: i32 = b2GetSolverSet(world, setIndex).bodyCount;
        b2GetSolverSet(world, setIndex).bodySims.push(sim);

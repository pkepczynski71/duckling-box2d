        if (smoothParams.convex2) {
            var s2: f32 = poly.FLT_MAX; i = 0i32;
            while (i < count) { let neighborS2: f32 = poly.b2Dot(smoothParams.normal2, b2Sub(vertices[i], p2)); if (neighborS2 < s2) s2 = neighborS2; i = i + 1i32; }
            if (s2 > edgeSeparation) { edgeSeparation = s2; incidentIndex = -1i32; }

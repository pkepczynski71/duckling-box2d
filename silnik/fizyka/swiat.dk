# Box2D 8c661469, src/solver.c:1260-1276,1309-1326,1422-1430,1487-1569.
fun b2PlanBlocks(count: i64, unit: i32) -> BlockPlan = {
    var result = BlockPlan();
    if (unit == 0i32) result.baseSize = 32i64;
    if (count <= 0i64) return result;
    if (count > 4i64 * result.baseSize) { result.baseSize = count / 4i64; result.blockCount = 4i64; }
    else result.blockCount = (count - 1i64) / result.baseSize + 1i64;
    result.lastCount = count - (result.blockCount - 1i64) * result.baseSize;
    return result;
}
# Box2D 8c661469, src/solver.                                                                    
fun b2BlocksFit(count: i64, unit: i32) -> bool = {
    if (count < 0i64) return false;
    let plan: BlockPlan = b2PlanBlocks(count, unit);
    if (plan.blockCount == 0i64) return true;
    if (plan.blockCount > 1i64 and plan.baseSize > 32767i64) return false;
    return plan.lastCount > 0i64 and plan.lastCount <= 32767i64;
}

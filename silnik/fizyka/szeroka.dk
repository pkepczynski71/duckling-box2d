import fizyka.drzewo as tree;
import fizyka.zbior as table;

# Box2D 8c661469, src/broad_phase.h:18-20.
fun B2_PROXY_TYPE(key: i32) -> i32 = { return key & 3i32; }
# Box2D 8c661469, src/broad_phase.h:19.
fun B2_PROXY_ID(key: i32) -> i32 = { return key >> 2i32; }
# Box2D 8c661469, src/broad_phase.h:20.
fun B2_PROXY_KEY(id: i32, bodyType: i32) -> i32 = { return (id << 2i32) | bodyType; }

# Box2D 8c661469, include/box2d/types.h:249-281.
class ShapeFilter {
    categoryBits: i64 = 1i64;
    maskBits: i64 = -1i64;
    groupIndex: i32 = 0i32;
}

# Box2D 8c661469, src/shape.h:15-16,19,31,33,46. Read-only collision view.
class ShapeView {
    id: i32 = 0i32;
    bodyId: i32 = 0i32;
    sensorIndex: i32 = -1i32;
    proxyKey: i32 = -1i32;
    filter: ShapeFilter = ShapeFilter();
    generation: u16 = 1u16;
}

# Box2D 8c661469, src/body.h:39-40,60,62.
class BodyView {
    headJointKey: i32 = -1i32;
    jointCount: i32 = 0i32;
    id: i32 = 0i32;
    bodyType: i32 = 0i32;
}

# Box2D 8c661469, src/joint.h:19-24,43,59. Named edges avoid a fixed array.
class JointView {
    bodyIdA: i32 = 0i32;
    bodyIdB: i32 = 0i32;
    nextKeyA: i32 = -1i32;
    nextKeyB: i32 = -1i32;
    collideConnected: bool = false;
}

# Box2D 8c661469, include/box2d/id.h:52-57.
class ShapeId {
    index1: i32 = 0i32;
    world0: u16 = 0u16;
    generation: u16 = 0u16;
}

# Box2D 8c661469, src/broad_phase.c:267-277. Explicit custom-filter context.
class FilterRule {
    shapeA: i32 = 0i32;
    shapeB: i32 = 0i32;
    decision: bool = true;
}

# Box2D 8c661469, src/broad_phase.                                               
fun emptyBodies() -> List[BodyView] = { var values: List[BodyView]; return values; }
# Box2D 8c661469, src/broad_phase.                
fun emptyShapes() -> List[ShapeView] = { var values: List[ShapeView]; return values; }
# Box2D 8c661469, src/body.                 

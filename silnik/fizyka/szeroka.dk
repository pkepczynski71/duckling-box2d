# Box2D 8c661469, src/broad_phase.                                
                                                                  
# Box2D 8c661469, src/broad_phase.                                               
fun b2DefaultPairCallback12(a: ShapeId, b: ShapeId, context: table.Key64) -> bool = { return true; }
class PairCallback12 {
    callback: funptr(ShapeId, ShapeId, table.Key64) -> bool;
    installed: bool = false;
    context: table.Key64 = table.Key64();
}
class CollisionView {
    callback12: PairCallback12 = PairCallback12(b2DefaultPairCallback12);
    bodies: List[BodyView] = emptyBodies();
    shapes: List[ShapeView] = emptyShapes();
    joints: List[JointView] = emptyJoints();
    worldId: u16 = 0u16;
    customMode: i32 = 0i32;
    customRules: List[FilterRule] = emptyFilterRules();
}

# Box2D 8c661469, src/broad_phase.h:30. Guide rule 22.
fun zeroTrees() -> tree.DynamicTree[3] = {
    var values: tree.DynamicTree[3];
    return values;
}

# Box2D 8c661469, src/broad_phase.h:28-56.
class BroadPhase {
    trees: tree.DynamicTree[3] = zeroTrees();
    moveSet: table.HashSet = table.HashSet();
    moveArray: List[i32] = tree.emptyIndices();
    movePairCapacity: i32 = 0i32;
    movePairIndex: i32 = 0i32;
    pairSet: table.HashSet = table.HashSet();
}

# Box2D 8c661469, src/broad_phase.c:137-150. Index replaces next pointer.
class MovePair {
    shapeIndexA: i32 = 0i32;
    shapeIndexB: i32 = 0i32;
    next: i32 = -1i32;
}

# Box2D 8c661469, src/broad_phase.c:418-435. Client consumes these requests.
class ContactRequest {
    moveIndex: i32 = 0i32;
    shapeIndexA: i32 = 0i32;
    shapeIndexB: i32 = 0i32;
}

# Box2D 8c661469, src/broad_phase.c:348-368. Transparent query observation.
class QueryTrace {
    moveIndex: i32 = -1i32;
    queryProxyKey: i32 = -1i32;
    treeType: i32 = 0i32;
    result: tree.TreeQueryResult = tree.TreeQueryResult();
}

# Box2D 8c661469, src/broad_phase.c:271-277.
class FilterTrace {
    idA: ShapeId = ShapeId();
    idB: ShapeId = ShapeId();
    decision: bool = false;
}

# Box2D 8c661469, src/broad_phase.                          
fun emptyMovePairs() -> List[MovePair] = { var values: List[MovePair]; return values; }
# Box2D 8c661469, src/broad_phase.                       
fun emptyRequests() -> List[ContactRequest] = { var values: List[ContactRequest]; return values; }
